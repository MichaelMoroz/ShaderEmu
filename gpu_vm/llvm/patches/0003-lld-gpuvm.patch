+//===- GPUVM.cpp ----------------------------------------------------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// gpu_vm, the shader machine's own ISA (gpu_vm/isa.h in ShaderEmu). Code is
+// bundles of 16 bytes: two op words, a long immediate (word 2) and a control
+// word (word 3). A relocation's field is at a fixed word of its bundle, and
+// PC-relative values are taken from the bundle's address (P & ~15). Static
+// links only: no PLT, no GOT.
+//
+//===----------------------------------------------------------------------===//
+
+#include "Symbols.h"
+#include "Target.h"
+#include "llvm/BinaryFormat/ELF.h"
+#include "llvm/Support/Endian.h"
+
+using namespace llvm;
+using namespace llvm::object;
+using namespace llvm::support::endian;
+using namespace llvm::ELF;
+using namespace lld;
+using namespace lld::elf;
+
+namespace {
+class GPUVM final : public TargetInfo {
+public:
+  GPUVM(Ctx &);
+  RelExpr getRelExpr(RelType type, const Symbol &s,
+                     const uint8_t *loc) const override;
+  RelType getDynRel(RelType type) const override;
+  int64_t getImplicitAddend(const uint8_t *buf, RelType type) const override;
+  void relocate(uint8_t *loc, const Relocation &rel,
+                uint64_t val) const override;
+  bool needsThunk(RelExpr expr, RelType type, const InputFile *file,
+                  uint64_t branchAddr, const Symbol &s,
+                  int64_t a) const override;
+  bool inBranchRange(RelType type, uint64_t src, uint64_t dst) const override;
+  uint32_t getThunkSectionSpacing() const override;
+};
+} // namespace
+
+GPUVM::GPUVM(Ctx &ctx) : TargetInfo(ctx) {
+  symbolicRel = R_GVM_32;
+  relativeRel = R_GVM_RELATIVE;
+  // A bundle of zero words: its control word 0 is illegal.
+  trapInstr = {0, 0, 0, 0};
+  defaultMaxPageSize = 4096;
+  defaultCommonPageSize = 4096;
+  defaultImageBase = 0x02000000; // RAM (GVM_RAM)
+  needsThunks = true;
+}
+
+// src is the relocation's place, the control word; offsets are from its
+// bundle.
+bool GPUVM::inBranchRange(RelType type, uint64_t src, uint64_t dst) const {
+  int64_t off = static_cast<int64_t>(dst - (src & ~uint64_t(15)));
+  switch (type) {
+  case R_GVM_J18:
+    return (off & 15) == 0 && isInt<18>(off >> 4);
+  case R_GVM_BR9:
+    return (off & 15) == 0 && isInt<9>(off >> 4);
+  default:
+    return true;
+  }
+}
+
+// A call or far j beyond +-2 MB goes through a thunk (Thunks.cpp, GPUVMThunk).
+bool GPUVM::needsThunk(RelExpr expr, RelType type, const InputFile *file,
+                       uint64_t branchAddr, const Symbol &s, int64_t a) const {
+  if (type != R_GVM_J18 || (s.isUndefined() && !s.isInPlt(ctx)))
+    return false;
+  return !inBranchRange(type, branchAddr, s.getVA(ctx, a));
+}
+
+uint32_t GPUVM::getThunkSectionSpacing() const {
+  // +-2 MB, less room for the thunks.
+  return 0x200000 - 0x20000;
+}
+
+RelExpr GPUVM::getRelExpr(RelType type, const Symbol &s,
+                          const uint8_t *loc) const {
+  switch (type) {
+  case R_GVM_NONE:
+    return R_NONE;
+  case R_GVM_32:
+  case R_GVM_IMM32:
+  case R_GVM_IMM12:
+    return R_ABS;
+  case R_GVM_REL32:
+  case R_GVM_PCIMM32:
+  case R_GVM_BR9:
+  case R_GVM_J18:
+    return R_PC;
+  case R_GVM_TPREL32:
+    return R_TPREL;
+  default:
+    Err(ctx) << getErrorLoc(ctx, loc) << "unknown relocation (" << type.v
+             << ") against symbol " << &s;
+    return R_NONE;
+  }
+}
+
+RelType GPUVM::getDynRel(RelType type) const {
+  return type == R_GVM_32 ? type : R_GVM_NONE;
+}
+
+int64_t GPUVM::getImplicitAddend(const uint8_t *buf, RelType type) const {
+  switch (type) {
+  case R_GVM_NONE:
+    return 0;
+  case R_GVM_32:
+  case R_GVM_REL32:
+  case R_GVM_IMM32:
+  case R_GVM_PCIMM32:
+  case R_GVM_TPREL32:
+  case R_GVM_RELATIVE:
+    return SignExtend64<32>(read32le(buf));
+  case R_GVM_IMM12:
+    return SignExtend64<12>(read32le(buf) >> 20);
+  case R_GVM_BR9:
+    return SignExtend64<9>(read32le(buf) >> 17) * 16;
+  case R_GVM_J18:
+    return SignExtend64<18>(read32le(buf) >> 14) * 16;
+  default:
+    InternalErr(ctx, buf) << "cannot read addend for relocation " << type;
+    return 0;
+  }
+}
+
+void GPUVM::relocate(uint8_t *loc, const Relocation &rel, uint64_t val) const {
+  switch (rel.type) {
+  case R_GVM_32:
+  case R_GVM_REL32:
+  case R_GVM_IMM32:
+  case R_GVM_TPREL32:
+    checkIntUInt(ctx, loc, val, 32, rel);
+    write32le(loc, val);
+    break;
+  case R_GVM_PCIMM32:
+    // S + A - P, P word 2 of the bundle: from the bundle.
+    write32le(loc, val + 8);
+    break;
+  case R_GVM_IMM12:
+    checkInt(ctx, loc, static_cast<int64_t>(val), 12, rel);
+    write32le(loc, (read32le(loc) & 0x000fffff) | (val & 0xfff) << 20);
+    break;
+  case R_GVM_BR9: {
+    // P is the control word, the bundle's last word.
+    int64_t off = static_cast<int64_t>(val) + 12;
+    checkAlignment(ctx, loc, off, 16, rel);
+    checkInt(ctx, loc, off >> 4, 9, rel);
+    write32le(loc, (read32le(loc) & ~(0x1ffu << 17)) |
+                       static_cast<uint32_t>((off >> 4) & 0x1ff) << 17);
+    break;
+  }
+  case R_GVM_J18: {
+    int64_t off = static_cast<int64_t>(val) + 12;
+    checkAlignment(ctx, loc, off, 16, rel);
+    checkInt(ctx, loc, off >> 4, 18, rel);
+    write32le(loc, (read32le(loc) & 0x3fffu) |
+                       static_cast<uint32_t>((off >> 4) & 0x3ffff) << 14);
+    break;
+  }
+  default:
+    llvm_unreachable("unknown relocation");
+  }
+}
+
+void elf::setGPUVMTargetInfo(Ctx &ctx) { ctx.target.reset(new GPUVM(ctx)); }

+static std::unique_ptr<Thunk> addThunkGPUVM(Ctx &ctx, const InputSection &isec,
+                                            Relocation &rel, Symbol &s,
+                                            int64_t a) {
+  if (rel.type != R_GVM_J18)
+    Fatal(ctx) << "unrecognized relocation " << rel.type << " to " << &s
+               << " for gpu_vm: only R_GVM_J18 has thunks";
+  return std::make_unique<GPUVMThunk>(ctx, isec, rel, s, a);
+}

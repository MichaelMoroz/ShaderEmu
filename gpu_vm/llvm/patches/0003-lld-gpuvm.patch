+// gpu_vm: R_GVM_J18 (call, far j) reaches +-2 MB. The thunk is one bundle:
+// `addi t26, zero, dest` (a long immediate) and `jr t26`. t26 (r63) is the
+// linker's scratch register; a call's link (r1) is the caller's already.
+class GPUVMThunk final : public Thunk {
+public:
+  GPUVMThunk(Ctx &ctx, const InputSection &isec, Relocation &rel, Symbol &dest,
+             int64_t addend)
+      : Thunk(ctx, dest, addend), relOffset(rel.offset) {
+    alignment = 16;
+  }
+  uint32_t relOffset;
+  uint32_t size() override { return 16; }
+  void writeTo(uint8_t *buf) override;
+  void addSymbols(ThunkSection &isec) override;
+};
+
 // MIPS LA25 thunk
 class MipsThunk final : public Thunk {
 public:
@@ -1535,6 +1551,24 @@ bool PPC64LongBranchThunk::isCompatibleWith(const InputSection &isec,
   return rel.type == R_PPC64_REL24 || rel.type == R_PPC64_REL14;
 }
 
+// gpu_vm Target Thunks
+void GPUVMThunk::writeTo(uint8_t *buf) {
+  uint64_t s = destination.getVA(ctx, addend);
+  support::endian::write32le(buf + 0, 0x60u << 12 | 63u << 6);  // addi t26, zero, (long)
+  support::endian::write32le(buf + 4, 0);
+  support::endian::write32le(buf + 8, static_cast<uint32_t>(s)); // the long immediate
+  // jr t26 (cc 0, sub 2), one op, word 2 op 0s, path 1 (x18: addi and a jr)
+  support::endian::write32le(buf + 12, 2u << 11 | 63u << 14 | 1u << 3 | 0x20u | 1u);
+}
+
+void GPUVMThunk::addSymbols(ThunkSection &isec) {
+  Symbol *enclosing = isec.getEnclosingSymbol(relOffset);
+  StringRef src = enclosing ? enclosing->getName() : isec.name;
+  addSymbol(
+      saver().save("__gpuvm_thunk_" + destination.getName() + "_from_" + src),
+      STT_FUNC, 0, isec);
+}

diff --git a/clang/lib/CodeGen/Targets/GPUVM.cpp b/clang/lib/CodeGen/Targets/GPUVM.cpp
new file mode 100644
index 000000000..c35e06f4e
--- /dev/null
+++ b/clang/lib/CodeGen/Targets/GPUVM.cpp
@@ -0,0 +1,100 @@
+//===- GPUVM.cpp ----------------------------------------------------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// gpu_vm's ABI (gpu_vm/GPU_VM.md, "ABI"): integers narrower than 32 bits
+// extended; aggregates and vectors up to 8 bytes in registers (as i32 or
+// i64), larger ones by reference (a copy the caller makes), and returned
+// the same way (larger ones by a hidden pointer). Variadic arguments are on
+// the stack, 4 bytes a slot (the backend puts them there).
+//
+//===----------------------------------------------------------------------===//
+
+#include "ABIInfoImpl.h"
+#include "TargetInfo.h"
+
+using namespace clang;
+using namespace clang::CodeGen;
+
+namespace {
+class GPUVMABIInfo : public DefaultABIInfo {
+public:
+  GPUVMABIInfo(CodeGen::CodeGenTypes &CGT) : DefaultABIInfo(CGT) {}
+
+  ABIArgInfo classifyType(QualType Ty, bool IsReturn) const;
+
+  void computeInfo(CGFunctionInfo &FI) const override {
+    if (!getCXXABI().classifyReturnType(FI))
+      FI.getReturnInfo() = classifyType(FI.getReturnType(), true);
+    for (auto &I : FI.arguments())
+      I.info = classifyType(I.type, false);
+  }
+
+  RValue EmitVAArg(CodeGenFunction &CGF, Address VAListAddr, QualType Ty,
+                   AggValueSlot Slot) const override;
+};
+} // namespace
+
+ABIArgInfo GPUVMABIInfo::classifyType(QualType Ty, bool IsReturn) const {
+  if (IsReturn && Ty->isVoidType())
+    return ABIArgInfo::getIgnore();
+  Ty = useFirstFieldIfTransparentUnion(Ty);
+
+  if (!IsReturn)
+    if (CGCXXABI::RecordArgABI RAA = getRecordArgABI(Ty, getCXXABI()))
+      return getNaturalAlignIndirect(
+          Ty, getDataLayout().getAllocaAddrSpace(),
+          /*ByVal=*/RAA == CGCXXABI::RAA_DirectInMemory);
+
+  if (isEmptyRecord(getContext(), Ty, true))
+    return ABIArgInfo::getIgnore();
+
+  uint64_t Size = getContext().getTypeSize(Ty);
+  if (!isAggregateTypeForABI(Ty) && !Ty->isVectorType()) {
+    if (const auto *ED = Ty->getAsEnumDecl())
+      Ty = ED->getIntegerType();
+    if (const auto *EIT = Ty->getAs<BitIntType>())
+      if (EIT->getNumBits() > 64)
+        return getNaturalAlignIndirect(Ty, getDataLayout().getAllocaAddrSpace(),
+                                       /*ByVal=*/false);
+    if (Size < 32 && Ty->isIntegralOrEnumerationType())
+      return ABIArgInfo::getExtend(Ty);
+    return ABIArgInfo::getDirect();
+  }
+
+  if (Size <= 32)
+    return ABIArgInfo::getDirect(llvm::IntegerType::get(getVMContext(), 32));
+  if (Size <= 64)
+    return ABIArgInfo::getDirect(llvm::IntegerType::get(getVMContext(), 64));
+  return getNaturalAlignIndirect(Ty, getDataLayout().getAllocaAddrSpace(),
+                                 /*ByVal=*/false);
+}
+
+RValue GPUVMABIInfo::EmitVAArg(CodeGenFunction &CGF, Address VAListAddr,
+                               QualType Ty, AggValueSlot Slot) const {
+  if (isEmptyRecord(getContext(), Ty, true))
+    return Slot.asRValue();
+  auto TInfo = getContext().getTypeInfoInChars(Ty);
+  bool IsIndirect = (isAggregateTypeForABI(Ty) || Ty->isVectorType()) &&
+                    TInfo.Width.getQuantity() > 8;
+  return emitVoidPtrVAArg(CGF, VAListAddr, Ty, IsIndirect, TInfo,
+                          CharUnits::fromQuantity(4),
+                          /*AllowHigherAlign=*/false, Slot);
+}
+
+namespace {
+class GPUVMTargetCodeGenInfo : public TargetCodeGenInfo {
+public:
+  GPUVMTargetCodeGenInfo(CodeGen::CodeGenTypes &CGT)
+      : TargetCodeGenInfo(std::make_unique<GPUVMABIInfo>(CGT)) {}
+};
+} // namespace
+
+std::unique_ptr<TargetCodeGenInfo>
+CodeGen::createGPUVMTargetCodeGenInfo(CodeGenModule &CGM) {
+  return std::make_unique<GPUVMTargetCodeGenInfo>(CGM.getTypes());
+}

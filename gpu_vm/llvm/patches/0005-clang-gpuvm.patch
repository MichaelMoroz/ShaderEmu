@@ -0,0 +1,28 @@
+//===--- BuiltinsGPUVM.td - gpu_vm Builtin function database ----*- C++ -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// The commit's operations (llvm.gpuvm.copy, llvm.gpuvm.fill): always the
+// operation, one sq of a descriptor to 0xf0000000, whatever the size.
+//
+//===----------------------------------------------------------------------===//
+
+include "clang/Basic/BuiltinsBase.td"
+
+// memmove(dst, src, bytes)
+def GPUVMCopy : TargetBuiltin {
+  let Spellings = ["__builtin_gpuvm_copy"];
+  let Attributes = [NoThrow];
+  let Prototype = "void(void*, void const*, unsigned int)";
+}
+
+// bytes at dst from the word (byte i is byte i % 4 of the word)
+def GPUVMFill : TargetBuiltin {
+  let Spellings = ["__builtin_gpuvm_fill"];
+  let Attributes = [NoThrow];
+  let Prototype = "void(void*, unsigned int, unsigned int)";
+}

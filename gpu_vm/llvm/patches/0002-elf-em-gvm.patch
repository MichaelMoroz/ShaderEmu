 // Section header.
diff --git a/llvm/include/llvm/BinaryFormat/ELFRelocs/GPUVM.def b/llvm/include/llvm/BinaryFormat/ELFRelocs/GPUVM.def
new file mode 100644
index 000000000..d786e859c
--- /dev/null
+++ b/llvm/include/llvm/BinaryFormat/ELFRelocs/GPUVM.def
@@ -0,0 +1,16 @@
+#ifndef ELF_RELOC
+#error "ELF_RELOC must be defined"
+#endif
+
+// gpu_vm (gpu_vm/isa.h). A bundle is 16 bytes: op 0, op 1, the long immediate
+// (word 2), the control word (word 3). "The bundle" is P & ~15.
+ELF_RELOC(R_GVM_NONE,      0)
+ELF_RELOC(R_GVM_32,        1) // a data word: S + A
+ELF_RELOC(R_GVM_REL32,     2) // a data word: S + A - P
+ELF_RELOC(R_GVM_IMM32,     3) // word 2: S + A
+ELF_RELOC(R_GVM_PCIMM32,   4) // word 2 (lpc): S + A - the bundle
+ELF_RELOC(R_GVM_BR9,       5) // control word [25:17]: (S + A - the bundle) / 16
+ELF_RELOC(R_GVM_J18,       6) // control word [31:14]: (S + A - the bundle) / 16
+ELF_RELOC(R_GVM_IMM12,     7) // op word [31:20]: S + A
+ELF_RELOC(R_GVM_TPREL32,   8) // word 2: S + A - the thread pointer's base
+ELF_RELOC(R_GVM_RELATIVE,  9)

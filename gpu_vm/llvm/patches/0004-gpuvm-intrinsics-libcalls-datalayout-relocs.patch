diff --git a/llvm/lib/Object/RelocationResolver.cpp b/llvm/lib/Object/RelocationResolver.cpp
index f88bb1710..ff77a1a9e 100644
--- a/llvm/lib/Object/RelocationResolver.cpp
+++ b/llvm/lib/Object/RelocationResolver.cpp
@@ -382,6 +382,20 @@ static uint64_t resolveAVR(uint64_t Type, uint64_t Offset, uint64_t S,
   }
 }
 
+// gpu_vm: the data words debug info and tables hold.
+static bool supportsGPUVM(uint64_t Type) {
+  return Type == ELF::R_GVM_32 || Type == ELF::R_GVM_REL32;
+}
+
+static uint64_t resolveGPUVM(uint64_t Type, uint64_t Offset, uint64_t S,
+                             uint64_t /*LocData*/, int64_t Addend) {
+  if (Type == ELF::R_GVM_32)
+    return (S + Addend) & 0xFFFFFFFF;
+  if (Type == ELF::R_GVM_REL32)
+    return (S + Addend - Offset) & 0xFFFFFFFF;
+  llvm_unreachable("Invalid relocation type");
+}
+
 static bool supportsLanai(uint64_t Type) {
   return Type == ELF::R_LANAI_32;
 }
@@ -865,6 +879,8 @@ getRelocationResolver(const ObjectFile &Obj) {
       return {supportsAVR, resolveAVR};
     case Triple::lanai:
       return {supportsLanai, resolveLanai};
+    case Triple::gpuvm:
+      return {supportsGPUVM, resolveGPUVM};
     case Triple::loongarch32:
       return {supportsLoongArch, resolveLoongArch};
     case Triple::mipsel:

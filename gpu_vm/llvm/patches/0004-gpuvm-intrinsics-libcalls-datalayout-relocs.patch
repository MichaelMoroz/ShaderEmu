diff --git a/llvm/include/llvm/IR/IntrinsicsGPUVM.td b/llvm/include/llvm/IR/IntrinsicsGPUVM.td
new file mode 100644
index 000000000..7ce1ebec2
--- /dev/null
+++ b/llvm/include/llvm/IR/IntrinsicsGPUVM.td
@@ -0,0 +1,28 @@
+//===- IntrinsicsGPUVM.td - gpu_vm intrinsics --------------*- tablegen -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// gpu_vm (the shader machine's own ISA): the commit's operations, asked for by
+// a 16-byte store of a descriptor to 0xf0000000 (gpu_vm/GPU_VM.md,
+// "Operations"). Always the operation, whatever the size.
+//
+//===----------------------------------------------------------------------===//
+
+let TargetPrefix = "gpuvm" in {
+// memmove(dst, src, bytes) by the commit (kind 1).
+def int_gpuvm_copy : DefaultAttrsIntrinsic<[],
+    [llvm_ptr_ty, llvm_ptr_ty, llvm_i32_ty],
+    [IntrArgMemOnly, NoCapture<ArgIndex<0>>, NoCapture<ArgIndex<1>>,
+     WriteOnly<ArgIndex<0>>, ReadOnly<ArgIndex<1>>]>,
+    ClangBuiltin<"__builtin_gpuvm_copy">;
+// Fills bytes at dst with the word (byte i of the fill is byte i & 3 of the
+// word) by the commit (kind 2).
+def int_gpuvm_fill : DefaultAttrsIntrinsic<[],
+    [llvm_ptr_ty, llvm_i32_ty, llvm_i32_ty],
+    [IntrArgMemOnly, NoCapture<ArgIndex<0>>, WriteOnly<ArgIndex<0>>]>,
+    ClangBuiltin<"__builtin_gpuvm_fill">;
+}
diff --git a/llvm/include/llvm/IR/RuntimeLibcalls.td b/llvm/include/llvm/IR/RuntimeLibcalls.td
index d5f38b967..800cbbf62 100644
--- a/llvm/include/llvm/IR/RuntimeLibcalls.td
+++ b/llvm/include/llvm/IR/RuntimeLibcalls.td
@@ -2659,6 +2659,21 @@ def LanaiSystemLibrary
   let DefaultLibcallCallingConv = FASTCC;
 }
 
+//===----------------------------------------------------------------------===//
+// gpu_vm Runtime Libcalls
+//===----------------------------------------------------------------------===//
+
+def isGPUVM : RuntimeLibcallPredicate<"TT.getArch() == Triple::gpuvm">;
+
+// compiler-rt's builtins (i64 division, double in software) and libm (musl's,
+// with sincos and sincosf; the exec tests' runtime has sincosf).
+def GPUVMSystemLibrary
+    : SystemRuntimeLibrary<isGPUVM,
+      (add DefaultRuntimeLibcallImpls,
+         sincosf, sincos,
+         exp10f, exp10, __powisf2, __powidf2,
+         DefaultStackProtector, DefaultSafeStackGlobals)>;
+
 //===----------------------------------------------------------------------===//
 // Mips16 Runtime Libcalls
 //===----------------------------------------------------------------------===//

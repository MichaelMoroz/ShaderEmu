# gpu_vm as the whole machine (gpu_vm/platform.md): the devices' drivers (drivers.py) and what the RISC-V machine's
# kernel has for its programs (linux/kernel/config.extra, ~/shaderemu-linux/all.config), merged over gpuvm_defconfig
# by build.sh's config step (MACHINE=0 leaves it out).
CONFIG_SHADEREMU_GPU=y
CONFIG_SHADEREMU_SOUND=y
CONFIG_FB=y
CONFIG_FB_SHADEREMU=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_SHADEREMU=y
CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_SHADEREMU_NET=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_FUTEX=y
CONFIG_POSIX_TIMERS=y
CONFIG_MULTIUSER=y
CONFIG_FILE_LOCKING=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_FHANDLE=y
CONFIG_SYSFS_SYSCALL=y
CONFIG_UNIX98_PTYS=y
CONFIG_SYSCTL=y
CONFIG_PROC_SYSCTL=y
CONFIG_OVERLAY_FS=y
CONFIG_OVERLAY_FS_REDIRECT_DIR=y
# SLOB's first fit was a tenth of the boot; the pool seeded from the device tree's rng-seed (image.sh)
# CONFIG_SLOB is not set
CONFIG_SLUB=y
# CONFIG_SLUB_DEBUG is not set
CONFIG_RANDOM_TRUST_BOOTLOADER=y
# one RAM disk, not sixteen (brd_init was a quarter of the kernel's start); no IPv6-in-IPv4 tunnel
CONFIG_BLK_DEV_RAM_COUNT=1
# CONFIG_IPV6_SIT is not set

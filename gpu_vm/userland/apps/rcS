#!/bin/sh
# the system's start for apps/image.sh's machine: rootfs.sh's (gpu_vm/userland/rootfs/etc/init.d/rcS), and a
# /persistence in memory (the host keeps nothing here yet: docs/system/persist.md), which the games' starters use
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mount -t tmpfs -o mode=1777,size=32m tmpfs /tmp
mount -t tmpfs -o mode=0755,size=4m tmpfs /persistence
mount -t tmpfs -o mode=0755,size=1m tmpfs /run
# /root, /var, /etc and /home written over the ROM's (the desktop's places, a program's saves, at's spool), as the
# RISC-V image's overlay makes the whole root
for d in root var etc home; do
    mkdir -p /tmp/.over/$d/up /tmp/.over/$d/work
    mount -t overlay overlay -o lowerdir=/$d,upperdir=/tmp/.over/$d/up,workdir=/tmp/.over/$d/work /$d
done
mkdir -p /var/spool/cron/atjobs /var/spool/cron/atspool /var/run /var/log
: > /var/spool/cron/atjobs/.SEQ   # (at's sequence file, which the RISC-V ROM has)
hostname -F /etc/hostname
echo "gpuvm: up in $(cut -d' ' -f1 /proc/uptime) s"

hush on a machine without an MMU runs a subshell, $(...) and a pipeline's builtins by executing itself again with
its own argv[0]: a login shell's "-/bin/sh", so every such child read /etc/profile again (the motd in the output of
$(...), and a cd to $HOME before (cd /tmp; pwd) ran). A re-executed hush is never a login shell.
--- a/shell/hush.c
+++ b/shell/hush.c
@@ -10533,6 +10533,7 @@
 		case '$': {
 			unsigned long long empty_trap_mask;
 
+			flags &= ~OPT_login;
 			G.root_pid = bb_strtou(optarg, &optarg, 16);
 			optarg++;
 			G.root_ppid = bb_strtou(optarg, &optarg, 16);

#!/bin/sh
# runs the tests of gpu_vm/userland/test in /usr/lib/gvm-tests (libc, signals, threads, math, badptr) and says how many passed
pass=0 fail=0
for t in /usr/lib/gvm-tests/*; do
    if "$t" > /tmp/gvm-test.out 2>&1; then
        echo "== $(basename $t): PASS"; pass=$((pass + 1))
    else
        echo "== $(basename $t): FAIL ($?)"; tail -5 /tmp/gvm-test.out; fail=$((fail + 1))
    fi
done
echo "gvm-tests: $pass passed, $fail failed"

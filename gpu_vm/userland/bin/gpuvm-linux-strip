#!/bin/sh
# llvm-strip for gpu_vm; a bFLT program has nothing to strip: copied unchanged (to -o's file when one is given)
out= ; in= ; prev=
for a do
    if [ "$prev" = -o ]; then out=$a; prev=; continue; fi
    case "$a" in -o) prev=-o ;; -*) ;; *) in=$a ;; esac
done
if [ -n "$in" ] && [ "$(head -c 4 "$in" 2>/dev/null)" = bFLT ]; then
    [ -n "$out" ] && [ "$out" != "$in" ] && cp "$in" "$out"
    exit 0
fi
exec "${LLVM_BIN:-$HOME/gpu_vm/llvm-build/bin}/llvm-strip" "$@"

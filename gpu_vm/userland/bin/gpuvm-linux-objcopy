#!/bin/sh
# llvm-objcopy for gpu_vm (gpu_vm/userland/README.md)
# llvm-objcopy takes --set-section-alignment's name exactly, GNU objcopy a pattern: the games' builds give `.data*=16`
# (a variable a texel), so a pattern with a * is made here into the input's own sections of that pattern.
L=${LLVM_BIN:-$HOME/gpu_vm/llvm-build/bin}
case "$*" in *--set-section-alignment*\**) ;; *) exec "$L/llvm-objcopy" "$@" ;; esac
in=
for a in "$@"; do case "$a" in -*|*=*) ;; *) [ -z "$in" ] && [ -f "$a" ] && in=$a ;; esac; done
secs=$("$L/llvm-readelf" -S -W "$in" | sed -n 's/^ *\[ *[0-9]*\] \([^ ]*\) .*/\1/p')
n=$#; i=0; take=
for a in "$@"; do
    i=$((i + 1))
    if [ -n "$take" ]; then
        take=; pat=${a%=*}; al=${a##*=}
        for s in $secs; do case "$s" in $pat) set -- "$@" --set-section-alignment "$s=$al" ;; esac; done
    elif [ "$a" = --set-section-alignment ]; then
        take=1
    else
        set -- "$@" "$a"
    fi
done
shift "$n"
exec "$L/llvm-objcopy" "$@"

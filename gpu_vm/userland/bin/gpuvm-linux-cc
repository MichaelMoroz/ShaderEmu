#!/bin/bash
# gpuvm-linux-cc: a C compiler for programs of gpu_vm's Linux (gpu_vm/userland/README.md). As gcc is used:
#   gpuvm-linux-cc -O2 -c a.c -o a.o           compile (clang --target=gpuvm-unknown-linux, musl's headers)
#   gpuvm-linux-cc a.o b.c -lm -o prog          link: ld.lld -q with flat.ld at 0, crt1.o, libc.a and compiler-rt's
#                                                builtins, then elf2flt: prog is a bFLT program
# Link options of its own: -Wl,-z,stack-size=N or -Wl,-elf2flt=-sN or GVM_STACK=N (the stack, default 65536);
# GVM_KEEP_ELF=1 keeps the linked ELF as PROG.gdb. -v prints the commands.
# SYSROOT (~/gpu_vm/sysroot), LLVM_BIN (~/gpu_vm/llvm-build/bin).
set -u
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
UL="$(dirname "$HERE")"
SYSROOT="${SYSROOT:-$HOME/gpu_vm/sysroot}"
LLVM_BIN="${LLVM_BIN:-$HOME/gpu_vm/llvm-build/bin}"
TARGET=gpuvm-unknown-linux
RES="$("$LLVM_BIN/clang" -print-resource-dir)"
BUILTINS="$SYSROOT/lib/libclang_rt.builtins-gpuvm.a"
CFLAGS0=(--target=$TARGET -nostdinc -isystem "$SYSROOT/include" -isystem "$RES/include" ${GVM_PIC:--fPIE})

mode=link out= stack="${GVM_STACK:-65536}" verbose=0 startfiles=1 stdlibs=1
compile=()      # arguments for each compilation
inputs=()       # link inputs in order: objects, archives, -l, -L, linker flags, sources (compiled first)
ldflags=()
xlang=
prev=
for a in "$@"; do
    if [ -n "$prev" ]; then
        case "$prev" in
        -o) out=$a ;;
        -Xlinker) ldflags+=("$a") ;;
        -x) xlang=$a ;;
        *) compile+=("$prev" "$a") ;;
        esac
        prev=; continue
    fi
    case "$a" in
    -c|-S|-E) mode=$a; compile+=("$a") ;;
    -M|-MM) [ $mode = link ] && mode=-E; compile+=("$a") ;;
    -fsyntax-only) mode=-c; compile+=("$a") ;;
    -o|-Xlinker|-x|-I|-D|-U|-include|-isystem|-idirafter|-iquote|-MF|-MT|-MQ|-imacros|-iprefix|-iwithprefix|-arch)
        prev=$a ;;
    -v) verbose=1; compile+=(-v) ;;
    -print-libgcc-file-name) echo "$BUILTINS"; exit 0 ;;
    -print-file-name=*) f=${a#-print-file-name=}; if [ -e "$SYSROOT/lib/$f" ]; then echo "$SYSROOT/lib/$f"; else echo "$f"; fi; exit 0 ;;
    -print-prog-name=*) echo "${a#-print-prog-name=}"; exit 0 ;;
    -print-search-dirs) echo "install: $SYSROOT/lib/"; echo "programs: =$LLVM_BIN"; echo "libraries: =$SYSROOT/lib"; exit 0 ;;
    -dumpmachine) echo gpuvm-unknown-linux-musl; exit 0 ;;
    -dumpversion) echo 23.1.4; exit 0 ;;
    --version) exec "$LLVM_BIN/clang" --target=$TARGET --version ;;
    -shared) echo "gpuvm-linux-cc: no shared libraries (static bFLT programs only)" >&2; exit 1 ;;
    -static|-static-pie|-pie|-no-pie|-rdynamic|-s|-pthread|-static-libgcc|-shared-libgcc)
        [ "$a" = -pthread ] && compile+=(-D_REENTRANT) ;;
    -nostdlib) startfiles=0; stdlibs=0 ;;
    -nostartfiles) startfiles=0 ;;
    -nodefaultlibs) stdlibs=0 ;;
    -l*|-L*) inputs+=("$a") ;;
    -Wl,*)
        IFS=, read -r -a w <<< "${a#-Wl,}"
        k=0
        while [ $k -lt ${#w[@]} ]; do
            case "${w[$k]}" in
            -z) if [[ "${w[$((k + 1))]:-}" == stack-size=* ]]; then stack=${w[$((k + 1))]#stack-size=}; k=$((k + 2)); continue; fi ;;
            -elf2flt=*) e=${w[$k]#-elf2flt=}; e=${e//\"/}; [[ "$e" == *-s* ]] && stack=$(echo "$e" | sed -n 's/.*-s *\([0-9xa-fA-F]*\).*/\1/p') ;;
            esac
            [[ "${w[$k]}" == -elf2flt* ]] || ldflags+=("${w[$k]}")
            k=$((k + 1))
        done ;;
    -) inputs+=("src:${xlang:-c}:-") ;;
    -*) compile+=("$a") ;;
    *)
        if [ -n "$xlang" ] && [ "$xlang" != none ]; then inputs+=("src:$xlang:$a"); continue; fi
        case "$a" in
        *.c|*.i|*.s|*.S|*.sx) inputs+=("src::$a") ;;
        *.cc|*.cpp|*.cxx|*.C) inputs+=("src::$a") ;;
        *) inputs+=("$a") ;;
        esac ;;
    esac
done

run() { [ $verbose = 1 ] && echo "$*" >&2; "$@"; }

if [ $mode != link ]; then
    srcs=()
    for i in "${inputs[@]+"${inputs[@]}"}"; do
        case "$i" in
        src:*) rest=${i#src:}; lang=${rest%%:*}; [ -n "$lang" ] && srcs+=(-x "$lang"); srcs+=("${rest#*:}") ;;
        -l*|-L*) ;;
        *) srcs+=("$i") ;;
        esac
    done
    o=(); [ -n "$out" ] && o=(-o "$out")
    run "$LLVM_BIN/clang" "${CFLAGS0[@]}" "${compile[@]+"${compile[@]}"}" "${srcs[@]+"${srcs[@]}"}" "${o[@]+"${o[@]}"}"
    exit $?
fi

out=${out:-a.out}
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
objs=()
n=0
for i in "${inputs[@]+"${inputs[@]}"}"; do
    case "$i" in
    src:*)
        rest=${i#src:}; lang=${rest%%:*}; f=${rest#*:}
        n=$((n + 1)); o="$tmp/$n-$(basename "${f%.*}").o"
        x=(); [ -n "$lang" ] && x=(-x "$lang")
        run "$LLVM_BIN/clang" "${CFLAGS0[@]}" "${compile[@]+"${compile[@]}"}" "${x[@]+"${x[@]}"}" -c "$f" -o "$o" || exit 1
        objs+=("$o") ;;
    *) objs+=("$i") ;;
    esac
done

pre=() post=()
if [ $startfiles = 1 ]; then pre=("$SYSROOT/lib/crt1.o" "$SYSROOT/lib/crti.o"); post=("$SYSROOT/lib/crtn.o"); fi
# GVM_ORDER_FILE: the functions laid out in that order (symbols, hottest first: gpu_vm/tick/gamebench_rv/autofdo.py):
# the hot code together (the code-size cliff, gpu_vm/IDEAS.md)
if [ -n "${GVM_ORDER_FILE:-}" ] && [ -f "$GVM_ORDER_FILE" ]; then
    ldflags+=("--symbol-ordering-file=$GVM_ORDER_FILE" --no-warn-symbol-ordering)
fi
libs=()
[ $stdlibs = 1 ] && libs=(--start-group -lc "$BUILTINS" --end-group)
run "$LLVM_BIN/ld.lld" -static -q -T "$UL/flat.ld" -o "$tmp/prog.elf" "${pre[@]+"${pre[@]}"}" "${objs[@]+"${objs[@]}"}" \
    -L"$SYSROOT/lib" "${ldflags[@]+"${ldflags[@]}"}" "${libs[@]+"${libs[@]}"}" "${post[@]+"${post[@]}"}" || exit 1
v=(); [ $verbose = 1 ] && v=(-v)
run python3 "$UL/elf2flt" -s "$stack" "${v[@]+"${v[@]}"}" "$tmp/prog.elf" "$out" || { rm -f "$out"; exit 1; }
chmod +x "$out"
[ "${GVM_KEEP_ELF:-0}" = 1 ] && cp "$tmp/prog.elf" "$out.gdb"
exit 0

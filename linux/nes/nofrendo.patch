 /* Issue a CPU Reset */
+/* ours: the registers brought to where the slices since have got to in the loop, by
+** doing the instructions between to them as the loop's trial turn did (nothing is run) */
+static void idle_wake(void)
+{
+   uint8 regs[4] = { cpu.a_reg, cpu.x_reg, cpu.y_reg, cpu.p_reg };
+   uint32 pc = cpu.pc_reg, steady = 0x7FFFFFFF, fell;
+   int at, jumped;
+
+   if (2 != idle.state)
+      return;
+   idle.state = 0;
+   if (idle.count_reg && idle.turns_done)
+   {
+      /* a loop that counts: the whole turns gone are the count moved on, all but the last,
+      ** which is done as below so that the flags are that turn's */
+      int whole = idle.turns_done - (idle.at < idle.was_at ? 1 : 0);
+
+      if (whole > 0)
+      {
+         regs[idle.count_reg] += idle.count_by * (whole - 1);
+         for (at = 0; at < idle.count; at++)
+            idle_step(&pc, regs, idle.status, &steady, &jumped, &fell);
+      }
+   }
+   for (at = idle.was_at; at != idle.at; at = (at + 1 == idle.count) ? 0 : at + 1)
+      idle_step(&pc, regs, idle.status, &steady, &jumped, &fell);
+   cpu.a_reg = regs[0];
+   cpu.x_reg = regs[1];
+   cpu.y_reg = regs[2];
+   cpu.p_reg = regs[3];
+   cpu.pc_reg = pc;
+}
+
 void nes6502_reset(void)
 {
+   idle_wake();
    cpu.p_reg = Z_FLAG | R_FLAG | I_FLAG;     /* Reserved bit always 1 */
    cpu.int_pending = 0;                      /* No pending interrupts */
    cpu.int_latency = 0;                      /* No latent interrupts */
@@ -2424,6 +2891,7 @@ void nes6502_nmi(void)
 {
    DECLARE_LOCAL_REGS
 
+   idle_wake();
    if (false == cpu.jammed)
    {
       GET_GLOBAL_REGS();
@@ -2438,6 +2906,13 @@ void nes6502_irq(void)
 {
    DECLARE_LOCAL_REGS
 
+   idle_wake();
+   /* ours: translated code has the registers (rc6502.h); it is left, and the interpreter takes this first */
+   if (rc_running)
+   {
+      cpu.int_pending = 1;
+      return;
+   }
    if (false == cpu.jammed)
    {
       GET_GLOBAL_REGS();
@@ -2457,6 +2932,7 @@ void nes6502_irq(void)
 /* Set dead cycle period */
 void nes6502_burn(int cycles)
 {
+   idle_wake();
    cpu.burn_cycles += cycles;
 }
 

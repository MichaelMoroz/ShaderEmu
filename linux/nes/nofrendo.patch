 /* Read from $2000-$2007 */
+/* ours, for the 6502's idle loops: what the status reads as now, when reading it would
+** change nothing (-1 when it would), and for how many cycles it will read as that.
+*/
+int ppu_status_steady(uint32 *cycles)
+{
+   uint32 now = nes6502_getcycles(false);
+   int value = (ppu.stat & 0xE0) | (ppu.latch & 0x1F);
+
+   if ((ppu.stat & PPU_STATF_VBLANK) || ppu.flipflop)
+      return -1;
+   *cycles = 0x7FFFFFFF;
+   if (ppu.strikeflag)
+   {
+      if (now >= ppu.strike_cycle)
+         value |= PPU_STATF_STRIKE;
+      else
+         *cycles = ppu.strike_cycle - now;
+   }
+   return value;
+}

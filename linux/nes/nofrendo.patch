+/* ours: four pixels of a background tile are one word looked up, by the tile's palette
+** and by a nibble of each of its two bit planes. Made again when the colours change.
+*/
+static uint32 bg_words[4][256];
+static uint8 bg_words_of[16];
+
+static void bg_words_make(void)
+{
+   uint32 pair[16];
+   int group, i;
+
+   for (group = 0; group < 4; group++)
+   {
+      const uint8 *colors = ppu.palette + group * 4;
+
+      /* two pixels: bits 1 and 3 are the left one's, bits 0 and 2 the right one's */
+      for (i = 0; i < 16; i++)
+         pair[i] = colors[((i >> 1) & 1) | ((i >> 2) & 2)] | colors[(i & 1) | ((i >> 1) & 2)] << 8;
+      for (i = 0; i < 256; i++)
+         bg_words[group][i] = pair[((i >> 2) & 3) | ((i >> 4) & 0xC)] | pair[(i & 3) | ((i >> 2) & 0xC)] << 16;
+   }
+   memcpy(bg_words_of, ppu.palette, 16);
+}

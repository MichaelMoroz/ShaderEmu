+{
+   if (2 == idle.state && idle.status >= 0)
+   {
+      /* (the status must read the same to the end of the slice's last instruction) */
+      uint32 steady;
+
+      if (ppu_status_steady(&steady) != idle.status || steady < (uint32) timeslice_cycles + 8)
+         idle_wake();
+   }
+   if (2 == idle.state)
+   {
+      int elapsed = 0, at = idle.at;
+
+      while (elapsed < timeslice_cycles)
+      {
+         if (0 == at)
+            elapsed += (timeslice_cycles - elapsed - 1) / idle.turn * idle.turn;
+         elapsed += idle.cycles[at];
+         if (++at == idle.count)
+            at = 0;
+      }
+      idle.at = at;
+      remaining_cycles = timeslice_cycles - elapsed;
+      cpu.total_cycles += elapsed;
+      return elapsed;
+   }
+   idle.state = 0;
+   return nes6502_awake(timeslice_cycles);
+}

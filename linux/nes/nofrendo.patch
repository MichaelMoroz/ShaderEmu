+/* A short loop that only looks (loads, compares, tests, branches) and comes round to the
+** registers and flags it began with: the loop a game waits in, for its interrupt or for
+** the PPU's status. Every turn of it is like the last, so the turns left in this slice are
+** counted instead of run. One turn is tried here, with nothing changed, to know.
+*/
+extern int ppu_status_steady(uint32 *cycles);
+
+int nes6502_plain; /* set: every turn of such a loop is run, to compare with */
+
+/* Asleep: a slice ended inside such a loop, one that reads only memory, so until something
+** wakes the 6502 (an interrupt, cycles to burn, its context asked for) every slice is turns
+** of the loop: where in it each slice ends is counted from the cycles of its instructions,
+** and the registers are brought there (by running the instructions between) on waking.
+*/
+nes6502_idle_t nes6502_idle;
+#define  idle  nes6502_idle
+
+/* slices that were counted elsewhere (ppu_quiet_lines) */
+void nes6502_slept(int cycles, int at)
+{
+   cpu.total_cycles += cycles;
+   idle.at = at;
+}
+static uint16 idle_never[64]; /* loops with something else in them, by their first address */
+/* what idle_loop made of X, Y and the flags, when it passed turns of a loop that counts */
+static struct { int any; uint8 x, y, p; } idle_passed;
+
+static int idle_looked;    /* the status as a trial turn read it */
+static int idle_counted;   /* a trial turn had dex, dey, inx or iny in it */
+
+/* a read that changes nothing (-1: not this time, -2: never); *steady: how long it gives that */
+static int idle_read(uint32 address, uint32 *steady)
+{
+   uint32 cycles;
+   int value;
+
+   if (address < 0x800)
+      return ram[address];
+   if (address >= 0x8000)
+      return bank_readbyte(address);
+   if (0x2002 == address)
+   {
+      value = ppu_status_steady(&cycles);
+      /* (never the whole 0x7FFFFFFF: a loop that reads the status is not one to sleep in) */
+      idle_looked = value;
+      if (value >= 0 && cycles < *steady)
+         *steady = cycles;
+      return value;
+   }
+   return -2;
+}
+
+/* One instruction of a loop that only looks, done to the registers given (a, x, y, p) and to
+** nothing else. Returns its cycles; 0: a read that would change something, this time; -1: not
+** such an instruction. *jumped: a branch was taken (*at is its target, *fell where it would
+** have gone on). status: what the PPU's status reads as (a turn gone over again), or -1 to ask.
+*/
+static int idle_step(uint32 *at, uint8 *regs, int status, uint32 *steady, int *jumped, uint32 *fell)
+{
+   uint32 pc = *at, address;
+   uint8 op = bank_readbyte(pc), p = regs[3], *reg;
+   int value, cycles;
+
+   *jumped = 0;
+   if (0x10 == (op & 0x1F))
+   {
+      static const uint8 flag_of[4] = { N_FLAG, V_FLAG, C_FLAG, Z_FLAG };
+      int8 offset = (int8) bank_readbyte(pc + 1);
+
+      pc += 2;
+      *fell = pc;
+      if (((p & flag_of[op >> 6]) != 0) != ((op >> 5) & 1))
+      {
+         *at = pc;
+         return 2;
+      }
+      *jumped = 1;
+      *at = pc + offset;
+      return (((int) offset + (int) (pc & 0xFF)) & 0x100) ? 4 : 3;
+   }
+
+   if (0x4C == op) /* jmp: as a branch that is always taken */
+   {
+      *fell = pc + 3;
+      *jumped = 1;
+      *at = bank_readbyte(pc + 1) | bank_readbyte(pc + 2) << 8;
+      return 3;
+   }
+
+   switch (op)
+   {
+   case 0xEA: *at = pc + 1; return 2;                                   /* nop */
+   case 0x18: regs[3] = p & ~C_FLAG; *at = pc + 1; return 2;            /* clc */
+   case 0x38: regs[3] = p | C_FLAG; *at = pc + 1; return 2;             /* sec */
+   case 0xCA: case 0xE8: case 0x88: case 0xC8:                          /* dex, inx, dey, iny */
+      idle_counted = 1;
+      reg = &regs[(0xCA == op || 0xE8 == op) ? 1 : 2];
+      *reg += (0xE8 == op || 0xC8 == op) ? 1 : -1;
+      regs[3] = (p & ~(N_FLAG | Z_FLAG)) | (*reg & N_FLAG) | (*reg ? 0 : Z_FLAG);
+      *at = pc + 1;
+      return 2;
+   }
+
+   /* the rest: an operation in bits 7-5 and 1-0, how its operand is found in bits 4-2 */
+   switch (op & 0xE3)
+   {
+   case 0x01: case 0x21: case 0x41: case 0xA1: case 0xA2: case 0xA0:
+   case 0xC1: case 0xE0: case 0xC0:
+      break;
+   default:
+      if (0x24 != op && 0x2C != op)
+         return -1;
+   }
+   switch (op & 0x1C)
+   {
+   case 0x00: /* immediate, of ldx, ldy, cpx, cpy */
+      if (0xA2 != op && 0xA0 != op && 0xE0 != op && 0xC0 != op)
+         return -1;
+      value = bank_readbyte(pc + 1); pc += 2; cycles = 2;
+      break;
+   case 0x08: /* immediate, of the accumulator's */
+      if (0x01 != (op & 0x03))
+         return -1;
+      value = bank_readbyte(pc + 1); pc += 2; cycles = 2;
+      break;
+   case 0x04: /* zero page */
+      value = ram[bank_readbyte(pc + 1)]; pc += 2; cycles = 3;
+      break;
+   case 0x0C: /* absolute */
+      address = bank_readbyte(pc + 1) | bank_readbyte(pc + 2) << 8;
+      if (0x2002 == address && status >= 0)
+         value = status;
+      else
+         value = idle_read(address, steady);
+      if (-2 == value)
+         return -1;
+      if (value < 0)
+         return 0;
+      pc += 3; cycles = 4;
+      break;
+   default:
+      return -1;
+   }
+   *at = pc;
+
+   switch (op & 0xE3)
+   {
+   case 0x01: regs[0] |= value; value = regs[0]; break;                 /* ora */
+   case 0x21: regs[0] &= value; value = regs[0]; break;                 /* and */
+   case 0x41: regs[0] ^= value; value = regs[0]; break;                 /* eor */
+   case 0xA1: regs[0] = value; break;                                   /* lda */
+   case 0xA2: regs[1] = value; break;                                   /* ldx */
+   case 0xA0: regs[2] = value; break;                                   /* ldy */
+   case 0x20:                                                           /* bit */
+      regs[3] = (p & ~(N_FLAG | V_FLAG | Z_FLAG)) | (value & (N_FLAG | V_FLAG)) | ((regs[0] & value) ? 0 : Z_FLAG);
+      return cycles;
+   case 0xC1: case 0xE0: case 0xC0:                                     /* cmp, cpx, cpy */
+      reg = (0xC1 == (op & 0xE3)) ? &regs[0] : (0xE0 == (op & 0xE3)) ? &regs[1] : &regs[2];
+      p = (p & ~C_FLAG) | ((*reg >= value) ? C_FLAG : 0);
+      value = (uint8) (*reg - value);
+      break;
+   }
+   regs[3] = (p & ~(N_FLAG | Z_FLAG)) | (value & N_FLAG) | (value ? 0 : Z_FLAG);
+   return cycles;
+}
+
+/* A loop that counts, after its trial turn (of so many steps and cycles, which left regs):
+** X or Y, one down or up, is all that a turn changes, by the one instruction before the bne
+** that closes it. So many turns from here end in that branch taken: those that fit the slice
+** are passed (their cycles are returned), and the rest may be slept through. -1: not one. */
+static __attribute__((noinline)) int idle_counting(int steps, int turn, uint8 a, uint8 x, uint8 y, const uint8 *regs, int left)
+{
+   int counts = 0, branches = 0, of_x = 0, of_y = 0, n, k, by, taken, turns;
+   uint8 op = 0, before = 0, was, now;
+
+   for (n = 0; n <= steps; n++)
+   {
+      before = op;
+      op = bank_readbyte(idle.pc[n]);
+      if (0x10 == (op & 0x1F) || 0x4C == op)
+         branches++;
+      else if (0xCA == op || 0xE8 == op || 0x88 == op || 0xC8 == op)
+         counts++;
+      /* (dex, inx, ldx, cpx; dey, iny, ldy, cpy: by the three ways idle_step finds an operand) */
+      if (0xCA == op || 0xE8 == op || 0xA2 == op || 0xA6 == op || 0xAE == op || 0xE0 == op || 0xE4 == op || 0xEC == op)
+         of_x++;
+      if (0x88 == op || 0xC8 == op || 0xA0 == op || 0xA4 == op || 0xAC == op || 0xC0 == op || 0xC4 == op || 0xCC == op)
+         of_y++;
+   }
+   k = of_x ? 1 : 2;
+   by = (0xCA == before || 0x88 == before) ? -1 : 1;
+   was = (1 == k) ? x : y;
+   if (1 != counts || 1 != branches || 0xD0 != op || 1 != of_x + of_y || idle_looked >= 0
+       || (0xCA != before && 0xE8 != before && 0x88 != before && 0xC8 != before)
+       || regs[0] != a || regs[3 - k] != ((1 == k) ? y : x))
+      return -1;
+   taken = (by < 0) ? ((was - 1) & 0xFF) : ((255 - was) & 0xFF);
+   turns = (left - 1) / turn;
+   if (turns > taken)
+      turns = taken;
+   idle.count = steps + 1;
+   idle.turn = turn;
+   idle.status = -1;
+   idle.state = 1;
+   idle.tabled = 0;
+   idle.count_reg = k;
+   idle.count_by = by;
+   idle.turns_left = taken - turns;
+   idle.turns_done = 0;
+   if (turns > 0)
+   {
+      now = (uint8) (was + by * turns);
+      idle_passed.any = 1;
+      idle_passed.x = (1 == k) ? now : x;
+      idle_passed.y = (2 == k) ? now : y;
+      idle_passed.p = (regs[3] & ~(N_FLAG | Z_FLAG)) | (now & N_FLAG) | (now ? 0 : Z_FLAG);
+   }
+   return turns * turn;
+}
+
+/* Returns the cycles to pass over: whole turns, leaving the slice at least one cycle. */
+static int idle_loop(uint32 top, uint32 end, uint8 a, uint8 x, uint8 y, uint8 p, int left)
+{
+   uint8 regs[4] = { a, x, y, p };
+   uint32 pc = top, steady = 0x7FFFFFFF, fell;
+   int turn = 0, steps, turns, cycles, jumped;
+
+   idle_passed.any = 0;
+   if (1 == nes6502_plain)
+      return 0;
+
+   /* a trial turn: it must come back to the top by the branch at the end, as it began */
+   idle_looked = -1;
+   idle_counted = 0;
+   for (steps = 0; steps < 12; steps++)
+   {
+      idle.pc[steps] = pc;
+      cycles = idle_step(&pc, regs, -1, &steady, &jumped, &fell);
+      if (cycles < 0)
+         goto never;
+      if (0 == cycles)
+         goto not_now;
+      idle.cycles[steps] = cycles;
+      turn += cycles;
+      if (jumped && fell == end && pc == top)
+         break;
+      if ((jumped && pc < fell) || pc >= end)
+         goto not_now; /* a branch back inside, or the loop is left */
+   }
+   if (12 == steps)
+      goto never;
+   if (idle_counted)
+   {
+      turns = idle_counting(steps, turn, a, x, y, regs, left);
+      if (turns < 0)
+         goto never;
+      return turns;
+   }
+   if (regs[0] != a || regs[1] != x || regs[2] != y
+       || ((regs[3] ^ p) & (N_FLAG | V_FLAG | Z_FLAG | C_FLAG)))
+      return 0;
+
+   idle.count = steps + 1;
+   idle.turn = turn;
+   idle.status = idle_looked;
+   idle.state = 1;
+   idle.tabled = 0;
+   idle.count_reg = 0;
+
+   turns = (left - 1) / turn;
+   if ((steady - 1) / turn < turns)
+      turns = (steady - 1) / turn;
+   return turns * turn;
+
+not_now:
+   /* (a loop that counts is one at its first turn, or never) */
+   if (0 == idle_counted)
+      return 0;
+never:
+   idle_never[top & 63] = (uint16) top;
+   return 0;
+}
+
+/* A loop that counts, as the 6502 goes to sleep in it at instruction at: the turns still to
+** end in the branch taken, from the register as it is. (The count idle_counting made has not
+** the turn that was run after it, when the slice had exactly one left.) */
+static void idle_count_from(int at, uint8 x, uint8 y)
+{
+   uint8 now = (1 == idle.count_reg) ? x : y;
+
+   if (0 == idle.count_reg)
+      return;
+   if (at == idle.count - 1)
+      idle.turns_left = (idle.count_by < 0) ? now : ((256 - now) & 0xFF);
+   else
+      idle.turns_left = (idle.count_by < 0) ? ((now - 1) & 0xFF) : ((255 - now) & 0xFF);
+   idle.turns_done = 0;
+}
+
+#include "rc6502.h"
+
 /* Execute instructions until count expires
 **
 ** Returns the number of cycles *actually* executed, which will be
 ** anywhere from zero to timeslice_cycles + 6
 */
+static int nes6502_awake(int timeslice_cycles);
+
+/* ours: asleep (see idle), a slice is as many of the loop's instructions as begin in it;
+** awake, it is the interpreter's (a large function, which this keeps a sleeping slice out of) */
 int nes6502_execute(int timeslice_cycles)
+{
+   if (2 == idle.state && idle.status >= 0)
+   {
+      /* (the status must read the same to the end of the slice's last instruction) */
+      uint32 steady;
+
+      if (ppu_status_steady(&steady) != idle.status || steady < (uint32) timeslice_cycles + 8)
+         idle_wake();
+   }
+   if (2 == idle.state)
+   {
+      int elapsed = 0, at = idle.at, round = 0;
+
+      while (elapsed < timeslice_cycles)
+      {
+         if (0 == at)
+         {
+            int whole = (timeslice_cycles - elapsed - 1) / idle.turn;
+
+            elapsed += whole * idle.turn;
+            round += whole;
+         }
+         elapsed += idle.cycles[at];
+         if (++at == idle.count)
+         {
+            at = 0;
+            round++;
+         }
+      }
+      /* (a loop that counts is slept in only while its turns last: the last one is run) */
+      if (0 == idle.count_reg || round <= idle.turns_left)
+      {
+         idle.turns_left -= round;
+         idle.turns_done += round;
+         idle.at = at;
+         remaining_cycles = timeslice_cycles - elapsed;
+         cpu.total_cycles += elapsed;
+         return elapsed;
+      }
+      idle_wake();
+   }
+   idle.state = 0;
+   /* a slice that begins in translated code is run from here (rc_slice) */
+   {
+      int elapsed;
+
+      if (rc_slice(timeslice_cycles, &elapsed))
+         return elapsed;
+      return elapsed + nes6502_awake(remaining_cycles);
+   }
+}
+
+static __attribute__((noinline)) int nes6502_awake(int timeslice_cycles)
 {
    int old_cycles = cpu.total_cycles;
 
@@ -1445,6 +1846,20 @@ int nes6502_execute(int timeslice_cycles)
    /* fetch first instruction */
    OPCODE_END
 
+rc_try:
+   {
+      int ran;
+
+      RC_RUN(ran);

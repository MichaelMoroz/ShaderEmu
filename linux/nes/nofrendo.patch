+/* Returns the cycles to pass over: whole turns, leaving the slice at least one cycle. */
+static int idle_loop(uint32 top, uint32 end, uint8 a, uint8 x, uint8 y, uint8 p, int left)
+{
+   uint8 regs[4] = { a, x, y, p };
+   uint32 pc = top, steady = 0x7FFFFFFF, fell;
+   int turn = 0, steps, turns, cycles, jumped;
+
+   if (1 == nes6502_plain)
+      return 0;
+
+   /* a trial turn: it must come back to the top by the branch at the end, as it began */
+   idle_looked = -1;
+   for (steps = 0; steps < 12; steps++)
+   {
+      idle.pc[steps] = pc;
+      cycles = idle_step(&pc, regs, -1, &steady, &jumped, &fell);
+      if (cycles < 0)
+         goto never;
+      if (0 == cycles)
+         return 0;
+      idle.cycles[steps] = cycles;
+      turn += cycles;
+      if (jumped && fell == end && pc == top)
+         break;
+      if ((jumped && pc < fell) || pc >= end)
+         return 0; /* a branch back inside, or the loop is left */
+   }
+   if (12 == steps)
+      goto never;
+   if (regs[0] != a || regs[1] != x || regs[2] != y
+       || ((regs[3] ^ p) & (N_FLAG | V_FLAG | Z_FLAG | C_FLAG)))
+      return 0;
+
+   idle.count = steps + 1;
+   idle.turn = turn;
+   idle.status = idle_looked;
+   idle.state = 1;
+
+   turns = (left - 1) / turn;
+   if ((steady - 1) / turn < turns)
+      turns = (steady - 1) / turn;
+   return turns * turn;
+
+never:
+   idle_never[top & 63] = (uint16) top;
+   return 0;
+}

 #else /* !NES6502_JUMPTABLE */
 
    /* Continue until we run out of cycles */
@@ -2389,6 +2804,24 @@ int nes6502_execute(int timeslice_cycles)
 #ifdef NES6502_JUMPTABLE
 end_execute:
 
+   /* ours: a slice that found an idle loop and ends inside it leaves the 6502 asleep */
+   if (1 == idle.state)
+   {
+      int at;
+
+      idle.state = 0;
+      for (at = 0; at < idle.count && !idle.waking && 2 != nes6502_plain; at++)

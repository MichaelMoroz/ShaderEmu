+/* A short loop that only looks (loads, compares, tests, branches) and comes round to the
+** registers and flags it began with: the loop a game waits in, for its interrupt or for
+** the PPU's status. Every turn of it is like the last, so the turns left in this slice are
+** counted instead of run. One turn is tried here, with nothing changed, to know.
+*/
+extern int ppu_status_steady(uint32 *cycles);
+
+int nes6502_plain; /* set: every turn of such a loop is run, to compare with */
+static uint16 idle_never[64]; /* loops with something else in them, by their first address */
+
+/* a read that changes nothing (-1: not this time, -2: never); *steady: how long it gives that */
+static int idle_read(uint32 address, uint32 *steady)
+{
+   uint32 cycles;
+   int value;
+
+   if (address < 0x800)
+      return ram[address];
+   if (address >= 0x8000)
+      return bank_readbyte(address);
+   if (0x2002 == address)
+   {
+      value = ppu_status_steady(&cycles);
+      if (value >= 0 && cycles < *steady)
+         *steady = cycles;
+      return value;
+   }
+   return -2;
+}
+
+/* Returns the cycles to pass over: whole turns, leaving the slice at least one cycle. */
+static int idle_loop(uint32 top, uint32 end, uint8 a, uint8 x, uint8 y, uint8 p, int left)
+{
+   const uint8 a0 = a, x0 = x, y0 = y, p0 = p;
+   uint32 pc = top, steady = 0x7FFFFFFF;
+   int turn = 0, steps, value, turns;
+   uint8 op, *reg;
+
+   if (nes6502_plain)
+      return 0;
+
+   /* the commonest, known at sight: lda, ldx, ldy, cmp, cpx, cpy or bit of the zero page */
+   op = bank_readbyte(top);
+   if (end - top == 4 && (0xA5 == op || 0xA6 == op || 0xA4 == op || 0xC5 == op || 0xE4 == op || 0xC4 == op || 0x24 == op))
+   {
+      turn = (((end ^ top) & 0xFF00) ? 4 : 3) + 3;
+      return (left - 1) / turn * turn;
+   }
+
+   for (steps = 0; steps < 12; steps++)
+   {
+      op = bank_readbyte(pc);
+
+      /* a branch: the last one back to the top ends the turn, one forward inside goes on */
+      if (0x10 == (op & 0x1F))
+      {
+         static const uint8 flag_of[4] = { N_FLAG, V_FLAG, C_FLAG, Z_FLAG };
+         int8 offset = (int8) bank_readbyte(pc + 1);
+
+         pc += 2;
+         if (((p & flag_of[op >> 6]) != 0) != ((op >> 5) & 1))
+         {
+            turn += 2;
+            if (pc >= end)
+               return 0; /* the loop is left */
+            continue;
+         }
+         turn += (((int) offset + (int) (pc & 0xFF)) & 0x100) ? 4 : 3;
+         if (pc == end && pc + offset == top)
+            break;
+         pc += offset;
+         if (offset < 0 || pc >= end)
+            return 0;
+         continue;
+      }
+
+      switch (op)
+      {
+      case 0xEA: pc += 1; turn += 2; continue;                          /* nop */
+      case 0x18: p &= ~C_FLAG; pc += 1; turn += 2; continue;            /* clc */
+      case 0x38: p |= C_FLAG; pc += 1; turn += 2; continue;             /* sec */
+      }
+
+      /* the rest: an operation in bits 7-5 and 1-0, how its operand is found in bits 4-2 */
+      switch (op & 0xE3)
+      {
+      case 0x01: case 0x21: case 0x41: case 0xA1: case 0xA2: case 0xA0:
+      case 0xC1: case 0xE0: case 0xC0:
+         break;
+      default:
+         if (0x24 != op && 0x2C != op)
+            goto never;
+      }
+      switch (op & 0x1C)
+      {
+      case 0x00: /* immediate, of ldx, ldy, cpx, cpy */
+         if (0xA2 != op && 0xA0 != op && 0xE0 != op && 0xC0 != op)
+            goto never;
+         value = bank_readbyte(pc + 1); pc += 2; turn += 2;
+         break;
+      case 0x08: /* immediate, of the accumulator's */
+         if (0x01 != (op & 0x03))
+            goto never;
+         value = bank_readbyte(pc + 1); pc += 2; turn += 2;
+         break;
+      case 0x04: /* zero page */
+         value = ram[bank_readbyte(pc + 1)]; pc += 2; turn += 3;
+         break;
+      case 0x0C: /* absolute */
+         value = idle_read(bank_readbyte(pc + 1) | bank_readbyte(pc + 2) << 8, &steady);
+         if (-2 == value)
+            goto never;
+         if (value < 0)
+            return 0; /* not now: this read of the status would change it */
+         pc += 3; turn += 4;
+         break;
+      default:
+         goto never;
+      }
+
+      switch (op & 0xE3)
+      {
+      case 0x01: a |= value; value = a; break;                          /* ora */
+      case 0x21: a &= value; value = a; break;                          /* and */
+      case 0x41: a ^= value; value = a; break;                          /* eor */
+      case 0xA1: a = value; break;                                      /* lda */
+      case 0xA2: x = value; break;                                      /* ldx */
+      case 0xA0: y = value; break;                                      /* ldy */
+      case 0x20:                                                        /* bit */
+         p = (p & ~(N_FLAG | V_FLAG | Z_FLAG)) | (value & (N_FLAG | V_FLAG)) | ((a & value) ? 0 : Z_FLAG);
+         continue;
+      case 0xC1: case 0xE0: case 0xC0:                                  /* cmp, cpx, cpy */
+         reg = (0xC1 == (op & 0xE3)) ? &a : (0xE0 == (op & 0xE3)) ? &x : &y;
+         p = (p & ~C_FLAG) | ((*reg >= value) ? C_FLAG : 0);
+         value = (uint8) (*reg - value);
+         break;
+      }
+      p = (p & ~(N_FLAG | Z_FLAG)) | (value & N_FLAG) | (value ? 0 : Z_FLAG);
+   }
+
+   if (12 == steps)
+      goto never;
+   if (a != a0 || x != x0 || y != y0
+       || ((p ^ p0) & (N_FLAG | V_FLAG | Z_FLAG | C_FLAG)))
+      return 0;
+
+   turns = (left - 1) / turn;
+   if ((steady - 1) / turn < turns)
+      turns = (steady - 1) / turn;
+   return turns * turn;
+
+never:
+   idle_never[top & 63] = (uint16) top;
+   return 0;
+}

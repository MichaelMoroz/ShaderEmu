+/* A short loop that only looks (loads, compares, tests, branches) and comes round to the
+** registers and flags it began with: the loop a game waits in, for its interrupt or for
+** the PPU's status. Every turn of it is like the last, so the turns left in this slice are
+** counted instead of run. One turn is tried here, with nothing changed, to know.
+*/
+extern int ppu_status_steady(uint32 *cycles);
+
+int nes6502_plain; /* set: every turn of such a loop is run, to compare with */
+
+/* Asleep: a slice ended inside such a loop, one that reads only memory, so until something
+** wakes the 6502 (an interrupt, cycles to burn, its context asked for) every slice is turns
+** of the loop: where in it each slice ends is counted from the cycles of its instructions,
+** and the registers are brought there (by running the instructions between) on waking.
+*/
+nes6502_idle_t nes6502_idle;
+#define  idle  nes6502_idle
+
+/* slices that were counted elsewhere (ppu_quiet_lines) */
+void nes6502_slept(int cycles, int at)
+{
+   cpu.total_cycles += cycles;
+   idle.at = at;
+}
+static uint16 idle_never[64]; /* loops with something else in them, by their first address */
+
+static int idle_looked;    /* the status as a trial turn read it */
+
+/* a read that changes nothing (-1: not this time, -2: never); *steady: how long it gives that */
+static int idle_read(uint32 address, uint32 *steady)
+{
+   uint32 cycles;
+   int value;
+
+   if (address < 0x800)
+      return ram[address];
+   if (address >= 0x8000)
+      return bank_readbyte(address);
+   if (0x2002 == address)
+   {
+      value = ppu_status_steady(&cycles);
+      /* (never the whole 0x7FFFFFFF: a loop that reads the status is not one to sleep in) */
+      idle_looked = value;
+      if (value >= 0 && cycles < *steady)
+         *steady = cycles;
+      return value;
+   }
+   return -2;
+}
+
+/* One instruction of a loop that only looks, done to the registers given (a, x, y, p) and to
+** nothing else. Returns its cycles; 0: a read that would change something, this time; -1: not
+** such an instruction. *jumped: a branch was taken (*at is its target, *fell where it would
+** have gone on). status: what the PPU's status reads as (a turn gone over again), or -1 to ask.
+*/
+static int idle_step(uint32 *at, uint8 *regs, int status, uint32 *steady, int *jumped, uint32 *fell)
+{
+   uint32 pc = *at, address;
+   uint8 op = bank_readbyte(pc), p = regs[3], *reg;
+   int value, cycles;
+
+   *jumped = 0;
+   if (0x10 == (op & 0x1F))
+   {
+      static const uint8 flag_of[4] = { N_FLAG, V_FLAG, C_FLAG, Z_FLAG };
+      int8 offset = (int8) bank_readbyte(pc + 1);
+
+      pc += 2;
+      *fell = pc;
+      if (((p & flag_of[op >> 6]) != 0) != ((op >> 5) & 1))
+      {
+         *at = pc;
+         return 2;
+      }
+      *jumped = 1;
+      *at = pc + offset;
+      return (((int) offset + (int) (pc & 0xFF)) & 0x100) ? 4 : 3;
+   }
+
+   switch (op)
+   {
+   case 0xEA: *at = pc + 1; return 2;                                   /* nop */
+   case 0x18: regs[3] = p & ~C_FLAG; *at = pc + 1; return 2;            /* clc */
+   case 0x38: regs[3] = p | C_FLAG; *at = pc + 1; return 2;             /* sec */
+   }
+
+   /* the rest: an operation in bits 7-5 and 1-0, how its operand is found in bits 4-2 */
+   switch (op & 0xE3)
+   {
+   case 0x01: case 0x21: case 0x41: case 0xA1: case 0xA2: case 0xA0:
+   case 0xC1: case 0xE0: case 0xC0:
+      break;
+   default:
+      if (0x24 != op && 0x2C != op)
+         return -1;
+   }
+   switch (op & 0x1C)
+   {
+   case 0x00: /* immediate, of ldx, ldy, cpx, cpy */
+      if (0xA2 != op && 0xA0 != op && 0xE0 != op && 0xC0 != op)
+         return -1;
+      value = bank_readbyte(pc + 1); pc += 2; cycles = 2;
+      break;
+   case 0x08: /* immediate, of the accumulator's */
+      if (0x01 != (op & 0x03))
+         return -1;
+      value = bank_readbyte(pc + 1); pc += 2; cycles = 2;
+      break;
+   case 0x04: /* zero page */
+      value = ram[bank_readbyte(pc + 1)]; pc += 2; cycles = 3;
+      break;
+   case 0x0C: /* absolute */
+      address = bank_readbyte(pc + 1) | bank_readbyte(pc + 2) << 8;
+      if (0x2002 == address && status >= 0)
+         value = status;
+      else
+         value = idle_read(address, steady);
+      if (-2 == value)
+         return -1;
+      if (value < 0)
+         return 0;
+      pc += 3; cycles = 4;
+      break;
+   default:
+      return -1;
+   }
+   *at = pc;
+
+   switch (op & 0xE3)
+   {
+   case 0x01: regs[0] |= value; value = regs[0]; break;                 /* ora */
+   case 0x21: regs[0] &= value; value = regs[0]; break;                 /* and */
+   case 0x41: regs[0] ^= value; value = regs[0]; break;                 /* eor */
+   case 0xA1: regs[0] = value; break;                                   /* lda */
+   case 0xA2: regs[1] = value; break;                                   /* ldx */
+   case 0xA0: regs[2] = value; break;                                   /* ldy */
+   case 0x20:                                                           /* bit */
+      regs[3] = (p & ~(N_FLAG | V_FLAG | Z_FLAG)) | (value & (N_FLAG | V_FLAG)) | ((regs[0] & value) ? 0 : Z_FLAG);
+      return cycles;
+   case 0xC1: case 0xE0: case 0xC0:                                     /* cmp, cpx, cpy */
+      reg = (0xC1 == (op & 0xE3)) ? &regs[0] : (0xE0 == (op & 0xE3)) ? &regs[1] : &regs[2];
+      p = (p & ~C_FLAG) | ((*reg >= value) ? C_FLAG : 0);
+      value = (uint8) (*reg - value);
+      break;
+   }
+   regs[3] = (p & ~(N_FLAG | Z_FLAG)) | (value & N_FLAG) | (value ? 0 : Z_FLAG);
+   return cycles;
+}

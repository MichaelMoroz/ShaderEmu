# Added to upstream rvc's linux.config for this project's kernel.
CONFIG_SHADEREMU_GPU=y
CONFIG_SHADEREMU_SOUND=y
CONFIG_FB=y
CONFIG_FB_SHADEREMU=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_SHADEREMU=y
# The network between machines (docs/lan.md); the fork's config has the stack already.
CONFIG_SHADEREMU_NET=y
# The machine's float registers are a task's own (docs/fpu.md, fpu_hook.py).
CONFIG_FPU=y
# Upstream ticks at 20 Hz; the polled input device and short sleeps want more.
CONFIG_HZ_20=n
CONFIG_HZ_100=y
# Boot time (docs/boot.md): no self-test of the hash behind /dev/random (1 s of a 10 s boot),
# no sysfs entry per slab cache, no virtual terminals, no zeroing of every stack frame.
CONFIG_EXPERT=y
CONFIG_CRYPTO=y
CONFIG_CRYPTO_MANAGER_DISABLE_TESTS=y
CONFIG_SLUB_DEBUG=n
CONFIG_SLAB_MERGE_DEFAULT=y
CONFIG_VT=n
CONFIG_INIT_STACK_ALL_ZERO=n
CONFIG_INIT_STACK_NONE=y
# EXPERT (needed to turn the above off) makes these visible, and a minimal config then leaves
# them out: everything it would otherwise have dropped is kept.
CONFIG_ADVISE_SYSCALLS=y
CONFIG_AIO=y
CONFIG_ALLOW_DEV_COREDUMP=y
CONFIG_BASE_FULL=y
CONFIG_BLOCK=y
CONFIG_BUG=y
CONFIG_COREDUMP=y
CONFIG_DEBUG_BUGVERBOSE=y
CONFIG_DEBUG_MEMORY_INIT=y
CONFIG_EFI_PARTITION=y
CONFIG_ELF_CORE=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_FHANDLE=y
CONFIG_FILE_LOCKING=y
CONFIG_FUTEX=y
CONFIG_FUTEX_PI=y
CONFIG_FW_LOADER=y
CONFIG_IO_URING=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_BASE_RELATIVE=y
CONFIG_MEMBARRIER=y
CONFIG_MEMFD_CREATE=y
CONFIG_MSDOS_PARTITION=y
CONFIG_MULTIUSER=y
CONFIG_NAMESPACES=y
CONFIG_POSIX_TIMERS=y
CONFIG_PROC_PAGE_MONITOR=y
CONFIG_PROC_SYSCTL=y
CONFIG_SHMEM=y
CONFIG_SIGNALFD=y
CONFIG_SYSCTL=y
CONFIG_SYSFS_SYSCALL=y
CONFIG_TIMERFD=y
CONFIG_TMPFS=y
CONFIG_UNIX98_PTYS=y
CONFIG_VM_EVENT_COUNTERS=y

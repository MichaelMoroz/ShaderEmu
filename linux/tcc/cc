#!/bin/sh
# cc: the machine's own C compiler (TinyCC), with the C library, Nano-X and OpenGL ES.
#   cc cube.c -o cube
# Headers and libraries are unpacked the first time: they live in the ROM as one archive.
[ -f /usr/lib/libc.a ] || tar -xf /usr/share/cc-sysroot.tar -C /
exec tcc -static "$@" -lgles -lnano-X

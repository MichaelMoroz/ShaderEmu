+size_t SpriteImageBound(const SpriteFile &file, size_t file_pos)
+{
+	if (file_pos == SIZE_MAX || file.ImageIfRead() == nullptr) return 0;
+	SpriteMemReader r{&file, file.ImageIfRead(), file.GetStartPos(), file.GetEndPos(), file_pos};

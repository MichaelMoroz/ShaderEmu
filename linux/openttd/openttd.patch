+/* The viewport is drawn on worker cores too (docs/games/openttd.md): what each core draws with,
+ * in 16 bytes of its own. VpCore() is the core that runs, by its stack: 0 the first. */
+static constexpr int VP_CORES = 128;
+struct alignas(16) VpCoreState {
+	DrawPixelInfo *cur_dpi;
+	const uint8_t *colour_remap;
+	uint8_t string_remap[3];
+	bool failed; ///< what this worker drew is given up, to be drawn again
+	bool full;   ///< and one of its lists had no room
+};
+extern VpCoreState _vp_core[VP_CORES];
+extern uintptr_t _vp_stacks, _vp_stacks_bytes;
+/* The game tick on a worker core of its own (docs/games/openttd.md, "The tick on a worker"): its stack */
+static constexpr uintptr_t TW_STACK = 512 * 1024;
+extern uintptr_t _tw_stack;
+extern int _tw_core; ///< the tick's worker, which draws nothing
+inline int VpCore()
+{
+	uintptr_t sp;
+	asm("mv %0, sp" : "=r"(sp));
+	uintptr_t d = sp - _vp_stacks;
+	if (d < _vp_stacks_bytes) return static_cast<int>(d >> 16) + 1;
+	return sp - _tw_stack < TW_STACK ? _tw_core : 0;
+}
+/** Whether this code runs in the game tick on its worker (then it leaves what the window system does to the first core). */
+inline bool TickOnWorker()
+{
+	uintptr_t sp;
+	asm("mv %0, sp" : "=r"(sp));
+	return sp - _tw_stack < TW_STACK;
+}
+/** What the tick on its worker leaves the first core: made there in the order asked, while the tick waits. */
+struct TickTask {
+	virtual ~TickTask() = default;
+	virtual void Run() = 0;
+};
+template <class F>
+struct TickTaskOf final : TickTask {
+	F f;
+	template <class G> explicit TickTaskOf(G &&g) : f(std::forward<G>(g)) {}
+	void Run() override { this->f(); }
+};
+void TickDeferTask(TickTask *task);
+template <class F>
+void TickDefer(F &&f) { TickDeferTask(new TickTaskOf<std::decay_t<F>>(std::forward<F>(f))); }
+/** In a function the window system's: on the tick's worker the call is made later by the first core. */
+#define TICK_DEFER(call) do { if (TickOnWorker()) { TickDefer([=]() mutable { call; }); return; } } while (false)
+#define TICK_DEFER_THIS(call) do { if (TickOnWorker()) { TickDefer([=, this]() mutable { call; }); return; } } while (false)
+/** Where the tick on its worker reaches what only the first core may use (OPENTTD_TRAPS=1 lists them at the end). */
+void TickTrap(const void *caller);
+#define TICK_TRAP() do { if (TickOnWorker()) TickTrap(__builtin_return_address(0)); } while (false)
+void TickExclusive(); ///< on the tick's worker: no worker draws from here to the tick's next wait
+extern void *_tw_dying; ///< a vehicle the tick deletes: its memory is freed by the first core, once out of the viewports
+void TickReleaseForFlush(); ///< the viewport's last flush of a picture: the tick goes on while it is drawn
+extern bool _tw_running; ///< the first core's: the tick on its worker is not waiting
+inline bool TickRunning() { return _tw_running; }
+extern bool _tw_on; ///< the first core's: the game's state is the tick's worker's to change
+inline bool TickElsewhere() { return _tw_on && !TickOnWorker(); }
+/** On a worker: what it is drawing is given up (true); on the first core: false. */
+inline bool VpRefuse()
+{
+	int k = VpCore();
+	if (k == 0) return false;
+	_vp_core[k].failed = true;
+	return true;
+}
+#define _cur_dpi (_vp_core[VpCore()].cur_dpi)
+
+/* The game tick runs in slices between pictures (docs/games/openttd.md, "The tick in slices"):
+ * where the tick may give way to the drawing it calls TickYieldPoint(). */
+/** The machine's time (5 kHz), and where a picture's went, by phase (VP_PHASE_*; the play lines print them). */
+inline uint32_t VpTime()
+{
+	uint32_t t;
+	asm volatile("rdtime %0" : "=r"(t));
+	return t;
+}
+enum { VP_PHASE_FLUSH, VP_PHASE_PIECES, VP_PHASE_AGAIN, VP_PHASE_FIRST, VP_PHASE_COPY, VP_PHASE_TEXTS, VP_PHASE_MOVE,
+	VP_PHASE_WINDOWS, VP_PHASE_PAINT, VP_PHASE_TICK, VP_PHASES };
+extern uint32_t _vp_phase[VP_PHASES];
+extern bool _tick_slicing;
+extern uint32_t _tick_yield_at; ///< core 0's instructions (the low word) at which a slice is spent
+void TickYield();
+void TickFinish();
+void ScrollSettle(); ///< waits for the screen move the workers make while the first core goes on, if one is out
+bool VpFlushOut(); ///< a picture's last flush is out: its pieces drawn while the next picture begins
+bool VpFlushReady(); ///< no flush is out, or its pieces are all drawn

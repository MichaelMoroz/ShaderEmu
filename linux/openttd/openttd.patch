+		size_t at = this->GetPos();
+		size_t bytes = this->GetEndPos() - this->GetStartPos();
+		this->image = std::make_unique<uint8_t[]>(bytes + 8);
+		this->SeekTo(this->GetStartPos(), SEEK_SET);

+/** On a worker running a job: its block of n bytes, or nullptr on any other core. */
+void *SeLinkGraphAlloc(size_t n)
+{
+	if (_lg_core == nullptr) return nullptr;
+	LgCore &c = _lg_core[mcw_self()];
+	if (c.lo == nullptr) return nullptr;
+	n = (std::max<size_t>(n, 1) + 15) & ~size_t{15};
+	const uint32_t k = static_cast<uint32_t>(n >> 4) - 1;
+	if (k < LG_CLASSES && c.free_[k] != nullptr) {
+		void *p = c.free_[k];
+		c.free_[k] = *static_cast<void **>(p);
+		return p;
+	}
+	if (n > c.size - c.used) longjmp(*c.jb, 1);
+	void *p = c.lo + c.used;
+	c.used += static_cast<uint32_t>(n);
+	return p;

+/** A part asked for while parts are kept: kept, to be made at the flush. */
+static void VpJobPlace(const VpJob &job, int &row, int &col, int &w, int &h);
+
+static bool ViewportKept(const Viewport &vp, int left, int top, int right, int bottom)
+{
+	if (_vp_keep_depth == 0 || VpCore() != 0 || _draw_bounding_boxes || _draw_dirty_blocks) return false;
+	if (_newgrf_debug_sprite_picker.mode == SPM_REDRAW || VpWorkers() == 0) return false;
+	/* a part over one kept is drawn after it, its texts too: the kept ones are made first */
+	VpJob job{ vp, *_cur_dpi, left, top, right, bottom };
+	int row, col, w, h;
+	VpJobPlace(job, row, col, w, h);
+	ViewportFlushOver(col, row, col + w, row + h);

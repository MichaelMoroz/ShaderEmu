+void TileRecOf(TileIndex t, TileRec &r)
+{
+	Tile tt(t);
+	r.tile = t.base();
+	std::copy_n(&tt.type(), 8, r.data);
+	std::copy_n(&tt.m6(), 4, r.data + 8);
+	const uint x = TileX(t), y = TileY(t);
+	const bool px = x < Map::MaxX(), py = y < Map::MaxY();
+	r.data[12] = px ? TileHeight(TileXY(x + 1, y)) : 0;
+	r.data[13] = py ? TileHeight(TileXY(x, y + 1)) : 0;
+	r.data[14] = px && py ? TileHeight(TileXY(x + 1, y + 1)) : 0;
+	r.data[15] = 0;
+	r.dock = 0;
+	r.kind = 0;
+}
+
+TileRec &AheadRead(AheadSlot &s, TileIndex t);
+
+/** What a region made anew reads of a tile: its water tracks, and whether it is a tunnel or bridge. */
+void TileStatusOf(TileIndex t, TileRec &r)
+{
+	r = {};
+	r.tile = t.base();
+	const TrackStatus ts = GetTileTrackStatus(t, TRANSPORT_WATER, 0);
+	for (int i = 0; i < 4; i++) r.data[i] = static_cast<uint8_t>(ts >> (8 * i));
+	r.data[4] = IsTileType(t, MP_TUNNELBRIDGE);
+	r.kind = 1;

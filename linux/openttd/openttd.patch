+	SeMemFile file{data, length};
+	uint8_t buffer[14];
+	if (fread(buffer, sizeof(buffer), 1, file) != 1) return false;
+	const uint8_t magic[] = { 'M', 'T', 'h', 'd', 0x00, 0x00, 0x00, 0x06 };

+
+constexpr uint32_t LG_CLASSES = 64; ///< blocks of 16 to 1,024 bytes freed into lists by size; larger ones are not used again
+constexpr int LG_SLOTS_MOST = 8;
+constexpr size_t LG_SPARE = 4 << 20; ///< the heap of a job of another kind (a song made: shaderemu_m.cpp; OpenMSX's largest takes 3.1 MB)
+
+struct alignas(16) LgCore { ///< a worker's, while it runs a job (indexed by mcw_self())
+	uint8_t *lo = nullptr; ///< the slot's heap, nullptr while it runs none
+	uint32_t used = 0, size = 0;

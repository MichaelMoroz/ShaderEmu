+	if (static_cast<size_t>(static_cast<uint8_t *>(p) - _lg_lo) >= static_cast<size_t>(_lg_hi - _lg_lo)) return false;
+	if (n == 0 || !mcw_on_worker()) return true;
+	LgCore &c = _lg_core[mcw_self()];
+	if (c.lo == nullptr || static_cast<size_t>(static_cast<uint8_t *>(p) - c.lo) >= c.size) return true;
+	n = (std::max<size_t>(n, 1) + 15) & ~size_t{15};
+	const uint32_t k = static_cast<uint32_t>(n >> 4) - 1;
+	if (k < LG_CLASSES) {
+		*static_cast<void **>(p) = c.free_[k];
+		c.free_[k] = p;
+	}
+	return true;
+}
+
+/** The first core: each slot's worker joined once it has ended, and each request given a worker, or said to have none. */
+void SeLinkGraphService()
+{
+	if (_lg_slots == nullptr || TickOnWorker() || mcw_on_worker()) return;
+	bool ended = false;
+	for (int k = 0; k < _lg_count; k++) {
+		LgSlot &s = _lg_slots[k];
+		if (s.f.h != 0 && mcw_ready(s.f.h)) {
+			mcw_join(s.f.h);
+			s.f.h = 0;
+		}
+		const uint32_t want = s.g.want;
+		if (s.f.decided == want || s.f.h != 0) continue;
+		mcw_handle h = 0;
+		if (!VpFlushOut()) { /* (a lingering team is ended only while no flush's pieces are out) */
+			if (!ended) mcw_for_end();
+			ended = true;
+			h = mcw_try_call(LgRun, static_cast<uint32_t>(reinterpret_cast<uintptr_t>(&s)), want);
+		}
+		if (h != 0) {
+			s.f.h = h;
+			s.f.launched = want;
+		}
+		s.f.decided = want;
+	}

+/** The whole file in memory (its first byte the file's GetStartPos()), read at the first call, on the first core. */
+const uint8_t *SpriteFile::Image()
+{
+	if (this->image == nullptr) {
+		size_t at = this->GetPos();
+		size_t bytes = this->GetEndPos() - this->GetStartPos();
+		this->image = std::make_unique<uint8_t[]>(bytes + 8);
+		this->SeekTo(this->GetStartPos(), SEEK_SET);
+		this->ReadBlock(this->image.get(), bytes);
+		this->SeekTo(at, SEEK_SET);
+	}
+	return this->image.get();
+}

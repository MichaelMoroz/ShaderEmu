+static void *SeAheadAlloc(size_t n)
+{
+	SeAheadCore &c = _se_ahead_core[mcw_self()];
+	if (c.lo == nullptr) return nullptr;
+	n = (n + 15) & ~size_t{15};
+	if (n > c.size - c.used) SeShipAheadRefuse(3);

+	static const bool piece_log_dear = piece_log && getenv("OPENTTD_PIECE_LOG")[0] == '2';
+	uint32_t dearest = 0;
+	for (const VpPiece &p : _vp_pieces) dearest = std::max(dearest, p.spent);
+	if (piece_log && (piece_log_dear ? dearest > 80000 : (flushes++ & 15) == 0)) {
+		std::string line;
+		for (size_t i = 0; i < _vp_pieces.size(); i++) {
+			const VpPiece &p = _vp_pieces[i];
+			line += fmt::format(" {}:{}x{}:{}:{}", p.job, p.width, p.row1 - p.row0, p.cost / 1000, p.spent / 1000);
+			if (i % 8 == 7 || i + 1 == _vp_pieces.size()) fmt::print(stderr, "openttd: pieces{}\n", line), line.clear();
+		}
+	}
+	{
+		uint32_t most = 0;
+		for (const VpPiece &p : _vp_pieces) most = std::max(most, p.spent), _vp_stat_spent += p.spent;
+		_vp_stat_most += most;

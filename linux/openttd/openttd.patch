+/** SpriteLoaderGrf::LoadSprite from the file's image (SpriteFile::Image(), read already), on any core. */
+ZoomLevels LoadSpriteFromImage(SpriteLoader::SpriteCollection &sprite, const SpriteFile &file, size_t file_pos, SpriteType sprite_type, bool load_32bpp, SpriteCacheCtrlFlags control_flags, ZoomLevels &avail_8bpp, ZoomLevels &avail_32bpp)

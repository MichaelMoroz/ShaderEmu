+void ViewportFlushOver(int left, int top, int right, int bottom)
+{
+	for (const VpJob &job : _vp_jobs) {
+		int row, col, w, h;
+		VpJobPlace(job, row, col, w, h);
+		if (col < right && col + w > left && row < bottom && row + h > top) {
+			ViewportFlush();
+			return;
+		}
+	}

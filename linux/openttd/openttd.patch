+
+/** A tile the worker reads: logged the first time, and the same as logged every time after. */
+TileRec &AheadRead(AheadSlot &s, TileIndex t)
+{
+	AheadOut &o = s.out;
+	const uint32_t i = t.base();
+	if (i >= s.in.map_size) SeShipAheadRefuse(5);
+	TileRec r;
+	TileRecOf(t, r);
+	const uint32_t k = o.index[i];
+	if (k != 0) {
+		if (!SameData(r, o.tiles[k - 1])) SeShipAheadRefuse(6);
+		return o.tiles[k - 1];
+	}
+	if (o.n_tiles >= AHEAD_TILES) SeShipAheadRefuse(7);
+	o.tiles[o.n_tiles] = r;
+	o.index[i] = static_cast<uint16_t>(++o.n_tiles);
+	return o.tiles[o.n_tiles - 1];
+}
+
+/** The ships on a docking tile, as the pathfinder counts them. */
+uint DockShips(TileIndex t)
+{
+	return static_cast<uint>(std::ranges::count_if(VehiclesOnTile(t), [](const Vehicle *v) {
+		/* Ignore other vehicles (aircraft) and ships inside depot. */
+		return v->type == VEH_SHIP && !v->vehstatus.Test(VehState::Hidden);

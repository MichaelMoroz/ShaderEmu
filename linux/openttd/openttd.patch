+/** A sprite made in a round: kept at the top of its core's arena until the first core copies it to the cache. */
+class VpArenaAllocator : public SpriteAllocator {
+public:
+	size_t size = 0;
+protected:
+	void *AllocatePtr(size_t bytes) override
+	{
+		VpArena &a = _vp_arena[VpCore()];
+		this->size = bytes;
+		bytes = (bytes + 15) & ~size_t{15};
+		assert(a.hi - a.lo >= bytes);
+		a.hi -= bytes;

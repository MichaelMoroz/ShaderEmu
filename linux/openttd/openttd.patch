+
+/** Of a tile next to a docking tile or in a region with aqueducts: its type alone. */
+void TileTypeOf(TileIndex t, TileRec &r)
+{
+	r = {};
+	r.tile = t.base();
+	r.data[0] = static_cast<uint8_t>(GetTileType(t));
+	if (IsTileType(t, MP_TUNNELBRIDGE)) {
+		r.data[1] = IsBridge(t);
+		r.data[2] = static_cast<uint8_t>(GetTunnelBridgeTransportType(t));
+		r.data[3] = static_cast<uint8_t>(GetTunnelBridgeDirection(t));
+	}
+	r.kind = 2;

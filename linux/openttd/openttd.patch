+		for (uint x = (x0 > 0 ? x0 - 1 : 0); x <= std::min(x0 + size, Map::MaxX()); x++) {
+			/* (a region is made of its tiles' water tracks and its ring's, followed from them: an aqueduct's head
+			 * onto its other end, its words read) */
+			const TileIndex t = TileXY(x, y);
+			AheadStatus(a, t);
+			const bool inside = x >= x0 && x < x0 + size && y >= y0 && y < y0 + size;
+			if (inside && IsTileType(t, MP_TUNNELBRIDGE)) {

+/** The worker cores asked for (OPENTTD_WORKERS, 47 by default, 0 draws as upstream), opened once. */
+static int VpWorkers()
+{
+	if (_vp_workers >= 0) return _vp_workers;
+	ScrollSettle();
+	const char *asked = getenv("OPENTTD_WORKERS");
+	int want = asked != nullptr ? 0 : 47; /* (more cost the first core more than they gain: docs/games/openttd.md) */
+	for (const char *c = asked; c != nullptr && *c >= '0' && *c <= '9'; c++) want = want * 10 + (*c - '0');
+	want = std::min(want, VP_CORES - 1);
+	_vp_workers = 0;
+	if (want <= 0 || BlitterFactory::GetCurrentBlitter()->GetScreenDepth() != 8) return 0;
+	int got = VpOpen(want);
+	if (got <= 0) return 0;
+	/* (a team waits a picture's worth of passes for its next round: one that left it is posted again late) */
+	const char *linger = getenv("OPENTTD_LINGER");
+	int passes = linger != nullptr ? 0 : 64;
+	for (const char *c = linger; c != nullptr && *c >= '0' && *c <= '9'; c++) passes = passes * 10 + (*c - '0');
+	mcw_for_linger(passes);
+	/* A worker's stack is the k-th 64 KB from the first, its top on a page: its sp says where they begin. */
+	mcw_for_opts opts = {};
+	opts.grain = 1;
+	mcw_for_opt(64, VpProbeStack, nullptr, &opts);
+	uintptr_t stacks = 0;
+	for (int k = 1; k < VP_CORES; k++) {
+		if (_vp_probes[k].self != k) continue;
+		uintptr_t base = ((_vp_probes[k].sp + 4095) & ~uintptr_t{4095}) - static_cast<uintptr_t>(k) * 0x10000;
+		if (stacks != 0 && base != stacks) return 0;
+		stacks = base;
+	}
+	if (stacks == 0) return 0;
+	_vp_stacks = stacks;
+	_vp_stacks_bytes = static_cast<uintptr_t>(got) * 0x10000;
+	for (int k = 1; k <= got; k++) _vp_room[k] = 2048;
+	_vp_workers = got;
+	return got;
+}
+
+/** The workers, opened if they are not yet: the drawing's (VpWorkers) under a video driver of 8 bits (the tick on a
+ * worker, shaderemu_t.cpp), otherwise as many as there are (a load's LZMA decoded ahead, saveload.cpp; ships' paths
+ * made ahead under the null driver). */
+int VpWorkersOpen()
+{
+	if (BlitterFactory::GetCurrentBlitter() != nullptr && BlitterFactory::GetCurrentBlitter()->GetScreenDepth() == 8) return VpWorkers();
+	/* (as VpWorkers asks for them, whatever the blitter: the null video driver's too) */
+	const char *asked = getenv("OPENTTD_WORKERS");
+	int want = asked != nullptr ? 0 : VP_CORES - 1;
+	for (const char *c = asked; c != nullptr && *c >= '0' && *c <= '9'; c++) want = want * 10 + (*c - '0');
+	want = std::min(want, VP_CORES - 1);
+	return want > 0 ? std::max(VpOpen(want), 0) : 0;
+}
+
+/** A part asked for while parts are kept: kept, to be made at the flush. */
+static void VpJobPlace(const VpJob &job, int &row, int &col, int &w, int &h);
+
+struct VpRect { int c0, r0, c1, r1; }; ///< on the screen: columns and rows, the ends excluded
+static const bool _vp_keep_flush = getenv("OPENTTD_KEEP_FLUSH") != nullptr;
+
+/** What of a is not in b, as up to four rectangles added to out. */
+static void VpRectMinus(const VpRect &a, const VpRect &b, std::vector<VpRect> &out)
+{
+	if (b.c0 >= a.c1 || b.c1 <= a.c0 || b.r0 >= a.r1 || b.r1 <= a.r0) {
+		out.push_back(a);
+		return;
+	}
+	const int r0 = std::max(a.r0, b.r0), r1 = std::min(a.r1, b.r1);
+	if (a.r0 < r0) out.push_back({ a.c0, a.r0, a.c1, r0 });
+	if (r1 < a.r1) out.push_back({ a.c0, r1, a.c1, a.r1 });
+	if (a.c0 < b.c0) out.push_back({ a.c0, r0, b.c0, r1 });
+	if (b.c1 < a.c1) out.push_back({ b.c1, r0, a.c1, r1 });
+}
+
+/** The part of job (placed at col, row) that lies on the screen's rectangle r. */
+static VpJob VpSubJob(const VpJob &job, int col, int row, const VpRect &r)
+{
+	VpJob s = job;
+	ZoomLevel z = job.vp.zoom;
+	int mask = ScaleByZoom(-1, z);
+	const int vl = job.left & mask, vt = job.top & mask;
+	s.left = vl + ScaleByZoom(r.c0 - col, z);
+	s.right = vl + ScaleByZoom(r.c1 - col, z);
+	s.top = vt + ScaleByZoom(r.r0 - row, z);
+	s.bottom = vt + ScaleByZoom(r.r1 - row, z);
+	return s;
+}
+
+static bool ViewportKept(const Viewport &vp, int left, int top, int right, int bottom)
+{
+	if (_vp_keep_depth == 0 || VpCore() != 0 || _draw_bounding_boxes || _draw_dirty_blocks) return false;
+	VpFlushFinish();
+	if (_newgrf_debug_sprite_picker.mode == SPM_REDRAW || VpWorkers() == 0) return false;
+	/* a part over one kept is drawn after it, its texts too: the kept ones are made first */
+	VpJob job{ vp, *_cur_dpi, left, top, right, bottom };
+	int row, col, w, h;
+	VpJobPlace(job, row, col, w, h);
+	/* (only the same view's pixels are the same: over another view's kept part, that part is made first) */
+	auto same_view = [&vp](const Viewport &k) {
+		return k.left == vp.left && k.top == vp.top && k.virtual_left == vp.virtual_left && k.virtual_top == vp.virtual_top && k.zoom == vp.zoom;
+	};
+	bool other = _vp_keep_flush;
+	for (size_t i = 0; i < _vp_jobs.size() && !other; i++) {
+		int kr, kc, kw, kh;
+		VpJobPlace(_vp_jobs[i], kr, kc, kw, kh);
+		other = !same_view(_vp_jobs[i].vp) && kc < col + w && col < kc + kw && kr < row + h && row < kr + kh;
+	}
+	if (other) { /* (OPENTTD_KEEP_FLUSH=1: always so, as before) */
+		ViewportFlushOver(col, row, col + w, row + h);
+		_vp_jobs.push_back(job);
+		return true;
+	}
+	static std::vector<VpRect> rects, next;
+	rects.assign(1, VpRect{ col, row, col + w, row + h });
+	for (const VpJob &kept : _vp_jobs) {
+		int kr, kc, kw, kh;
+		VpJobPlace(kept, kr, kc, kw, kh);
+		next.clear();
+		for (const VpRect &r : rects) VpRectMinus(r, VpRect{ kc, kr, kc + kw, kr + kh }, next);
+		rects.swap(next);
+		if (rects.empty()) return true;
+	}
+	if (rects.size() > 16) { /* (too many pieces: the kept ones are made first) */
+		ViewportFlush();
+		_vp_jobs.push_back(job);
+		return true;
+	}
+	for (const VpRect &r : rects) _vp_jobs.push_back(VpSubJob(job, col, row, r));
+	return true;
+}
+
+ViewportKeep::ViewportKeep() { _vp_keep_depth++; }
+ViewportKeep::~ViewportKeep()
+{
+	if (--_vp_keep_depth == 0) ViewportFlush();
+}
+
+/** What ViewportDoDraw draws of sprites, into this core's lists and dst (its first pixel): no signs or texts. */
+#ifdef WITH_SHADEREMU
+#pragma push_macro("_vd")
+#undef _vd
+#define _vd (vd_here)
+#endif
+static void VpDrawSprites(const Viewport &vp, int left, int top, int right, int bottom, uint8_t *dst, int pitch)
+{
+#ifdef WITH_SHADEREMU
+	VP_HERE;
+#endif
+	VpCoreState &me = _vp_core[VpCore()];
+	_vd.dpi.zoom = vp.zoom;
+	int mask = ScaleByZoom(-1, vp.zoom);
+	_vd.combine_sprites = SPRITE_COMBINE_NONE;
+	_vd.dpi.width = (right - left) & mask;
+	_vd.dpi.height = (bottom - top) & mask;
+	_vd.dpi.left = left & mask;
+	_vd.dpi.top = top & mask;
+	_vd.dpi.pitch = pitch;
+	_vd.last_child = LAST_CHILD_NONE;
+	_vd.dpi.dst_ptr = dst;
+	AutoRestoreBackup dpi_backup(_cur_dpi, &_vd.dpi);
+
+	ViewportAddLandscape();
+	ViewportAddVehicles(&_vd.dpi);
+	/* (a failed piece goes on blitting nothing, so that it asks for every sprite it lacks) */
+	if (!_vd.tile_sprites_to_draw.empty()) ViewportDrawTileSprites(&_vd.tile_sprites_to_draw);
+	for (auto &psd : _vd.parent_sprites_to_draw) {
+		if (!VpRoom(_vd.parent_sprites_to_sort)) break;
+		_vd.parent_sprites_to_sort.push_back(&psd);
+	}
+	if (!me.full) ViewportSortParentSpritesKept(&_vd.parent_sprites_to_sort);
+	if (!me.full) ViewportDrawParentSprites(&_vd.parent_sprites_to_sort, &_vd.child_screen_sprites_to_draw);
+	_vd.tile_sprites_to_draw.clear();
+	_vd.parent_sprites_to_draw.clear();
+	_vd.parent_sprites_to_sort.clear();
+	_vd.child_screen_sprites_to_draw.clear();
+}
+#ifdef WITH_SHADEREMU
+#pragma pop_macro("_vd")
+#endif
+
+/** A piece of a part, into its buffer, on whichever core runs it. */
+static void VpDrawPiece(VpPiece &piece)
+{
+	int k = VpCore();
+	if (k != 0 && k != mcw_self()) {
+		piece.failed = true;
+		return;
+	}
+	VpCoreState &me = _vp_core[k];
+	me.failed = false;
+	uint32_t i0;
+	asm volatile("rdinstret %0" : "=r"(i0));
+	const uint32_t refused = k != 0 ? VpSpritesRefused(k) : 0;
+	const size_t learned = _vd_of[k].reach_new.size();
+	const VpJob &job = _vp_jobs[piece.job];
+	VehiclesKeptUse(piece.job);
+	/* (what no sprite covers stays as the screen was; on the GPU a piece is records: SeGpuPieceBegin) */
+	const bool gpu = SeGpuOn();
+	for (int r = 0; r < piece.row1 - piece.row0 && !gpu; r++) {
+		std::copy_n(piece.screen + r * _screen.pitch, piece.width, piece.buf + r * piece.pitch);
+	}
+	const int index = static_cast<int>(&piece - _vp_pieces.data());
+	if (gpu) SeGpuPieceBegin(index);
+	DrawPixelInfo outer = job.outer;
+	DrawPixelInfo *was = me.cur_dpi;
+	me.cur_dpi = &outer;
+	VpDrawSprites(job.vp, piece.left, piece.top, piece.right, piece.bottom, piece.buf, piece.pitch);
+	VehiclesKeptUse(-1);
+	me.cur_dpi = was;
+	if (gpu) SeGpuPieceEnd(index, me.failed);
+	piece.failed = me.failed;
+	piece.full = me.full;
+	if (me.failed) _vd_of[k].reach_new.resize(learned); /* (what a piece given up learned may lack sprites) */
+	piece.refused = k != 0 ? VpSpritesRefused(k) - refused : 0;
+	me.failed = false;
+	if (!piece.failed && (piece.self || k == 0)) {
+		for (int r = 0; r < piece.row1 - piece.row0; r++) {
+			std::copy_n(piece.buf + r * piece.pitch, piece.width, piece.screen + r * _screen.pitch);
+		}
+		piece.copied = true;
+	}
+	uint32_t i1;
+	asm volatile("rdinstret %0" : "=r"(i1));
+	piece.spent = i1 - i0;
+}
+
+static void VpDrawPieces(void *, uint32_t from, uint32_t to)
+{
+	for (uint32_t i = from; i < to; i++) VpDrawPiece(_vp_pieces[_vp_order[i]]);
+}
+
+/** The pieces' buffers to the screen, 16 rows an item: no two cores write the same 16 bytes. */
+static void VpCopyOut(void *, uint32_t from, uint32_t to)
+{
+	const int top = static_cast<int>(from) * 16, bottom = static_cast<int>(to) * 16;
+	for (const VpPiece &p : _vp_pieces) {
+		if (p.copied) continue;
+		int r0 = std::max(top, p.row0), r1 = std::min(bottom, p.row1);
+		for (int r = r0; r < r1; r++) {
+			std::copy_n(p.buf + (r - p.row0) * p.pitch, p.width, p.screen + (r - p.row0) * _screen.pitch);
+		}
+	}
+}
+
+static std::vector<StringSpriteToDrawVector> _vp_texts; ///< each kept part's strings, made before they are drawn
+
+/**
+ * A part's signs, texts and overlay over its sprites, by the first core (they format strings and load glyphs):
+ * made (its strings into _vp_texts[j]) while the workers draw, drawn after.
+ */
+static void VpDrawTexts(const VpJob &job, size_t j, bool make)
+{
+	const Viewport &vp = job.vp;
+	DrawPixelInfo outer = job.outer;
+	AutoRestoreBackup outer_backup(_cur_dpi, &outer);
+	_vd.dpi.zoom = vp.zoom;
+	int mask = ScaleByZoom(-1, vp.zoom);
+	_vd.dpi.width = (job.right - job.left) & mask;
+	_vd.dpi.height = (job.bottom - job.top) & mask;
+	_vd.dpi.left = job.left & mask;
+	_vd.dpi.top = job.top & mask;
+	_vd.dpi.pitch = _cur_dpi->pitch;
+	int x = UnScaleByZoom(_vd.dpi.left - (vp.virtual_left & mask), vp.zoom) + vp.left;
+	int y = UnScaleByZoom(_vd.dpi.top - (vp.virtual_top & mask), vp.zoom) + vp.top;
+	_vd.dpi.dst_ptr = BlitterFactory::GetCurrentBlitter()->MoveTo(_cur_dpi->dst_ptr, x - _cur_dpi->left, y - _cur_dpi->top);
+	AutoRestoreBackup dpi_backup(_cur_dpi, &_vd.dpi);
+
+	if (make) {
+		ViewportAddKdtreeSigns(&_vd.dpi);
+		DrawTextEffects(&_vd.dpi);
+		if (_vp_texts.size() <= j) _vp_texts.resize(j + 1);
+		_vp_texts[j].swap(_vd.string_sprites_to_draw);
+		_vd.string_sprites_to_draw.clear();
+		return;
+	}
+	_vd.string_sprites_to_draw.swap(_vp_texts[j]);
+	_vp_texts[j].clear();
+
+	DrawPixelInfo dp = _vd.dpi;
+	ZoomLevel zoom = _vd.dpi.zoom;
+	dp.zoom = ZoomLevel::Min;
+	dp.width = UnScaleByZoom(dp.width, zoom);
+	dp.height = UnScaleByZoom(dp.height, zoom);
+	AutoRestoreBackup cur_dpi(_cur_dpi, &dp);
+
+	if (vp.overlay != nullptr && vp.overlay->GetCargoMask() != 0 && vp.overlay->GetCompanyMask().Any()) {
+		dp.left = x;
+		dp.top = y;
+		vp.overlay->Draw(&dp);
+	}
+	if (!_vd.string_sprites_to_draw.empty()) {
+		dp.left = UnScaleByZoom(_vd.dpi.left, zoom);
+		dp.top = UnScaleByZoom(_vd.dpi.top, zoom);
+		ViewportDrawStrings(zoom, &_vd.string_sprites_to_draw);
+	}
+	_vd.string_sprites_to_draw.clear();
+}
+
+/** The worker k's lists made room for _vp_room[k] sprites, before a round (a worker may not allocate). */
+static void VpMakeRoom(int k)
+{
+	ViewportDrawer &d = _vd_of[k];
+	size_t n = _vp_room[k];
+	/* (the lists keep their room: made again only when it grew) */
+	static size_t made[VP_CORES];
+	if (made[k] == n) return;
+	made[k] = n;
+	d.tile_sprites_to_draw.reserve(n);
+	d.parent_sprites_to_draw.reserve(n);
+	d.parent_sprites_to_sort.reserve(n);
+	d.child_screen_sprites_to_draw.reserve(n);
+	d.sort_list.reserve(n);
+	d.sort_next.reserve(n);
+	d.sort_preceding.reserve(n);
+	d.sort_stack.reserve(4 * n);
+	d.reach_new.reserve(4 * n);
+}
+
+/** Where a part lies on the screen: its first pixel's row and column, and its size in pixels. */
+static void VpJobPlace(const VpJob &job, int &row, int &col, int &w, int &h)
+{
+	const Viewport &vp = job.vp;
+	ZoomLevel z = vp.zoom;
+	int mask = ScaleByZoom(-1, z);
+	w = UnScaleByZoom((job.right - job.left) & mask, z);
+	h = UnScaleByZoom((job.bottom - job.top) & mask, z);
+	int x = UnScaleByZoom((job.left & mask) - (vp.virtual_left & mask), z) + vp.left;
+	int y = UnScaleByZoom((job.top & mask) - (vp.virtual_top & mask), z) + vp.top;
+	uintptr_t at = reinterpret_cast<uintptr_t>(BlitterFactory::GetCurrentBlitter()->MoveTo(job.outer.dst_ptr, x - job.outer.left, y - job.outer.top));
+	uintptr_t screen = reinterpret_cast<uintptr_t>(_screen.dst_ptr);
+	row = static_cast<int>((at - screen) / _screen.pitch);
+	col = static_cast<int>((at - screen) % _screen.pitch);
+}
+
+/** The parts kept made now if any of them lies in the screen's rectangle (right and bottom excluded). */
+void ViewportFlushOver(int left, int top, int right, int bottom)
+{
+	for (const VpJob &job : _vp_jobs) {
+		int row, col, w, h;
+		VpJobPlace(job, row, col, w, h);
+		if (col < right && col + w > left && row < bottom && row + h > top) {
+			ViewportFlush();
+			return;
+		}
+	}
+}
+
+/**
+ * A scroll of the screen's rectangle by (xo, yo): the parts kept in it move with what they show, so they
+ * need not be made first; if one lies over its edge, before or after, all are made now.
+ */
+void ViewportScrollKept(int left, int top, int width, int height, int xo, int yo)
+{
+	const int right = left + width, bottom = top + height;
+	const VpRect area{ left, top, right, bottom };
+	if (_vp_keep_flush) {
+		for (const VpJob &job : _vp_jobs) {
+			int row, col, w, h;
+			VpJobPlace(job, row, col, w, h);
+			if (!(col < right && col + w > left && row < bottom && row + h > top)) continue;
+			const bool inside = col >= left && col + w <= right && row >= top && row + h <= bottom &&
+					col + xo >= left && col + w + xo <= right && row + yo >= top && row + h + yo <= bottom;
+			if (!inside) {
+				ViewportFlush();
+				return;
+			}
+		}
+	}
+	static std::vector<VpJob> jobs;
+	static std::vector<VpRect> outside;
+	jobs.clear();
+	for (const VpJob &job : _vp_jobs) {
+		int row, col, w, h;
+		VpJobPlace(job, row, col, w, h);
+		if (!(col < right && col + w > left && row < bottom && row + h > top)) {
+			jobs.push_back(job);
+			continue;
+		}
+		/* what lies outside stays; what lies inside moves, as much of it as stays inside */
+		outside.clear();
+		VpRectMinus(VpRect{ col, row, col + w, row + h }, area, outside);
+		for (const VpRect &r : outside) jobs.push_back(VpSubJob(job, col, row, r));
+		VpRect in{ std::max(col, left) + xo, std::max(row, top) + yo, std::min(col + w, right) + xo, std::min(row + h, bottom) + yo };
+		in = { std::max(in.c0, left) - xo, std::max(in.r0, top) - yo, std::min(in.c1, right) - xo, std::min(in.r1, bottom) - yo };
+		if (in.c0 >= in.c1 || in.r0 >= in.r1) continue;
+		VpJob moved = VpSubJob(job, col, row, in);
+		moved.vp.left += xo, moved.vp.top += yo;
+		jobs.push_back(moved);
+	}
+	_vp_jobs.assign(jobs.begin(), jobs.end());
+}
+
+uint32_t _vp_phase[VP_PHASES];
+
+bool _vp_flush_last; ///< the flush UpdateWindows ends with: the tick on its worker goes on from its pieces
+
+/* OPENTTD_FLUSH_COST=1: the first core's instructions in each step of a flush, every 64 flushes */
+static uint64_t _fc_sum[13];
+static uint32_t _fc_at, _fc_n;
+static void FcMark(int i)
+{
+	uint32_t now;
+	asm volatile("rdinstret %0" : "=r"(now));
+	_fc_sum[i] += now - _fc_at;
+	_fc_at = now;
+}
+
+static void VpFlushRest(uint32_t t, uint32_t flush_from);
+
+void ViewportFlush()
+{
+	VpFlushFinish();
+	const bool last = std::exchange(_vp_flush_last, false);
+	if (_vp_jobs.empty()) return;
+	assert(VpCore() == 0);
+	static const bool fc = getenv("OPENTTD_FLUSH_COST") != nullptr;
+	FcMark(12);
+	const uint32_t flush_from = VpTime();
+	VpBridgeMost(); /* (made here: a worker only reads it) */
+	/* sprites of vehicles that change when drawn are made here, not on the workers, the tick waiting;
+	 * the vehicles a part may draw copied for it (VehiclesKeptPart) */
+	VehiclesKeptBegin();
+	for (const VpJob &job : _vp_jobs) {
+		VehiclesKeptPart();
+		int row0, col0, w, h;
+		VpJobPlace(job, row0, col0, w, h);
+		if (w <= 0 || h <= 0) continue;
+		ZoomLevel z = job.vp.zoom;
+		int mask = ScaleByZoom(-1, z);
+		DrawPixelInfo whole = {};
+		whole.left = job.left & mask;
+		whole.top = job.top & mask;
+		whole.width = ScaleByZoom(w, z);
+		whole.height = ScaleByZoom(h, z);
+		whole.zoom = z;
+		ViewportRevalidateVehicles(&whole);
+	}
+	VehiclesKeptPart();
+	VehiclesKeptEnd();
+	FcMark(0);
+	if (last) TickReleaseForFlush();
+	/* (the first core hands the pieces out: at most one a worker, OPENTTD_CUT=old one a core) */
+	static const bool cut_old = getenv("OPENTTD_CUT") != nullptr;
+	const int cores = _vp_workers + (cut_old ? 1 : 0) - (_tw_on ? 1 : 0); /* (the tick's worker draws nothing) */
+	_vp_pieces.clear();
+
+	/* how each part is cut: the dearest piece of all is cut again (in columns or rows) while the flush, the
+	 * dearest piece or all work over the cores, gets shorter; a piece costs as its pixels with margins of 4
+	 * and as 240 more (its tiles passed and sorted), at normal zoom: fitted to the pieces of OPENTTD_PIECE_LOG */
+	/* OPENTTD_CUT_M=MH,MV,K: the margins and the piece's own in pixels at normal zoom */
+	static int _vp_cut_mh = 4, _vp_cut_mv = 4, _vp_cut_k = 240;
+	static bool margins_read = false;
+	if (!margins_read) {
+		margins_read = true;
+		if (const char *e = getenv("OPENTTD_CUT_M"); e != nullptr) {
+			int v[3] = {0, 0, 0}, i = 0;
+			for (; *e != 0 && i < 3; e++) {
+				if (*e == ',') i++;

+/** The machine's copy (CSRs 0xb0 to 0xb3, docs/machine/gpu.md): the core stops until it is made, a pass a 256 KB. */
+static void MachineCopy(void *dst, const void *src, uint32_t bytes)
+{
+	asm volatile("csrw 0x0b1, %0" :: "r"(src));
+	asm volatile("csrw 0x0b2, %0" :: "r"(dst));
+	asm volatile("csrw 0x0b3, %0" :: "r"(bytes));
+	asm volatile("csrw 0x0b0, %0" :: "r"(1) : "memory");
+}
+
+/**
+ * A part as wide as the screen moved as one block (OPENTTD_MEMOP=0: row by row, =check: and compared):
+ * what wraps round a row's end lands in the strips the caller draws anew. The machine copies whole
+ * texels of the destination from words of the source: a move by other than whole words is row by row,
+ * and the part texels at the ends are the processor's (docs/games/openttd.md, "Scrolls").
+ */
+static bool ScrollAsBlock(void *video, int left, int top, int width, int height, int scroll_x, int scroll_y)
+{
+	static const char *how = getenv("OPENTTD_MEMOP");
+	ptrdiff_t d = static_cast<ptrdiff_t>(scroll_y) * _screen.pitch + scroll_x;
+	if (left != 0 || width != _screen.pitch || (how != nullptr && how[0] == '0') || d % 4 != 0 || std::abs(d) < 64) return false;
+	uint8_t *base = static_cast<uint8_t *>(video) + top * _screen.pitch;
+	size_t total = static_cast<size_t>(height) * _screen.pitch;
+	/* the destination [to, end), its texels [a, b) */
+	uint8_t *to = d > 0 ? base + d : base, *end = d > 0 ? base + total : base + total + d;
+	uint8_t *a = reinterpret_cast<uint8_t *>((reinterpret_cast<uintptr_t>(to) + 15) & ~uintptr_t{15});
+	uint8_t *b = reinterpret_cast<uint8_t *>(reinterpret_cast<uintptr_t>(end) & ~uintptr_t{15});
+	if (b - a < 1024) return false;
+	std::vector<uint8_t> want;
+	bool check = how != nullptr && how[0] == 'c';
+	if (check) {
+		want.assign(base, base + total);
+		if (d > 0) std::copy_backward(want.begin(), want.end() - d, want.end());
+		else std::copy(want.begin() - d, want.end(), want.begin());
+	}
+	auto move = [d](uint8_t *from, uint8_t *until) {
+		if (until <= from) return;
+		if (d > 0) std::copy_backward(from - d, until - d, until);
+		else std::copy(from - d, until - d, from);
+	};
+	if (d > 0) { /* (ahead: the end first) */
+		move(b, end);
+		MachineCopy(a, a - d, static_cast<uint32_t>(b - a));
+		move(to, a);
+	} else {
+		move(to, a);
+		MachineCopy(a, a - d, static_cast<uint32_t>(b - a));
+		move(b, end);
+	}
+	if (check) {
+		size_t wrong = 0;
+		for (size_t i = 0; i < total; i++) wrong += base[i] != want[i];
+		fmt::print(stderr, "openttd: scroll by {},{} of {} bytes, {} wrong\n", scroll_x, scroll_y, total, wrong);
+	}
+	return true;
+}
+#endif
+
+#ifdef WITH_SHADEREMU
+/** A scroll's rows moved by every core (VpMovePixels). */
+static struct {
+	const uint8_t *src;
+	uint8_t *dst;
+	size_t width, height;
+	ptrdiff_t pitch;
+	uint8_t *temp;
+	size_t temp_pitch;
+} _vp_move;
+static std::vector<uint8_t> _vp_move_temp;
+
+static void VpMoveInRows(void *, uint32_t from, uint32_t to)
+{
+	for (size_t r = from * 16; r < std::min<size_t>(to * 16, _vp_move.height); r++) {
+		const uint8_t *src = _vp_move.src + r * _vp_move.pitch;
+		uint8_t *dst = _vp_move.dst + r * _vp_move.pitch;
+		if (src < dst) {
+			std::move_backward(src, src + _vp_move.width, dst + _vp_move.width);
+		} else {
+			std::move(src, src + _vp_move.width, dst);
+		}
+	}
+}
+
+static void VpMoveToTemp(void *, uint32_t from, uint32_t to)
+{
+	for (size_t r = from * 16; r < std::min<size_t>(to * 16, _vp_move.height); r++) {
+		std::copy_n(_vp_move.src + r * _vp_move.pitch, _vp_move.width, _vp_move.temp + r * _vp_move.temp_pitch);
+	}
+}
+
+static void VpMoveFromTemp(void *, uint32_t from, uint32_t to)
+{
+	for (size_t r = from * 16; r < std::min<size_t>(to * 16, _vp_move.height); r++) {
+		std::copy_n(_vp_move.temp + r * _vp_move.temp_pitch, _vp_move.width, _vp_move.dst + r * _vp_move.pitch);
+	}
+}
+
+/**
+ * Blitter::MovePixels by every core, 16 rows an item, so that no two write the same 16 bytes: a move within
+ * rows at once, a move across rows through a buffer (a row's source is another's destination). False: a small
+ * move, or none of the workers open, is the first core's as before.
+ */
+static bool VpMovePixels(const uint8_t *src, uint8_t *dst, size_t width, size_t height, ptrdiff_t pitch, bool within_rows)
+{
+	if (width * height < 16384 || mcw_count() == 0 || src == dst) return false;
+	_vp_move = { src, dst, width, height, pitch, nullptr, (width + 15) & ~size_t{15} };
+	mcw_for_opts opts = {};
+	opts.grain = 1;
+	const uint32_t items = static_cast<uint32_t>((height + 15) / 16);
+	if (within_rows) {
+		mcw_for_opt(items, VpMoveInRows, nullptr, &opts);
+		return true;
+	}
+	/* (the buffer grows on the first core, so that its pages are there before a worker writes them) */
+	if (_vp_move_temp.size() < _vp_move.temp_pitch * height + 16) _vp_move_temp.resize(_vp_move.temp_pitch * height * 2 + 16);
+	_vp_move.temp = reinterpret_cast<uint8_t *>((reinterpret_cast<uintptr_t>(_vp_move_temp.data()) + 15) & ~uintptr_t{15});
+	mcw_for_opt(items, VpMoveToTemp, nullptr, &opts);
+	mcw_for_opt(items, VpMoveFromTemp, nullptr, &opts);
+	return true;
+}

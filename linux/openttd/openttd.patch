+		_fc_left = _fc_left_bytes = _fc_rounds = 0;
+	}
+	_vp_phase[VP_PHASE_TEXTS] += VpTime() - t;
+	_vp_phase[VP_PHASE_FLUSH] += VpTime() - flush_from;
+	_vp_stat_jobs += static_cast<uint32_t>(_vp_jobs.size());
+	_vp_stat_pieces += static_cast<uint32_t>(n);
+	_vp_jobs.clear();
+	_vp_forget_late.clear();
+	_vp_forget_all_late = false;
+}

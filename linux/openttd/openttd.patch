+		if (_ahead_state[k] == AHEAD_ABANDONED && AheadEnded(k)) {
+			AheadJoin(k);
+			_ahead_state[k] = AHEAD_FREE;
+		}
+	}
+}
+
+/** The tile a ship enters next and the trackdirs it leaves its own on, if it will ask the pathfinder there. */
+bool AheadWanted(const Ship *v, TileIndex &next, TrackdirBits &origin)
+{
+	if (v->dest_tile == 0 || !v->path.empty()) return false;
+	if (v->vehstatus.Any({VehState::Stopped, VehState::Crashed, VehState::Hidden}) || v->IsInDepot()) return false;
+	if (v->state == TRACK_BIT_WORMHOLE || v->direction != v->rotation) return false;
+	if (v->current_order.IsType(OT_LOADING) || v->current_order.IsType(OT_LEAVESTATION)) return false;
+	const DiagDirection exitdir = VehicleExitDir(v->direction, v->state);
+	if (exitdir == INVALID_DIAGDIR) return false;
+	next = TileAddByDiagDir(v->tile, exitdir);
+	if (!IsValidTile(next)) return false;
+	if ((TrackStatusToTrackBits(GetTileTrackStatus(next, TRANSPORT_WATER, 0)) & DiagdirReachesTracks(exitdir)) == TRACK_BIT_NONE) return false;
+	const Trackdir td = v->GetVehicleTrackdir();
+	if (td == INVALID_TRACKDIR) return false;
+	origin = TrackdirToTrackdirBits(td);
+	return true;
+}
+
+bool AheadSameShip(const AheadIn &in, const Ship *v)
+{
+	const Ship *c = reinterpret_cast<const Ship *>(in.ship);
+	return c->dest_tile == v->dest_tile && c->current_order.GetType() == v->current_order.GetType() &&
+		c->current_order.GetDestination() == v->current_order.GetDestination() && c->engine_type == v->engine_type && c->owner == v->owner;
+}
+
+/** Whether everything the worker read is as it is now. */
+/** Whether the tiles from..to of what the worker read are each as they are now: 0, or why not. */
+int AheadValidTiles(const AheadSlot &s, uint32_t from, uint32_t to)
+{
+	const AheadIn &in = s.in;
+	const AheadOut &o = s.out;
+	for (uint32_t i = from; i < to; i++) {
+		const TileRec &was = o.tiles[i];
+		TileRec r;
+		if (was.kind == 1) {
+			TileStatusOf(TileIndex{was.tile}, r);
+		} else if (was.kind == 2) {
+			TileTypeOf(TileIndex{was.tile}, r);
+		} else {
+			TileRecOf(TileIndex{was.tile}, r);
+		}
+		if (!SameData(r, was)) {
+			if (AheadMode() == 2) Debug(misc, 0, "ship ahead: tile {} ({},{}) kind {} type {} changed: {:02x} {:02x} {:02x} {:02x} {:02x} {:02x} {:02x} {:02x} {:02x} {:02x} {:02x} {:02x} {:02x} {:02x} {:02x} to {:02x} {:02x} {:02x} {:02x} {:02x} {:02x} {:02x} {:02x} {:02x} {:02x} {:02x} {:02x} {:02x} {:02x} {:02x}, {} logged",
+				was.tile, TileX(TileIndex{was.tile}), TileY(TileIndex{was.tile}), was.kind, (int)GetTileType(TileIndex{was.tile}),
+				was.data[0], was.data[1], was.data[2], was.data[3], was.data[4], was.data[5], was.data[6], was.data[7], was.data[8], was.data[9], was.data[10], was.data[11], was.data[12], was.data[13], was.data[14],
+				r.data[0], r.data[1], r.data[2], r.data[3], r.data[4], r.data[5], r.data[6], r.data[7], r.data[8], r.data[9], r.data[10], r.data[11], r.data[12], r.data[13], r.data[14], o.n_tiles);
+			return 8;
+		}
+		if (was.dock) {
+			uint count = 0;
+			for (int j = 0; j < in.snaps; j++) {
+				if (in.snap_tile[j] == was.tile) count = in.snap_count[j];
+			}
+			if (DockShips(TileIndex{was.tile}) != count) return 9;
+		}
+	}
+	return 0;
+}
+
+/** A worker's part of AheadValidTiles: the slot, and from | to << 16. */
+uint32_t AheadValidJob(uint32_t at, uint32_t range)
+{
+	return static_cast<uint32_t>(AheadValidTiles(*reinterpret_cast<const AheadSlot *>(at), range & 0xffff, range >> 16));
+}
+
+int AheadValid(AheadSlot &s, const Ship *v)
+{
+	const AheadIn &in = s.in;
+	const AheadOut &o = s.out;
+	for (uint32_t i = 0; i < o.regions; i++) {
+		if (SeWaterRegionGen(o.region_index[i]) != o.region_gen[i]) return 1;
+	}
+	if (!SeSameBytes(&in.settings, &_settings_game.pf.yapf, sizeof(YAPFSettings))) return 2;
+	if (!AheadSameShip(in, v)) return 3;
+	if (in.dest_station != StationID::Invalid()) {
+		if (CalcClosestStationTile(in.dest_station, v->tile, StationType::Dock) != in.dest_closest) return 4;
+		WaterRegionPatchDesc now[AHEAD_ORIGINS];
+		const int n = StationOrigins(in.dest_station, now);
+		if (n != in.origins) return 5;
+		for (int i = 0; i < n; i++) {
+			if (!(now[i] == in.origin_patch[i])) return 6;
+		}
+	}
+	/* The tiles in parts, on the workers free (each only reads: the map does not change while the first core waits
+	 * here), the first part on the first core; why not is the first part's that says so, as one pass in order gives. */
+	constexpr uint32_t SLICE = 128, MOST = 24;
+	const uint32_t n = o.n_tiles;
+	if (n < 2 * SLICE || AheadMode() == 2 || _tw_on) return AheadValidTiles(s, 0, n);
+	const uint32_t parts = std::min<uint32_t>(MOST, (n + SLICE - 1) / SLICE);
+	mcw_for_end(); /* (a lingering team takes no calls) */
+	mcw_handle h[MOST];
+	const uint32_t at = static_cast<uint32_t>(reinterpret_cast<uintptr_t>(&s));
+	for (uint32_t p = 1; p < parts; p++) {
+		h[p] = mcw_try_call(AheadValidJob, at, (n * p / parts) | (n * (p + 1) / parts) << 16);
+	}
+	int why = AheadValidTiles(s, 0, n / parts);
+	for (uint32_t p = 1; p < parts; p++) {
+		const int w = h[p] != 0 ? static_cast<int>(mcw_join(h[p])) : AheadValidTiles(s, n * p / parts, n * (p + 1) / parts);
+		if (why == 0) why = w;
+	}
+	return why;
+}
+
+/** The path made ahead for this ship, if there is one and all it read is as it was. */
+bool AheadTake(const Ship *v, TileIndex tile, TrackdirBits origin, bool &path_found, ShipPathCache &path_cache, Trackdir &td)
+{
+	const int k = AheadFind(v->index);
+	if (k < 0) {
+		_ahead_stats.none++;
+		return false;
+	}
+	AheadSlot &s = _ahead_slots[k];
+	if (_ahead_state[k] != AHEAD_RUNNING || s.in.v_tile != v->tile || s.in.origin != origin || s.in.tile != tile) {
+		_ahead_stats.moved++;
+		AheadAbandon(k);
+		return false;
+	}
+	if (_tw_on && _ahead_post[k].decided == s.in.req && AheadPosted(k) && !AheadEnded(k)) {
+		/* (the tick on a worker: the job runs only while the tick waits; it is waited for here, the map still) */
+		_ahead_stats.waited++;
+		YapfShipAheadGo();
+		while (!AheadEnded(k)) {
+			TickWorkerYield();
+			YapfShipAheadGo();
+			mc_end_pass();
+		}
+		YapfShipAheadStop();
+	}
+	if (!AheadEnded(k)) {
+		_ahead_stats.late++;
+		AheadAbandon(k);
+		return false;
+	}
+	AheadJoin(k);
+	_ahead_state[k] = AHEAD_FREE;
+	if (!AheadPosted(k)) {
+		_ahead_stats.unposted++;
+		return false;
+	}
+	if (s.out.refused != 0) {
+		_ahead_stats.refused[std::clamp(s.out.refused, 0, 11)]++;
+		return false;
+	}
+	if (const int why = AheadValid(s, v); why != 0) {
+		_ahead_stats.invalid++;
+		_ahead_stats.why[std::min(why, 11)]++;
+		return false;
+	}
+	path_cache.assign(s.out.path, s.out.path + s.out.path_len);
+	path_found = s.out.path_found;
+	td = s.out.result;
+	_ahead_stats.taken++;
+	return true;
+}
+
+} // namespace
+
+/** After the vehicles' tick: a path made ahead for each ship that will ask for one at its next tile. */
+void WaterRegionsMakeAll();
+
+void YapfShipAhead()
+{
+	if (_game_mode == GM_NORMAL) {
+		AheadReap();
+		WaterRegionsMakeAll(); /* (the regions made invalid since, on the workers: a ship's path then makes none) */
+	}
+	/* (the tick on a worker of its own: a path is made ahead only while the tick waits, the map still; the first core
+	 * posts the jobs, YapfShipAheadService) */
+	if (AheadMode() == 0 || _game_mode != GM_NORMAL) return;
+	if (_tw_on ? _ahead_slots == nullptr : !AheadInit()) return;
+	AheadReap();
+	bool team_ended = false;
+	/* The ships, listed anew every 64 ticks: Ship::Iterate goes through the whole pool of vehicles, a thousand a tick
+	 * for 64 ships (one made since waits for its list; a path made ahead or not is the same path). */
+	static std::vector<VehicleID> ships;
+	static uint64_t listed_at = 0;
+	if (ships.empty() || TimerGameTick::counter - listed_at >= 64) {
+		ships.clear();
+		for (const Ship *v : Ship::Iterate()) ships.push_back(v->index);
+		listed_at = TimerGameTick::counter;
+	}
+	for (VehicleID id : ships) {
+		const Ship *v = Ship::GetIfValid(id);
+		if (v == nullptr) continue;
+		TileIndex next;
+		TrackdirBits origin;
+		if (!AheadWanted(v, next, origin)) continue;
+		int k = AheadFind(v->index);
+		if (k >= 0) {
+			const AheadIn &in = _ahead_slots[k].in;
+			if (_ahead_state[k] == AHEAD_RUNNING && in.v_tile == v->tile && in.tile == next && in.origin == origin && AheadSameShip(in, v)) continue;
+			AheadAbandon(k);
+		}
+		for (k = 0; k < AHEAD_SLOTS && _ahead_state[k] != AHEAD_FREE; k++) {}
+		if (k == AHEAD_SLOTS) break;
+
+		AheadSlot &s = _ahead_slots[k];
+		AheadIn &in = s.in;
+		std::copy_n(reinterpret_cast<const uint8_t *>(v), sizeof(Ship), in.ship);
+		in.settings = _settings_game.pf.yapf;
+		in.id = v->index;
+		in.v_tile = v->tile;
+		in.tile = next;
+		in.origin = origin;
+		in.map_size = Map::Size();
+		in.dest_station = StationID::Invalid();
+		in.origins = 0;
+		if (v->current_order.IsType(OT_GOTO_STATION)) {
+			in.dest_station = v->current_order.GetDestination().ToStationID();
+			in.dest_closest = CalcClosestStationTile(in.dest_station, v->tile, StationType::Dock);
+			in.origins = StationOrigins(in.dest_station, in.origin_patch);
+			if (in.origins < 0) continue;
+		}
+		GetWaterRegionPatchInfo(v->tile); /* (the region the ship is in made now, where it is to be made: a worker refuses to) */
+		in.snaps = 0;
+		for (const Ship *u : Ship::Iterate()) {
+			if (in.snaps == AHEAD_SNAP || !IsDockingTile(u->tile)) continue;
+			bool have = false;
+			for (int i = 0; i < in.snaps; i++) have |= in.snap_tile[i] == u->tile.base();
+			if (have) continue;
+			in.snap_tile[in.snaps] = u->tile.base();
+			in.snap_count[in.snaps++] = DockShips(u->tile);
+		}
+		in.cancel = 0;
+		s.out.ack = ~0u;
+		if (_tw_on) {
+			in.req = in.req + 1;
+			_ahead_state[k] = AHEAD_RUNNING;
+			_ahead_stats.launched++;
+			continue;
+		}
+		if (!team_ended) {
+			mcw_for_end(); /* (a lingering team takes no calls) */
+			team_ended = true;
+		}
+		const mcw_handle h = mcw_try_call(AheadJob, static_cast<uint32_t>(reinterpret_cast<uintptr_t>(&s)), in.req);
+		if (h == 0) break;
+		_ahead_handle[k] = h;
+		_ahead_state[k] = AHEAD_RUNNING;
+		_ahead_stats.launched++;
+	}
+}
+
+/** The first core begins (true) or ends drawing the dirty blocks: ends, and waits until every path made ahead waits. */
+void YapfShipAheadCancel();
+
+void YapfShipAheadQuiet(bool on)
+{
+	if (_ahead_slots == nullptr || _tw_on) return;
+	if (on) {
+		/* A picture with no tick since the last (the game paused, or drawn faster than it ticks): the paths are
+		 * given up, not made on, so that every worker draws. The jobs launched at a tick held up to nine workers
+		 * in every paused picture after it, and the first core waited at each picture's end for them to stop
+		 * (paused scroll 7.8 pictures a second to 1.9). A path given up is made again or by the first core. */
+		static uint64_t opened_at = UINT64_MAX;
+		if (TimerGameTick::counter == opened_at || _pause_mode.Any()) {
+			YapfShipAheadCancel();
+			return;
+		}
+		opened_at = TimerGameTick::counter;
+		_ahead_quiet.v = (_ahead_gen << 1) | 1;
+		return;
+	}
+	_ahead_gen++;
+	const uint32_t q = _ahead_gen << 1;
+	_ahead_quiet.v = q;
+	for (int k = 0; k < AHEAD_SLOTS; k++) {
+		if (_ahead_state[k] == AHEAD_FREE) continue;
+		while (_ahead_slots[k].out.ack != q && !mcw_ready(_ahead_handle[k])) mcw_rest();
+	}
+}
+
+/** Before the map or the engines are made anew: every path made ahead ends, and is waited for. */
+void YapfShipAheadCancel()
+{
+	if (_ahead_slots == nullptr) return;
+	for (int k = 0; k < AHEAD_SLOTS; k++) {
+		if (_ahead_state[k] == AHEAD_FREE) continue;
+		_ahead_slots[k].in.cancel = 1;
+		if (_tw_on) {
+			/* (the first core, the tick held: each request posted or not now, and each job joined once it has ended) */
+			while (!AheadEnded(k) || _ahead_post[k].h != 0) {
+				YapfShipAheadService();
+				mcw_rest();
+			}
+		} else {
+			mcw_join(_ahead_handle[k]);
+		}
+		_ahead_state[k] = AHEAD_FREE;
+	}
+}
+
+/**
+ * The tick on a worker, the first core: each job the tick asked for posted to a free worker (or said to have none), and
+ * each that has ended joined. Never while a flush's pieces are out (a lingering team is ended first).
+ */
+void YapfShipAheadService()
+{
+	if (_ahead_slots == nullptr || TickOnWorker() || mcw_on_worker()) return;
+	bool ended = false;
+	for (int k = 0; k < AHEAD_SLOTS; k++) {
+		AheadPost &f = _ahead_post[k];
+		if (f.h != 0 && mcw_ready(f.h)) {
+			mcw_join(f.h);
+			f.h = 0;
+		}
+		AheadSlot &s = _ahead_slots[k];
+		const uint32_t req = s.in.req;
+		if (f.decided == req || f.h != 0) continue;
+		mcw_handle h = 0;
+		if (!VpFlushOut() && !s.in.cancel) {
+			if (!ended) mcw_for_end();
+			ended = true;
+			h = mcw_try_call(AheadJob, static_cast<uint32_t>(reinterpret_cast<uintptr_t>(&s)), req);
+		}
+		if (h != 0) {
+			f.h = h;
+			f.posted = req;
+		}
+		f.decided = req;
+	}
+}
+
+/**
+ * The tick on a worker: the map may change from here (the tick begins or goes on, or the first core holds it). The
+ * stillness is ended, and every job whose word says it reads is waited for until it stops (SeShipAheadPoll).
+ */
+void YapfShipAheadStop()
+{
+	if (_ahead_slots == nullptr) return;
+	const uint32_t q = _ahead_quiet.v;
+	if ((q & 1) == 0) return;
+	_ahead_quiet.v = q + 1;
+	/* (with no job out none can read: a job posted from here on starts in a later pass and sees the word stored; the
+	 * pass waited for nothing was most of the first core's holds of the tick, 3 ms a picture of a paused game's scroll) */
+	bool out = false;
+	for (int k = 0; k < AHEAD_SLOTS; k++) {
+		const uint32_t r = _ahead_slots[k].in.req;
+		if (_ahead_slots[k].out.ended != r && !(_ahead_post[k].decided == r && _ahead_post[k].posted != r)) out = true;
+	}
+	if (!out) return;
+	const bool first = !TickOnWorker();
+	auto pass = [first] { if (first) mcw_rest(); else mc_end_pass(); };
+	pass();
+	for (int k = 0; k < AHEAD_SLOTS; k++) {
+		const AheadSlot &s = _ahead_slots[k];
+		while (s.out.ack == q && s.out.ended != s.in.req) pass();
+	}
+}
+
+/**
+ * The tick on its worker, in a paused game: every path out is given up (a paused game takes none). A job out keeps
+ * every hold of the tick waiting a pass or two for it (YapfShipAheadStop): 2 ms of each paused picture.
+ */
+void YapfShipAheadDrop()
+{
+	if (_ahead_slots == nullptr || !_tw_on) return;
+	for (int k = 0; k < AHEAD_SLOTS; k++) AheadAbandon(k);
+	AheadReap();
+}
+
+/** The tick on its worker waits, between two ticks or for a path: the map is still until YapfShipAheadStop. */
+void YapfShipAheadGo()
+{
+	if (_ahead_slots == nullptr) return;
+	const uint32_t q = _ahead_quiet.v;
+	if ((q & 1) == 0) _ahead_quiet.v = q + 1;
+}
+
+void YapfShipAheadInit()
+{
+	if (AheadMode() != 0) AheadInit();
+}
+
+void YapfShipAheadStats()
+{
+	if (_ahead_slots == nullptr) return;
+	const auto &a = _ahead_stats;
+	Debug(misc, 0, "ship paths ahead: {} waited for, {} with no worker", a.waited, a.unposted);
+	Debug(misc, 0, "ship paths ahead: {} made, {} taken, {} with none, {} moved, {} late, {} invalid, refused {} {} {} {} {} {} {} {} {} {} {} {}, {} checked, {} differ; invalid by {} {} {} {} {} {} {} {} {} {}",
+		a.launched, a.taken, a.none, a.moved, a.late, a.invalid, a.refused[0], a.refused[1], a.refused[2], a.refused[3], a.refused[4], a.refused[5], a.refused[6], a.refused[7], a.refused[8], a.refused[9], a.refused[10], a.refused[11], a.checked, a.differ, a.why[1], a.why[2], a.why[3], a.why[4], a.why[5], a.why[6], a.why[7], a.why[8], a.why[9], a.why[10]);
+}
+#endif
+
 /** Ship controller helper - path finder invoker. */
 Track YapfShipChooseTrack(const Ship *v, TileIndex tile, bool &path_found, ShipPathCache &path_cache)
 {
 	Trackdir best_origin_dir = INVALID_TRACKDIR;
 	const TrackdirBits origin_dirs = TrackdirToTrackdirBits(v->GetVehicleTrackdir());
+#ifdef WITH_SHADEREMU
+	Trackdir td_ret;
+	if (AheadMode() != 0 && AheadTake(v, tile, origin_dirs, path_found, path_cache, td_ret)) {
+		if (AheadMode() == 2) {
+			bool found = false;
+			ShipPathCache cache;
+			const Trackdir td = CYapfShip::ChooseShipTrack(v, tile, origin_dirs, TRACKDIR_BIT_NONE, found, cache, best_origin_dir);
+			_ahead_stats.checked++;
+			bool same = td == td_ret && found == path_found && cache.size() == path_cache.size();
+			for (size_t i = 0; same && i < cache.size(); i++) same = cache[i].trackdir == path_cache[i].trackdir;
+			if (!same) {
+				_ahead_stats.differ++;
+				path_cache = cache;
+				path_found = found;
+				td_ret = td;
+			}
+		}
+	} else {
+		td_ret = CYapfShip::ChooseShipTrack(v, tile, origin_dirs, TRACKDIR_BIT_NONE, path_found, path_cache, best_origin_dir);
+	}
+#else
 	const Trackdir td_ret = CYapfShip::ChooseShipTrack(v, tile, origin_dirs, TRACKDIR_BIT_NONE, path_found, path_cache, best_origin_dir);
+#endif
 	return (td_ret != INVALID_TRACKDIR) ? TrackdirToTrack(td_ret) : INVALID_TRACK;
 }
 

+ZoomLevels LoadSpriteFromImage(SpriteLoader::SpriteCollection &sprite, const SpriteFile &file, size_t file_pos, SpriteType sprite_type, bool load_32bpp, SpriteCacheCtrlFlags control_flags, ZoomLevels &avail_8bpp, ZoomLevels &avail_32bpp)
+{
+	SpriteMemReader r{&file, file.ImageIfRead(), file.GetStartPos(), file.GetEndPos(), file_pos};
+	if (file.GetContainerVersion() >= 2) return LoadSpriteV2(sprite, r, file_pos, sprite_type, load_32bpp, control_flags, avail_8bpp, avail_32bpp);
+	return LoadSpriteV1(sprite, r, file_pos, sprite_type, load_32bpp, avail_8bpp);
+}
+#endif
+
+#ifdef WITH_SHADEREMU
+/**
+ * At most how much memory a core needs to load the sprite at file_pos from the file's image (VpLoadWanted):
+ * its records decoded, the levels out made and all encoded; 0 if it is not a plain sprite.
+ */
+size_t SpriteImageBound(const SpriteFile &file, size_t file_pos)
+{
+	if (file_pos == SIZE_MAX || file.ImageIfRead() == nullptr) return 0;
+	SpriteMemReader r{&file, file.ImageIfRead(), file.GetStartPos(), file.GetEndPos(), file_pos};
+	size_t bound = 0, most = 0;
+	if (file.GetContainerVersion() >= 2) {
+		uint32_t id = r.ReadDword();
+		do {
+			uint32_t num = r.ReadDword();
+			size_t start = r.GetPos();
+			uint8_t type = r.ReadByte();
+			if (type == 0xFF || start + num > r.end) return 0;
+			r.ReadByte(); /* (zoom) */
+			size_t h = r.ReadWord(), w = r.ReadWord();
+			r.SkipBytes(4);
+			size_t decomp = (type & 0x08) ? r.ReadDword() : w * h * 5;
+			if (decomp > 16 * 1024 * 1024) return 0;
+			bound += decomp + 16 + w * h * sizeof(SpriteLoader::CommonPixel) + 16;
+			most = std::max(most, w * h);
+			r.SeekTo(start + num, SEEK_SET);
+		} while (r.GetPos() + 4 <= r.end && r.ReadDword() == id);
+	} else {
+		size_t num = r.ReadWord();
+		uint8_t type = r.ReadByte();
+		if (type == 0xFF) return 0;
+		size_t h = r.ReadByte(), w = r.ReadWord();
+		size_t decomp = (type & 0x02) ? w * h : num;
+		bound = decomp + 16 + w * h * sizeof(SpriteLoader::CommonPixel) + 16;
+		most = w * h;
+	}
+	/* the levels out (a third more), the encoder's guess (five times the levels) and what it keeps */
+	return bound + most * sizeof(SpriteLoader::CommonPixel) / 2 + 16 * 4 + (most * 2 + 64) * 5 * 2 + 4096;
+}
+#endif

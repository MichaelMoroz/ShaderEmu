+		VpReachMerge();
+		_vp_stat_again += static_cast<uint32_t>(_vp_order.size());
+		for (int k = 1; k <= _vp_workers; k++) {
+			if (_vp_core[k].full) _vp_room[k] *= 2, _vp_core[k].full = false;
+		}
+		VpLoadWanted();
+	}
+
+	_vp_phase[VP_PHASE_AGAIN] += VpTime() - t;
+	t = VpTime();
+	/* what a worker gave up twice, then the buffers to the screen, then the texts */
+	for (VpPiece &p : _vp_pieces) {
+		if (!p.failed) continue;
+		VpDrawPiece(p);
+		_vp_stat_redrawn++;
+	}
+	_vp_phase[VP_PHASE_FIRST] += VpTime() - t;
+	t = VpTime();
+	static uint32_t _fc_left, _fc_left_bytes, _fc_rounds;
+	uint32_t left_bytes = 0;
+	for (const VpPiece &p : _vp_pieces) {
+		if (!p.copied) _fc_left++, left_bytes += p.width * (p.row1 - p.row0);
+	}
+	_fc_left_bytes += left_bytes;
+	/* (a few KB the first core copies itself: a round is two passes) */
+	if (left_bytes > 16384) {
+		_fc_rounds++;
+		mcw_for_opt(static_cast<uint32_t>((_screen.height + 15) / 16), VpCopyOut, nullptr, &opts);
+	} else if (left_bytes > 0) {
+		VpCopyOut(nullptr, 0, static_cast<uint32_t>((_screen.height + 15) / 16));
+	}
+	_vp_phase[VP_PHASE_COPY] += VpTime() - t;
+	t = VpTime();
+	FcMark(9);
+	for (size_t j = 0; j < _vp_jobs.size(); j++) VpDrawTexts(_vp_jobs[j], j, false);
+	FcMark(10);
+	if (fc && ++_fc_n % 64 == 0) {
+		std::string line = "openttd: flush steps (k a flush): revalidate, cut, pieces made, their copies, sort and room, scroll waited, pieces, stats, reach, again and copy, texts drawn, texts made:";
+		for (int i = 0; i < 12; i++) line += fmt::format(" {:.1f}", _fc_sum[i] / 64000.0), _fc_sum[i] = 0;

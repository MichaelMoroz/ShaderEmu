+		o.index = static_cast<uint16_t *>(SeAheadAlloc(s.in.map_size * sizeof(uint16_t)));
+		o.status_index = static_cast<uint16_t *>(SeAheadAlloc(s.in.map_size * sizeof(uint16_t)));
+		o.type_index = static_cast<uint16_t *>(SeAheadAlloc(s.in.map_size * sizeof(uint16_t)));

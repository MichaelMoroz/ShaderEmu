+/** A tile's water tracks (or type) the worker reads: logged once, the same every time after. */
+void AheadDerived(AheadSlot &s, TileIndex t, uint16_t *index, void (*of)(TileIndex, TileRec &))
+{
+	AheadOut &o = s.out;
+	const uint32_t i = t.base();
+	if (i >= s.in.map_size) SeShipAheadRefuse(5);
+	TileRec r;
+	of(t, r);
+	const uint32_t k = index[i];
+	if (k != 0) {
+		if (!SameData(r, o.tiles[k - 1])) SeShipAheadRefuse(6);
+		return;
+	}
+	if (o.n_tiles >= AHEAD_TILES) SeShipAheadRefuse(7);
+	o.tiles[o.n_tiles] = r;
+	index[i] = static_cast<uint16_t>(++o.n_tiles);
+}
+
+void AheadStatus(AheadSlot &s, TileIndex t) { AheadDerived(s, t, s.out.status_index, TileStatusOf); }
+
+/** A tile whose type alone is read (a tunnel's or bridge's, whether it is an aqueduct), unless it is a station's: then its words. */
+void AheadType(AheadSlot &s, TileIndex t)
+{
+	if (IsTileType(t, MP_STATION)) {

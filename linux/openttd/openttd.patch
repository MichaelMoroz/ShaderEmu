+/*
+ * The viewport on worker cores (docs/games/openttd.md, "The viewport on worker cores"): the parts
+ * asked for while a ViewportKeep lives are cut in pieces at the flush, every core draws pieces into
+ * buffers of their own, the buffers go to the screen by rows, then the first core draws the texts.
+ */
+struct VpJob {
+	Viewport vp;
+	DrawPixelInfo outer; ///< _cur_dpi as it was when the part was asked for
+	int left, top, right, bottom;
+};
+
+struct alignas(16) VpPiece {
+	int job;
+	int left, right;  ///< virtual
+	int top, bottom;  ///< virtual
+	int row0, row1;   ///< screen rows
+	int width;        ///< pixels
+	int cost;
+	uint8_t *screen;  ///< its first pixel
+	uint8_t *buf;     ///< where it is drawn, 16-aligned
+	int pitch;        ///< of buf
+	uint32_t refused; ///< sprites its core was refused while making it
+	bool failed;
+	bool full;        ///< its core's lists had no room
+};
+
+static std::vector<VpJob> _vp_jobs;
+static VpVector<VpPiece> _vp_pieces;
+static std::vector<int> _vp_order; ///< pieces of a round, the dearest first
+static VpVector<uint8_t> _vp_buffers;
+static int _vp_keep_depth;
+static int _vp_workers = -1;
+static size_t _vp_room[VP_CORES];
+uint32_t _vp_stat_jobs, _vp_stat_pieces, _vp_stat_again, _vp_stat_redrawn, _vp_stat_loaded; ///< for OPENTTD_PLAY's report
+uint32_t VpSpritesRefused(int k);
+uint32_t VpLoadWanted();
+
+struct alignas(16) VpProbe {
+	uintptr_t sp;
+	int self;
+};
+static VpProbe _vp_probes[VP_CORES];
+
+static void VpProbeStack(void *, uint32_t from, uint32_t to)
+{
+	for (uint32_t i = from; i < to; i++) {
+		int k = mcw_self();
+		uintptr_t sp;
+		asm volatile("mv %0, sp" : "=r"(sp));
+		if (k > 0 && k < VP_CORES) _vp_probes[k] = { sp, k };
+	}
+}
+
+/** The worker cores asked for (OPENTTD_WORKERS, 31 by default, 0 draws as upstream), opened once. */
+static int VpWorkers()
+{
+	if (_vp_workers >= 0) return _vp_workers;
+	const char *asked = getenv("OPENTTD_WORKERS");
+	int want = asked != nullptr ? 0 : VP_CORES - 1;
+	for (const char *c = asked; c != nullptr && *c >= '0' && *c <= '9'; c++) want = want * 10 + (*c - '0');
+	want = std::min(want, VP_CORES - 1);
+	_vp_workers = 0;
+	if (want <= 0 || BlitterFactory::GetCurrentBlitter()->GetScreenDepth() != 8) return 0;
+	int got = mcw_open(want);
+	if (got <= 0) return 0;
+	/* A worker's stack is the k-th 64 KB from the first, its top on a page: its sp says where they begin. */
+	mcw_for_opts opts = {};
+	opts.grain = 1;
+	mcw_for_opt(64, VpProbeStack, nullptr, &opts);
+	uintptr_t stacks = 0;
+	for (int k = 1; k < VP_CORES; k++) {
+		if (_vp_probes[k].self != k) continue;
+		uintptr_t base = ((_vp_probes[k].sp + 4095) & ~uintptr_t{4095}) - static_cast<uintptr_t>(k) * 0x10000;
+		if (stacks != 0 && base != stacks) return 0;
+		stacks = base;
+	}
+	if (stacks == 0) return 0;
+	_vp_stacks = stacks;
+	_vp_stacks_bytes = static_cast<uintptr_t>(got) * 0x10000;
+	for (int k = 1; k <= got; k++) _vp_room[k] = 2048;
+	_vp_workers = got;
+	return got;
+}
+
+/** A part asked for while parts are kept: kept, to be made at the flush. */
+static void VpJobPlace(const VpJob &job, int &row, int &col, int &w, int &h);
+
+static bool ViewportKept(const Viewport &vp, int left, int top, int right, int bottom)
+{
+	if (_vp_keep_depth == 0 || VpCore() != 0 || _draw_bounding_boxes || _draw_dirty_blocks) return false;
+	if (_newgrf_debug_sprite_picker.mode == SPM_REDRAW || VpWorkers() == 0) return false;
+	/* a part over one kept is drawn after it, its texts too: the kept ones are made first */
+	VpJob job{ vp, *_cur_dpi, left, top, right, bottom };
+	int row, col, w, h;
+	VpJobPlace(job, row, col, w, h);
+	ViewportFlushOver(col, row, col + w, row + h);
+	_vp_jobs.push_back(job);
+	return true;
+}
+
+ViewportKeep::ViewportKeep() { _vp_keep_depth++; }
+ViewportKeep::~ViewportKeep()
+{
+	if (--_vp_keep_depth == 0) ViewportFlush();
+}
+
+/** What ViewportDoDraw draws of sprites, into this core's lists and dst (its first pixel): no signs or texts. */
+static void VpDrawSprites(const Viewport &vp, int left, int top, int right, int bottom, uint8_t *dst, int pitch)
+{
+	VpCoreState &me = _vp_core[VpCore()];
+	_vd.dpi.zoom = vp.zoom;
+	int mask = ScaleByZoom(-1, vp.zoom);
+	_vd.combine_sprites = SPRITE_COMBINE_NONE;
+	_vd.dpi.width = (right - left) & mask;
+	_vd.dpi.height = (bottom - top) & mask;
+	_vd.dpi.left = left & mask;
+	_vd.dpi.top = top & mask;
+	_vd.dpi.pitch = pitch;
+	_vd.last_child = LAST_CHILD_NONE;
+	_vd.dpi.dst_ptr = dst;
+	AutoRestoreBackup dpi_backup(_cur_dpi, &_vd.dpi);
+
+	ViewportAddLandscape();
+	ViewportAddVehicles(&_vd.dpi);
+	/* (a failed piece goes on blitting nothing, so that it asks for every sprite it lacks) */
+	if (!_vd.tile_sprites_to_draw.empty()) ViewportDrawTileSprites(&_vd.tile_sprites_to_draw);
+	for (auto &psd : _vd.parent_sprites_to_draw) {
+		if (!VpRoom(_vd.parent_sprites_to_sort)) break;
+		_vd.parent_sprites_to_sort.push_back(&psd);
+	}
+	if (!me.full) ViewportSortParentSpritesKept(&_vd.parent_sprites_to_sort);
+	if (!me.full) ViewportDrawParentSprites(&_vd.parent_sprites_to_sort, &_vd.child_screen_sprites_to_draw);
+	_vd.tile_sprites_to_draw.clear();
+	_vd.parent_sprites_to_draw.clear();
+	_vd.parent_sprites_to_sort.clear();
+	_vd.child_screen_sprites_to_draw.clear();
+}
+
+/** A piece of a part, into its buffer, on whichever core runs it. */
+static void VpDrawPiece(VpPiece &piece)
+{
+	int k = VpCore();
+	if (k != 0 && k != mcw_self()) {
+		piece.failed = true;
+		return;
+	}
+	VpCoreState &me = _vp_core[k];
+	me.failed = false;
+	const uint32_t refused = k != 0 ? VpSpritesRefused(k) : 0;
+	const VpJob &job = _vp_jobs[piece.job];
+	/* (what no sprite covers stays as the screen was) */
+	for (int r = 0; r < piece.row1 - piece.row0; r++) {
+		std::copy_n(piece.screen + r * _screen.pitch, piece.width, piece.buf + r * piece.pitch);
+	}
+	DrawPixelInfo outer = job.outer;
+	DrawPixelInfo *was = me.cur_dpi;
+	me.cur_dpi = &outer;
+	VpDrawSprites(job.vp, piece.left, piece.top, piece.right, piece.bottom, piece.buf, piece.pitch);
+	me.cur_dpi = was;
+	piece.failed = me.failed;
+	piece.full = me.full;
+	piece.refused = k != 0 ? VpSpritesRefused(k) - refused : 0;
+	me.failed = false;
+}
+
+static void VpDrawPieces(void *, uint32_t from, uint32_t to)
+{
+	for (uint32_t i = from; i < to; i++) VpDrawPiece(_vp_pieces[_vp_order[i]]);
+}
+
+/** The pieces' buffers to the screen, 16 rows an item: no two cores write the same 16 bytes. */
+static void VpCopyOut(void *, uint32_t from, uint32_t to)
+{
+	const int top = static_cast<int>(from) * 16, bottom = static_cast<int>(to) * 16;
+	for (const VpPiece &p : _vp_pieces) {
+		int r0 = std::max(top, p.row0), r1 = std::min(bottom, p.row1);
+		for (int r = r0; r < r1; r++) {
+			std::copy_n(p.buf + (r - p.row0) * p.pitch, p.width, p.screen + (r - p.row0) * _screen.pitch);
+		}
+	}
+}
+
+/** A part's signs, texts and overlay over its sprites, by the first core (they format strings and load glyphs). */
+static void VpDrawTexts(const VpJob &job)
+{
+	const Viewport &vp = job.vp;
+	DrawPixelInfo outer = job.outer;
+	AutoRestoreBackup outer_backup(_cur_dpi, &outer);
+	_vd.dpi.zoom = vp.zoom;
+	int mask = ScaleByZoom(-1, vp.zoom);
+	_vd.dpi.width = (job.right - job.left) & mask;
+	_vd.dpi.height = (job.bottom - job.top) & mask;
+	_vd.dpi.left = job.left & mask;
+	_vd.dpi.top = job.top & mask;
+	_vd.dpi.pitch = _cur_dpi->pitch;
+	int x = UnScaleByZoom(_vd.dpi.left - (vp.virtual_left & mask), vp.zoom) + vp.left;
+	int y = UnScaleByZoom(_vd.dpi.top - (vp.virtual_top & mask), vp.zoom) + vp.top;
+	_vd.dpi.dst_ptr = BlitterFactory::GetCurrentBlitter()->MoveTo(_cur_dpi->dst_ptr, x - _cur_dpi->left, y - _cur_dpi->top);
+	AutoRestoreBackup dpi_backup(_cur_dpi, &_vd.dpi);
+
+	ViewportAddKdtreeSigns(&_vd.dpi);
+	DrawTextEffects(&_vd.dpi);
+
+	DrawPixelInfo dp = _vd.dpi;
+	ZoomLevel zoom = _vd.dpi.zoom;
+	dp.zoom = ZoomLevel::Min;
+	dp.width = UnScaleByZoom(dp.width, zoom);
+	dp.height = UnScaleByZoom(dp.height, zoom);
+	AutoRestoreBackup cur_dpi(_cur_dpi, &dp);
+
+	if (vp.overlay != nullptr && vp.overlay->GetCargoMask() != 0 && vp.overlay->GetCompanyMask().Any()) {
+		dp.left = x;
+		dp.top = y;
+		vp.overlay->Draw(&dp);
+	}
+	if (!_vd.string_sprites_to_draw.empty()) {
+		dp.left = UnScaleByZoom(_vd.dpi.left, zoom);
+		dp.top = UnScaleByZoom(_vd.dpi.top, zoom);
+		ViewportDrawStrings(zoom, &_vd.string_sprites_to_draw);
+	}
+	_vd.string_sprites_to_draw.clear();
+}
+
+/** The worker k's lists made room for _vp_room[k] sprites, before a round (a worker may not allocate). */
+static void VpMakeRoom(int k)
+{
+	ViewportDrawer &d = _vd_of[k];
+	size_t n = _vp_room[k];
+	d.tile_sprites_to_draw.reserve(n);
+	d.parent_sprites_to_draw.reserve(n);
+	d.parent_sprites_to_sort.reserve(n);
+	d.child_screen_sprites_to_draw.reserve(n);
+	d.sort_list.reserve(n);
+	d.sort_next.reserve(n);
+	d.sort_preceding.reserve(n);
+	d.sort_stack.reserve(4 * n);
+}
+
+/** Where a part lies on the screen: its first pixel's row and column, and its size in pixels. */
+static void VpJobPlace(const VpJob &job, int &row, int &col, int &w, int &h)
+{
+	const Viewport &vp = job.vp;
+	ZoomLevel z = vp.zoom;
+	int mask = ScaleByZoom(-1, z);
+	w = UnScaleByZoom((job.right - job.left) & mask, z);
+	h = UnScaleByZoom((job.bottom - job.top) & mask, z);
+	int x = UnScaleByZoom((job.left & mask) - (vp.virtual_left & mask), z) + vp.left;
+	int y = UnScaleByZoom((job.top & mask) - (vp.virtual_top & mask), z) + vp.top;
+	uintptr_t at = reinterpret_cast<uintptr_t>(BlitterFactory::GetCurrentBlitter()->MoveTo(job.outer.dst_ptr, x - job.outer.left, y - job.outer.top));
+	uintptr_t screen = reinterpret_cast<uintptr_t>(_screen.dst_ptr);
+	row = static_cast<int>((at - screen) / _screen.pitch);
+	col = static_cast<int>((at - screen) % _screen.pitch);
+}
+
+/** The parts kept made now if any of them lies in the screen's rectangle (right and bottom excluded). */
+void ViewportFlushOver(int left, int top, int right, int bottom)
+{
+	for (const VpJob &job : _vp_jobs) {
+		int row, col, w, h;
+		VpJobPlace(job, row, col, w, h);
+		if (col < right && col + w > left && row < bottom && row + h > top) {
+			ViewportFlush();
+			return;
+		}
+	}
+}
+
+void ViewportFlush()
+{
+	if (_vp_jobs.empty()) return;
+	assert(VpCore() == 0);
+	const int cores = _vp_workers + 1;
+	_vp_pieces.clear();
+
+	/* how each part is cut: the dearest piece of all is cut again (in columns or rows) while the flush, the
+	 * dearest piece or all work over the cores, gets shorter; a column's tiles reach 128 pixels to its sides
+	 * and a row's 250 below it, at normal zoom */
+	struct Cut { int w, h, mh, mv, cols, rows; int64_t Cost(int c, int r) const { return int64_t{w / c + mh} * (h / r + mv); } };
+	std::vector<Cut> cuts(_vp_jobs.size());
+	int64_t total = 0;
+	for (size_t j = 0; j < _vp_jobs.size(); j++) {
+		ZoomLevel z = _vp_jobs[j].vp.zoom;
+		int row, col;
+		Cut &c = cuts[j];
+		VpJobPlace(_vp_jobs[j], row, col, c.w, c.h);
+		c.mh = 128 * 4 / ScaleByZoom(1, z);
+		c.mv = 250 * 4 / ScaleByZoom(1, z);
+		c.cols = c.rows = 1;
+		if (c.w > 0 && c.h > 0) total += c.Cost(1, 1);
+	}
+	for (;;) {
+		size_t worst = 0;
+		int64_t worst_cost = -1;
+		for (size_t j = 0; j < cuts.size(); j++) {
+			const Cut &c = cuts[j];
+			if (c.w > 0 && c.h > 0 && c.Cost(c.cols, c.rows) > worst_cost) worst = j, worst_cost = c.Cost(c.cols, c.rows);
+		}
+		if (worst_cost < 0) break;
+		Cut &c = cuts[worst];
+		const int64_t was = std::max(worst_cost, total / cores);
+		int64_t best = INT64_MAX;
+		int bc = 0, br = 0;
+		if ((c.cols + 1) * c.rows <= cores && c.w / (c.cols + 1) >= 16 && c.Cost(c.cols + 1, c.rows) < best) best = c.Cost(c.cols + 1, c.rows), bc = c.cols + 1, br = c.rows;
+		if (c.cols * (c.rows + 1) <= cores && c.h / (c.rows + 1) >= 8 && c.Cost(c.cols, c.rows + 1) < best) best = c.Cost(c.cols, c.rows + 1), bc = c.cols, br = c.rows + 1;
+		if (bc == 0) break;
+		int64_t now_total = total - c.Cost(c.cols, c.rows) * c.cols * c.rows + best * bc * br;
+		int64_t next_worst = best;
+		for (size_t j = 0; j < cuts.size(); j++) {
+			if (j != worst && cuts[j].w > 0 && cuts[j].h > 0) next_worst = std::max(next_worst, cuts[j].Cost(cuts[j].cols, cuts[j].rows));
+		}
+		if (std::max(next_worst, now_total / cores) >= was) break;
+		c.cols = bc, c.rows = br, total = now_total;
+	}
+
+	size_t buffer_bytes = 0;
+	for (size_t j = 0; j < _vp_jobs.size(); j++) {
+		const VpJob &job = _vp_jobs[j];
+		const Viewport &vp = job.vp;
+		ZoomLevel z = vp.zoom;
+		int mask = ScaleByZoom(-1, z);
+		int vl = job.left & mask, vt = job.top & mask;
+		int row0, col0, w, h;
+		VpJobPlace(job, row0, col0, w, h);
+		if (w <= 0 || h <= 0) continue;
+		uint8_t *at = static_cast<uint8_t *>(_screen.dst_ptr) + row0 * _screen.pitch + col0;
+
+		/* sprites of vehicles that change when drawn are made here, not on the workers */
+		DrawPixelInfo whole = {};
+		whole.left = vl;
+		whole.top = vt;
+		whole.width = ScaleByZoom(w, z);
+		whole.height = ScaleByZoom(h, z);
+		whole.zoom = z;
+		ViewportRevalidateVehicles(&whole);
+
+		const int cols = cuts[j].cols, rows = cuts[j].rows, mh = cuts[j].mh, mv = cuts[j].mv;
+		for (int p = 0; p < cols; p++) {
+			int a = w * p / cols, b = w * (p + 1) / cols;
+			for (int q = 0; q < rows; q++) {
+				int r0 = h * q / rows, r1 = h * (q + 1) / rows;
+				VpPiece piece = {};
+				piece.job = static_cast<int>(j);
+				piece.left = vl + ScaleByZoom(a, z);
+				piece.right = vl + ScaleByZoom(b, z);
+				piece.top = vt + ScaleByZoom(r0, z);
+				piece.bottom = vt + ScaleByZoom(r1, z);
+				piece.row0 = row0 + r0;
+				piece.row1 = row0 + r1;
+				piece.width = b - a;
+				piece.cost = (b - a + mh) * (r1 - r0 + mv);
+				piece.screen = at + r0 * _screen.pitch + a;
+				piece.pitch = (b - a + 15) & ~15;
+				buffer_bytes += static_cast<size_t>(piece.pitch) * (r1 - r0);
+				_vp_pieces.push_back(piece);
+			}
+		}
+	}
+	/* (the buffers grow on the first core, so that their pages are there before a worker writes them) */
+	if (_vp_buffers.size() < buffer_bytes) _vp_buffers.resize(buffer_bytes * 2);
+	uint8_t *buf = _vp_buffers.data();
+	for (VpPiece &p : _vp_pieces) p.buf = buf, buf += static_cast<size_t>(p.pitch) * (p.row1 - p.row0);
+
+	const int n = static_cast<int>(_vp_pieces.size());
+	_vp_order.resize(n);
+	for (int i = 0; i < n; i++) _vp_order[i] = i;
+	std::sort(_vp_order.begin(), _vp_order.end(), [](int a, int b) { return _vp_pieces[a].cost > _vp_pieces[b].cost; });
+
+	for (int k = 1; k <= _vp_workers; k++) VpMakeRoom(k);
+	mcw_for_opts opts = {};
+	opts.grain = 1;
+	mcw_for_opt(static_cast<uint32_t>(n), VpDrawPieces, nullptr, &opts);
+
+	/* pieces that lacked sprites or room are made again by the workers once those are loaded and made */
+	for (int k = 1; k <= _vp_workers; k++) {
+		if (_vp_core[k].full) _vp_room[k] *= 2, _vp_core[k].full = false;
+	}
+	_vp_stat_loaded += VpLoadWanted();
+	std::vector<int> again;
+	for (int i : _vp_order) {
+		const VpPiece &p = _vp_pieces[i];
+		if (p.failed && (p.refused != 0 || p.full)) again.push_back(i);
+	}
+	if (!again.empty()) {
+		_vp_order.swap(again);
+		for (int k = 1; k <= _vp_workers; k++) VpMakeRoom(k);
+		mcw_for_opt(static_cast<uint32_t>(_vp_order.size()), VpDrawPieces, nullptr, &opts);
+		_vp_stat_again += static_cast<uint32_t>(_vp_order.size());
+		for (int k = 1; k <= _vp_workers; k++) {
+			if (_vp_core[k].full) _vp_room[k] *= 2, _vp_core[k].full = false;
+		}
+		VpLoadWanted();
+	}
+
+	/* what a worker gave up twice, then the buffers to the screen, then the texts */
+	for (VpPiece &p : _vp_pieces) {
+		if (!p.failed) continue;
+		VpDrawPiece(p);
+		_vp_stat_redrawn++;
+	}
+	mcw_for_opt(static_cast<uint32_t>((_screen.height + 15) / 16), VpCopyOut, nullptr, &opts);
+	for (const VpJob &job : _vp_jobs) VpDrawTexts(job);
+	_vp_stat_jobs += static_cast<uint32_t>(_vp_jobs.size());
+	_vp_stat_pieces += static_cast<uint32_t>(n);
+	_vp_jobs.clear();
+}
+#endif

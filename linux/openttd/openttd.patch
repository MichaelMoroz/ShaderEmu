+#ifdef WITH_SHADEREMU
+/* The viewport is drawn on worker cores too (docs/games/openttd.md): what each core draws with,
+ * in 16 bytes of its own. VpCore() is the core that runs, by its stack: 0 the first. */
+static constexpr int VP_CORES = 32;
+struct alignas(16) VpCoreState {
+	DrawPixelInfo *cur_dpi;
+	const uint8_t *colour_remap;
+	uint8_t string_remap[3];
+	bool failed; ///< what this worker drew is given up, to be drawn again
+	bool full;   ///< and one of its lists had no room
+};
+extern VpCoreState _vp_core[VP_CORES];
+extern uintptr_t _vp_stacks, _vp_stacks_bytes;
+inline int VpCore()
+{
+	uintptr_t sp;
+	asm("mv %0, sp" : "=r"(sp));
+	uintptr_t d = sp - _vp_stacks;
+	return d < _vp_stacks_bytes ? static_cast<int>(d >> 16) + 1 : 0;
+}
+/** On a worker: what it is drawing is given up (true); on the first core: false. */
+inline bool VpRefuse()
+{
+	int k = VpCore();
+	if (k == 0) return false;
+	_vp_core[k].failed = true;
+	return true;
+}
+#define _cur_dpi (_vp_core[VpCore()].cur_dpi)
+/**
+ * A core's memory while it loads sprites in a round (VpLoadWanted): temporaries from the bottom, made
+ * anew for each sprite, what is kept from the top; a worker may not allocate. In 32 bytes of its own.
+ */
+struct alignas(32) VpArena {
+	uint8_t *base;
+	size_t lo, hi, size;
+	bool on;
+};
+extern VpArena _vp_arena[VP_CORES];
+inline bool VpArenaOn() { return _vp_arena[VpCore()].on; }
+void *VpArenaTemp(size_t bytes, bool zero = true);
+#else
 extern DrawPixelInfo *_cur_dpi;
+#endif
 
 #endif /* GFX_FUNC_H */

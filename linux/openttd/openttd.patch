+#ifdef WITH_SHADEREMU
+/** The machine's copy (CSRs 0xb0 to 0xb3, docs/machine/gpu.md): the core stops until it is made, a pass a 256 KB. */
+static void MachineCopy(void *dst, const void *src, uint32_t bytes)
+{
+	asm volatile("csrw 0x0b1, %0" :: "r"(src));
+	asm volatile("csrw 0x0b2, %0" :: "r"(dst));
+	asm volatile("csrw 0x0b3, %0" :: "r"(bytes));
+	asm volatile("csrw 0x0b0, %0" :: "r"(1) : "memory");
+}
+
+/**
+ * A part as wide as the screen moved as one block (OPENTTD_MEMOP=0: row by row, =check: and compared):
+ * what wraps round a row's end lands in the strips the caller draws anew. The machine copies whole
+ * texels of the destination from words of the source: a move by other than whole words is row by row,
+ * and the part texels at the ends are the processor's (docs/games/openttd.md, "Scrolls").
+ */
+/* A move by other than whole words: the part copied aside by the machine, then put back moved by the workers. */
+static constexpr size_t ODD_CHUNK = 4096; ///< bytes a piece, whole texels
+static struct { uint8_t *to, *end; const uint8_t *from; } _odd; ///< destination [to, end) from from on
+static uint8_t *_odd_aside;
+static size_t _odd_room;
+
+/** The room aside for a move, its pages there before a worker reads them. */
+static uint8_t *OddAside(size_t total)
+{
+	if (_odd_room < total + 32) {
+		if (_odd_aside != nullptr) ::operator delete(_odd_aside, std::align_val_t{16});
+		_odd_room = (total + 32) * 2;
+		_odd_aside = static_cast<uint8_t *>(::operator new(_odd_room, std::align_val_t{16}));
+		std::fill_n(_odd_aside, _odd_room, 0);
+	}
+	return _odd_aside;
+}
+
+
+static void OddMovePieces(void *, uint32_t lo, uint32_t hi)
+{
+	for (uint32_t i = lo; i < hi; i++) {
+		uint8_t *at = _odd.to + i * ODD_CHUNK, *until = std::min(at + ODD_CHUNK, _odd.end);
+		std::copy_n(_odd.from + (at - _odd.to), until - at, at);
+	}
+}
+
+static bool _odd_out; ///< a move begun on the workers and not waited for
+static uint32_t _odd_began;
+uint32_t _odd_stat[3]; ///< moves by other than whole words, the time from each one's start to its wait, and waited
+
+void ScrollSettle()
+{
+	if (!_odd_out) return;
+	const uint32_t t = VpTime();
+	mcw_for_wait();
+	_odd_out = false;
+	_odd_stat[0]++, _odd_stat[1] += t - _odd_began, _odd_stat[2] += VpTime() - t;
+	_vp_phase[VP_PHASE_MOVE] += VpTime() - t;
+}
+
+/* (the workers' part is not waited for: the first core cuts the viewport's parts meanwhile) */
+static void MoveOdd(uint8_t *base, size_t total, ptrdiff_t d, uint8_t *to, uint8_t *end)
+{
+	const uintptr_t off = reinterpret_cast<uintptr_t>(base) & 15;
+	uint8_t *aside = OddAside(total) + off;
+	uint8_t *a = reinterpret_cast<uint8_t *>((reinterpret_cast<uintptr_t>(base) + 15) & ~uintptr_t{15});
+	uint8_t *b = reinterpret_cast<uint8_t *>(reinterpret_cast<uintptr_t>(base + total) & ~uintptr_t{15});
+	std::copy_n(base, a - base, aside);
+	MachineCopy(aside + (a - base), a, static_cast<uint32_t>(b - a));
+	std::copy_n(b, base + total - b, aside + (b - base));
+	/* (the first texel's bytes before a whole one are this core's, the rest in whole texels the workers') */
+	uint8_t *first = reinterpret_cast<uint8_t *>((reinterpret_cast<uintptr_t>(to) + 15) & ~uintptr_t{15});
+	const uint8_t *from = aside + (to - d - base);
+	std::copy_n(from, first - to, to);
+	_odd = { first, end, from + (first - to) };
+	mcw_for_opts opts = {};
+	opts.grain = 1;
+	opts.first_idle = 1;
+	mcw_for_begin(static_cast<uint32_t>((end - first + ODD_CHUNK - 1) / ODD_CHUNK), OddMovePieces, nullptr, &opts);
+	_odd_out = true;
+	_odd_began = VpTime();
+}
+
+/* A part narrower than the screen: its rows copied aside by the machine, then put back moved by the workers. */
+static struct { const uint8_t *from; uint8_t *to; size_t width; ptrdiff_t pitch; uint32_t height; } _rows;
+static constexpr uint32_t ROWS_A_JOB = 4;
+
+static void MoveRowsPieces(void *, uint32_t lo, uint32_t hi)
+{
+	for (uint32_t i = lo * ROWS_A_JOB; i < std::min(hi * ROWS_A_JOB, _rows.height); i++) {
+		std::copy_n(_rows.from + i * _rows.pitch, _rows.width, _rows.to + i * _rows.pitch);
+	}
+}
+
+static bool MoveRows(const uint8_t *src, uint8_t *dst, int width, int height, ptrdiff_t pitch)
+{
+	ScrollSettle();
+	static const char *how = getenv("OPENTTD_MEMOP");
+	if ((how != nullptr && how[0] == '0') || width < 64 || static_cast<size_t>(width) * height < 16384) return false;
+	const uint8_t *lo = pitch > 0 ? src : src + (height - 1) * pitch;
+	const size_t total = static_cast<size_t>(height - 1) * std::abs(pitch) + width;
+	uint8_t *base = const_cast<uint8_t *>(lo);
+	const uintptr_t off = reinterpret_cast<uintptr_t>(base) & 15;
+	uint8_t *aside = OddAside(total) + off;
+	uint8_t *a = reinterpret_cast<uint8_t *>((reinterpret_cast<uintptr_t>(base) + 15) & ~uintptr_t{15});
+	uint8_t *b = reinterpret_cast<uint8_t *>(reinterpret_cast<uintptr_t>(base + total) & ~uintptr_t{15});
+	std::copy_n(base, a - base, aside);
+	MachineCopy(aside + (a - base), a, static_cast<uint32_t>(b - a));
+	std::copy_n(b, base + total - b, aside + (b - base));
+	_rows = { aside + (src - lo), dst, static_cast<size_t>(width), pitch, static_cast<uint32_t>(height) };
+	const uint32_t t = VpTime();
+	mcw_for_opts opts = {};
+	opts.grain = 1;
+	opts.first_idle = 1;
+	mcw_for_opt((static_cast<uint32_t>(height) + ROWS_A_JOB - 1) / ROWS_A_JOB, MoveRowsPieces, nullptr, &opts);
+	_vp_phase[VP_PHASE_MOVE] += VpTime() - t;
+	return true;
+}
+
+static bool ScrollAsBlock(void *video, int left, int top, int width, int height, int scroll_x, int scroll_y)
+{
+	ScrollSettle();
+	static const char *how = getenv("OPENTTD_MEMOP");
+	ptrdiff_t d = static_cast<ptrdiff_t>(scroll_y) * _screen.pitch + scroll_x;
+	if (left != 0 || width != _screen.pitch || (how != nullptr && how[0] == '0') || std::abs(d) < 64) return false;
+	uint8_t *base = static_cast<uint8_t *>(video) + top * _screen.pitch;
+	size_t total = static_cast<size_t>(height) * _screen.pitch;
+	/* the destination [to, end), its texels [a, b) */
+	uint8_t *to = d > 0 ? base + d : base, *end = d > 0 ? base + total : base + total + d;
+	uint8_t *a = reinterpret_cast<uint8_t *>((reinterpret_cast<uintptr_t>(to) + 15) & ~uintptr_t{15});
+	uint8_t *b = reinterpret_cast<uint8_t *>(reinterpret_cast<uintptr_t>(end) & ~uintptr_t{15});
+	if (b - a < 1024) return false;
+	std::vector<uint8_t> want;
+	bool check = how != nullptr && how[0] == 'c';
+	if (check) {
+		want.assign(base, base + total);
+		if (d > 0) std::copy_backward(want.begin(), want.end() - d, want.end());
+		else std::copy(want.begin() - d, want.end(), want.begin());
+	}
+	auto move = [d](uint8_t *from, uint8_t *until) {
+		if (until <= from) return;
+		if (d > 0) std::copy_backward(from - d, until - d, until);
+		else std::copy(from - d, until - d, from);
+	};
+	if (d % 4 != 0) {
+		const uint32_t t = VpTime();
+		MoveOdd(base, total, d, to, end);
+		_vp_phase[VP_PHASE_MOVE] += VpTime() - t;
+	} else if (d > 0) { /* (ahead: the end first) */
+		move(b, end);
+		MachineCopy(a, a - d, static_cast<uint32_t>(b - a));
+		move(to, a);
+	} else {
+		move(to, a);
+		MachineCopy(a, a - d, static_cast<uint32_t>(b - a));
+		move(b, end);
+	}
+	if (check) {
+		ScrollSettle();
+		size_t wrong = 0;
+		for (size_t i = 0; i < total; i++) wrong += base[i] != want[i];
+		fmt::print(stderr, "openttd: scroll by {},{} of {} bytes, {} wrong\n", scroll_x, scroll_y, total, wrong);
+	}
+	return true;
+}
+#endif

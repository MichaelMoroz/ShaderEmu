+struct alignas(16) VpPiece {
+	int job;
+	int left, right;  ///< virtual
+	int top, bottom;  ///< virtual
+	int row0, row1;   ///< screen rows
+	int width;        ///< pixels
+	int cost;
+	uint8_t *screen;  ///< its first pixel
+	uint8_t *buf;     ///< where it is drawn, 16-aligned
+	int pitch;        ///< of buf
+	uint32_t refused; ///< sprites its core was refused while making it
+	bool failed;
+	bool full;        ///< its core's lists had no room

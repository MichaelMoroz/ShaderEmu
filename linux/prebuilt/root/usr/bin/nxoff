#!/bin/sh
# Shut down: the desktop's programs are asked to go, then the window system, what was written
# is put where it is kept, and Linux stops. The host is asked to switch the machine off
# (nxpersist off: the world does); under one that cannot it stands still until switched off.
# From the desktop it is asked first, and the programs get to ask about what is not saved;
# nxoff now asks nothing. nxoff save: the folder the host keeps is saved first (docs/system/persist.md),
# after the programs have closed and written what they had; not saved, the machine stays up.
# (in a session of its own: started from a terminal of the desktop it would go with that terminal)
# (not exec: no-MMU busybox's setsid run by a session leader says "nxoff: applet not found", as nx's)
[ -z "$NX_OWN_SESSION" ] && { NX_OWN_SESSION=1 setsid "$0" "$@"; exit; }
unset NX_OWN_SESSION
if [ "$1" = save ] && pidof nano-X >/dev/null; then
    nxask "Save /persistence and shut the machine down?" "Save and shut down" Cancel || exit 0
    nxask --closing || exit 0
    nxpersist save || exit 0
elif [ "$1" = save ]; then
    nxpersist save || exit 1
elif [ "$1" != now ] && pidof nano-X >/dev/null; then
    nxask "Shut the machine down?" "Shut down" Cancel || exit 0
    nxask --closing || exit 0
fi
killall nxbar nxterm 2>/dev/null
sleep 1
killall nano-X 2>/dev/null
n=0
while pidof nano-X >/dev/null && [ $n -lt 5 ]; do sleep 1; n=$((n + 1)); done
killall -9 nano-X 2>/dev/null
sync
echo "The machine has stopped: it can be switched off." > /dev/console
nxpersist off >/dev/null 2>&1
exec poweroff -f

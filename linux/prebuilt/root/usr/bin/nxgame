#!/bin/sh
# nxgame quake|quake3|openttd host|join, nxgame doom host|now: a game over the network with the other
# computers (docs/system/lan.md, "Games over the network"). A computer that hosts says so to whoever
# asks who is there (/tmp/nxhosting, which nxnet --serve reads); a join looks for it.
game="$1"
how="${2:-host}"
own=$(ifconfig lan0 2>/dev/null | sed -n 's/.*inet addr:\([0-9.]*\).*/\1/p')
say() { echo "nxgame: $1"; [ -f /tmp/nano-X.lock ] && nxask "$1" OK; }
# (twelve seconds of answers: a computer busy with a game answers late over the world's link)
others() { nxnet --find 12 | grep "\[$1\]" | cut -d' ' -f1; }
if [ -z "$own" ]; then
    say "This computer is not on a network."
    exit 1
fi
later=""
trap 'rm -f /tmp/nxhosting; [ -n "$later" ] && kill $later 2>/dev/null' EXIT INT TERM
case "$game $how" in
"quake host")
    # said to be hosting once the level is up: a join before that finds no game
    # (without this script's trap: it would take the word away again as the waiting part ends)
    (trap - EXIT INT TERM; sleep "${NXGAME_WAIT:-40}"; echo quake > /tmp/nxhosting) &
    later=$!
    quake -listen 4 +hostname "$own" +map e1m1
    ;;
"quake join")
    it=$(others quake | head -1)
    if [ -z "$it" ]; then
        say "Nobody is hosting Quake yet: a computer that hosts says so some forty seconds after it starts."
        exit 1
    fi
    echo "nxgame: joining Quake at $it"
    quake +connect "$it"
    ;;
"quake3 host")
    # (its level takes longer to come up than Quake's; a client on the LAN is kept to the
    # link's rate as any other, where the game would send it all it has)
    (trap - EXIT INT TERM; sleep "${NXGAME_WAIT:-60}"; echo quake3 > /tmp/nxhosting) &
    later=$!
    quake3 +set sv_hostname "$own" +set sv_maxclients 4 +set sv_lanForceRate 0 +set sv_maxRate 3000 +map q3dm17
    ;;
"quake3 join")
    it=$(others quake3 | head -1)
    if [ -z "$it" ]; then
        say "Nobody is hosting Quake III yet: a computer that hosts says so about a minute after it starts."
        exit 1
    fi
    echo "nxgame: joining Quake III at $it"
    quake3 +set rate 3000 +set snaps 10 +set cl_maxpackets 15 +connect "$it"
    ;;
"openttd host")
    # a new game made a server; the game itself says so once it runs (its start and map take minutes)
    OPENTTD_HOST=1 OPENTTD_HOSTING=/tmp/nxhosting openttd -g
    ;;
"openttd join")
    it=$(others openttd | head -1)
    if [ -n "$it" ]; then
        echo "nxgame: joining OpenTTD at $it"
        openttd -n "$it"
    else
        # (nobody yet: the server list, whose Search LAN asks again)
        echo "nxgame: nobody is hosting OpenTTD yet; the server list"
        OPENTTD_JOIN=1 openttd
    fi
    ;;
"doom host" | "doom now")
    # every player starts this: the players are the computers that say doom, in their addresses' order
    echo doom > /tmp/nxhosting
    if [ "$how" = host ]; then
        nxask "Doom over the network: start this on every computer that plays, then press Start on each." Start Cancel || exit 0
    else
        sleep "${NXGAME_WAIT:-8}"
    fi
    all=$( (echo "$own"; others doom) | sort -t. -k3,3n -k4,4n)
    n=0; me=0; rest=""
    for a in $all; do
        n=$((n + 1))
        if [ "$a" = "$own" ]; then me=$n; else rest="$rest .$a"; fi
    done
    if [ -z "$rest" ]; then
        say "No other computer has started Doom over the network."
        exit 1
    fi
    echo "nxgame: Doom, player $me of $n:$rest"
    doom -net "$me"$rest
    ;;
*)
    echo "usage: nxgame quake|quake3|openttd host|join, nxgame doom host|now"
    exit 2
    ;;
esac

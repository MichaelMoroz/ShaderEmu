#!/bin/sh
# Starts the Nano-X window system with its desktop and its bar. NANOX_SIZE=WIDTHxHEIGHT picks
# the screen size (800x600 by default); NANOX_SOFTWARE=1 draws without the GPU.
# nx restart: the desktop over again (Settings does this for a new screen size). First it is
# taken down whole: its own programs are asked to go, then the window system, and nothing is
# started until that has really gone. Any other program on it goes with it.
# nx restart ask [SIZE]: asked first, and the programs get to ask about what is not saved.
if [ "$1" = restart ]; then
    # in a session of its own: typed in a terminal of the desktop it would go with that terminal
    # (not exec: no-MMU busybox's setsid, run by a session leader such as Settings' child,
    # re-execs itself with the command's name as the applet's and says "nx: applet not found")
    [ -z "$NX_OWN_SESSION" ] && { NX_OWN_SESSION=1 setsid "$0" "$@"; exit; }
    unset NX_OWN_SESSION
    # one restart at a time: a second one (the button pressed twice) would take down the
    # window system the first is starting, and leave two of everything or none
    if [ -f /tmp/nxrestart.pid ] && kill -0 "$(cat /tmp/nxrestart.pid)" 2>/dev/null; then
        exit 0
    fi
    echo $$ > /tmp/nxrestart.pid
    if [ "$2" = ask ]; then
        { nxask "Start the desktop again?\nEvery open program closes." "Start again" Cancel && nxask --closing; } ||
            { rm -f /tmp/nxrestart.pid; exit 0; }
    fi
    [ -n "$3" ] && nxreg set desktop.size "$3"
    killall nxbar nxfiles nxterm nxsettings 2>/dev/null
    sleep 1
    killall nano-X 2>/dev/null
    n=0
    while pidof nano-X >/dev/null && [ $n -lt 10 ]; do sleep 1; n=$((n + 1)); done
    killall -9 nano-X 2>/dev/null
    sleep 1
    # the size comes from what Settings wrote, not from what the last desktop's programs inherited
    unset NANOX_SIZE
fi
# one desktop at a time (the window system itself refuses a second, too)
if pidof nano-X >/dev/null; then
    echo "nx: the desktop is running already (nx restart starts it over)"
    exit 0
fi
# the size Settings last chose, unless this start names one
named=$NANOX_SIZE
mkdir -p /persistence/desktop
# (the registry is every program's kept settings: registry.h, docs/system/persist.md)
[ -z "$NANOX_SIZE" ] && NANOX_SIZE="$(nxreg get desktop.size)" && export NANOX_SIZE
[ -d /dev/pts ] || { mkdir /dev/pts && mount -t devpts devpts /dev/pts; }
# the player's name, every program's: $USER and the registry's user.name (docs/system/persist.md)
name=$(nxpersist name 2>/dev/null | tr -cd 'A-Za-z0-9._-' | cut -c1-32)
[ -n "$name" ] && nxreg set user.name "$name"
USER=$(nxreg get user.name)
[ -n "$USER" ] || USER=player
LOGNAME=$USER
export USER LOGNAME
nano-X -p &            # -p: it stays when the last program has gone
# the start's word in the middle of the screen as soon as the server takes it (a client tries to
# reach it for 2 s), until the picture covers it
nxbar --splash "the kept settings and files" 2>/dev/null || nxbar --splash "the kept settings and files"
# what the host keeps of /persistence, once a session and before the desktop shows it (docs/system/persist.md)
if [ ! -f /tmp/nxpersist.loaded ]; then
    : > /tmp/nxpersist.loaded
    # (geotune loads it at boot, before the workers are laid out: linux/userland/geotune.c)
    [ -f /tmp/nxpersist.early ] || nxpersist load
    kept=$(nxreg get sound.volume) && nxsettings volume "$kept"
    # the desktop's icons stand where they were left
    [ -f /persistence/desktop/places ] || cp /root/Desktop/.places /persistence/desktop/places 2>/dev/null
    ln -sf /persistence/desktop/places /root/Desktop/.places
    # a kept screen size that is not this one: the desktop starts over with it
    kept=$(nxreg get desktop.size)
    [ -z "$named" ] && [ -n "$kept" ] && [ "$kept" != "${NANOX_SIZE:-800x600}" ] && exec "$0" restart
fi
nxbar --look          # the look Settings chose (Windows 7 by default), before anything is drawn in it
nxbar --splash "its picture and icons"
nxnet --serve 2>/dev/null &   # answers the other computers' Network program (one a machine: a second finds the port taken)
nxfiles --desktop &   # the desktop: its picture, and the icons of /root/Desktop on it
nxbar &
if [ "$1" = restart ]; then sleep 2; rm -f /tmp/nxrestart.pid; fi

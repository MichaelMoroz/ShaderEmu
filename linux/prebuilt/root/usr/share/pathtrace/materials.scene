# The example meshes in four materials (docs/apps/raytrace.md, "Example scenes"): a matt teapot, a
# plastic rabbit, a metal teapot and a glass knot.
camera target 0 0.35 0 turn 0 tilt 18 far 3.4 lens 0.6
background colour 0.6 0.75 1 power 0.3
object Ground plane scale 5 colour 0.7 0.7 0.68
object "Matt teapot" /root/Models/teapot.obj fit 1 move -1.65 0 0 colour 0.85 0.45 0.25
object "Plastic rabbit" /root/Models/bunny.ply fit 0.9 move -0.55 0 0 kind plastic colour 0.2 0.35 0.85
object "Metal teapot" /root/Models/teapot.obj fit 1 move 0.55 0 0 kind metal rough 0.25 colour 0.95 0.8 0.45
object "Glass knot" /root/Models/knot.obj fit 0.9 move 1.6 0 0 kind glass density 0.6 colour 0.8 0.95 1
light Light place -1.5 3.5 2.5 radius 0.25 power 90

+void SE_CardPainted( void );
+
+// A channel moved on as the mixer would have mixed it: finished at its end, or round its loop
+static void S_AdvanceChannel( channel_t *ch, const wavdata_t *sc, int num_samples, int out_rate, double pitch )
+{
+	double end = ch->sample + pitch * sc->rate / out_rate * num_samples;
+
+	if( ch->forced_end && end >= ch->forced_end )
+		SetBits( ch->flags, FL_CHAN_FINISHED );
+	else if( end < sc->samples )
+		ch->sample = end;
+	else if( FBitSet( sc->flags, SOUND_LOOPED ) && FBitSet( ch->flags, FL_CHAN_USE_LOOP ) && sc->samples > sc->loop_start )
+		ch->sample = sc->loop_start + fmod( end - sc->loop_start, sc->samples - sc->loop_start );
+	else SetBits( ch->flags, FL_CHAN_FINISHED );
+}
+
+void S_PaintChannels( int endtime )
+{
+	const qboolean sp = Host_IsSinglePlayerGame();
+	const qboolean ingame = CL_IsInGame();
+	const int num_samples = endtime - snd.paintedtime;
+	const float pitch_mult = ( sys_timescale.value + 1 ) / 2;
+
+	if( num_samples <= 0 )
+		return;
+	snd.paintedtime = endtime;
+	if( cl.background && cls.key_dest == key_console )
+	{
+		SE_CardPainted();
+		return;
+	}
+	for( int i = 0; i < snd.total_channels; i++ )
+	{
+		channel_t *ch = &snd.channels[i];
+
+		if( !ch->sfx )
+			continue;
+		if( !cl.background )
+		{
+			if( cls.key_dest == key_console && FBitSet( ch->flags, FL_CHAN_LOCAL_SOUND ))
+				;
+			else if(( cls.key_dest == key_menu || cl.paused ) && !FBitSet( ch->flags, FL_CHAN_LOCAL_SOUND ) && sp )
+				continue;
+			else if( cls.key_dest != key_menu && !ingame && !FBitSet( ch->flags, FL_CHAN_STATIC_SOUND ))
+				continue;
+		}
+		wavdata_t *sc = S_LoadSound( ch->sfx );
+		if( !sc )
+		{
+			S_FreeChannel( ch );
+			continue;
+		}
+		if( ch->leftvol < 8 && ch->rightvol < 8 )
+		{
+			if( !FBitSet( sc->flags, SOUND_LOOPED ) || !FBitSet( ch->flags, FL_CHAN_USE_LOOP ))
+			{
+				if( ch->inauduble_free_time == 0.0f )
+					ch->inauduble_free_time = host.realtime + MAX_CHANNEL_INAUDIBLE_TIME;
+				else if( host.realtime > ch->inauduble_free_time )
+					S_FreeChannel( ch );
+			}
+			continue;
+		}
+		ch->inauduble_free_time = 0.0f;
+
+		double pitch = VOX_ModifyPitch( ch, ch->basePitch * 0.01 ) * pitch_mult, from = ch->sample;
+		cl_entity_t *ent = ch->entchannel == CHAN_VOICE || ch->entchannel == CHAN_STREAM ? CL_GetEntityByIndex( ch->entnum ) : NULL;
+
+		SE_CardChannel( i, ch, sc, pitch );
+		S_AdvanceChannel( ch, sc, num_samples, snd.format.speed, pitch );
+		SE_CardMoved( i, ch, sc, ent ? &ent->mouth : NULL, from );
+		if( FBitSet( ch->flags, FL_CHAN_FINISHED ) && ch->words )
+		{
+			// the sentence's next word, from where this paint left it
+			VOX_FreeWord( ch );
+			ch->word_index++;
+			VOX_LoadWord( ch );
+			if( !FBitSet( ch->flags, FL_CHAN_SENTENCE_FINISHED ))
+				ch->sfx = ch->words[ch->word_index].sfx;
+		}
+		if( ch->words ? FBitSet( ch->flags, FL_CHAN_SENTENCE_FINISHED ) : FBitSet( ch->flags, FL_CHAN_FINISHED ))
+			S_FreeChannel( ch );
+	}
+	SE_CardPainted();
+}

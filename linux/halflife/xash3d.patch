+#if XASH_SHADEREMU
+static particle_t **se_tail( particle_t **p ) { while( *p ) p = &( *p )->next; return p; }
+static BEAM **se_beams_tail( BEAM **b ) { while( *b ) b = &( *b )->next; return b; }
+// The effects to draw given to the drawing's worker, and 64 free particles for its beams' trails.
+void SE_EfxGive( void )
+{
+	se_efx.particles = cl_active_particles, se_efx.tracers = cl_active_tracers, se_efx.beams = cl_active_beams;
+	cl_active_particles = cl_active_tracers = NULL, cl_active_beams = NULL;
+	se_efx.freed = NULL, se_efx.freed_beams = NULL, se_efx.free = NULL;
+	for( int i = 0; i < 64 && cl_free_particles; i++ )
+	{
+		particle_t *p = cl_free_particles;
+		cl_free_particles = p->next, p->next = se_efx.free, se_efx.free = p;
+	}
+}
+// Its lists after those made since (theirs first, as one list would have them), its free ones free.
+void SE_EfxTaken( void )
+{
+	*se_tail( &cl_active_particles ) = se_efx.particles;
+	*se_tail( &cl_active_tracers ) = se_efx.tracers;
+	*se_beams_tail( &cl_active_beams ) = se_efx.beams;
+	*se_tail( &se_efx.freed ) = se_efx.free;
+	*se_tail( &se_efx.freed ) = cl_free_particles;
+	cl_free_particles = se_efx.freed;
+	*se_beams_tail( &se_efx.freed_beams ) = cl_free_beams;
+	cl_free_beams = se_efx.freed_beams;
+	memset( &se_efx, 0, sizeof( se_efx ));
+}
+#endif

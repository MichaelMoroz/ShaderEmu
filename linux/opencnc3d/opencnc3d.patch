@@ -55,6 +55,59 @@
 
 #include "debugstring.h"
 #include "rawfile.h"
+#ifdef SHADEREMU_BRAIN
+#include <sys/mman.h>
+/*
+** A file's bytes from `at` on as memory: the file's own pages, all there at once, and a page
+** the game writes to (a shape's header) becomes a copy of its own. Reading a mix into the heap
+** was the pages and a copy of them: 25 million instructions of Red Alert's start, and 24 MB.
+*/
+static struct
+{
+    void* data;
+    void* base;
+    size_t length;
+} ShaderEmu_Maps[16];
+
+void* ShaderEmu_Mix_Map(FILE* file, long at, int size)
+{
+    long page = at & ~4095L;
+    size_t length = (size_t)size + (size_t)(at - page);
+
+    for (int i = 0; i < 16; i++) {
+        if (ShaderEmu_Maps[i].data == NULL) {
+            void* base = mmap(NULL, length, PROT_READ, MAP_PRIVATE | MAP_POPULATE, fileno(file), page);
+            if (base == MAP_FAILED) {
+                return (NULL);
+            }
+            mprotect(base, length, PROT_READ | PROT_WRITE);
+            ShaderEmu_Maps[i].base = base;
+            ShaderEmu_Maps[i].length = length;
+            ShaderEmu_Maps[i].data = (char*)base + (at - page);
+            return (ShaderEmu_Maps[i].data);
+        }
+    }
+    return (NULL);
+}
+
+bool ShaderEmu_Mix_Unmap(void* data)
+{
+    for (int i = 0; i < 16; i++) {
+        if (ShaderEmu_Maps[i].data == data && data != NULL) {
+            munmap(ShaderEmu_Maps[i].base, ShaderEmu_Maps[i].length);
+            ShaderEmu_Maps[i].data = NULL;
+            return (true);
+        }
+    }
+    return (false);
+}
+
+void ShaderEmu_Folders_Forget(void); /* file_posix.cpp: the folders' names it keeps are not all there is now */
+int ShaderEmu_File_Listed(const char* path, bool opened);
+#define SHADEREMU_FOLDERS_FORGET() ShaderEmu_Folders_Forget()

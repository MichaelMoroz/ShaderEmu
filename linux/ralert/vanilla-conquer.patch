+#ifdef SHADEREMU
+/*
+** What Can_Enter_Cell said of a cell, kept while one object's searches go on with nothing
+** changed between them (FootClass::Basic_Path: up to four, over the same cells; no version of
+** it looks at the facing). RALERT_CHECK_ENTER=1 asks again every time and compares.
+*/
+static unsigned ShaderEmu_Enter_Kept, ShaderEmu_Enter_Wrong;
+static struct search
+{
+    CELL dest;
+    int maxlen;
+    int threshhold;
+    unsigned seen;
+    PathType path;
+    FacingType moves[256];
+    unsigned int overlap[MAP_CELL_TOTAL / 32];
+} ShaderEmu_Search[4];
+static int ShaderEmu_Searches;
+static int ShaderEmu_Path_Out[PATH_CORES]; /* the threshold core k is out searching with, less one */
+/* The search this core is in, and the unit's highest threshold (0: none that others could help) */
+static struct
+{
+    CELL dest;
+    int maxlen, now, most;
+} ShaderEmu_Path_Asked;
+
+static void ShaderEmu_Enter_Report(void)
+{
+    fprintf(stderr, "ralert: %u answers about cells kept within a search, %u of them wrong\n", ShaderEmu_Enter_Kept,
+            ShaderEmu_Enter_Wrong);
+}
+
+void ShaderEmu_Enter_Keep(bool keep)
+{
+    static unsigned short turn;
+    static int check = -1;
+
+    if (check < 0) {
+        check = getenv("RALERT_CHECK_ENTER") != NULL;
+        ShaderEmu_Enter_Check = check && atoi(getenv("RALERT_CHECK_ENTER"));
+        if (check) {
+            atexit(ShaderEmu_Enter_Report);
+        }
+    }
+    if (keep && ++turn == 0) {
+        memset(ShaderEmu_Enter_At, 0, sizeof(ShaderEmu_Enter_At));
+        turn = 1;
+    }
+    ShaderEmu_Enter_Now = keep ? turn : 0;
+    ShaderEmu_Searches = 0;
+    /* searches nobody asked the result of are stopped, and waited for: the unit is put back next */
+    for (int k = 1; k < PATH_CORES; k++) {
+        if (ShaderEmu_Path_Out[k]) {
+            ShaderEmu_Path_Stop = ShaderEmu_Path_Turn;
+            host_path_wait(k);
+            ShaderEmu_Path_Out[k] = 0;
+        }
+    }
+    if (keep && ++ShaderEmu_Path_Turn == 0) {
+        ShaderEmu_Path_Turn = 1;
+    }
+}
+
+/*
+** Searches differ only in the threshold, which is compared with a cell's answer and nowhere
+** else: one that met no answer between its threshold and another's went the other's way,
+** step for step. Its result is put back as that search would leave it.
+*/
+static struct search* ShaderEmu_Path_Same(CELL dest, int maxlen, int threshhold)
+{
+    for (struct search* s = ShaderEmu_Search; s < ShaderEmu_Search + ShaderEmu_Searches; s++) {
+        int low = s->threshhold < threshhold ? s->threshhold : threshhold;
+        int high = s->threshhold < threshhold ? threshhold : s->threshhold;
+        if (s->dest == dest && s->maxlen == maxlen && !(s->seen & ((2u << high) - (2u << low)))) {
+            return s;
+        }
+    }
+    return NULL;
+}
+
+static struct search* ShaderEmu_Path_Keep(struct path_core* core, CELL dest, int maxlen, int threshhold)
+{
+    if (ShaderEmu_Searches == 4) {
+        return NULL;
+    }
+    struct search* s = &ShaderEmu_Search[ShaderEmu_Searches++];
+    s->dest = dest;
+    s->maxlen = maxlen;
+    s->threshhold = threshhold;
+    s->seen = core->seen;
+    s->path = core->path;
+    memcpy(s->moves, core->path.Command, maxlen);
+    memcpy(s->overlap, core->path.Overlap, sizeof(s->overlap));
+    return s;
+}
+
+/* A search on a worker core, into the core's own memory: the threshold and the core, and the place. */
+unsigned FootClass::ShaderEmu_Path_Job(unsigned object, unsigned what)
+{
+    int who = what >> 4 & 15;
+    struct path_core* core = &ShaderEmu_Core[who];
+
+    core->seen = 0;
+    core->turn = ShaderEmu_Path_Turn;
+    ((FootClass*)object)->Find_Path((CELL)(what >> 16), core->moves, what >> 8 & 255, (MoveType)(what & 255));
+    return 1;
+}
+
+/*
+** The unit's searches that may follow the one this core is in (the next thresholds up) begin
+** on worker cores, each with its own threshold: neither walk of this core's got round a block.
+*/
+void FootClass::ShaderEmu_Path_Help(void)
+{
+    void ShaderEmu_Threat_Settle(void); /* (cell.cpp: the threat the searches read, as it is) */
+    ShaderEmu_Threat_Settle();
+    CELL dest = ShaderEmu_Path_Asked.dest;
+    int maxlen = ShaderEmu_Path_Asked.maxlen, now = ShaderEmu_Path_Asked.now, most = ShaderEmu_Path_Asked.most;
+    int cores = most > now ? host_path_cores() : 0, k = 1;
+
+    for (int other = now + 1; other <= most && cores > 0; other++) {
+        bool out = ShaderEmu_Path_Same(dest, maxlen, other) != NULL;
+        for (int j = 1; j < PATH_CORES; j++) {
+            out |= ShaderEmu_Path_Out[j] == other + 1;
+        }
+        for (; k <= cores && ShaderEmu_Path_Out[k]; k++) {
+        }
+        if (out) {
+            continue;
+        }
+        if (k > cores || !host_path_post(k, ShaderEmu_Path_Job, (unsigned)(uintptr_t)this,
+                                         (unsigned)dest << 16 | (unsigned)maxlen << 8 | k << 4 | other)) {
+            break; /* (no worker is free) */
+        }
+        ShaderEmu_Path_Out[k] = other + 1;
+    }
+}
+
+/*
+** Find_Path, or what it would find. A search whose walks fail has the unit's next ones
+** made by worker cores meanwhile (nothing changes between a unit's searches, and a search
+** stores only into its core's own memory). RALERT_CHECK_PATHS=1 compares.
+*/
+PathType* FootClass::ShaderEmu_Find_Path(CELL dest, FacingType* final_moves, int maxlen, MoveType threshhold)
+{
+    static int check = -1;
+    static unsigned reused, helped, wrong;
+    struct path_core* core = &ShaderEmu_Core[0];
+    struct search* s;
+    PathType* path;
+
+    if (check < 0) {
+        check = getenv("RALERT_CHECK_PATHS") != NULL;
+        ShaderEmu_Walk_Check = check;
+        ShaderEmu_Walk_Old = getenv("RALERT_WALK") && !strcmp(getenv("RALERT_WALK"), "old");
+        if (check) {
+            atexit([]() {
+                fprintf(stderr, "ralert: %u searches not run again and %u another core's, %u of them wrong\n", reused,
+                        helped, wrong);
+                fprintf(stderr, "ralert: %u edge walks made both ways, %u of them wrong\n", ShaderEmu_Walks,
+                        ShaderEmu_Walks_Wrong);
+            });
+        }
+    }
+    if (!ShaderEmu_Enter_Now || !final_moves || maxlen > 200 || threshhold > 15) {
+        return Find_Path(dest, final_moves, maxlen, threshhold);
+    }
+    s = ShaderEmu_Path_Same(dest, maxlen, threshhold);
+    if (s) {
+        reused++;
+    } else {
+        for (int k = 1; k < PATH_CORES; k++) {
+            if (ShaderEmu_Path_Out[k] == threshhold + 1) {
+                host_path_wait(k);
+                ShaderEmu_Path_Out[k] = 0;
+                s = ShaderEmu_Path_Keep(&ShaderEmu_Core[k], dest, maxlen, threshhold);
+                helped += s != NULL;
+            }
+        }
+    }
+    if (s) {
+        if (check) {
+            path = Find_Path(dest, final_moves, maxlen, threshhold);
+            PathType same = s->path;
+            same.Command = final_moves;
+            same.Overlap = path->Overlap;
+            wrong += memcmp(path, &same, sizeof(same)) != 0 || memcmp(final_moves, s->moves, s->path.Length) != 0
+                     || memcmp(path->Overlap, s->overlap, sizeof(s->overlap)) != 0;
+            return path;
+        }
+        path = &core->path;
+        *path = s->path;
+        path->Command = final_moves;
+        path->Overlap = core->overlap[0];
+        memcpy(final_moves, s->moves, maxlen);
+        memcpy(path->Overlap, s->overlap, sizeof(s->overlap));
+        return path;
+    }
+
+    ShaderEmu_Path_Asked.dest = dest;
+    ShaderEmu_Path_Asked.maxlen = maxlen;
+    ShaderEmu_Path_Asked.now = threshhold;
+    ShaderEmu_Path_Asked.most = ShaderEmu_Path_Most;
+    core->seen = 0;
+    path = Find_Path(dest, final_moves, maxlen, threshhold);
+    ShaderEmu_Path_Asked.most = 0;
+    if (!path->Cost) { /* (a path found is the unit's last search: Basic_Path) */
+        ShaderEmu_Path_Keep(core, dest, maxlen, threshhold);
+    }
+    return path;
+}

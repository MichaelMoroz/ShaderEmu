+            return (0);
+        }
+        if (where[house] < count && Houses.Ptr(where[house])->Class->House == house) {
+            return (Houses.Ptr(where[house]));
+        }
+        for (int index = 0; index < count; index++) {
+            if (Houses.Ptr(index)->Class->House == house) {
+                where[house] = (unsigned char)index;
+                return (Houses.Ptr(index));
+            }
+        }
+        missing |= 1u << house;
+        return (0);
+    }
+#endif

 int FootClass::Passable_Cell(CELL cell, FacingType face, int threat, MoveType threshhold)
 {
+#ifdef SHADEREMU
+    MoveType move;
+    int who = threshhold >> 4;
+    threshhold = (MoveType)(threshhold & 15);
+    if (ShaderEmu_Enter_Now && (unsigned)cell < MAP_CELL_TOTAL) {
+        if (ShaderEmu_Enter_At[who][cell] == ShaderEmu_Enter_Now) {
+            move = (MoveType)ShaderEmu_Enter[who][cell];
+            if (!who) { /* (the counts and the check are the first core's) */
+                ShaderEmu_Enter_Kept++;
+                ShaderEmu_Enter_Wrong += ShaderEmu_Enter_Check && move != Can_Enter_Cell(cell, face);
+            }
+        } else {
+            move = Can_Enter_Cell(cell, face);
+            ShaderEmu_Enter[who][cell] = (unsigned char)move;
+            ShaderEmu_Enter_At[who][cell] = ShaderEmu_Enter_Now;
+        }
+    } else {
+        move = Can_Enter_Cell(cell, face);
+    }
+    ShaderEmu_Core[who].seen |= 1u << move;
+#else
     MoveType move = Can_Enter_Cell(cell, face);
+#endif
 
+#ifdef SHADEREMU
+    /* (a cell that is free passes any threshold: only a cloaked blocker's distance is asked) */
+    if (move == MOVE_CLOAK && Distance(Cell_Coord(cell)) > 0x0100)
+        threshhold = MOVE_MOVING_BLOCK;
+#else
     if (move < MOVE_MOVING_BLOCK && Distance(Cell_Coord(cell)) > 0x0100)
         threshhold = MOVE_MOVING_BLOCK;
+#endif
 
     if (move > threshhold)
         return (0);

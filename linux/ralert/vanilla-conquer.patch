+                }
+                checkcell = (CELL)(oldcell + AdjacentCell[newdir]);
+                int checkval = WALK_SIDE(checkcell);
+                forcefail = checkval && !online && (checkval ^ oldval) < 0;
+                if (forcefail && length > 0 && (newdir ^ 4) == (int)command[length - 1]) {
+                    forcefail = false;
+                }
+            }
+            if (newdir == (int)olddir) {
+                goto out;
+            }
+            newcell = (CELL)(oldcell + AdjacentCell[newdir]);
+            if (!forcefail) {
+                WALK_COST(newcell, newdir, cost, threats);
+                if (cost) {
+                    break;
+                }
+            }
+            if (newcell == target) {
+                forceout = true;
+                break;
+            }
+        }
+        if (!forceout) {
+            int pos = newcell >> 5;
+            unsigned bit = 1u << (newcell & 31); /* (as Register_Cell has them: TEST) */
+            if (!(overlap[pos] & bit)) {
+                command[length++] = (FacingType)newdir;
+                total += cost;
+                overlap[pos] |= bit;
+            } else if ((int)command[length - 1] == (newdir ^ 4)) {
+                /* Register_Cell: straight back, the cell this one is in is left */
+                CELL here = (CELL)(newcell + AdjacentCell[newdir ^ 4]);
+                WALK_CLEAR(here);
+                length--;
+            } else if (path->LastOverlap != newcell) {
+                /* Register_Cell: the path is cut back to where it was in that cell */
+                path->LastOverlap = newcell;
+                CELL at = path->Start;
+                int idx = 0, newlen = 0;
+                if (at != newcell) {
+                    while (idx < length) {
+                        at = (CELL)(at + AdjacentCell[command[idx++]]);
+                        if (at == newcell) {
+                            break;
+                        }
+                    }
+                    newlen = idx;
+                }
+                for (; idx < length; idx++) {
+                    int face = command[idx], gone;
+                    at = (CELL)(at + AdjacentCell[face]);
+                    WALK_COST(at, face, gone, false);
+                    total -= gone;
+                    WALK_CLEAR(at);
+                }
+                length = newlen;
+            } else {
+                /* Unravel_Loop: back along the path to a cell on the line that left it on a diagonal */
+                int curr_dir = newdir, idx = length;
+                CELL curr_pos = (CELL)(newcell + AdjacentCell[curr_dir ^ 4]);
+                FacingType* list = &command[idx - 1];
+                bool last_was_line = false, unravelled = false;
+                while (idx) {
+                    if (!WALK_SIDE(curr_pos) || last_was_line) {
+                        if ((curr_dir & 1) && curr_pos != path->LastFixup) {
+                            newcell = curr_pos;
+                            newdir = *(list - 1);
+                            length = idx;
+                            path->LastFixup = curr_pos;
+                            unravelled = true;
+                            break;
+                        }
+                        last_was_line = !last_was_line;
+                    }
+                    int gone;
+                    WALK_COST(curr_pos, *list, gone, false);
+                    total -= gone;
+                    WALK_CLEAR(curr_pos);
+                    curr_dir = *list--;
+                    curr_pos = (CELL)(curr_pos + AdjacentCell[curr_dir ^ 4]);
+                    idx--;
+                }
+                if (!unravelled) {
+                    goto out;
+                }
+                newdir = (newdir + twice) & 7;
+            }
+            int val = WALK_SIDE(newcell);
+            if (val) {
+                oldval = val;
+                online = false;
+            } else {
+                online = true;
+            }
+            if (++cellcount == MAX_PATH_EDGE_FOLLOW) {
+                goto out;
+            }
+        }
+        if (newcell == target) {
+            command[length] = END;
+            found = true;
+            goto out;
+        }
+        if (newcell == firstcell && newdir == firstdir) {
+            goto out;
+        }
+        if (firstcell == -1) {
+            firstcell = newcell;
+            firstdir = newdir;
+        }
+        olddir = (FacingType)((newdir + back) & 7);
+        oldcell = newcell;
+    }
+out:
+    path->Length = length;
+    path->Cost = total;
+    ShaderEmu_Core[who].seen |= seen;
+    return found;
+#undef WALK_COST
+#undef WALK_SIDE
+#undef WALK_CLEAR
+}
+
+bool FootClass::Follow_Edge(CELL start,
+                            CELL target,
+                            PathType* path,
+                            FacingType search,
+                            FacingType olddir,
+                            int threat,
+                            int threat_stage,
+                            int max_cells,
+                            MoveType threshhold)
+{
+    if (!path || !ShaderEmu_Enter_Now || ShaderEmu_Enter_Check || ShaderEmu_Walk_Old) {
+        return ShaderEmu_Edge_Old(start, target, path, search, olddir, threat, threat_stage, max_cells, threshhold);
+    }
+    if (!ShaderEmu_Walk_Check || (threshhold >> 4)) {
+        return ShaderEmu_Walk(start, target, path, search, olddir, threat, max_cells, threshhold);
+    }
+    /* RALERT_CHECK_PATHS: the walk both ways from the same path, and the game's own is the one kept */
+    PathType kept = *path, made;
+    FacingType kept_moves[MAX_MLIST_SIZE + 2], made_moves[MAX_MLIST_SIZE + 2];
+    unsigned int kept_overlap[MAP_CELL_TOTAL / 32], made_overlap[MAP_CELL_TOTAL / 32];
+    unsigned seen = ShaderEmu_Core[0].seen, made_seen;
+    memcpy(kept_moves, path->Command, sizeof(kept_moves));
+    memcpy(kept_overlap, path->Overlap, sizeof(kept_overlap));
+    bool found = ShaderEmu_Walk(start, target, path, search, olddir, threat, max_cells, threshhold);
+    made = *path;
+    made_seen = ShaderEmu_Core[0].seen;
+    memcpy(made_moves, path->Command, sizeof(made_moves));
+    memcpy(made_overlap, path->Overlap, sizeof(made_overlap));
+    *path = kept;
+    ShaderEmu_Core[0].seen = seen;
+    memcpy(path->Command, kept_moves, sizeof(kept_moves));
+    memcpy(path->Overlap, kept_overlap, sizeof(kept_overlap));
+    bool old = ShaderEmu_Edge_Old(start, target, path, search, olddir, threat, threat_stage, max_cells, threshhold);
+    ShaderEmu_Walks++;
+    ShaderEmu_Walks_Wrong += old != found || memcmp(&made, path, sizeof(made)) != 0 || made_seen != ShaderEmu_Core[0].seen
+                             || memcmp(made_moves, path->Command, sizeof(made_moves)) != 0
+                             || memcmp(made_overlap, path->Overlap, sizeof(made_overlap)) != 0;
+    return old;
+}

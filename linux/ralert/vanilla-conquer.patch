+            if (want == got || shade[gx] || gx <= mx0 || gx >= mx1 - 1 || gy <= my0 || gy >= my1 - 1 || (abs(gx - px) < 34 && abs(gy - py) < 34)) {
+                continue;
+            }
+            bool found = ShaderEmu_Colour_Near(want, got);
+            for (int k = 0; stretched && !found && k < 9; k++) {
+                int i = (gy + k / 3 - 1) * width + gx + k % 3 - 1;
+                found = dark[i] || under_dark[i] || ShaderEmu_Colour_Near(palette[index[i]], got)
+                        || ShaderEmu_Colour_Near(palette[under[i]], got);
+            }
+            if (found) {
+                continue;
+            }
+            differ++;
+            x0 = MIN(x0, x), x1 = MAX(x1, x), y0 = MIN(y0, y), y1 = MAX(y1, y);
+        }
+    }
+    ShaderEmu_GPU_Frames++;
+    if (differ) {
+        ShaderEmu_GPU_Differ++;
+        fprintf(stderr, "ragpu: frame %d view %08x: %d of the window's %dx%d pixels are not the program's (x %d..%d, y %d..%d)\n",
+                (int)Frame, (unsigned)Map.TacticalCoord, differ, w, h, x0, x1, y0, y1);
+    }
+}
+
+/*
+** TDAWN_MOVE=N,DX,DY: at frame N the player's units and soldiers are selected and sent, as by a
+** click, to the cell DX,DY from the view's middle (TDAWN_MOVE_UNSELECT=1: unselected after).
+*/
+static void ShaderEmu_Move(void)
+{
+    static int move = -1, dx, dy;
+    if (move < 0) {
+        move = 0;
+        if (getenv("TDAWN_MOVE")) {
+            sscanf(getenv("TDAWN_MOVE"), "%d,%d,%d", &move, &dx, &dy);
+        }
+    }
+    if (!move || (int)Frame != move) {
+        return;
+    }
+    int cx = Coord_XCell(Map.TacticalCoord) + Lepton_To_Cell(Map.TacLeptonWidth) / 2 + dx;
+    int cy = Coord_YCell(Map.TacticalCoord) + Lepton_To_Cell(Map.TacLeptonHeight) / 2 + dy;
+    CELL cell = XY_Cell(cx, cy);
+    int count = 0;
+    for (int i = 0; i < Units.Count(); i++) {
+        if (Units.Ptr(i)->Is_Owned_By_Player() && !Units.Ptr(i)->IsInLimbo) {
+            Units.Ptr(i)->Select(true);
+        }
+    }
+    for (int i = 0; i < Infantry.Count(); i++) {
+        if (Infantry.Ptr(i)->Is_Owned_By_Player() && !Infantry.Ptr(i)->IsInLimbo) {
+            Infantry.Ptr(i)->Select(true);
+        }
+    }
+    for (int i = 0; i < CurrentObject.Count(); i++) {
+        CurrentObject[i]->Active_Click_With(ACTION_MOVE, cell);
+        count++;
+    }
+    if (getenv("TDAWN_MOVE_UNSELECT")) {
+        Unselect_All();
+    }
+    fprintf(stderr, "ralert: %d sent to cell %d,%d at frame %d\n", count, cx, cy, (int)Frame);
+}
+
+/*
+** RALERT_ATTACK=N[,E]: from frame N, every E frames (50), the player's units and soldiers are
+** selected, sent at the enemy building nearest them and the view centred on them.
+*/
+static void ShaderEmu_Attack(void)
+{
+    static int from = -1, every = 50;
+    if (from < 0) {
+        from = 0;
+        if (getenv("RALERT_ATTACK")) {
+            sscanf(getenv("RALERT_ATTACK"), "%d,%d", &from, &every);
+        }
+    }
+    if (!from || (int)Frame < from || ((int)Frame - from) % every) {
+        return;
+    }
+    Unselect_All();
+    for (int i = 0; i < Units.Count(); i++) {
+        if (Units.Ptr(i)->Is_Owned_By_Player() && !Units.Ptr(i)->IsInLimbo) {
+            Units.Ptr(i)->Select(true);
+        }
+    }
+    for (int i = 0; i < Infantry.Count(); i++) {
+        if (Infantry.Ptr(i)->Is_Owned_By_Player() && !Infantry.Ptr(i)->IsInLimbo) {
+            Infantry.Ptr(i)->Select(true);
+        }
+    }
+    if (!CurrentObject.Count()) {
+        return;
+    }
+    COORDINATE center = Map.Center_Map();
+    BuildingClass* best = NULL;
+    int nearest = 0, left = 0;
+    for (int i = 0; i < Buildings.Count(); i++) {
+        BuildingClass* b = Buildings.Ptr(i);
+        if (b->IsInLimbo || !b->Strength || b->House->Is_Ally(PlayerPtr) || !b->Class->Cost_Of()) {
+            continue;
+        }
+        left++;
+        int d = Distance(center, b->Center_Coord());
+        if (!best || d < nearest) {
+            best = b, nearest = d;
+        }
+    }
+    for (int i = 0; best && i < CurrentObject.Count(); i++) {
+        CurrentObject[i]->Active_Click_With(ACTION_ATTACK, best);
+    }
+    fprintf(stderr, "ralert: %d sent at %s at frame %d, %d enemy buildings left\n", CurrentObject.Count(),
+            best ? best->Class->IniName : "nothing", (int)Frame, left);
+}
+
+/* TDAWN_SELECT=N, for a test: every N frames the player's units and soldiers are selected. */
+static void ShaderEmu_Select(void)
+{
+    static int select = -1;
+
+    if (select < 0) {
+        select = getenv("TDAWN_SELECT") ? atoi(getenv("TDAWN_SELECT")) : 0;
+    }
+    ShaderEmu_Move();
+    ShaderEmu_Attack();
+    {
+        /* RALERT_WIN=N[,K]: the player wins the mission at frame N, in K missions in a row (1) */
+        static int win = -1, wins = 1;
+        if (win < 0) {
+            win = 0;
+            if (getenv("RALERT_WIN")) {
+                sscanf(getenv("RALERT_WIN"), "%d,%d", &win, &wins);
+            }
+        }
+        if (getenv("RALERT_WIN") && Frame == 1) {
+            ShaderEmu_Stage(Scen.ScenarioName); /* (its memory: a mission after another must not have more) */
+        }
+        if (win && (int)Frame == win && !PlayerPtr->IsToWin) {
+            win = --wins > 0 ? win : 0; /* (then the next mission is played) */
+            PlayerPtr->Flag_To_Win();
+            ShaderEmu_Stage("the mission won");
+        }
+    }
+    if (select && (int)Frame % select == 0) {
+        for (int i = 0; i < Units.Count(); i++) {
+            if (Units.Ptr(i)->Is_Owned_By_Player()) {
+                Units.Ptr(i)->Select(true);
+            }
+        }
+        for (int i = 0; i < Infantry.Count(); i++) {
+            if (Infantry.Ptr(i)->Is_Owned_By_Player()) {
+                Infantry.Ptr(i)->Select(true);
+            }
+        }
+    }
+}
+
+static void ShaderEmu_Stats(void)
+{
+    static int every = -1, cap, stop, frame_then;
+    static unsigned ms_then, cycles_then;
+    unsigned ms = host_ms(), cycles = host_cycles();
+    int frames = (int)Frame - frame_then;
+
+    ShaderEmu_Check_Occupy();
+    if (every < 0) {
+        const char* text = getenv("RALERT_STATS_MS");
+        every = text ? atoi(text) : 5000;
+        text = getenv("RALERT_FRAMES");
+        cap = text ? atoi(text) : 0;
+        text = getenv("RALERT_STOP_FRAME");
+        stop = text ? atoi(text) : 0;
+        ms_then = ms;
+        cycles_then = cycles;
+        frame_then = (int)Frame;
+        ShaderEmu_Logic_Cycles = ShaderEmu_Draw_Cycles = ShaderEmu_Show_Cycles = ShaderEmu_Shows = 0;
+        ShaderEmu_State("begun");
+        return;
+    }
+    {
+        /* RALERT_HUNT=N: at frame N everything the player has goes after the enemy by itself: a
+        ** battle to measure, which a mission left alone never has */
+        static int hunt = -1;
+        if (hunt < 0) {
+            hunt = getenv("RALERT_HUNT") ? atoi(getenv("RALERT_HUNT")) : 0;
+        }
+        if (hunt && (int)Frame == hunt) {
+            for (int i = 0; i < Units.Count(); i++) {
+                if (Units.Ptr(i)->House == PlayerPtr) {
+                    Units.Ptr(i)->Assign_Mission(MISSION_HUNT);
+                }
+            }
+            for (int i = 0; i < Infantry.Count(); i++) {
+                if (Infantry.Ptr(i)->House == PlayerPtr) {
+                    Infantry.Ptr(i)->Assign_Mission(MISSION_HUNT);
+                }
+            }
+        }
+    }
+    {
+        /* RALERT_MARK=A,B: a line as frame A begins and as frame B does (rvc_cpu --pc-from, --until) */
+        static int mark_a = -1, mark_b;
+        if (mark_a < 0) {
+            mark_a = mark_b = 0;
+            if (getenv("RALERT_MARK")) {
+                sscanf(getenv("RALERT_MARK"), "%d,%d", &mark_a, &mark_b);
+            }
+        }
+        if (mark_b && ((int)Frame == mark_a || (int)Frame == mark_b)) {
+            host_workers_mark((int)Frame == mark_b, mark_b - mark_a);
+            fprintf(stderr, "ralert: mark %s\n", (int)Frame == mark_a ? "begins" : "ends");
+        }
+        /* RALERT_FRAME_LOG=1: every frame's instructions (all, logic, drawing, the map and its parts) and what
+        ** the scene drew anew and put into the atlas, said when the run ends */
+        static unsigned (*log)[10], logged, was[10];
+        static int on = -1;
+        unsigned now[10] = {cycles, ShaderEmu_Logic_Cycles, ShaderEmu_Draw_Cycles, ShaderEmu_GL_Cycles,
+                            ShaderEmu_GL_Parts[0], ShaderEmu_GL_Parts[1], ShaderEmu_GL_Parts[2],
+                            ShaderEmu_GL_Objects[2], ShaderEmu_GL_Put[0], ShaderEmu_GL_Put[1]};
+        if (on < 0) {
+            on = getenv("RALERT_FRAME_LOG") != NULL;
+            log = on ? (unsigned (*)[10])calloc(8192, sizeof *log) : NULL;
+        } else if (log && logged < 8192) {
+            for (int i = 0; i < 10; i++) {
+                log[logged][i] = now[i] >= was[i] ? now[i] - was[i] : now[i];
+            }
+            logged++;
+        }
+        memcpy(was, now, sizeof(was));
+        if (log && cap && (int)Frame >= cap) {
+            for (unsigned i = 0; i < logged; i++) {
+                fprintf(stderr, "frame %u: %u %u %u map %u %u %u %u drawn %u put %u %u\n", (unsigned)Frame - logged + i,
+                        log[i][0], log[i][1], log[i][2], log[i][3], log[i][4], log[i][5], log[i][6], log[i][7], log[i][8],
+                        log[i][9]);
+            }
+        }
+    }
+    if (cap || (stop && getenv("RALERT_NO_DELAY"))) {
+        FrameTimer = 0;
+    }
+    if (frames > 0 && ((every && ms - ms_then >= (unsigned)every) || (cap && (int)Frame >= cap))) {
+        unsigned all = (cycles - cycles_then) / frames;
+        unsigned logic = ShaderEmu_Logic_Cycles / frames, draw = ShaderEmu_Draw_Cycles / frames;
+        unsigned show = ShaderEmu_Show_Cycles / frames;
+        unsigned span = ms - ms_then ? ms - ms_then : 1;
+
+        fprintf(stderr,
+                "rastat: frame %d: %d.%d game frames/s, %uk instructions/s; a frame %uk = logic %uk + draw %uk + "
+                "show %uk (%u.%u shows) + rest %uk; %d objects; %u page copies of %u; the map %uk (cells %uk, objects %uk: "
+                "%u kept, %u away, %u drawn; shroud %uk), %u quads (%u shroud, %u shadows), %u shapes put, %u left to the game\n",
+                (int)Frame, frames * 1000 / span, frames * 10000 / span % 10, (cycles - cycles_then) / span, all / 1000,
+                logic / 1000, draw / 1000, show / 1000, ShaderEmu_Shows / frames, ShaderEmu_Shows * 10 / frames % 10,
+                (all - logic - draw - show) / 1000,
+                Units.Count() + Infantry.Count() + Vessels.Count() + Buildings.Count() + Aircraft.Count()
+                    + Bullets.Count() + Anims.Count(),
+                ShaderEmu_Page_Copies, ShaderEmu_Page_Flips, ShaderEmu_GL_Cycles / frames / 1000,
+                ShaderEmu_GL_Parts[0] / frames / 1000, ShaderEmu_GL_Parts[1] / frames / 1000, ShaderEmu_GL_Objects[0] / frames,
+                ShaderEmu_GL_Objects[1] / frames, ShaderEmu_GL_Objects[2] / frames, ShaderEmu_GL_Parts[2] / frames / 1000,
+                ShaderEmu_GL_Quads / frames, ShaderEmu_GL_Shroud / frames, ShaderEmu_GL_Shadows / frames, ShaderEmu_GL_Put[0],
+                ShaderEmu_GL_Refused);
+        host_scene_settle(); /* (the objects' worker adds to these: not while it draws) */
+        ShaderEmu_Page_Copies = ShaderEmu_Page_Flips = 0;
+        ShaderEmu_GL_Quads = ShaderEmu_GL_Shroud = ShaderEmu_GL_Shadows = ShaderEmu_GL_Cycles = ShaderEmu_GL_Refused = 0;
+        ShaderEmu_GL_Parts[0] = ShaderEmu_GL_Parts[1] = ShaderEmu_GL_Parts[2] = ShaderEmu_GL_Put[0] = 0;
+        ShaderEmu_GL_Objects[0] = ShaderEmu_GL_Objects[1] = ShaderEmu_GL_Objects[2] = 0;
+        ms_then = ms;
+        cycles_then = cycles;
+        frame_then = (int)Frame;
+        ShaderEmu_Logic_Cycles = ShaderEmu_Draw_Cycles = ShaderEmu_Show_Cycles = ShaderEmu_Shows = 0;
+    }
+    if (cap && (int)Frame >= cap) {
+        ShaderEmu_State("done");
+        exit(0);
+    }
+    if (stop && (int)Frame >= stop) {
+        /* the picture reaches the window a machine frame after it is shown */
+        Video_Render_Frame();
+        for (int wait = 0; wait < 8; wait++) {
+            host_wait();
+        }
+        ShaderEmu_Picture();
+        ShaderEmu_State("stopped");
+        for (;;) {
+            host_wait();
+        }
+    }
+}

+*/
+unsigned MessageListClass::ShaderEmu_Signature(void)
+{
+    unsigned sum = IsEdit ? 0x9e3779b9u * (unsigned)Frame : 2166136261u;
+
+    for (GadgetClass* gadget = MessageList; gadget; gadget = gadget->Get_Next()) {
+        TextLabelClass* label = (TextLabelClass*)gadget;
+        sum = (sum ^ (unsigned)label->X) * 16777619u;
+        sum = (sum ^ (unsigned)label->Y) * 16777619u;
+        sum = (sum ^ (unsigned)(uintptr_t)label->Color) * 16777619u;
+        sum = (sum ^ (unsigned)label->Style) * 16777619u;
+        for (const char* text = label->Text; text && *text; text++) {
+            sum = (sum ^ (unsigned char)*text) * 16777619u;
+        }
+    }
+    return sum;
+}
+#endif

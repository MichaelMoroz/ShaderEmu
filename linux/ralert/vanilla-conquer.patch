  *=========================================================================*/
+#ifdef SHADEREMU
+/*
+** A unit that steps is lifted and put down again, nearly always in the same region, and the two
+** changes of threat undo each other. A lifting is kept back until what follows it is known;
+** whoever reads threat settles it first (Cell_Threat, and the main loop once a frame).
+*/
+static int held_region = -1, held_threat;
+static HousesType held_house;
+
+static void Threat_To_Houses(int region, HousesType house, int threat_value)
+{
+    for (HousesType lp = HOUSE_FIRST; lp < HOUSE_COUNT; lp++) {
+        if (lp == house)
+            continue;
+
+        HouseClass* house_ptr = HouseClass::As_Pointer(lp);
+        if (house_ptr && (!house_ptr->IsHuman || !house_ptr->Is_Ally(house))) {
+            house_ptr->Adjust_Threat(region, threat_value);
+        }
+    }
+}
+
+void ShaderEmu_Threat_Settle(void)
+{
+    if (held_region >= 0) {
+        int region = held_region;
+        held_region = -1;
+        Threat_To_Houses(region, held_house, held_threat);
+    }
+}
+#endif
+
 void CellClass::Adjust_Threat(HousesType house, int threat_value)
 {
     assert((unsigned)Cell_Number() <= MAP_CELL_TOTAL);
 
     int region = Map.Cell_Region(Cell_Number());
 
+#ifdef SHADEREMU
+    if (held_region == region && held_house == house && held_threat == -threat_value) {
+        held_region = -1;
+        return;
+    }
+    ShaderEmu_Threat_Settle();
+    if (threat_value < 0 && !Debug_Threat) {
+        held_region = region;
+        held_house = house;
+        held_threat = threat_value;
+        return;
+    }
+    Threat_To_Houses(region, house, threat_value);
+#else
     for (HousesType lp = HOUSE_FIRST; lp < HOUSE_COUNT; lp++) {
         if (lp == house)
             continue;
@@ -2091,6 +2155,7 @@ void CellClass::Adjust_Threat(HousesType house, int threat_value)
             house_ptr->Adjust_Threat(region, threat_value);
         }
     }
+#endif
     if (Debug_Threat) {
         Map.Flag_To_Redraw(true);
     }

+/*
+** The tables CCPtr looks its objects up in (ccptr.h): one for each heap that has one, made
+** again whenever the heap's buffer is another. Entry 0 is for the ID that is none.
+*/
+void* ShaderEmu_No_Table[2];
+static struct
+{
+    FixedHeapClass* heap;
+    void*** table;
+} ShaderEmu_Tables[48];
+static int ShaderEmu_Table_Count;
+
+static void ShaderEmu_Table_Fill(FixedHeapClass* heap, void*** table)
+{
+    int count = heap->Length();
+    void** made = (void**)malloc((count + 2) * sizeof(void*));
+
+    if (!made) {
+        return;
+    }
+    made[0] = NULL;
+    for (int i = 0; i <= count; i++) {
+        made[i + 1] = (*heap)[i];
+    }
+    if (*table != ShaderEmu_No_Table) {
+        free(*table);
+    }
+    *table = made;
+}
+
+void ShaderEmu_Heap_Table(FixedHeapClass* heap, void*** table)
+{
+    int i = 0;
+
+    while (i < ShaderEmu_Table_Count && ShaderEmu_Tables[i].table != table) {
+        i++;
+    }
+    if (i == 48) {
+        abort();
+    }
+    ShaderEmu_Tables[i].heap = heap, ShaderEmu_Tables[i].table = table;
+    ShaderEmu_Table_Count += i == ShaderEmu_Table_Count;
+    ShaderEmu_Table_Fill(heap, table);
+}
+
+static void ShaderEmu_Heap_Moved(FixedHeapClass* heap)
+{
+    for (int i = 0; i < ShaderEmu_Table_Count; i++) {
+        if (ShaderEmu_Tables[i].heap == heap) {
+            ShaderEmu_Table_Fill(heap, ShaderEmu_Tables[i].table);
+        }
+    }

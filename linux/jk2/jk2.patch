+		se_dirs[i].dir = dir, se_dirs[i].gen = se_dirs_gen, se_dirs[i].first = se_dir_files;
+		int used = se_dir_used, files = se_dir_files;
+		se_dirs[i].ok = strlen( top ) < sizeof( top ) - 1 && se_dir_walk( top, "", 0 );
+		if ( !se_dirs[i].ok ) {

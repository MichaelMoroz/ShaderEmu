+		se_jpeg_shrink = p->allowPicmip ? ( r_picmip->integer < 3 ? r_picmip->integer : 3 ) : 0;
+		se_jpeg_shrunk = 0;
+		R_LoadImage( p->name, &here, &width, &height );
+		se_jpeg_shrink = 0;
+		shrunk = se_jpeg_shrunk;
+		pic = here;
+	}
+	if ( pic ) {
+		image_t *image = p->image;
+		if ( (width&(width-1)) || (height&(height-1)) ) {
+			Com_Error( ERR_FATAL, "R_CreateImage: %s dimensions (%i x %i) not power of 2!\n", p->name, width, height );

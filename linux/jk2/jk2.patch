+void SE_SlotJoin( int handle );
+int SE_SlotMode( void );		// 0: JK2_PLAYERS=core, 1: on this core, 2: on workers
+void SE_CGRandFor( int number, int time );
+void SE_CGRandEnd( void );
+struct seAbort_t { jmp_buf *jb; int why, unused[2]; } __attribute__(( aligned( 16 ) ));
+extern seAbort_t se_abort[SE_SLOTS + 1];

+#ifdef SHADEREMU
+/*
+==================
+CM_PointContentsGrid (ShaderEmu, docs/games/jk2.md)
+
+CM_PointContents( p, 0 ) & mask of every point origin + step * (x, y, z) of a grid, x < nx, y < ny, z < nz, without
+asking for each: a box of the grid's points goes down the tree whole while it lies on one side of a plane, and in a
+leaf it has one answer when each brush of the mask lies round all of it or apart from all of it. Anything nearer a
+plane than SE_GRID_MARGIN (a hundred times what a float's rounding can move a dot product here) is cut in two, down
+to a single point, which is asked as CM_PointContents asks: so the answers are its own. mark() is called for each
+point whose answer is not 0. (The weather's cache asked 13.5 million points of the demo's level one by one.)
+==================
+*/
+#define SE_GRID_MARGIN 0.25f
+typedef struct {
+	vec3_t origin;
+	float step;
+	int mask;
+	void ( *mark )( void *ctx, int x, int y, int z, int contents );
+	void *ctx;
+} seGrid_t;
+
+static int CM_SE_PointBrushes( const seGrid_t *g, const vec3_t p, const cLeaf_t *leaf )
+{
+	int contents = 0;
+	for ( int k = 0; k < leaf->numLeafBrushes; k++ ) {
+		const cbrush_t *b = &cmg.brushes[cmg.leafbrushes[leaf->firstLeafBrush + k]];
+		int i;
+		if ( !( b->contents & g->mask ) )
+			continue;
+		for ( i = 0; i < b->numsides; i++ )
+			if ( DotProduct( p, b->sides[i].plane->normal ) > b->sides[i].plane->dist )
+				break;
+		if ( i == b->numsides )
+			contents |= b->contents;
+	}
+	return contents & g->mask;
+}
+
+// the least and the most of normal . p - dist over the box
+static void CM_SE_Span( const cplane_t *plane, const vec3_t mins, const vec3_t maxs, float *low, float *high )
+{
+	float lo = -plane->dist, hi = -plane->dist;
+	for ( int i = 0; i < 3; i++ ) {
+		float a = plane->normal[i] * mins[i], b = plane->normal[i] * maxs[i];
+		lo += a < b ? a : b;
+		hi += a < b ? b : a;
+	}
+	*low = lo, *high = hi;
+}
+
+static void CM_SE_Grid_r( const seGrid_t *g, int num, const int lo[3], const int hi[3] )
+{
+	vec3_t mins, maxs;
+	for ( int i = 0; i < 3; i++ ) {
+		mins[i] = g->origin[i] + g->step * lo[i];
+		maxs[i] = g->origin[i] + g->step * ( hi[i] - 1 );
+	}
+	int one = hi[0] - lo[0] == 1 && hi[1] - lo[1] == 1 && hi[2] - lo[2] == 1;
+	if ( one ) {     // a point: as CM_PointContents finds it
+		vec3_t p;
+		for ( int i = 0; i < 3; i++ )
+			p[i] = g->origin[i] + g->step * lo[i];
+		int leafnum = CM_PointLeafnum_r( p, num, &cmg );
+		int contents = CM_SE_PointBrushes( g, p, &cmg.leafs[leafnum] );
+		if ( contents )
+			g->mark( g->ctx, lo[0], lo[1], lo[2], contents );
+		return;
+	}
+	int whole = 1, contents = 0;
+	while ( num >= 0 ) {
+		const cNode_t *node = cmg.nodes + num;
+		float low, high;
+		CM_SE_Span( node->plane, mins, maxs, &low, &high );
+		if ( low > SE_GRID_MARGIN )
+			num = node->children[0];
+		else if ( high < -SE_GRID_MARGIN )
+			num = node->children[1];
+		else {
+			whole = 0;
+			break;
+		}
+	}
+	if ( whole ) {
+		const cLeaf_t *leaf = &cmg.leafs[-1 - num];
+		for ( int k = 0; k < leaf->numLeafBrushes && whole; k++ ) {
+			const cbrush_t *b = &cmg.brushes[cmg.leafbrushes[leaf->firstLeafBrush + k]];
+			if ( !( b->contents & g->mask ) )
+				continue;
+			int inside = 1, apart = 0;
+			for ( int i = 0; i < b->numsides; i++ ) {
+				float low, high;
+				CM_SE_Span( b->sides[i].plane, mins, maxs, &low, &high );
+				if ( low > SE_GRID_MARGIN ) {
+					apart = 1;
+					break;
+				}
+				if ( high >= -SE_GRID_MARGIN )
+					inside = 0;
+			}
+			if ( apart )
+				continue;
+			if ( inside )
+				contents |= b->contents;
+			else
+				whole = 0;
+		}
+	}
+	if ( whole ) {
+		contents &= g->mask;
+		if ( contents )
+			for ( int z = lo[2]; z < hi[2]; z++ )
+				for ( int y = lo[1]; y < hi[1]; y++ )
+					for ( int x = lo[0]; x < hi[0]; x++ )
+						g->mark( g->ctx, x, y, z, contents );
+		return;
+	}
+	// in two along the longest side (num: the node where the box crossed a plane; above it both halves go the same way)
+	int axis = 0;
+	for ( int i = 1; i < 3; i++ )
+		if ( hi[i] - lo[i] > hi[axis] - lo[axis] )
+			axis = i;
+	int mid = ( lo[axis] + hi[axis] ) / 2, lo2[3] = { lo[0], lo[1], lo[2] }, hi1[3] = { hi[0], hi[1], hi[2] };
+	hi1[axis] = mid, lo2[axis] = mid;
+	if ( num < 0 )
+		num = 0;     // (a leaf with a brush across the box: from the top again, as the halves may lie in other leaves)
+	CM_SE_Grid_r( g, num, lo, hi1 );
+	CM_SE_Grid_r( g, num, lo2, hi );
+}
 
+void CM_PointContentsGrid( const vec3_t origin, float step, int nx, int ny, int nz, int mask,
+	void ( *mark )( void *ctx, int x, int y, int z, int contents ), void *ctx )
+{
+	seGrid_t g;
+	int lo[3] = { 0, 0, 0 }, hi[3] = { nx, ny, nz };
+	if ( !cmg.numNodes || nx <= 0 || ny <= 0 || nz <= 0 )
+		return;
+	VectorCopy( origin, g.origin );
+	g.step = step, g.mask = mask, g.mark = mark, g.ctx = ctx;
+	CM_SE_Grid_r( &g, 0, lo, hi );
+}
+#endif

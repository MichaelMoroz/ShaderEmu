+{
+	if ( n < 4 ) {
+		return 0;
+	}
+	if ( d[0] != 0xff || d[1] != 0xd8 ) {
+		return 1;
+	}
+	for ( int i = 2; i + 9 < n; ) {
+		if ( d[i] != 0xff ) {
+			return 1;
+		}
+		int m = d[i + 1];
+		if ( m == 0xff ) {
+			i++;
+			continue;
+		}
+		int length = d[i + 2] << 8 | d[i + 3];
+		if ( m == 0xc0 || m == 0xc1 ) {
+			return 1;
+		}
+		if ( ( m >= 0xc2 && m <= 0xcf && m != 0xc4 && m != 0xc8 && m != 0xcc ) || m == 0xd9 || m == 0xda || length < 2 ) {
+			return 1;
+		}
+		i += 2 + length;
+	}
+	return 0;
+}

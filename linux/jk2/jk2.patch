+					( p->image->mipmap ? 1 : 0 ) | ( glConfig.textureCompression == TC_NONE ? 2 : 0 ) );
+			}
+			if ( p->given && SE_PictureReady( p->given ) ) {
+				se_upload( p, SE_PictureJoin( p->given ) );
+				se_pending[i] = se_pending[--se_pending_count];
+				progress = qtrue;
+				continue;
+			}
+			i++;
+		}
+		if ( !all || !se_pending_count ) {
+			return;
+		}
+		if ( !progress ) {	// the first given waited for; none given (no worker free: the music's take some): a pass
+			int i = 0;	// rested for one, and after 4,096 passes the first made here
+			while ( i < se_pending_count && !se_pending[i].given ) {
+				i++;
+			}
+			if ( i == se_pending_count && rests++ < 4096 ) {
+				SE_PicturesRest();
+				continue;
+			}
+			se_pending_t *p = &se_pending[i < se_pending_count ? i : 0];
+			se_upload( p, p->given ? SE_PictureJoin( p->given ) : 2 );
+			se_pending[p - se_pending] = se_pending[--se_pending_count];
+		}
+	}
+}

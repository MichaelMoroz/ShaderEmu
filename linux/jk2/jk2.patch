+// A JPEG's size, where its first bytes say it: a baseline or extended frame of 1 or 3 components
+static qboolean se_jpeg_size( const byte *d, int n, int *width, int *height )
+{
+	if ( n < 4 || d[0] != 0xff || d[1] != 0xd8 ) {
+		return qfalse;
+	}
+	for ( int i = 2; i + 9 < n; ) {
+		if ( d[i] != 0xff ) {
+			return qfalse;
+		}
+		int m = d[i + 1];
+		if ( m == 0xff ) {
+			i++;
+			continue;
+		}
+		int length = d[i + 2] << 8 | d[i + 3];
+		if ( m == 0xc0 || m == 0xc1 ) {
+			*height = d[i + 5] << 8 | d[i + 6];
+			*width = d[i + 7] << 8 | d[i + 8];
+			return (qboolean)( ( d[i + 9] == 1 || d[i + 9] == 3 ) && *width > 0 && *height > 0 );
+		}
+		if ( ( m >= 0xc2 && m <= 0xcf && m != 0xc4 && m != 0xc8 && m != 0xcc ) || m == 0xd9 || m == 0xda || length < 2 ) {
+			return qfalse;	// (progressive, lossless, arithmetic: libjpeg's)
+		}
+		i += 2 + length;
+	}
+	return qfalse;
+}

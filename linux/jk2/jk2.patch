+// ShaderEmu: which job slot this core is in (docs/games/jk2.md, "The players on workers"). 0: the first core, and any
+// core not running a job of the client game's; 1 to SE_SLOTS: a job of the client game's (a player's CG_AddCEntity on a
+// worker core, codeJK2/cgame/cg_ents.cpp), told by the stack it runs on (sys_shaderemu.cpp's se_slot_stacks, one a
+// slot). What such a job writes that is not its own entity's is kept a slot (statics indexed by SE_Slot()) or recorded
+// and done by the first core in the order of the entities; what it cannot do so (an allocation, a print, an effect, an
+// entity spawned...) ends the job with SE_SlotAbort(), its entity put back as it was, and the first core makes that
+// entity itself in its turn. The first core records too while it makes a player ahead (SE_Recording()).
+#pragma once
+#include <stdint.h>
+#define SE_SLOTS 8
+#define SE_SLOT_STACK ( 128 * 1024 )
+#ifdef __cplusplus
+extern "C" {
+#endif
+extern unsigned char se_slot_stacks[];
+extern int se_recording0;		// the first core makes a player ahead: what it records goes to that player's list
+void SE_SlotAbort( int why ) __attribute__(( noreturn ));
+int SE_OnFirstCore( void );	// not a worker, nor the drawing's own stack
+#ifdef __cplusplus
+}
+#endif
+static inline int SE_Slot( void )
+{
+	unsigned char here;
+	const uint32_t d = (uint32_t)( (uintptr_t)&here - (uintptr_t)se_slot_stacks );
+	return d < (uint32_t)( SE_SLOTS * SE_SLOT_STACK ) ? 1 + (int)( d / SE_SLOT_STACK ) : 0;
+}
+// whether this core makes a player ahead (a job, or the first core recording): then nothing that cannot be recorded
+static inline int SE_Recording( void ) { return SE_Slot() || ( se_recording0 && SE_OnFirstCore() ); }
+// what a player made ahead must not do: the job ends, and the first core makes the player in its turn
+#define SE_NOT_AHEAD( why ) do { if ( SE_Recording() ) SE_SlotAbort( why ); } while ( 0 )
+enum {		// why a player was not made ahead (JK2_PLAYERS_LOG counts them)
+	SE_WHY_MALLOC = 1, SE_WHY_PRINT, SE_WHY_CALL, SE_WHY_FX, SE_WHY_LOCAL, SE_WHY_MARK, SE_WHY_CAMERA, SE_WHY_SPAWN,
+	SE_WHY_TASK, SE_WHY_EVENT, SE_WHY_SABER, SE_WHY_CHAIR, SE_WHY_RAND, SE_WHY_BOX, SE_WHY_SUBBSP, SE_WHY_FULL,
+	SE_WHY_LOOKUP, SE_WHY_TRACE, SE_WHY_SET, SE_WHY_CMD, SE_WHY_MARKS, SE_WHY_COUNT
+};

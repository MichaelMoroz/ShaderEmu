+static unsigned se_dir_hash( const char *name, int *dir )
+{
+	const char *slash = strrchr( name, '/' );
+	unsigned h = 0;
+	*dir = slash ? (int)( slash - name ) + 1 : 0;
+	for ( int i = 0; i < *dir; i++ ) {
+		h = h * 31 + (unsigned)tolower( (unsigned char)name[i] );
+	}
+	return h & ( SE_DIR_HASH - 1 );

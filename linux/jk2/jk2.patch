+	for ( int h = 1; h < MAX_FILE_HANDLES; h++ ) {
+		if ( fsh[h].handleFiles.file.z == pak->handle && fsh[h].zipFile == qtrue && fsh[h].handleFiles.file.o ) {
+			if ( getenv( "JK2_AHEAD_LOG" ) ) Com_Printf( "jk2ahead: %s: handle %d open (%s)\n", f->name, h, fsh[h].name );
+			return;	// (another file of the pak open on its handle: its place in the pak is kept)
+		}
+	}

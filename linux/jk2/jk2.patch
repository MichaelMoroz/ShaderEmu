+		const char *e = getenv( "JK2_PICTURES_BIND" );
+		on = !e || atoi( e ) != 0;
+	}
+	return on;
+}
+void R_SE_PictureNeeded( image_t *image )
+{
+	if ( se_uploading ) {
+		return;
+	}
+	for ( int i = 0; i < se_pending_count; i++ ) {
+		se_pending_t *p = &se_pending[i];
+		if ( p->image != image ) {
+			continue;
+		}
+		if ( !p->given ) {
+			p->given = SE_PictureGive( p->raw, p->raw_len, p->method, p->plain, p->len, p->kind, p->shrink, p->rgba,
+				p->width, p->height, se_halvings( p, p->kind == 1 ? p->shrink : 0 ),
+				( p->image->mipmap ? 1 : 0 ) | ( glConfig.textureCompression == TC_NONE ? 2 : 0 ) );
+		}
+		int tmu = glState.currenttmu;
+		se_upload( p, p->given ? SE_PictureJoin( p->given ) : 2 );
+		se_pending[i] = se_pending[--se_pending_count];
+		if ( qglActiveTextureARB && glState.currenttmu != tmu ) {
+			GL_SelectTexture( tmu );
+		}
+		return;
+	}
+}
+
+void R_SE_PicturesFinish( void )
+{
+	if ( se_pending_count ) {
+		se_pump( qtrue );
+	}
+}

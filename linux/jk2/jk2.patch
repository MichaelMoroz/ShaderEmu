+		if ( ( len = FS_SE_ReadRaw( file, &raw, &raw_len, &method ) ) != -1 ) {
+			break;
+		}
+	}
+	if ( !file ) {
+		*missing = qtrue;
+		return NULL;
+	}
+	if ( len < 0 ) {
+		return NULL;
+	}

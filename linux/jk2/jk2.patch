+	}
+	return on;
+}
+
+static se_pak_t *se_seen_of( pack_t *pak )
+{
+	int i;
+	if ( se_seen.pak == pak ) {
+		return &se_seen;
+	}
+	if ( se_seen.pak || pak->numfiles > SE_PAK_FILES ) {
+		return NULL;
+	}
+	se_pak_t *s = &se_seen;
+	s->seen = se_seen_bytes, s->head = se_dir_head, s->next = se_dir_next;
+	memset( s->seen, 0, pak->numfiles );
+	for ( i = 0; i < SE_DIR_HASH; i++ ) {
+		s->head[i] = -1;
+	}
+	for ( i = pak->numfiles - 1; i >= 0; i-- ) {	// (each chain in the pak's order)
+		int dir;
+		unsigned h = se_dir_hash( pak->buildBuffer[i].name, &dir );
+		s->next[i] = s->head[h];
+		s->head[h] = i;
+	}
+	s->pak = pak;
+	return s;
+}
+
+static se_pak_t *se_seen_of( pack_t *pak );
+
+// Room for a file read ahead in the arena: the lowest gap between the table's files
+static byte se_arena[SE_AHEAD_BYTES] __attribute__((aligned(16)));
+static byte *se_arena_take( unsigned bytes )
+{
+	unsigned at = 0;
+	for ( qboolean moved = qtrue; moved; ) {
+		moved = qfalse;
+		for ( int k = 0; k < se_ahead_count; k++ ) {
+			unsigned from = (unsigned)( se_ahead[k].buf - se_arena ), to = from + ( ( (unsigned)se_ahead[k].len + 15 ) & ~15u );
+			if ( from < at + bytes && to > at ) {
+				at = to, moved = qtrue;
+			}
+		}
+	}
+	return at + bytes <= SE_AHEAD_BYTES ? se_arena + at : NULL;
+}
+
+// Entry k of the table waited for and let go (unread: it may be read ahead again)
+static void se_ahead_drop( int k )
+{
+	if ( se_ahead[k].given ) {
+		se_pak_t *sp = se_seen_of( se_ahead[k].pak );
+		if ( sp ) {
+			sp->seen[se_ahead[k].f - se_ahead[k].pak->buildBuffer] = 0;
+		}
+	}
+	SE_FileJoin( se_ahead[k].given );
+	se_ahead_bytes -= ( (unsigned)se_ahead[k].len + 15 ) & ~15u;
+	memmove( &se_ahead[k], &se_ahead[k + 1], ( se_ahead_count - k - 1 ) * sizeof( se_ahead[0] ) );
+	se_ahead_count--;
+}
+
+// A pak let go: what was read ahead of it, and what of it was seen
+static void se_ahead_forget( pack_t *pak )
+{
+	for ( int k = se_ahead_count - 1; k >= 0; k-- ) {
+		if ( se_ahead[k].pak == pak ) {
+			SE_FileJoin( se_ahead[k].given );
+			se_ahead[k].given = 0;
+			se_ahead_drop( k );
+		}
+	}
+	if ( se_seen.pak == pak ) {
+		se_seen.pak = NULL;
+	}
+}
+
+
+// The file f of a pak into buf when it was read ahead (qtrue)
+static qboolean se_ahead_take( fileInPack_t *f, byte *buf, long len )
+{
+	for ( int k = 0; k < se_ahead_count; k++ ) {
+		if ( se_ahead[k].f == f ) {
+			qboolean ok = SE_FileJoin( se_ahead[k].given ) == 1 && se_ahead[k].len == len ? qtrue : qfalse;
+			if ( ok ) {
+				memcpy( buf, se_ahead[k].buf, len );
+			}
+			se_ahead[k].given = 0;
+			se_ahead_drop( k );
+			return ok;
+		}
+	}
+	return qfalse;
+}

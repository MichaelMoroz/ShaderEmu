+}
+static void se_prepared_size( int halvings, int *width, int *height )
+{
+	for ( int i = 0; i < halvings; i++ ) {
+		*width = *width >> 1 > 0 ? *width >> 1 : 1;
+		*height = *height >> 1 > 0 ? *height >> 1 : 1;
+	}
+	while ( *width > glConfig.maxTextureSize || *height > glConfig.maxTextureSize ) {
+		*width >>= 1;
+		*height >>= 1;
+	}
+}

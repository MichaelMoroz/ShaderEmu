+#define SE_PLAYERS 32
+#define SE_PLAYER_REC ( 12 * 1024 )
+struct sePlayer_t {
+	centity_t *cent;
+	int num, wave, slot, handle;	// (the first core's)
+	int look, unused[3];	// look: the player it waits for, or -1
+	struct { int state, why, bytes, ran; } __attribute__(( aligned( 16 ) )) out;	// ran: its instructions (JK2_PLAYERS_LOG)	// (the maker's) state: 0 not yet, 1 made ahead (to replay), 2 to make in its turn
+	__attribute__(( aligned( 16 ) )) centity_t cent_was;
+	gentity_t gent_was;
+	gclient_t client_was;
+	unsigned char rec[SE_PLAYER_REC];
+} __attribute__(( aligned( 16 ) ));
+static sePlayer_t se_players[SE_PLAYERS];

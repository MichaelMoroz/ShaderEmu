+	}
+	int dir;
+	unsigned hash = se_dir_hash( f->name, &dir );
+	static char last[MAX_QPATH];	// (the file read before)
+	qboolean run = !Q_stricmpn( last, f->name, dir ) && !strchr( last + dir, '/' ) && strrchr( last, '.' ) &&
+		!Q_stricmp( strrchr( last, '.' ), dot ) ? qtrue : qfalse;

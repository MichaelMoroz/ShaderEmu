+// leaves the surfaces lie in, against the view's cluster's PVS; a surface no leaf names, or no vis, counts as seen.
+static const world_t *se_pw;
+static int se_pn, se_pall, se_pclusters[32];
+int R_SE_PortalMaybeSeen( const vec3_t origin )
+{
+	if ( se_pw != tr.world ) {
+		se_pw = tr.world, se_pn = 0, se_pall = 0;
+		const msurface_t *found[32];
+		int nfound = 0, total = 0;
+		for ( int i = 0 ; i < tr.world->numsurfaces ; i++ )
+			if ( tr.world->surfaces[i].shader && tr.world->surfaces[i].shader->sort <= SS_PORTAL )
+				total++;
+		for ( int n = 0 ; n < tr.world->numnodes && !se_pall ; n++ ) {
+			const mnode_t *leaf = &tr.world->nodes[n];
+			if ( leaf->contents == -1 )
+				continue;
+			for ( int m = 0 ; m < leaf->nummarksurfaces ; m++ ) {
+				const msurface_t *surf = leaf->firstmarksurface[m];
+				if ( !surf->shader || surf->shader->sort > SS_PORTAL )
+					continue;
+				int k;
+				for ( k = 0 ; k < nfound && found[k] != surf ; k++ ) {}
+				if ( k == nfound ) {
+					if ( nfound == 32 ) { se_pall = 1; break; }
+					found[nfound++] = surf;
+				}
+				if ( leaf->cluster < 0 ) { se_pall = 1; break; }
+				for ( k = 0 ; k < se_pn && se_pclusters[k] != leaf->cluster ; k++ ) {}
+				if ( k == se_pn ) {
+					if ( se_pn == 32 ) { se_pall = 1; break; }
+					se_pclusters[se_pn++] = leaf->cluster;
+				}
+			}
+		}
+		if ( nfound < total )
+			se_pall = 1;
+	}
+	if ( se_pall || r_novis->integer || !tr.world->vis )
+		return 1;
+	const mnode_t *leaf = R_PointInLeaf( (float *)origin );
+	if ( leaf->cluster < 0 )
+		return 1;
+	const byte *vis = R_ClusterPVS( leaf->cluster );
+	for ( int k = 0 ; k < se_pn ; k++ )
+		if ( vis[se_pclusters[k] >> 3] & ( 1 << ( se_pclusters[k] & 7 ) ) )
+			return 1;
+	return 0;
+}
+#endif
+

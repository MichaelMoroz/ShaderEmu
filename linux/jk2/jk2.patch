+// f of pak just read (its handle closed): its neighbours of the same folder and extension read ahead
+static void se_ahead_more( pack_t *pak, fileInPack_t *f )
+{
+	se_pak_t *sp = se_seen_of( pak );
+	int i = (int)( f - pak->buildBuffer );
+	if ( !sp || i < 0 || i >= pak->numfiles ) {

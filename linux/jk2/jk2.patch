+unsigned long long SE_Instructions( void );
+static void se_player_run( void *arg )
+{
+	sePlayer_t *p = (sePlayer_t *)arg;
+	const int slot = SE_Slot();
+	const unsigned se_t0 = (unsigned)SE_Instructions();
+	centity_t *cent = p->cent;
+	memcpy( &p->cent_was, cent, sizeof( centity_t ) );
+	memcpy( &p->gent_was, cent->gent, sizeof( gentity_t ) );
+	if ( cent->gent->client )
+		memcpy( &p->client_was, cent->gent->client, sizeof( gclient_t ) );
+	jmp_buf jb;
+	if ( setjmp( jb ) ) {
+		// (ended: put back as it was, made in its turn)
+		se_abort[slot].jb = NULL;
+		SE_RecEnd();
+		SE_CGRandEnd();
+		memcpy( cent, &p->cent_was, sizeof( centity_t ) );
+		gclient_t *client = cent->gent->client;
+		memcpy( cent->gent, &p->gent_was, sizeof( gentity_t ) );
+		if ( client )
+			memcpy( client, &p->client_was, sizeof( gclient_t ) );
+		p->out.why = se_abort[slot].why;
+		p->out.ran = (int)( (unsigned)SE_Instructions() - se_t0 );
+		p->out.state = 2;
+		return;
+	}
+	se_abort[slot].jb = &jb;
+	SE_RecBegin( p->rec, SE_PLAYER_REC );
+	CG_AddCEntity( cent );
+	p->out.bytes = SE_RecEnd();
+	se_abort[slot].jb = NULL;
+	p->out.ran = (int)( (unsigned)SE_Instructions() - se_t0 );
+	p->out.state = 1;
+}
+
+// What a player reads of the one it looks at (cg_players.cpp's CG_CheckLookTarget): its eye, or its place when it is not
+// a client, as that entity's turn has left it
+const float *CG_SE_LookPoint( const centity_t *cent, const centity_t *look, qboolean eye )
+{
+	const int n = look->currentState.number, me = cent->currentState.number;
+	if ( se_ahead_frame == cg.time && se_order_frame == cg.time && se_look[n].frame == cg.time &&
+		 se_order[n] >= 0 && se_order[me] >= 0 && se_order[n] > se_order[me] )
+		return eye ? se_look[n].eye : se_look[n].lerp;	// (its turn comes after this one's: the frame before's)
+	return eye ? look->gent->client->renderInfo.eyePoint : look->lerpOrigin;
+}
+
+static void CG_SE_PlayersAhead( void )
+{
+	const int mode = SE_SlotMode();
+	se_nplayers = 0;
+	se_ahead_frame = cg.time;
+	se_order_frame = cg.time;
+	for ( int i = 0; i < MAX_GENTITIES; i++ )
+		se_order[i] = -1;
+	for ( int num = 0 ; num < cg.snap->numEntities ; num++ ) {
+		centity_t *cent = &cg_entities[ cg.snap->entities[ num ].number ];
+		se_order[cent->currentState.number] = (short)num;
+		if ( cent->currentState.eType != ET_PLAYER || !cent->gent || !cent->gent->client || se_nplayers >= SE_PLAYERS )
+			continue;
+		sePlayer_t *p = &se_players[se_nplayers++];
+		p->cent = cent, p->num = num, p->out.state = 0, p->out.why = 0, p->out.bytes = 0, p->look = -1, p->wave = 0, p->handle = 0;
+	}
+	// what a player made after another reads of it is the frame before's: kept first
+	for ( int i = 0; i < se_nplayers; i++ ) {
+		centity_t *cent = se_players[i].cent;
+		seLook_t *l = &se_look[cent->currentState.number];
+		VectorCopy( cent->gent->client->renderInfo.eyePoint, l->eye );
+		VectorCopy( cent->lerpOrigin, l->lerp );
+		l->frame = cg.time;
+	}
+	for ( int i = 0; i < se_nplayers; i++ ) {
+		sePlayer_t *p = &se_players[i];
+		const renderInfo_t *ri = &p->cent->gent->client->renderInfo;
+		if ( ri->lookMode != LM_ENT || ri->lookTarget < 0 || ri->lookTarget >= ENTITYNUM_WORLD )
+			continue;
+		centity_t *look = &cg_entities[ri->lookTarget];
+		const int at = se_order[ri->lookTarget];
+		if ( !look->gent || at < 0 )
+			continue;
+		// (a look at the player in the first person is at cg.refdef's eye, made before the entities: CG_PlayerHeadExtension
+		// reads nothing of the player's turn then, so this player waits for none; JK2_PLAYERS_WAVE=all: it does)
+		static int wave_all = -1;
+		if ( wave_all < 0 ) {
+			const char *e = getenv( "JK2_PLAYERS_WAVE" );
+			wave_all = e && !strcmp( e, "all" );
+		}
+		if ( !wave_all && ri->lookTarget == 0 && !cg.renderingThirdPerson )
+			continue;
+		if ( !look->gent->client ) {
+			// (an entity placed in its turn before this player's: placed now, as again in its turn; one after: the
+			// frame before's, kept)
+			seLook_t *l = &se_look[ri->lookTarget];
+			if ( l->frame != cg.time ) {
+				VectorCopy( look->lerpOrigin, l->lerp );
+				VectorClear( l->eye );
+				l->frame = cg.time;
+			}
+			if ( at < p->num && look->currentState.eType < ET_EVENTS )
+				CG_CalcEntityLerpPositions( look );
+			continue;
+		}
+		for ( int k = 0; k < i; k++ )
+			if ( se_players[k].cent == look ) {
+				p->look = k;
+				p->wave = se_players[k].wave + 1;
+			}
+	}
+	// the waves: a player after the one it waits for, on workers while there are free ones, else here
+	for ( int wave = 0; ; wave++ ) {
+		int any = 0, slot = 0;
+		for ( int i = 0; i < se_nplayers; i++ ) {
+			sePlayer_t *p = &se_players[i];
+			if ( p->wave != wave )
+				continue;
+			any = 1;
+			if ( p->look >= 0 && se_players[p->look].out.state != 1 ) {
+				p->out.state = 2;	// (the one it waits for is made in its turn: so is this one)
+				se_counts[3]++;
+				continue;
+			}
+			if ( mode == 2 && slot < SE_SLOTS && ( p->handle = SE_SlotGive( slot + 1, se_player_run, p ) ) ) {
+				p->slot = ++slot;
+				se_counts[2]++;
+				continue;
+			}
+			p->slot = 0;
+			se_recording0 = 1;
+			se_player_run( p );
+			se_recording0 = 0;
+		}
+		for ( int i = 0; i < se_nplayers; i++ )
+			if ( se_players[i].wave == wave && se_players[i].handle ) {
+				SE_SlotJoin( se_players[i].handle );
+				se_players[i].handle = 0;
+			}
+		if ( !any )
+			break;
+	}
+	{
+		unsigned longest = 0, all = 0, wl[SE_PLAYERS] = { 0 };
+		int waves = 0;
+		for ( int i = 0; i < se_nplayers; i++ ) {
+			const unsigned r = (unsigned)se_players[i].out.ran;
+			all += r;
+			if ( r > longest )
+				longest = r;
+			const int w = se_players[i].wave;
+			if ( w >= 0 && w < SE_PLAYERS && r > wl[w] )
+				wl[w] = r;
+			if ( w + 1 > waves )
+				waves = w + 1;
+		}
+		se_ran[0] += longest, se_ran[1] += all, se_ran[2]++;
+		for ( int w = 0; w < waves && w < SE_PLAYERS; w++ )
+			se_ran[3] += wl[w];
+		se_ran[4] += waves;
+	}
+	for ( int i = 0; i < se_nplayers; i++ ) {
+		se_counts[0]++;
+		if ( se_players[i].out.state == 1 )
+			se_counts[1]++;
+		else if ( se_players[i].out.why > 0 && se_players[i].out.why < SE_WHY_COUNT )
+			se_counts[4 + se_players[i].out.why]++;
+	}
+	static int every = -1;
+	if ( every < 0 ) {
+		const char *e = getenv( "JK2_PLAYERS_LOG" );
+		every = e && *e ? atoi( e ) : 0;
+	}
+	if ( every > 0 && ++se_frames_logged % every == 0 ) {
+		char why[256] = "";
+		static const char *names[SE_WHY_COUNT] = { "", "malloc", "print", "call", "fx", "local", "mark", "camera", "spawn",
+			"task", "event", "saber", "chair", "rand", "box", "subbsp", "full", "lookup", "trace", "set", "cmd", "marks" };
+		for ( int k = 1; k < SE_WHY_COUNT; k++ )
+			if ( se_counts[4 + k] )
+				Q_strcat( why, sizeof why, va( " %s %u", names[k], se_counts[4 + k] ) );
+		Com_Printf( "jk2players: %u players, %u made ahead, %u on workers, %u waited on one in its turn; in its turn:%s; "
+			"a frame the longest %uk, all %uk, the waves' longest %uk in %u.%02u waves\n", se_counts[0], se_counts[1], se_counts[2], se_counts[3], why,
+			se_ran[2] ? (unsigned)( se_ran[0] / se_ran[2] / 1000 ) : 0, se_ran[2] ? (unsigned)( se_ran[1] / se_ran[2] / 1000 ) : 0,
+			se_ran[2] ? (unsigned)( se_ran[3] / se_ran[2] / 1000 ) : 0, se_ran[2] ? (unsigned)( se_ran[4] / se_ran[2] ) : 0,
+			se_ran[2] ? (unsigned)( se_ran[4] * 100 / se_ran[2] % 100 ) : 0 );
+		se_ran[0] = se_ran[1] = se_ran[2] = se_ran[3] = se_ran[4] = 0;
+		memset( se_counts, 0, sizeof se_counts );
+	}
+}
+
+// whether this entity was made ahead this frame (then its record is replayed)
+static sePlayer_t *CG_SE_MadeAhead( centity_t *cent, int num )

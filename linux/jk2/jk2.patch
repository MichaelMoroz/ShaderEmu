+		SE_PictureHead( raw, raw_len, method, len, se_head, kind == 2 ? 32 : 4096 );
+	int width = 0, height = 0, shrink = 0;
+	if ( kind == 1 ) {
+		shrink = allowPicmip ? ( r_picmip->integer < 3 ? r_picmip->integer : 3 ) : 0;
+		shrink = shrink > 0 ? shrink : 0;
+		qboolean sized = se_jpeg_size( head, got, &width, &height );
+		if ( !sized && method != 0 && se_head && got == 4096 ) {

+#ifdef SHADEREMU
+// (ShaderEmu: C_MP3_GetUnpackedSize's count made from the frames' headers alone, for an MPEG-1 layer III file of a
+// bitrate in its first header: the decoder's walk (towave.c, L3audio_decode_MPEG1 with bFastEstimateOnly) parses each
+// frame's side information to add a constant; it was 132 million instructions of the load's sounds. The same stops: fewer
+// bytes left than the first frame's, a sync lost, a frame past the data or of a size the decoder refuses. Any other file
+// is the decoder's; JK2_MP3_CHECK=1 counts both ways and says where they differ. docs/games/jk2.md, "The load")
+static qboolean se_mp3_count( const byte *f, int iDataLen, qboolean bStereoDesired, int *piUnpackedSize )
+{
+	static const int sr20[2][4] = { { 441, 480, 320, -999 }, { 882, 960, 640, -999 } };
+	static const int brL3[2][16] = { { 0, 8, 16, 24, 32, 40, 48, 56, 64, 80, 96, 112, 128, 144, 160, 0 },
+					 { 0, 32, 40, 48, 56, 64, 80, 96, 112, 128, 160, 192, 224, 256, 320, 0 } };
+	unsigned int n = (unsigned int)iDataLen / 2, at = 0;
+	// (head_info3: the first 0xFF of a sync in the file's first half)
+	while ( at < n && !( f[at] == 0xFF && ( ( f[at + 1] & 0xF0 ) == 0xF0 || ( f[at + 1] & 0xF0 ) == 0xE0 ) ) )
+		at++;
+	if ( at == n || at + 4 > (unsigned int)iDataLen || ( f[at + 1] & 0xF0 ) != 0xF0 )
+		return qfalse;
+	int id = ( f[at + 1] >> 3 ) & 1, layer = ( f[at + 1] >> 1 ) & 3, br = f[at + 2] >> 4, sr = ( f[at + 2] >> 2 ) & 3;
+	int mode = f[at + 3] >> 6;
+	if ( id != 1 || layer != 1 || br == 0 || br == 15 || sr == 3 )
+		return qfalse;	// (layer III of MPEG-1 at a bitrate of its header: the rest is the decoder's)
+	int first = 2880 * brL3[1][br] / sr20[1][sr];	// (head_info's frame size, iFrameBytes)
+	int out_chans = ( mode == 3 || !bStereoDesired ) ? 1 : 2;
+	int outbytes = 2 * 1152 * out_chans;
+	int remaining = iDataLen;
+	if ( remaining >= 128 && !strncmp( (const char *)f + remaining - 128, "TAG", 3 ) )
+		remaining -= 128;	// (BYTESREMAINING_ACCOUNT_FOR_REAR_TAG)
+	remaining -= (int)at;
+	int limit = (int)at + remaining, framebytes = first, made = 0;
+	for ( ;; ) {
+		if ( remaining == 0 || remaining < first )
+			break;
+		const byte *b = f + at;
+		if ( (int)at + 4 > iDataLen || b[0] != 0xFF || ( b[1] & 0xF0 ) != 0xF0 )
+			break;	// (sync lost: in_bytes 0)
+		int fid = ( b[1] >> 3 ) & 1, prot = b[1] & 1, fbr = b[2] >> 4, fsr = ( b[2] >> 2 ) & 3, pad = ( b[2] >> 1 ) & 1;
+		int fmode = b[3] >> 6;
+		if ( fsr == 3 )
+			return qfalse;	// (the decoder's table has no such rate: the decoder's)
+		if ( fbr > 0 )
+			framebytes = 2880 * brL3[fid][fbr] / sr20[fid][fsr];
+		int padframebytes = framebytes + pad;
+		if ( (int)at + padframebytes > limit )
+			break;
+		int nbytes = padframebytes - ( fmode == 3 ? 4 + 17 : 4 + 32 ) - ( prot ? 0 : 2 );
+		if ( nbytes < 0 || nbytes > 8 * 1024 || padframebytes <= 0 )

+// (the drawing's worker, or this core drawing the frame itself: the view made and drawn)
+const void *R_SE_FrontView( const void *data )
+{
+	const seViewCommand_t *cmd = (const seViewCommand_t *)data;
+	tr.refdef = cmd->refdef;
+	tr.viewParms = cmd->viewParms;
+	tr.viewCount = cmd->viewCount;
+	tr.ori = tr.viewParms.world;	// (as R_RotateForViewer leaves it: the world's faces are culled by tr.ori's eye)
+	int n = cmd->count > MAX_DRAWSURFS ? MAX_DRAWSURFS : cmd->count;
+	if ( n > 0 )
+		memcpy( se_front_surfs, cmd->refdef.drawSurfs + cmd->first, n * sizeof( drawSurf_t ) );
+	tr.refdef.drawSurfs = se_front_surfs;
+	tr.refdef.numDrawSurfs = n;
+	R_AddWorldSurfaces();
+	R_AddPolygonSurfaces();
+	R_SetupProjection();
+	se_entity_filter = 2;
+	R_AddEntitySurfaces();
+	se_entity_filter = 0;
+	n = tr.refdef.numDrawSurfs > MAX_DRAWSURFS ? MAX_DRAWSURFS : tr.refdef.numDrawSurfs;
+	if ( n > 0 )
+		R_RadixSort( se_front_surfs, n );
+	SE_ViewSumNote( se_front_surfs, n, 1 );
+	if ( SE_FrontOn() == 2 ) {
+		se_front_check.views++;
+		if ( (unsigned)n != cmd->checkCount || ( n > 0 && SE_FrontSum( se_front_surfs, n ) != cmd->check ) )
+			se_front_check.wrong++;	// (no print here: the first core prints the counts, R_SE_FrontWait)
+	}
+	drawSurfsCommand_t dc;
+	dc.commandId = RC_DRAW_SURFS;
+	dc.drawSurfs = se_front_surfs;
+	dc.numDrawSurfs = n;
+	dc.refdef = tr.refdef;
+	dc.viewParms = tr.viewParms;
+	se_views_made.made = cmd->seq;	// (made: the first core may go on with its frame)
+	RB_DrawSurfs( &dc );
+	return (const void *)( cmd + 1 );
+}
+// (at the give: the views of the given list are waited for at the next frame's start; a list drawn here is made already)
+void R_SE_FrontGiven( int given )
+{
+	se_views.target = given ? se_views.last : 0;
+	se_views.last = 0;
+}
+seKeptCount_t se_kept_stats __attribute__(( aligned( 16 ) ));
+void R_SE_FrontWait( void )
+{
+	static int count_on = -1;
+	if ( count_on < 0 )
+		count_on = getenv( "JK2_KEPT_COUNT" ) != NULL;
+	if ( count_on && tr.frameCount % 200 == 0 ) {
+		const seKeptCount_t *c = &se_kept_stats;
+		ri.Printf( PRINT_ALL, "jk2kept: frames %u batches %u world %u faces %u indices %u stage-indices %u kept %u; not: fog/dlight %u deform %u colour %u coords %u multi %u other %u; entities' stage-indices %u; drawn kept %u, refused %u\n",
+			c->frames, c->batches, c->world, c->faces, c->indices, c->stage, c->kept, c->fog, c->deform, c->colour, c->coords, c->multi, c->other, c->ent, c->unused[0], c->unused[1] );
+	}
+
+	if ( SE_ViewSumOn() ) {
+		while ( se_views.target && (int)( se_views_made.made - se_views.target ) < 0 )
+			SE_FrontRest();
+		R_SE_ViewSumPrint();
+	}
+	if ( !se_views.target )
+		return;
+	while ( (int)( se_views_made.made - se_views.target ) < 0 )
+		SE_FrontRest();
+	se_views.target = 0;
+	static unsigned printed;
+	if ( SE_FrontOn() == 2 && se_front_check.views >= printed + 100 )
+		printed = se_front_check.views, ri.Printf( PRINT_ALL, "jk2front: %u views checked, %u not as made whole\n", se_front_check.views, se_front_check.wrong );
+}

+#ifdef SHADEREMU
+// JK2_SUM=N: a jk2sum: line every N frames of the game, a sum over every entity in use (what it is, its health, where
+// it is and faces, a client's place, speed and weapon, an NPC's behaviour), its places to an eighth of a unit (the
+// build computer's libm and the machine's may differ in the last bit), and the game's random state: the build
+// computer's program and the machine's must print the same lines (docs/games/jk2.md, "Is it the same game")
+static unsigned se_mix( unsigned h, int v )
+{
+	h ^= (unsigned)v;
+	return h * 16777619u;
+}
+
+static int se_eighth( float f )
+{
+	return (int)( f * 8.0f + ( f < 0 ? -0.5f : 0.5f ) );
+}
+
+extern "C" unsigned se_rand_state;    // (linux/jk2/se_rand.c)
+extern "C" uint32_t SE_Holdrand( void );    // (q_math.c)
+
+void SE_GameSum( void )
+{
+	static int every = -1;
+	if ( every < 0 ) {
+		const char *s = getenv( "JK2_SUM" );
+		every = s && *s ? atoi( s ) : 0;
+	}
+	if ( every <= 0 || level.framenum % every )
+		return;
+	unsigned h = 2166136261u;
+	int count = 0;
+	static int detail = -2;     // JK2_SUM_AT=N: at game frame N a jk2ent: line an entity, to find what differs
+	if ( detail == -2 ) {
+		const char *s = getenv( "JK2_SUM_AT" );
+		detail = s && *s ? atoi( s ) : -1;
+	}
+	for ( int i = 0; i < globals.num_entities; i++ ) {
+		gentity_t *e = &g_entities[i];
+		if ( !e->inuse )
+			continue;
+		count++;
+		h = se_mix( h, i );
+		h = se_mix( h, e->s.eType );
+		h = se_mix( h, e->health );
+		for ( int k = 0; k < 3; k++ ) {
+			h = se_mix( h, se_eighth( e->currentOrigin[k] ) );
+			h = se_mix( h, se_eighth( e->currentAngles[k] ) );
+		}
+		if ( e->client ) {
+			for ( int k = 0; k < 3; k++ ) {
+				h = se_mix( h, se_eighth( e->client->ps.origin[k] ) );
+				h = se_mix( h, se_eighth( e->client->ps.velocity[k] ) );
+			}
+			h = se_mix( h, e->client->ps.weapon );
+			h = se_mix( h, e->client->ps.legsAnim );
+			h = se_mix( h, e->client->ps.torsoAnim );
+		}
+		if ( e->NPC )
+			h = se_mix( h, e->NPC->behaviorState );
+		if ( detail == level.framenum )
+			gi.Printf( "jk2ent: %d %s type %d health %d at %d %d %d facing %d %d %d%s %d %d %d npc %d\n", i,
+				e->classname ? e->classname : "-", e->s.eType, e->health, se_eighth( e->currentOrigin[0] ),
+				se_eighth( e->currentOrigin[1] ), se_eighth( e->currentOrigin[2] ), se_eighth( e->currentAngles[0] ),
+				se_eighth( e->currentAngles[1] ), se_eighth( e->currentAngles[2] ), e->client ? " client" : "",
+				e->client ? se_eighth( e->client->ps.origin[0] ) : 0, e->client ? se_eighth( e->client->ps.velocity[2] ) : 0,
+				e->client ? e->client->ps.legsAnim : 0, e->NPC ? e->NPC->behaviorState : -1 );
+	}
+	h = se_mix( h, (int)se_rand_state );
+	gi.Printf( "jk2sum: frame %d time %d entities %d sum %08x draws %08x\n", level.framenum, level.time, count, h,
+		(unsigned)SE_Holdrand() );
 }
+#endif
 
 
 

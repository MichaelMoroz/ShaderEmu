+		}
+		se_dirs[i].count = se_dir_files - se_dirs[i].first;
+	}
+	if ( !se_dirs[i].ok ) {
+		return qfalse;
+	}
+	for ( int k = 0; k < se_dirs[i].count; k++ ) {
+		if ( !strcmp( se_dir_names + se_dir_name_at[se_dirs[i].first + k], filename ) ) {
+			return qfalse;
+		}
+	}
+	return qtrue;
+}

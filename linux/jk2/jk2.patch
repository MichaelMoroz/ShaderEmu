+// R_CreateImage's upload of a picture made: decoded by a worker (answer 1, or 16 + its samples where the worker prepared
+// it too), else by R_LoadImage here
+static void se_upload( se_pending_t *p, int answer )
+{
+	byte *pic = (byte *)p->rgba, *here = NULL;
+	int width = p->width, height = p->height, shrunk = p->kind == 1 ? p->shrink : 0;
+	if ( answer != 1 && !( answer & 32 ) && getenv( "JK2_PICTURES_LOG" ) )
+		ri.Printf( PRINT_ALL, "jk2pic-here: %s kind %d method %d %dx%d shrink %d answer %d\n", p->name, p->kind, p->method,
+			p->width, p->height, p->shrink, answer );

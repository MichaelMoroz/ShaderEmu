+// (on a worker, after the decode: what Upload32 makes of the picture before it is uploaded, the halvings of r_picmip it was
+// not decoded with and to the GL's largest side, the scan for alpha and, mipmapped (lightscale 1), the light's scale, and
+// with lightscale 2 the GPU's words; it stores to the pixels alone. The samples, 3 or 4, + 8 for words and + 16 for holes.)
+extern "C" void hlglWordsInPlace( unsigned char *rgba, int n, int opaque, int *holes );
+static int se_prepare( unsigned char *data, int width, int height, int halvings, int lightscale )
+{
+	int i, c;
+	for ( i = 0; i < halvings; i++ ) {
+		R_MipMap( (byte *)data, width, height );
+		width >>= 1;
+		height >>= 1;
+		if ( width < 1 )
+			width = 1;
+		if ( height < 1 )
+			height = 1;
+	}
+	while ( width > glConfig.maxTextureSize || height > glConfig.maxTextureSize ) {
+		R_MipMap( (byte *)data, width, height );
+		width >>= 1;
+		height >>= 1;
+	}
+	int samples = 3;
+	for ( i = 0, c = width * height; i < c; i++ ) {
+		if ( data[i * 4 + 3] != 255 ) {
+			samples = 4;
+			break;
+		}
+	}
+	if ( lightscale & 1 )
+		R_LightScaleTexture( (unsigned *)data, width, height, qfalse );
+	if ( lightscale & 2 ) {	// (the GPU's words, as the shim makes them of what Upload32 gives it: opaque when its format is RGB)
+		int holes = 0;
+		hlglWordsInPlace( data, width * height, samples == 3, &holes );
+		return samples | 8 | ( holes ? 16 : 0 );
+	}
+	return samples;
+}

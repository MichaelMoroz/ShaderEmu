+// The pictures given to workers that are free, and those through uploaded; with `all` every picture, waited for
+static void se_pump( qboolean all )
+{
+	int rests = 0;
+	for ( ;; ) {
+		qboolean progress = qfalse;
+		for ( int i = 0; i < se_pending_count; ) {
+			se_pending_t *p = &se_pending[i];
+			if ( !p->given ) {

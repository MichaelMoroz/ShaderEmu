+===============
+SV_SE_FindConfigstring
+
+(ShaderEmu: the game's G_FindConfigstringIndex loop over the configstrings where they lie, not each copied out: the
+index 1 to max - 1 of `name` in the set at `start`, or minus the first empty one's, or -max for a full set. A name is
+compared as the game compared its copy, case folded, the set's strings no longer than a copy keeps.)
+===============
+*/
+// (each configstring's case-folded hash, kept with the string it was made of: a string set anew by SV_SetConfigstring is
+// hashed again, as is one whose place is another string's; an empty one ends the search before its hash is asked. Only
+// a hash equal to the name's is compared: the search compared every configstring of a set, 10 million instructions of
+// the load's. docs/games/jk2.md, "The load")
+static const char *se_cs_of[MAX_CONFIGSTRINGS];
+static unsigned se_cs_hash[MAX_CONFIGSTRINGS];
+static unsigned SV_SE_Fold( const char *s )
+{
+	unsigned h = 2166136261u;
+	for ( ; *s; s++ ) {
+		unsigned c = (unsigned char)*s;
+		if ( c >= 'a' && c <= 'z' ) {
+			c -= 'a' - 'A';	// (Q_stricmp's folding)
+		}
+		h = ( h ^ c ) * 16777619u;
+	}
+	return h;
+}
+void SV_SE_ConfigstringChanged( int index )
+{
+	if ( index >= 0 && index < MAX_CONFIGSTRINGS ) {
+		se_cs_of[index] = NULL;
+	}
+}
+int SV_SE_FindConfigstring( const char *name, int start, int max )
+{
+	int i;
+	const unsigned want = SV_SE_Fold( name );
+	for ( i = 1 ; i < max ; i++ ) {
+		const int at = start + i;
+		const char *s = at >= 0 && at < MAX_CONFIGSTRINGS ? sv.configstrings[at] : NULL;
+		if ( !s || !s[0] ) {
+			return -i;
+		}
+		if ( se_cs_of[at] != s ) {
+			se_cs_of[at] = s, se_cs_hash[at] = SV_SE_Fold( s );
+		}
+		if ( se_cs_hash[at] == want && !Q_stricmp( s, name ) ) {
+			return i;
+		}
+	}
+	return -max;
+}
+#endif

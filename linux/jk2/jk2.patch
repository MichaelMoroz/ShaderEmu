+// ---- players made ahead (se_slot.h; docs/games/jk2.md, "The players on workers")
+// What a player made ahead asks of the engine: a call that only reads is made where it is asked; one that adds to the
+// scene or the sound is recorded with what its pointers point at, and made by the first core when that player's turn
+// comes (SE_RecReplay); a name to register is looked up in what the first core registered (and registered again at the
+// replay, so that what registering touches is touched in its turn); anything else ends the job (SE_WHY_CALL).
+struct seRec_t { unsigned char *start, *at, *end; int unused; } __attribute__(( aligned( 16 ) ));
+static seRec_t se_rec[SE_SLOTS + 1];
+struct seRecHead_t { int op, size, nargs, ptrs; intptr_t args[6]; int lens[6]; } __attribute__(( aligned( 16 ) ));
+extern "C" void SE_RecBegin( void *buf, int size )
+{
+	seRec_t *r = &se_rec[SE_Slot()];
+	r->start = r->at = (unsigned char *)buf, r->end = r->start + size;
+}
+extern "C" int SE_RecEnd( void )
+{
+	seRec_t *r = &se_rec[SE_Slot()];
+	int n = (int)( r->at - r->start );
+	r->start = r->at = r->end = NULL;
+	return n;
+}
+// (op: the call as the game asked it, before CL_ConvertJK2SysCall; args 1 to n, those in `ptrs` pointers to lens' bytes)
+static void se_record( intptr_t op, const intptr_t *args, int n, int ptrs, const int *lens )
+{
+	seRec_t *r = &se_rec[SE_Slot()];
+	int size = (int)sizeof( seRecHead_t );
+	for ( int i = 0; i < n; i++ )
+		if ( ( ptrs >> i & 1 ) && args[1 + i] )
+			size += ( lens[i] + 15 ) & ~15;
+	if ( !r->at || r->at + size > r->end )
+		SE_SlotAbort( SE_WHY_FULL );
+	seRecHead_t *h = (seRecHead_t *)r->at;
+	h->op = (int)op, h->size = size, h->nargs = n, h->ptrs = ptrs;
+	unsigned char *d = r->at + sizeof( seRecHead_t );
+	for ( int i = 0; i < n; i++ ) {
+		h->args[i] = args[1 + i];
+		h->lens[i] = 0;
+		if ( ( ptrs >> i & 1 ) && args[1 + i] ) {
+			h->lens[i] = lens[i];
+			memcpy( d, (const void *)args[1 + i], lens[i] );
+			d += ( lens[i] + 15 ) & ~15;
+		}
+	}
+	r->at += size;
+}
+intptr_t CL_CgameSystemCalls( intptr_t *args );
+extern "C" void SE_RecReplay( const void *buf, int bytes )
+{
+	const unsigned char *at = (const unsigned char *)buf, *end = at + bytes;
+	while ( at < end ) {
+		const seRecHead_t *h = (const seRecHead_t *)at;
+		intptr_t a[16] = { h->op };
+		const unsigned char *d = at + sizeof( seRecHead_t );
+		for ( int i = 0; i < h->nargs; i++ ) {
+			a[1 + i] = h->args[i];
+			if ( ( h->ptrs >> i & 1 ) && h->args[i] ) {
+				a[1 + i] = (intptr_t)d;
+				d += ( h->lens[i] + 15 ) & ~15;
+			}
+		}
+		CL_CgameSystemCalls( a );
+		at += h->size;
+	}
+}
+// The names the first core registered (sounds, shaders, skins): a player made ahead asks for them by name every frame
+#define SE_NAMES 1024
+struct seName_t { uint32_t hash; int op; intptr_t handle; char name[52]; } __attribute__(( aligned( 16 ) ));
+static seName_t se_names[SE_NAMES];
+static uint32_t se_name_hash( int op, const char *name )
+{
+	uint32_t h = 2166136261u ^ (uint32_t)op;
+	for ( ; *name; name++ )
+		h = ( h ^ (unsigned char)*name ) * 16777619u;
+	return h | 1;
+}
+static void se_name_keep( int op, const char *name, intptr_t handle )
+{
+	if ( strlen( name ) >= sizeof( se_names[0].name ) )
+		return;
+	const uint32_t h = se_name_hash( op, name );
+	for ( int k = 0; k < 8; k++ ) {
+		seName_t *e = &se_names[( h + k ) & ( SE_NAMES - 1 )];
+		if ( !e->hash || ( e->hash == h && e->op == op && !strcmp( e->name, name ) ) ) {
+			e->op = op, e->handle = handle;
+			strcpy( e->name, name );
+			e->hash = h;
+			return;
+		}
+	}
+}
+static bool se_name_find( int op, const char *name, intptr_t *handle )
+{
+	const uint32_t h = se_name_hash( op, name );
+	for ( int k = 0; k < 8; k++ ) {
+		const seName_t *e = &se_names[( h + k ) & ( SE_NAMES - 1 )];
+		if ( !e->hash )
+			return false;
+		if ( e->hash == h && e->op == op && !strcmp( e->name, name ) ) {
+			*handle = e->handle;
+			return true;
+		}
+	}
+	return false;
+}
+extern "C" void SE_NamesForget( void ) { memset( se_names, 0, sizeof se_names ); }

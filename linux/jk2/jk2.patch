+static void se_sound_done( se_sound_out_t *p, int answer )
+{
+	if ( !answer && p->packed ) {	// (the worker's inflate failed: here; silence where it fails here too)
+		if ( !SE_InflateHere( p->packed, p->packed_size, p->plain, p->size ) )
+			memset( p->plain, 0, p->size );
+		answer = SE_SoundResample( (const byte *)p->plain + p->dataofs, p->width, p->step, p->count, p->out );
+	} else if ( !answer ) {	// (the worker's decode made too little: the decode before, here: libmedia's team, else the engine's)
+		if ( getenv( "JK2_SOUNDS_LOG" ) )
+			Com_Printf( "jk2snd-again: %s mp3 bytes %d pcm %d ch %d\n", p->sfx->sSoundName, p->size, p->pcm_bytes, p->channels );
+		if ( SE_SoundMP3( p->file, p->size, p->pcm, p->pcm_bytes, p->rate, p->channels ) < 0 )

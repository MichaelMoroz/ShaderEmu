+#define SE_SOUNDS_OUT 192
+struct se_sound_out_t {
+	sfx_t *sfx;
+	byte *file;
+	void *pcm, *out;
+	int count, given;
+	unsigned bytes;
+	int size, width, dataofs, pcm_bytes, rate, channels;	// (for the decode before, where the worker's made too little)
+	void *packed, *plain;	// a WAV's bytes as they lie, and their room inflated (`file` is then only its head, of malloc's)
+	int packed_size;

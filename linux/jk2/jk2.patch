+static seLook_t se_look[MAX_GENTITIES];	// what a player made after another read of it: the frame before's
+static unsigned se_counts[SE_WHY_COUNT + 4];	// [0] players, [1] made ahead, [2] by workers, [3] waited on an ended one, 4.. why
+static int se_frames_logged;
+static unsigned long long se_ran[5];	// the longest player's instructions summed over the frames, all players', frames, each wave's longest summed, waves

+		qglTexParameterf( GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, p->wrap );
+		qglBindTexture( GL_TEXTURE_2D, 0 );
+		glState.currenttextures[glState.currenttmu] = 0;
+		se_picmip_done = 0;
+		se_prepared = 0;
+		se_prepared_words = 0;
+	} else {
+		ri.Printf( PRINT_WARNING, "WARNING: %s could not be decoded\n", p->name );
+	}
+	if ( here ) {
+		R_Free( here );
+	}
+	FS_SE_FreeRaw( p->raw );
+	free( p->plain );
+	free( p->rgba );
+	se_pending_bytes -= p->bytes;
+}

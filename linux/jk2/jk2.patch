+		seen[j] = 1;
+		if ( !at || method != 8 || plain != c->len || !packed ) {
+			continue;
+		}
+		void *buf = se_arena_take( bytes );
+		if ( !buf ) {
+			seen[j] = 0;
+			break;
+		}
+		int given = SE_FileGive( at, (int)packed, buf, (int)c->len );
+		if ( !given ) {
+			seen[j] = 0;
+			if ( getenv( "JK2_AHEAD_LOG" ) ) Com_Printf( "jk2ahead: %s: none to give %s\n", f->name, c->name );
+			break;	// (no worker with nothing to do: the rest when the next is read)
+		}
+		se_ahead[se_ahead_count].f = c, se_ahead[se_ahead_count].pak = pak, se_ahead[se_ahead_count].buf = (byte *)buf;
+		se_ahead[se_ahead_count].len = (int)c->len, se_ahead[se_ahead_count].given = given;
+		se_ahead[se_ahead_count].queued = 0, se_ahead[se_ahead_count].at = se_reads;
+		se_ahead_count++;
+		se_ahead_bytes += bytes;
+		if ( getenv( "JK2_AHEAD_LOG" ) ) Com_Printf( "jk2ahead: %s: gave %s\n", f->name, c->name );
+	}
+}
+
+// (ShaderEmu: files named ahead, in the order they will be read: the sounds a table or the configstrings register one at
+// a time (snd_dma.cpp's S_SE_SoundAhead), each read ahead as soon as there is room and a worker, in the pak that has it
+// first. A folder of the search path before that pak is not looked at: a file read from there is another, and what was
+// read ahead is let go unread.)
+#define SE_QUEUE 512
+static char se_queue[SE_QUEUE][MAX_QPATH];
+static int se_queue_count, se_queue_next;
+static void se_queue_pump( void )
+{
+	for ( int k = se_ahead_count - 1; k >= 0; k-- ) {
+		if ( se_ahead[k].queued && se_reads - se_ahead[k].at > 64 ) {
+			se_ahead_drop( k );	// (named, and not read since)
+		}
+	}
+	while ( se_queue_next < se_queue_count && se_ahead_count < SE_AHEAD ) {
+		const char *name = se_queue[se_queue_next];
+		fileInPack_t *f = NULL;
+		pack_t *pk = NULL;
+		for ( searchpath_t *search = fs_searchpaths; search && !f; search = search->next ) {
+			if ( !search->pack ) {
+				continue;
+			}
+			long hash = FS_HashFileName( name, search->pack->hashSize );
+			for ( fileInPack_t *c = search->pack->hashTable[hash]; c; c = c->next ) {
+				if ( !FS_FilenameCompare( c->name, name ) ) {
+					f = c, pk = search->pack;
+					break;
+				}
+			}
+		}
+		se_pak_t *sp = f ? se_seen_of( pk ) : NULL;
+		int j = f ? (int)( f - pk->buildBuffer ) : -1;
+		if ( !sp || j < 0 || j >= pk->numfiles || sp->seen[j] || f->len <= 0 || f->len > SE_AHEAD_MOST ) {
+			se_queue_next++;
+			continue;
+		}
+		for ( int h = 1; h < MAX_FILE_HANDLES; h++ ) {
+			if ( fsh[h].handleFiles.file.z == pk->handle && fsh[h].zipFile == qtrue && fsh[h].handleFiles.file.o ) {
+				return;	// (its pak's handle in use: later)
+			}
+		}
+		int method = 0;
+		unsigned long packed = 0, plain = 0;
+		const void *at = unzSE_EntryAt( pk->handle, f->pos, &method, &packed, &plain );
+		if ( !at || method != 8 || plain != f->len || !packed ) {
+			sp->seen[j] = 1;
+			se_queue_next++;
+			continue;
+		}
+		unsigned bytes = ( (unsigned)f->len + 15 ) & ~15u;
+		void *buf = se_arena_take( bytes );
+		int given = buf ? SE_FileGive( at, (int)packed, buf, (int)f->len ) : 0;
+		if ( !given ) {
+			return;	// (no room or no worker: when the next file is read)
+		}
+		sp->seen[j] = 1;
+		se_ahead[se_ahead_count].f = f, se_ahead[se_ahead_count].pak = pk, se_ahead[se_ahead_count].buf = (byte *)buf;
+		se_ahead[se_ahead_count].len = (int)f->len, se_ahead[se_ahead_count].given = given;
+		se_ahead[se_ahead_count].queued = 1, se_ahead[se_ahead_count].at = se_reads;
+		se_ahead_count++;
+		se_ahead_bytes += bytes;
+		se_queue_next++;
+		if ( getenv( "JK2_AHEAD_LOG" ) ) Com_Printf( "jk2ahead: queued %s\n", f->name );
+	}
+}
+void FS_SE_QueueAhead( const char *qpath )
+{
+	if ( !se_ahead_on() || !qpath || !qpath[0] || strlen( qpath ) >= MAX_QPATH ) {
+		return;
+	}
+	if ( se_queue_next == se_queue_count ) {
+		se_queue_next = se_queue_count = 0;
+	}
+	if ( se_queue_count == SE_QUEUE ) {
+		return;
+	}
+	Q_strncpyz( se_queue[se_queue_count++], qpath, MAX_QPATH );
+	se_queue_pump();

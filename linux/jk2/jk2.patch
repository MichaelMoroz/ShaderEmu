+// The files under `path` (relative names after `rel`) put in the lists: false when they do not fit
+static qboolean se_dir_walk( const char *path, const char *rel, int depth )
+{
+	DIR *d = opendir( path );
+	struct dirent *e;
+	if ( !d ) {
+		return qtrue;	// (no folder: no files)
+	}
+	qboolean ok = qtrue;
+	while ( ok && ( e = readdir( d ) ) != NULL ) {
+		if ( !strcmp( e->d_name, "." ) || !strcmp( e->d_name, ".." ) ) {
+			continue;
+		}
+		char full[MAX_OSPATH], name[MAX_OSPATH];
+		struct stat st;
+		Com_sprintf( full, sizeof( full ), "%s/%s", path, e->d_name );
+		Com_sprintf( name, sizeof( name ), "%s%s%s", rel, rel[0] ? "/" : "", e->d_name );
+		if ( strlen( full ) >= sizeof( full ) - 1 || strlen( name ) >= sizeof( name ) - 1 || stat( full, &st ) ) {
+			ok = qfalse;
+		} else if ( S_ISDIR( st.st_mode ) ) {
+			ok = depth < 8 ? se_dir_walk( full, name, depth + 1 ) : qfalse;
+		} else {
+			int len = (int)strlen( name ) + 1;
+			if ( se_dir_files == SE_DIR_FILES || se_dir_used + len > SE_DIR_NAMES ) {
+				ok = qfalse;
+			} else {

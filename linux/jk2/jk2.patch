+	if ( !run ) {
+		return;
+	}
+	for ( int k = se_ahead_count - 1; k >= 0; k-- ) {
+		const char *n = se_ahead[k].f->name;
+		if ( !se_ahead[k].queued && ( se_ahead[k].pak != pak || Q_stricmpn( n, f->name, dir ) || strchr( n + dir, '/' ) ) ) {
+			se_ahead_drop( k );	// (another folder's)
+		}
+	}
+	for ( int j = sp->head[hash]; j >= 0 && se_ahead_count < SE_AHEAD; j = sp->next[j] ) {
+		fileInPack_t *c = &pak->buildBuffer[j];
+		const char *cdot = strrchr( c->name, '.' );
+		unsigned bytes = ( (unsigned)c->len + 15 ) & ~15u;
+		if ( seen[j] || c->len <= 0 || c->len > SE_AHEAD_MOST || !cdot || cdot - c->name < dir || c->name[dir - 1] != '/' ||

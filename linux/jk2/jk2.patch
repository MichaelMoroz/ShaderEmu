+		se_record( args[0], args, 1, 1, lens );
+		return true;
+	}
+	case CG_R_ADDPOLYTOSCENE: {
+		const int lens[3] = { 0, 0, (int)( args[2] * sizeof( polyVert_t ) ) };
+		se_record( args[0], args, 3, 4, lens );
+		return true;
+	}
+	case CG_R_ADDLIGHTTOSCENE: {
+		const int lens[5] = { 12 };
+		se_record( args[0], args, 5, 1, lens );
+		return true;
+	}
+	case CG_S_STARTSOUND: {
+		const int lens[4] = { 12 };
+		se_record( args[0], args, 4, 1, lens );
+		return true;
+	}
+	case CG_S_ADDLOOPINGSOUND: {
+		const int lens[5] = { 0, 12, 12 };
+		se_record( args[0], args, 5, 6, lens );
+		return true;
+	}
+	case CG_S_UPDATEENTITYPOSITION: {
+		const int lens[2] = { 0, 12 };

+#ifdef SHADEREMU
+/* a bot's think on a core beside the server's frees its messages here, into the heap after the thinks (SE_BotFreesDone) */
+static struct { bot_consolemessage_t *first; unsigned unused[3]; } se_freed[SE_CORES] __attribute__ ((aligned (16)));
+void FreeConsoleMessageNow(bot_consolemessage_t *message);
 void FreeConsoleMessage(bot_consolemessage_t *message)
+{
+	int core = SE_OnWorker();
+
+	if (core >= 3) {
+		message->next = se_freed[core].first;
+		se_freed[core].first = message;
+		return;
+	}
+	FreeConsoleMessageNow(message);
+}
+void SE_BotFreesDone(void)
+{
+	int core;
+	bot_consolemessage_t *m, *next;
+
+	for (core = 3; core < SE_CORES; core++) {
+		for (m = se_freed[core].first; m; m = next) {
+			next = m->next;
+			FreeConsoleMessageNow(m);
+		}
+		se_freed[core].first = NULL;
+	}
+}
+void FreeConsoleMessageNow(bot_consolemessage_t *message)
+#else
+void FreeConsoleMessage(bot_consolemessage_t *message)

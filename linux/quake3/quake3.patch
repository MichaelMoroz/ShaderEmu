+} se_route_t;
+static se_route_t se_route[SE_CORES];
+#define SE_AREAUPDATE	(SE_OnWorker() >= 3 ? se_route[SE_OnWorker()].area : aasworld.areaupdate)
+#define SE_PORTALUPDATE	(SE_OnWorker() >= 3 ? se_route[SE_OnWorker()].portal : aasworld.portalupdate)

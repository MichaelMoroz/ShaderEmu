+/*
+ * A bot's think on a core beside the server's (SE_OnWorker() 3 and up) has scratch of its own,
+ * and the routes it makes are its own: kept in chunks the server's core gives it between
+ * thinks (AAS_SE_ThinkPools), read by it alone. A route is the same whoever makes it.
+ */
+#define SE_CHUNK	0x40000
+typedef struct {
+	aas_routingupdate_t *area, *portal;
+	unsigned short *hide;
+	aas_routingcache_t *own, *temp[2];
+	byte *pool, *chunks;

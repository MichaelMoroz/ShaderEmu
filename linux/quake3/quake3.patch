+#define SE_CORES		( 4 + SE_THINKERS )
+static inline int SE_OnWorker( void ) {
+	char here;
+	unsigned at = (unsigned)(__UINTPTR_TYPE__)&here;
+
+	if ( se_main_stack - at < 0x400000u ) {
+		return 0;
+	}
+	if ( se_client_stack - at < 0x80000u ) {
+		return 2;
+	}
+	if ( se_side_stack - at < SE_THINK_STACK ) {
+		return SE_SIDE;
+	}
+	return at - se_think_stacks < SE_THINKERS * SE_THINK_STACK ? 3 + ( at - se_think_stacks ) / SE_THINK_STACK : 1;

+extern unsigned se_part, se_part_since, se_part_cycles[24];
+static inline int SE_Part( int next ) {
+	unsigned	now;
+	int			was = (int)se_part;
+
+	__asm__ volatile ( "rdcycle %0" : "=r"( now ) );
+	se_part_cycles[se_part] += now - se_part_since;
+	se_part = (unsigned)next, se_part_since = now;
+	return was;

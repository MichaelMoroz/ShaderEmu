+void AAS_UpdatePortalRoutingCache(aas_routingcache_t *portalcache);
+void AAS_SE_FreeCores(void)
+{
+	int c;
+	byte *chunk, *next;
+
+	for (c = 3; c < SE_CORES; c++)
+	{
+		if (se_route[c].area) FreeMemory(se_route[c].area);
+		if (se_route[c].portal) FreeMemory(se_route[c].portal);
+		if (se_route[c].hide) FreeMemory(se_route[c].hide);
+		if (se_route[c].temp[0]) FreeMemory(se_route[c].temp[0]);
+		if (se_route[c].temp[1]) FreeMemory(se_route[c].temp[1]);
+		for (chunk = se_route[c].chunks; chunk; chunk = next)
+		{
+			next = *(byte **) chunk;
+			FreeMemory(chunk);
+		}
+		Com_Memset(&se_route[c], 0, sizeof(se_route[c]));
+	}
+}
+/* Before bots think at once: each core beside the server's has room for the routes it may make. */
+void AAS_SE_ThinkPools(void)
+{
+	int c;
+	byte *chunk;
+
+	for (c = 3; c < SE_CORES; c++)
+	{
+		if (!se_route[c].area || se_route[c].left >= SE_CHUNK / 4) continue;
+		chunk = (byte *) GetMemory(SE_CHUNK + 16);
+		*(byte **) chunk = se_route[c].chunks;
+		se_route[c].chunks = chunk;
+		se_route[c].pool = chunk + 16;
+		se_route[c].left = SE_CHUNK;
+	}
+}
+/* A route this core makes for itself (it is not in the level's lists): found, or made now. */
+static aas_routingcache_t *AAS_SE_OwnCache(int type, int clusternum, int areanum, int travelflags, int numtraveltimes)
+{
+	se_route_t *r = &se_route[SE_OnWorker()];
+	aas_routingcache_t *cache;
+	int size = (sizeof(aas_routingcache_t) + numtraveltimes * 3 + 15) & ~15;
+
+	for (cache = r->own; cache; cache = cache->next)
+	{
+		if (cache->type == type && cache->areanum == areanum && cache->travelflags == travelflags &&
+			(type == CACHETYPE_PORTAL || cache->cluster == clusternum)) return cache;
+	}
+	if (r->left >= size)
+	{
+		cache = (aas_routingcache_t *) r->pool;
+		r->pool += size;
+		r->left -= size;
+		Com_Memset(cache, 0, size);
+		cache->next = r->own;
+		r->own = cache;
+	}
+	else
+	{
+		/* (no room: made in the core's one spare of the kind, for the one who asked) */
+		cache = r->temp[type == CACHETYPE_PORTAL];
+		Com_Memset(cache, 0, sizeof(aas_routingcache_t) + numtraveltimes * 3);
+	}
+	cache->reachabilities = (unsigned char *) cache + sizeof(aas_routingcache_t) + numtraveltimes * sizeof(unsigned short int);
+	cache->size = size;
+	cache->type = type;
+	cache->cluster = clusternum;
+	cache->areanum = areanum;
+	VectorCopy(aasworld.areas[areanum].center, cache->origin);
+	cache->starttraveltime = 1;
+	cache->travelflags = travelflags;
+	if (type == CACHETYPE_PORTAL) AAS_UpdatePortalRoutingCache(cache);
+	else AAS_UpdateAreaRoutingCache(cache);
+	return cache;
+}
+#endif

+/* The routes to these areas from an area of every cluster, made now (docs/games/quake3.md, "The server's pace"); the bytes they took. */
+int AAS_WarmRoutes(const int *goalareas, int count, int travelflags)
+{
+	int first[256], cluster, area, i, clusters, before = routingcachesize;
+
+	if (!aasworld.initialized) return 0;
+	clusters = aasworld.numclusters < 256 ? aasworld.numclusters : 256;
+	Com_Memset(first, 0, sizeof(first));
+	for (area = 1; area < aasworld.numareas; area++)
+	{
+		cluster = aasworld.areasettings[area].cluster;
+		if (cluster > 0 && cluster < clusters && !first[cluster] && AAS_AreaReachability(area)) first[cluster] = area;
+	} //end for
+	for (i = 0; i < count; i++)
+	{
+		for (cluster = 1; cluster < clusters; cluster++)
+		{
+			if (first[cluster] && first[cluster] != goalareas[i])
+				AAS_AreaTravelTimeToGoalArea(first[cluster], aasworld.areas[first[cluster]].center, goalareas[i], travelflags);
+		} //end for
+	} //end for
+	return routingcachesize - before;
+} //end of the function AAS_WarmRoutes
+/* The routes to every area that can be reached; the bytes they took. */
+int AAS_WarmAllRoutes(int travelflags)
+{
+	int areas[64], count = 0, area, bytes = 0;
+
+	for (area = 1; area < aasworld.numareas; area++)
+	{
+		if (!AAS_AreaReachability(area)) continue;
+		areas[count++] = area;
+		if (count == 64) bytes += AAS_WarmRoutes(areas, count, travelflags), count = 0;
+	} //end for
+	return bytes + AAS_WarmRoutes(areas, count, travelflags);
+} //end of the function AAS_WarmAllRoutes

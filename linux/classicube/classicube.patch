+static void SE_GameFrame(void) {
+	struct SEFrame* f;
+	struct LocalPlayer* p;
+	struct Matrix mvp;
+	cc_bool split;
+	float t, delta;
+	cc_uint64 render  = Stopwatch_Measure();
+	cc_uint64 elapsed = Stopwatch_ElapsedMicroseconds(frameStart, render);
+	if (elapsed > 5000000) elapsed = 5000000;
+
+	delta = (float)(int)elapsed * 0.000001f;
+	if (delta <= 0.0f) return;
+	frameStart = render;
+	Game.Time += delta;
+	Gamepad_Tick(delta);
+
+	/* beside the worker's list of the frame before (what it is made of is waited for: Gfx_SE_Own) */
+	PerformScheduledTasks(delta);
+	Window_ProcessEvents(delta);
+	Camera.Active->UpdateMouse(Entities.CurPlayer, delta);
+	if (!Window_Main.Focused && !Gui.InputGrab && autoPause) { Gfx_SE_Settle(); Gui_ShowPauseMenu(); }
+	if (Bind_IsTriggered[BIND_ZOOM_SCROLL] && !Gui.InputGrab) { Gfx_SE_Settle(); InputHandler_SetFOV(Camera.ZoomFov); }
+
+	t = (float)(Game_Tasks.entities.accumulator / Game_Tasks.entities.interval);
+	LocalPlayer_SetInterpPosition(Entities.CurPlayer, t);
+	Camera.CurrentPos = Camera.Active->GetPosition(t);
+	AudioBackend_Tick();
+
+	f = &se_frames[se_next];
+	f->delta = delta; f->t = t; f->time = Game.Time;
+	f->world = !Gui_GetBlocksWorld();
+	if (f->world) {
+		Camera.Active->GetPickedBlock(&Game_SelectedPos);
+		Camera_KeyLookUpdate(delta);
+		InputHandler_Tick(delta);
+
+		p = Entities.CurPlayer;
+		Camera.Active->GetView(&f->view);
+		f->tiltM      = Camera.TiltM;
+		f->camPos     = Camera.CurrentPos;
+		f->bobbingHor = Camera.BobbingHor;
+		f->bobbingVer = Camera.BobbingVer;
+		f->pitch      = p->Base.Pitch;
+		f->yaw        = p->Base.Yaw;
+		f->selected   = Game_SelectedPos;
+		f->heldCol    = HeldBlockRenderer_SE_Col();
+		f->seated     = SE_Seated();
+		f->handOn     = SE_SeatHand(f->hand);
+		f->heldScale  = SE_SeatHeld();
+	} else {
+		RayTracer_SetInvalid(&Game_SelectedPos);
+	}
+	split = SE_CanSplit(f);
+	/* (all that drawing the player's model in the eye does: Entities_RenderModels) */
+	if (split) AnimatedComp_GetCurrent(&Entities.CurPlayer->Base, t);
+
+	/* the frame before's list is made and submitted: this frame's is begun here */
+	Gfx_SE_Settle();
+	EnvRenderer_UpdateFog();
+	if (Window_Main.Inactive) return;
+	SE_Frame = f;
+	se_next ^= 1;
+	MapRenderer_SE_Between();
+
+	Gfx_BeginFrame();
+	Gfx_BindIb(Gfx.DefaultIb);
+	Game_Vertices = 0;
+	Gfx_ClearBuffers(GFX_BUFFER_COLOR | GFX_BUFFER_DEPTH);
+	if (f->world) {
+		Gfx.View = f->view;
+		Gfx_LoadMVP(&Gfx.View, &Gfx.Projection, &mvp);
+		SE_SeatCull(&mvp, f);
+		Frustum_CalcPlanes(&mvp);
+		Gfx_SetDepthTest(true);
+		Gfx_SetDepthWrite(true);
+
+		if (EnvRenderer_ShouldRenderSkybox()) EnvRenderer_RenderSkybox();
+		AxisLinesRenderer_Render();
+		if (!split) Entities_RenderModels(delta, t);
+		EntityNames_Render();
+		Particles_Render(t);
+	}
+
+	if (split) {
+		Gfx_SE_Post(SE_FrameJob);
+	} else {
+		SE_FrameRest();
+		if (Game_ScreenshotRequested) Game_TakeScreenshot();
+		Gfx_EndFrame();
+	}
+	if (gfx_minFrameMs != 0.0f) LimitFPS();
+}
+#endif

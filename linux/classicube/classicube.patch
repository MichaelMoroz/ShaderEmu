+/* Builder_DrawSprite's four quads, vertex for vertex */
+static void SE_Sprite(struct Builder1DPart* part, PackedCol color, float x1, float y1, float z1,
+						float x2, float y2, float z2, float v1, float v2) {
+	struct SEVertex* v = (struct SEVertex*)Builder_Vertices + part->sOffset;
+	const int quarter  = part->sCount >> 2;
+	const float cx = (float)se_corner[0], cy = (float)se_corner[1], cz = (float)se_corner[2];
+	const int lx = SE_Floor(x1), ly = SE_Floor(y1), lz = SE_Floor(z1);
+	const cc_uint32 X1 = SE_Eighths(x1 - cx),       X2 = SE_Eighths(x2 - cx);
+	const cc_uint32 Y1 = SE_Eighths(y1 - cy) << 8,  Y2 = SE_Eighths(y2 - cy) << 8;
+	const cc_uint32 Z1 = SE_Eighths(z1 - cz) << 16, Z2 = SE_Eighths(z2 - cz) << 16;
+	const cc_uint32 U1 = SE_U(0.0f), U2 = SE_U(UV2_Scale), V1 = SE_V(v1), V2 = SE_V(v2);
+
+	if (lx < se_least[0]) se_least[0] = lx;
+	if (ly < se_least[1]) se_least[1] = ly;
+	if (lz < se_least[2]) se_least[2] = lz;
+
+	v->colour = color;
+	SE_Vertex(0, X1, Y1, Z1, U2, V2) SE_Vertex(1, X1, Y2, Z1, U2, V1)
+	SE_Vertex(2, X2, Y2, Z2, U1, V1) SE_Vertex(3, X2, Y1, Z2, U1, V2)
+	v += quarter; v->colour = color;
+	SE_Vertex(0, X2, Y1, Z2, U2, V2) SE_Vertex(1, X2, Y2, Z2, U2, V1)
+	SE_Vertex(2, X1, Y2, Z1, U1, V1) SE_Vertex(3, X1, Y1, Z1, U1, V2)
+	v += quarter; v->colour = color;
+	SE_Vertex(0, X1, Y1, Z2, U2, V2) SE_Vertex(1, X1, Y2, Z2, U2, V1)
+	SE_Vertex(2, X2, Y2, Z1, U1, V1) SE_Vertex(3, X2, Y1, Z1, U1, V2)
+	v += quarter; v->colour = color;
+	SE_Vertex(0, X2, Y1, Z1, U2, V2) SE_Vertex(1, X2, Y2, Z1, U2, V1)
+	SE_Vertex(2, X1, Y2, Z2, U1, V1) SE_Vertex(3, X1, Y1, Z2, U1, V2)
+	part->sOffset += 4;
+}
+#endif

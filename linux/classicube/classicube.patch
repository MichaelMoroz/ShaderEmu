+/* The world after the particles, the block in the hand and the 2D screen: what the worker makes */
+static void SE_FrameRest(void) {
+	const struct SEFrame* f = SE_Frame;
+	struct RayTracer* sel   = (struct RayTracer*)&f->selected;
+	float delta = f->delta;
+	int i;
+
+	Animations_SE_Catchup();
+	if (f->world) {
+		EnvRenderer_RenderSky();
+		if (f->seated) EnvRenderer_SE_RenderHorizon();
+		EnvRenderer_RenderClouds();
+		MapRenderer_Update(delta);
+		MapRenderer_RenderNormal(delta);
+		EnvRenderer_RenderMapSides();
+		EntityShadows_Render();
+		if (sel->valid && !Game_HideGui) SelOutlineRenderer_Render(sel, true);
+
+		if (f->camPos.y < Env.EdgeHeight && (f->camPos.x < 0 || f->camPos.z < 0 || f->camPos.x > World.Width || f->camPos.z > World.Length)) {
+			MapRenderer_RenderTranslucent(delta);
+			EnvRenderer_RenderMapEdges();
+		} else {
+			EnvRenderer_RenderMapEdges();
+			MapRenderer_RenderTranslucent(delta);
+		}
+		if (sel->valid && !Game_HideGui && Blocks.Draw[sel->block] == DRAW_TRANSLUCENT) SelOutlineRenderer_Render(sel, false);
+
+		Selections_Render();
+		EntityNames_RenderHovered();
+		if (!Game_HideGui) HeldBlockRenderer_Render(delta);
+	}
+	Gfx_Begin2D(Game.Width, Game.Height);
+	Gui_RenderGui(delta);
+	for (i = 0; i < Array_Elems(Game.Draw2DHooks); i++)
+	{
+		if (Game.Draw2DHooks[i]) Game.Draw2DHooks[i](delta);
+	}
+	Gfx_End2D();
+	Gfx_SE_FrameLater();
+}
+/* From a holodeck's seat with tracked hands the chunks in view are the head's, which looks
+   round the body the camera stands for: a frustum of 120 degrees from the head's way. */
+static void SE_SeatCull(struct Matrix* mvp, const struct SEFrame* f) {
+	extern int SE_SeatHead(float* yaw, float* pitch);
+	static struct Matrix proj, last;
+	static float lastYaw, lastPitch, lastFar;
+	static Vec3 lastPos;
+	struct Matrix view;
+	Vec2 rot;
+	float yaw, pitch;
+	if (!SE_SeatHead(&yaw, &pitch)) return;
+	if (lastFar != (float)Game_ViewDistance) {
+		lastFar = (float)Game_ViewDistance;
+		Gfx_CalcPerspectiveMatrix(&proj, 120.0f * MATH_DEG2RAD, 1.0f, lastFar);
+		lastYaw = -1000.0f;
+	}
+	if (yaw != lastYaw || pitch != lastPitch || !Vec3_Equals(&f->camPos, &lastPos)) {
+		lastYaw = yaw; lastPitch = pitch; lastPos = f->camPos;
+		rot.x = yaw * MATH_DEG2RAD; rot.y = pitch * MATH_DEG2RAD;
+		Matrix_LookRot(&view, f->camPos, rot);
+		Matrix_Mul(&last, &view, &proj);
+	}
+	*mvp = last;
+}
+
+cc_uint32 cycles(void);
+void Gfx_SE_JobCycles(cc_uint32 n);
+static cc_uint32 SE_FrameJob(cc_uint32 a, cc_uint32 b) {
+	cc_uint32 began = cycles();
+	SE_FrameRest();
+	Gfx_SE_JobCycles(cycles() - began);
+	return 0;
+}

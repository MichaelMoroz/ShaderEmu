+#ifdef CC_BUILD_SHADEREMU
+/* Frustum_TestSphere for the chunks' centres, which are on a grid: a plane's products with
+   the grid's x, y and z are made once a frame and a test adds three of them and the plane's
+   fourth number, in the order the function adds them: the same sums. */
+const float* Frustum_SE_Planes(void);
+#define SE_GRID 64
+static float se_fx[5][SE_GRID], se_fy[5][SE_GRID], se_fz[5][SE_GRID], se_fd[5];
+static cc_bool se_grid;
+
+static void SE_Frustum(void) {
+	const float* p = Frustum_SE_Planes();
+	int i, k;
+	se_grid = World.ChunksX <= SE_GRID && World.ChunksY <= SE_GRID && World.ChunksZ <= SE_GRID;
+	if (!se_grid) return;
+	for (k = 0; k < 5; k++, p += 4) {
+		for (i = 0; i < World.ChunksX; i++) se_fx[k][i] = p[0] * (float)(i * CHUNK_SIZE + HALF_CHUNK_SIZE);
+		for (i = 0; i < World.ChunksY; i++) se_fy[k][i] = p[1] * (float)(i * CHUNK_SIZE + HALF_CHUNK_SIZE);
+		for (i = 0; i < World.ChunksZ; i++) se_fz[k][i] = p[2] * (float)(i * CHUNK_SIZE + HALF_CHUNK_SIZE);
+		se_fd[k] = p[3];
+	}
+}

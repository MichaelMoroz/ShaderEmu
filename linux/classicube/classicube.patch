+/* Whether the rest can be a worker's: alone in the world and seen from the eye, the player's
+   model is not drawn and nothing else reads what the ticks change (CLASSICUBE_RENDER=inline: never) */
+static cc_bool SE_CanSplit(const struct SEFrame* f) {
+	if (se_split < 0) {
+		const char* how = getenv("CLASSICUBE_RENDER");
+		se_split = !(how && !strcmp(how, "inline"));
+	}
+	return se_split && f->world && mcw_count() > 0 && !Game_Anaglyph3D && !Game_ScreenshotRequested &&
+		Entities_SE_First == ENTITIES_SELF_ID && !Camera.Active->isThirdPerson;
+}

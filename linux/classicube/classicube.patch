+#ifdef CC_BUILD_SHADEREMU
+			/* (Block_CalcCulling's own first case, most of the 65,536 pairs, without the call) */
+			if (Blocks.FullOpaque[block] && Blocks.FullOpaque[neighbour]) {
+				Blocks.Hidden[(block * BLOCK_COUNT) + neighbour] = 0x3F;
+				continue;
+			}
+#endif

+/* What a worker made becomes the chunks' own. True if any chunk has a mesh from it. */
+static cc_bool SE_Mesh_Take(struct SEWork* w) {
+	struct ChunkInfo* chunk;
+	struct ChunkPartInfo* ptr;
+	struct SEMeshOut* out;
+	cc_bool any = false;
+	int i, k, partsIndex;
+
+	w->running = false;
+	se_running--;
+	se_stale = true;
+	for (k = 0; k < w->job.count; k++) {
+		chunk = w->chunks[k];
+		out   = &w->job.out[k];
+		chunk->building = false;
+		/* (no room for the first of a job: no worker can make it) */
+		if (!out->made && k == 0) se_own = chunk;
+		/* (a chunk changed since, or one there was no room for, is made another time) */
+		if (!out->made || chunk->made != w->made[k] || !chunk->dirty) continue;
+		/* (one made again was drawn by its old mesh until now) */
+		if (!chunk->noData) DeleteChunk(chunk);
+		se_walk_serial++;
+
+		chunk->allAir = w->job.copy[k].allAir;
+		if (out->verts) {
+			chunk->vb = Gfx_TryCreateStaticVb(VERTEX_FORMAT_TEXTURED, out->verts + 1);
+			if (!chunk->vb) continue;
+			partsIndex = (int)(chunk - mapChunks);
+			for (i = 0; i < MapRenderer_1DUsedCount; i++) {
+				MapRenderer_PartsNormal[partsIndex + i * chunksCount]      = out->norm[i];
+				MapRenderer_PartsTranslucent[partsIndex + i * chunksCount] = out->tran[i];
+			}
+			if (out->hasNorm) chunk->normalParts      = &MapRenderer_PartsNormal[partsIndex];
+			if (out->hasTran) chunk->translucentParts = &MapRenderer_PartsTranslucent[partsIndex];
+			if (out->packed) {
+				Gfx_SE_UnlockPacked(chunk->vb, (struct SEVertex*)out->at, out->verts, out->corner, out->least);
+			} else {
+				Gfx_SE_UnlockFrom(chunk->vb, out->at, VERTEX_FORMAT_TEXTURED, out->verts + 1);
+			}
+		}
+		/* (and BuildChunk's own end) */
+		Game.ChunkUpdates++;
+		se_mesh_chunks++;
+		chunk->dirty  = false;
+		chunk->noData = !chunk->normalParts && !chunk->translucentParts;
+		chunk->empty  = chunk->noData;
+		if (chunk->empty) continue;
+		any = true;
+
+		if (chunk->normalParts) {
+			ptr = chunk->normalParts;
+			for (i = 0; i < MapRenderer_1DUsedCount; i++, ptr += chunksCount) {
+				if (ptr->offset >= 0) normPartsCount[i]++;
+			}
+		}
+		if (chunk->translucentParts) {
+			ptr = chunk->translucentParts;
+			for (i = 0; i < MapRenderer_1DUsedCount; i++, ptr += chunksCount) {
+				if (ptr->offset >= 0) tranPartsCount[i]++;
+			}
+		}
+	}
+	return any;
+}
+
+static cc_bool SE_Mesh_Collect(void) {
+	cc_bool any = false;
+	int k;
+	if (!se_running) return false;
+	for (k = 0; k < SE_COPIES; k++) {
+		if (se_work[k].running && mcw_ready(se_handle[k])) { mcw_join(se_handle[k]); any |= SE_Mesh_Take(&se_work[k]); }
+	}
+	return any;
+}
+
+/* The workers, asked for once (the world's generator has opened them: Generator.c). */
+static void SE_Workers(void) {
+	const char* how  = getenv("CLASSICUBE_MESH");
+	const char* most = getenv("CLASSICUBE_MESH_WORKERS");
+	int want = most ? atoi(most) : SE_COPIES, i, k;
+
+	if (want > SE_COPIES) want = SE_COPIES;
+	se_workers = (how && !strcmp(how, "inline")) || want <= 0 ? 0 : mcw_open(want);
+	if (se_workers > want) se_workers = want;
+	if (se_workers > 0) {
+		extern char __DATA_BEGIN__[], _end[];
+		atexit(mcw_close);
+		/* (the workers' copies of the builder are variables nobody has touched: see mcw.h) */
+		mcw_touch(__DATA_BEGIN__, (unsigned)(_end - __DATA_BEGIN__));
+		/* (and code no core has run: a page of it stops the worker that comes to it. A copy's */
+		/*  job is the last of its 44 KB) */
+		for (k = 0; k < se_workers; k++) {
+			const volatile char* code = (const volatile char*)se_jobs[k];
+			for (i = -48 * 1024; i <= 4096; i += 4096) (void)code[i];
+		}
+	}
+}
+
+static void SE_Mesh_Post(void);
+/* Before the frame's worker walks the map: core 0 takes what the mesh workers made and gives
+   out what waits (mcw_call is core 0's) */
+void MapRenderer_SE_Between(void) {
+	if (se_workers < 0) SE_Workers();
+	if (SE_Mesh_Collect()) se_collected = true;
+	SE_Mesh_Post();
+}
+
+/* The nearest chunks that wait for a mesh go to the workers that have none to make, a new
+   chunk or one whose block changed: that one is drawn by its old mesh until the new is there. */
+static void SE_Mesh_Post(void) {
+	struct ChunkInfo* list[SE_COPIES * SE_JOB_CHUNKS];
+	struct ChunkInfo* chunk;
+	struct SEWork* w;
+	int i, k, n = 0, idle = 0, each, at = 0, m;
+
+	if (se_workers <= 0 || !se_stale || !mapChunks || !World.Blocks) return;
+	if (se_light != 2 && !SE_Light()) return;
+	for (k = 0; k < se_workers; k++) idle += !se_work[k].running;
+	if (!idle) return;
+
+	for (i = 0; i < chunksCount && n < idle * SE_JOB_CHUNKS; i++) {
+		chunk = sortedChunks[i];
+		if (chunk->empty || !chunk->dirty || chunk->building || chunk == se_own || distances[i] > (cc_uint32)buildDistSquared) continue;
+		list[n++] = chunk;
+	}
+	/* (nothing waits: not looked at again until a chunk changes or a job ends) */
+	if (!n) { se_stale = false; return; }
+	each = (n + idle - 1) / idle;
+
+	for (k = 0; k < se_workers && at < n; k++) {
+		w = &se_work[k];
+		if (w->running) continue;
+		for (m = 0; m < each && at < n; m++, at++) {
+			chunk = list[at];
+			chunk->building = true;
+			w->chunks[m]    = chunk;
+			w->made[m]      = chunk->made;
+			w->job.copy[m]  = *chunk;
+			w->job.copy[m].normalParts = NULL; w->job.copy[m].translucentParts = NULL;
+			/* (the light's heights of the chunk are made here: the worker then only reads them, and */
+			/*  never stores into 16 bytes of the height map that this core is storing into) */
+			Lighting.LightHint(chunk->centreX - HALF_CHUNK_SIZE - 1, chunk->centreY - HALF_CHUNK_SIZE - 1,
+				chunk->centreZ - HALF_CHUNK_SIZE - 1);
+		}
+		w->job.count = m;
+		w->running   = true;
+		se_running++;
+		se_mesh_jobs++;
+		se_handle[k] = mcw_call(se_jobs[k], (unsigned)&w->job, 0);
+	}
+}
+#endif

+	if (block == other && Blocks.Draw[block] == DRAW_TRANSPARENT_THICK && Blocks.MinBB[block].x == 0.0f &&
+		Blocks.MinBB[block].y == 0.0f && Blocks.MinBB[block].z == 0.0f && Blocks.MaxBB[block].x == 1.0f &&
+		Blocks.MaxBB[block].y == 1.0f && Blocks.MaxBB[block].z == 1.0f) {
+		Blocks.Hidden[(block * BLOCK_COUNT) + other] = FACE_BIT_XMAX | FACE_BIT_ZMAX | FACE_BIT_YMAX;
+		return;
+	}
+#endif
 

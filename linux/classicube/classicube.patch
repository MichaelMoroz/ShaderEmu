+static cc_bool SE_Light(void) {
+	int k, z, share;
+	if (se_light == 0) {
+		se_light = 2;
+		if (se_workers < 2 || se_running || !ClassicLighting_SE_Shared()) return true;
+		share = (World.Length + se_workers - 1) / se_workers;
+		for (k = 0, z = 0; z < World.Length; k++, z += share) {
+			se_light_calls[k] = mcw_call(ClassicLighting_SE_Rows, (unsigned)z, (unsigned)min(z + share, World.Length));
+		}
+		se_light_jobs = k;
+		se_light      = 1;
+		return false;
+	}
+	for (k = 0; k < se_light_jobs; k++) {
+		if (!mcw_ready(se_light_calls[k])) return false;
+	}

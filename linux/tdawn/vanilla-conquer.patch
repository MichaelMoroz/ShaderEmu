+}
+#endif
+
+/*
+** The ground layer's pass made by a worker core while this one draws the frame, which moves
+** nothing (ShaderEmu_Sort_Begin() before Map.Render()): into a list of its own, from where the
+** objects are, storing nothing else. Sort() then takes that list. TDAWN_CHECK_SORT=1 compares.
+*/
+#include "common/mcwx.h"
+alignas(16) static ObjectClass* ShaderEmu_Sorted[1024];
+static mcw_handle ShaderEmu_Sorting;
+static LayerClass* ShaderEmu_Sort_Of;
+static int ShaderEmu_Sort_Check = -1;
+static unsigned ShaderEmu_Sorts_Made, ShaderEmu_Sorts_Wrong;
+
+static uint32_t ShaderEmu_Sort_Job(uint32_t layer, uint32_t count)
+{
+    LayerClass& objects = *(LayerClass*)layer;
+    ObjectClass** out = ShaderEmu_Sorted;
+    for (int index = 0; index < (int)count; index++) {
+        out[index] = objects[index];
+    }
+    ObjectClass* lower = out[0];
+    COORDINATE lower_y = lower->ShaderEmu_SortState == 1 && lower->ShaderEmu_SortFor == lower->Coord ? lower->ShaderEmu_SortKey : lower->Sort_Y();
+    for (int index = 0; index < (int)count - 1; index++) {
+        ObjectClass* next = out[index + 1];
+        COORDINATE next_y = next->ShaderEmu_SortState == 1 && next->ShaderEmu_SortFor == next->Coord ? next->ShaderEmu_SortKey : next->Sort_Y();
+        if (next_y < lower_y) {
+            out[index + 1] = lower;
+            out[index] = next;
+        } else {
+            lower = next;
+            lower_y = next_y;
+        }
+    }
+    return count;
+}
+
+void ShaderEmu_Sort_Begin(LayerClass& layer)
+{

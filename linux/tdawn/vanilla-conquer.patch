+        fprintf(stderr, "tdawn: movie %s: %u frames by libmedia with %d worker cores", name, movie_frames, movie_workers);
+        if (movie_checked) {
+            fprintf(stderr, ", %u of %u checked differ", movie_wrong, movie_checked);
+        }
+        fprintf(stderr, "\n");
+    }
+    if (movie_workers >= 0) {
+        mcw_for_end();
+        mcw_close();
+    }
+    movie_workers = -1;
+    movie_frames = movie_checked = movie_wrong = 0;
+}

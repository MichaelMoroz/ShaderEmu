diff --git a/common/interpal.cpp b/common/interpal.cpp
index 6091774..7b558fc 100644
--- a/common/interpal.cpp
+++ b/common/interpal.cpp
@@ -118,11 +118,196 @@ void Write_Interpolation_Palette(char const* palette_file_name)
  * HISTORY:                                                                *
  *   12/06/1995  MG : Created.                                             *
  *=========================================================================*/
+#ifdef SHADEREMU
+#include "host.h"
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+/*
+** The same table (docs/games/ralert.md, "A mission won"): the nearest colour is looked for outward from the
+** midpoint's r + g + b in the palette sorted by it ((dr + dg + db)^2 <= 3 d), a row's half from its
+** diagonal on, the rows on the worker cores, and the other half copied (the table is symmetric).
+*/
+struct ShaderEmu_Interpolation
+{
+    const unsigned char* palette;
+    unsigned char order[256];
+    short sum[256];
+    short first[766]; /* the first place in `order` of each sum or more */
+};
+
+static int ShaderEmu_Nearest(const ShaderEmu_Interpolation* s, int r, int g, int b)
+{
+    const unsigned char* pal = s->palette;
+    int t = r + g + b, best = 1 << 24, index = 256;
+
+    /* (the lowest index of the nearest, as the search through all of them finds) */
+    for (int k = s->first[t]; k < SIZE_OF_PALETTE; k++) {
+        int ds = s->sum[k] - t;
+        if (ds * ds > 3 * best) {
+            break;
+        }
+        const unsigned char* c = pal + s->order[k] * 3;
+        int d = (c[0] - r) * (c[0] - r) + (c[1] - g) * (c[1] - g) + (c[2] - b) * (c[2] - b);
+        if (d < best || (d == best && s->order[k] < index)) {
+            best = d, index = s->order[k];
+        }
+    }
+    for (int k = s->first[t] - 1; k >= 0; k--) {
+        int ds = t - s->sum[k];
+        if (ds * ds > 3 * best) {
+            break;
+        }
+        const unsigned char* c = pal + s->order[k] * 3;
+        int d = (c[0] - r) * (c[0] - r) + (c[1] - g) * (c[1] - g) + (c[2] - b) * (c[2] - b);
+        if (d < best || (d == best && s->order[k] < index)) {
+            best = d, index = s->order[k];
+        }
+    }
+    return index;
+}
+
+static void ShaderEmu_Interpolation_Rows(void* context, unsigned from, unsigned to)
+{
+    const ShaderEmu_Interpolation* s = (const ShaderEmu_Interpolation*)context;
+    const unsigned char* pal = s->palette;
+
+    for (unsigned i = from; i < to; i++) {
+        unsigned char* row = InterpolationTable->PaletteInterpolationTable[i];
+        for (unsigned j = i; j < SIZE_OF_PALETTE; j++) {
+            row[j] = (unsigned char)ShaderEmu_Nearest(s,
+                                                      (pal[i * 3] + pal[j * 3]) >> 1,
+                                                      (pal[i * 3 + 1] + pal[j * 3 + 1]) >> 1,
+                                                      (pal[i * 3 + 2] + pal[j * 3 + 2]) >> 1);
+        }
+    }
+}
+
+/* TDAWN_INTERPOLATION=game: the game's own table and rows; =check: both, compared */
+static int ShaderEmu_Interpolation_How(void)
+{
+    static int how = -1;
+    if (how < 0) {
+        const char* text = getenv("TDAWN_INTERPOLATION");
+        how = !text ? 0 : !strcmp(text, "game") ? 1 : 2;
+    }
+    return how;
+}
+
+/* Asm_Interpolate_Line_Interpolate's rows, a source row's two at a time on the worker cores. */
+struct ShaderEmu_Lines
+{
+    const unsigned char* src;
+    unsigned char* dst;
+    int height, width, pitch;
+};
+
+static void ShaderEmu_Line_X(const unsigned char* s, unsigned char* d, int width)
+{
+    for (int i = 0; i < width - 1; i++) {
+        d[2 * i] = s[i];
+        d[2 * i + 1] = InterpolationTable->PaletteInterpolationTable[s[i]][s[i + 1]];
+    }
+    d[2 * width - 2] = s[width - 1];
+    d[2 * width - 1] = 0;
+}
+
+static void ShaderEmu_Lines_Rows(void* context, unsigned from, unsigned to)
+{
+    const ShaderEmu_Lines* l = (const ShaderEmu_Lines*)context;
+    unsigned char top[800], bottom[800];
+
+    for (unsigned y = from; y < to; y++) {
+        unsigned char* out = l->dst + 2 * y * l->pitch;
+        ShaderEmu_Line_X(l->src + y * l->width, top, l->width);
+        memcpy(out, top, 2 * l->width);
+        if ((int)y + 1 < l->height) {
+            ShaderEmu_Line_X(l->src + (y + 1) * l->width, bottom, l->width);
+            out += l->pitch;
+            for (int i = 0; i < 2 * l->width; i++) {
+                out[i] = InterpolationTable->PaletteInterpolationTable[top[i]][bottom[i]];
+            }
+        }
+    }
+}
+
+static bool ShaderEmu_Interpolate_Lines(const unsigned char* src, unsigned char* dst, int height, int width, int dst_pitch)
+{
+    static ShaderEmu_Lines l;
+    int how = ShaderEmu_Interpolation_How();
+    if (how == 1 || width > 400 || height < 2 || ((dst_pitch / 2) & 15) || ((uintptr_t)dst & 15)) {
+        return false;
+    }
+    l.src = src, l.dst = dst, l.height = height, l.width = width, l.pitch = dst_pitch / 2;
+    host_for(height, ShaderEmu_Lines_Rows, &l, dst, dst_pitch);
+    if (how == 2) {
+        int size = (2 * height - 1) * (dst_pitch / 2), differ = 0;
+        unsigned char* game = (unsigned char*)malloc(size + dst_pitch);
+        Asm_Interpolate_Line_Interpolate((void*)src, game, height, width, dst_pitch);
+        for (int y = 0; y < 2 * height - 1; y++) {
+            differ += memcmp(game + y * (dst_pitch / 2), dst + y * (dst_pitch / 2), 2 * width) != 0;
+        }
+        free(game);
+        fprintf(stderr, "interpolation: %d of %d rows differ from the game's own\n", differ, 2 * height - 1);
+    }
+    return true;
+}
+
+static void ShaderEmu_Interpolation_Table(void)
+{
+    static ShaderEmu_Interpolation s;
+    const unsigned char* pal = (const unsigned char*)InterpolationPalette;
+    int count[767] = {0};
+
+    s.palette = pal;
+    for (int p = 0; p < 256; p++) {
+        count[pal[p * 3] + pal[p * 3 + 1] + pal[p * 3 + 2] + 1]++;
+    }
+    for (int v = 0; v < 766; v++) {
+        count[v + 1] += count[v];
+    }
+    for (int v = 0; v < 766; v++) {
+        s.first[v] = (short)count[v];
+    }
+    for (int p = 0; p < 256; p++) {
+        int v = pal[p * 3] + pal[p * 3 + 1] + pal[p * 3 + 2], at = count[v]++;
+        s.order[at] = (unsigned char)p, s.sum[at] = (short)v;
+    }
+    unsigned char(*table)[256] = InterpolationTable->PaletteInterpolationTable;
+    if (((uintptr_t)table & 15) == 0) {
+        host_for(256, ShaderEmu_Interpolation_Rows, &s, table, 256);
+    } else {
+        ShaderEmu_Interpolation_Rows(&s, 0, 256);
+    }
+    for (int i = 1; i < 256; i++) {
+        for (int j = 0; j < i; j++) {
+            table[i][j] = table[j][i];
+        }
+    }
+}
+#endif

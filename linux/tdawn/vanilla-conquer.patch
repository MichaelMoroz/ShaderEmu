+#include <stdlib.h>
+
+static int movie_workers = -1;
+static unsigned movie_frames, movie_checked, movie_wrong;
+
+static void ShaderEmu_UnVQ_4x2(uint8_t* codebook,
+                               uint8_t* pointers,
+                               uint8_t* buffer,
+                               unsigned blocks_per_row,
+                               unsigned num_rows,
+                               unsigned buff_width)
+{
+    static const char* check = getenv("TDAWN_MOVIE_CHECK");
+    if (movie_workers < 0) {
+        const char* limit = getenv("TDAWN_MOVIE_WORKERS");
+        /* the mission's scene had some: a movie has them all, as Red Alert's (fifteen) */
+        host_workers_close();
+        movie_workers = mcw_open(limit ? atoi(limit) : 15);
+    }
+    media_vq2_rows(codebook, pointers, buffer, blocks_per_row, num_rows, buff_width, movie_workers);
+    movie_frames++;
+    if (check) {
+        unsigned bytes = num_rows * 2 * buff_width, wrong = 0;
+        static uint8_t* own;
+        static unsigned own_bytes;
+        if (own_bytes < bytes) {
+            own = (uint8_t*)realloc(own, bytes);
+            own_bytes = bytes;
+        }
+        UnVQ_4x2(codebook, pointers, own, blocks_per_row, num_rows, buff_width);
+        for (unsigned i = 0; i < bytes; i++) {
+            wrong += own[i] != buffer[i];
+        }
+        movie_checked++;
+        if (wrong) {
+            movie_wrong++;
+            fprintf(stderr, "tdawn: movie frame %u: %u of %u bytes differ from the game's own decoding\n", movie_frames, wrong, bytes);
+        }
+    }
+}

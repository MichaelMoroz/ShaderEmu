+    memcpy(&keyfr, file, sizeof(keyfr));
+    if (frame < 0 || frame >= le16toh(keyfr.frames)) {
+        return 0;
+    }
+    unsigned short size = (unsigned short)(le16toh(keyfr.width) * le16toh(keyfr.height));
+    int skip = le16toh(keyfr.flags) & 1 ? 768 : 0;
+    memcpy(offset, data + ((unsigned)frame << 3) + sizeof(KeyFrameHeaderType), 8);
+    offset[0] = le32toh(offset[0]), offset[1] = le32toh(offset[1]);

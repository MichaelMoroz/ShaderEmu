+    }
+    // the chain's first frame (the one changed from the key frame), and the key frame's place
+    int first = frame;
+    if (flags & KF_DELTA) {
+        first = (unsigned short)offset[1];
+        memcpy(offset, data + ((unsigned)first << 3) + sizeof(KeyFrameHeaderType), 8);
+        offset[0] = le32toh(offset[0]), offset[1] = le32toh(offset[1]);
+    }
+    unsigned key = offset[1] & 0x00FFFFFF;
+    const unsigned char* from = data + key + skip;
+    int at = first;
+    if (have >= first && have < frame) {
+        // (the buffer's frame is of this chain if it is the chain's first or says the same first)
+        memcpy(other, data + ((unsigned)have << 3) + sizeof(KeyFrameHeaderType), 8);
+        other[0] = le32toh(other[0]), other[1] = le32toh(other[1]);

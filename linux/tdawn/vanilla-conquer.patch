+
+static ShaderEmu_Folder* ShaderEmu_Folder_Of(const char* name)
+{
+    int free_at = -1;
+
+    for (int i = 0; i < 16; i++) {
+        if (ShaderEmu_Folders[i].name == NULL) {
+            free_at = free_at < 0 ? i : free_at;
+        } else if (strcmp(ShaderEmu_Folders[i].name, name) == 0) {
+            return &ShaderEmu_Folders[i];
+        }
+    }
+    DIR* directory = opendir(name);
+    if (directory == NULL) {
+        return NULL;
+    }
+    if (free_at < 0) {
+        ShaderEmu_Folders_Forget();
+        free_at = 0;
+    }
+    ShaderEmu_Folder* folder = &ShaderEmu_Folders[free_at];
+    int room = 0;
+    for (struct dirent* entry; (entry = readdir(directory)) != NULL;) {
+        if (folder->count == room) {
+            room = room ? room * 2 : 64;
+            folder->entries = (struct dirent*)realloc(folder->entries, room * sizeof(struct dirent));
+        }
+        folder->entries[folder->count++] = *entry;
+    }
+    closedir(directory);
+    folder->name = strdup(name);
+    folder->opened = (unsigned char*)calloc(folder->count + 1, 1);
+    return folder;
+}
+#endif
+
+#ifdef SHADEREMU
+/* What is known of a path before rawfile.cpp opens it only to see whether it is there (1,370 times before
+** Tiberian Dawn's first frame): 0, not among its folder's names; 1, there and opened before (`opened` says
+** that it was now); 2, not known. */
+int ShaderEmu_File_Listed(const char* path, bool opened)
+{
+    char folder_name[PATH_MAX];
+    const char* slash = strrchr(path, '/');
+    const char* name = slash ? slash + 1 : path;
+    size_t length = slash ? (size_t)(slash - path + 1) : 0;
+
+    if (length >= sizeof(folder_name) || !*name) {
+        return 2;
+    }
+    memcpy(folder_name, path, length);
+    folder_name[length] = 0;
+    ShaderEmu_Folder* folder = ShaderEmu_Folder_Of(length ? folder_name : ".");
+    if (folder == NULL || folder->opened == NULL) {
+        return 2;
+    }
+    for (int i = 0; i < folder->count; i++) {
+        if (strcmp(folder->entries[i].d_name, name) == 0) {
+            folder->opened[i] |= opened;
+            return folder->opened[i] ? 1 : 2;
+        }
+    }
+    return 0;
+}
+#endif

+*/
+extern "C" int ShaderEmu_Frame_Step(const void* file, int frame, void* buffer, int have)
+{
+    const unsigned char* data = (const unsigned char*)file;
+    unsigned char* to = (unsigned char*)buffer;
+    uint32_t offset[2], other[2];
+    KeyFrameHeaderType keyfr;

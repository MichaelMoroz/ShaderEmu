+        for (; k <= cores && ShaderEmu_Path_Out[k]; k++) {
+        }
+        if (out || k > cores) {
+            continue;
+        }
+        if (!host_path_post(k, ShaderEmu_Path_Job, (unsigned)(uintptr_t)this,
+                            (unsigned)dest << 16 | (unsigned)maxlen << 8 | k << 4 | other)) {
+            break; /* (no worker is free) */
+        }
+        ShaderEmu_Path_Out[k] = other + 1;
+    }
+    int pre = most && !ShaderEmu_Pre_Out ? host_pre_cores() : 0;
+    int y = Map.MapCellY, end = y + Map.MapCellHeight, each = pre ? (Map.MapCellHeight + pre - 1) / pre : 0;
+    static bool run;
+    if (pre && !run) {
+        /* (a worker stops at a page of code no core has run: this core runs the job's once) */
+        run = true;
+        ShaderEmu_Pre_Job((unsigned)(uintptr_t)this, (unsigned)y | (unsigned)(y + 1) << 8 | (unsigned)Map.MapCellX << 16
+                                                         | (unsigned)(Map.MapCellX + 1) << 24);
+    }
+    for (k = 0; k < pre && y < end; k++, y += each) {
+        if (!host_pre_post(k, ShaderEmu_Pre_Job, (unsigned)(uintptr_t)this,
+                           (unsigned)y | (unsigned)MIN(y + each, end) << 8 | (unsigned)Map.MapCellX << 16
+                               | (unsigned)(Map.MapCellX + Map.MapCellWidth) << 24)) {
+            break;
+        }
+        ShaderEmu_Pre_Out = k + 1;
+    }
+}
+
+/*
+** Find_Path, or what it would find. A search that turns out long has the unit's next ones
+** made by worker cores meanwhile (nothing changes between a unit's searches, and a search
+** stores only into its core's own memory). TDAWN_CHECK_PATHS=1 compares.
+*/
+PathType* FootClass::ShaderEmu_Find_Path(CELL dest, FacingType* final_moves, int maxlen, MoveType threshhold)
+{
+    static int check = -1;
+    static unsigned reused, helped, wrong;
+    struct path_core* core = &ShaderEmu_Core[0];
+    struct search* s;
+    PathType* path;
+
+    if (check < 0) {
+        check = getenv("TDAWN_CHECK_PATHS") != NULL;
+        ShaderEmu_Walk_Check = check;
+        ShaderEmu_Walk_Old = getenv("TDAWN_WALK") && !strcmp(getenv("TDAWN_WALK"), "old");
+        if (check) {
+            atexit([]() {
+                fprintf(stderr, "tdawn: %u searches not run again and %u another core's, %u of them wrong\n", reused,
+                        helped, wrong);
+                fprintf(stderr, "tdawn: %u edge walks made both ways, %u of them wrong\n", ShaderEmu_Walks,
+                        ShaderEmu_Walks_Wrong);
+            });
+        }
+    }
+    if (!ShaderEmu_Enter_Now || !final_moves || maxlen > 200) {
+        return Find_Path(dest, final_moves, maxlen, threshhold);
+    }
+    s = ShaderEmu_Path_Same(dest, maxlen, threshhold);
+    if (s) {
+        reused++;
+    } else {
+        for (int k = 1; k < PATH_CORES; k++) {
+            if (ShaderEmu_Path_Out[k] == threshhold + 1) {
+                host_path_wait(k);
+                ShaderEmu_Path_Out[k] = 0;
+                s = ShaderEmu_Path_Keep(&ShaderEmu_Core[k], dest, maxlen, threshhold);
+                helped += s != NULL;
+            }
+        }
+    }
+    if (s) {
+        if (check) {
+            path = Find_Path(dest, final_moves, maxlen, threshhold);
+            PathType same = s->path;
+            same.Command = final_moves;
+            same.Overlap = path->Overlap;
+            wrong += memcmp(path, &same, sizeof(same)) != 0 || memcmp(final_moves, s->moves, s->path.Length) != 0
+                     || memcmp(path->Overlap, s->overlap, sizeof(s->overlap)) != 0;
+            return path;
+        }
+        path = &core->path;
+        *path = s->path;
+        path->Command = final_moves;
+        path->Overlap = core->overlap[0];
+        memcpy(final_moves, s->moves, maxlen);
+        memcpy(path->Overlap, s->overlap, sizeof(s->overlap));
+        return path;
+    }
+
+    ShaderEmu_Path_Asked.dest = dest;
+    ShaderEmu_Path_Asked.maxlen = maxlen;
+    ShaderEmu_Path_Asked.now = threshhold;
+    ShaderEmu_Path_Asked.most = ShaderEmu_Searches ? ShaderEmu_Search[0].threshhold : threshhold;
+    core->seen = 0;
+    path = Find_Path(dest, final_moves, maxlen, threshhold);
+    ShaderEmu_Path_Asked.most = 0;
+    ShaderEmu_Path_Keep(core, dest, maxlen, threshhold);
+    return path;
+}
+#endif
+
 int FootClass::Passable_Cell(CELL cell, FacingType face, int threat, MoveType threshhold)
 {
+#ifdef SHADEREMU
+    MoveType move;
+    int who = threshhold >> 4;
+    threshhold = (MoveType)(threshhold & 15);
+    if (ShaderEmu_Enter_Now && (unsigned)cell < MAP_CELL_TOTAL) {
+        if (ShaderEmu_Enter_At[who][cell] == ShaderEmu_Enter_Now) {
+            move = (MoveType)ShaderEmu_Enter[who][cell];
+            if (!who) { /* (the counts and the check are the first core's) */
+                ShaderEmu_Enter_Kept++;
+                ShaderEmu_Enter_Wrong += ShaderEmu_Enter_Check && move != Can_Enter_Cell(cell, face);
+            }
+        } else {
+            if (ShaderEmu_Pre_At[cell] == ShaderEmu_Enter_Now) {
+                move = (MoveType)ShaderEmu_Pre[cell]; /* (another core has asked) */
+                if (!who && ShaderEmu_Enter_Check) {
+                    ShaderEmu_Enter_Kept++;
+                    ShaderEmu_Enter_Wrong += move != Can_Enter_Cell(cell, face);
+                }
+            } else {
+                move = Can_Enter_Cell(cell, face);
+            }
+            ShaderEmu_Enter[who][cell] = (unsigned char)move;
+            ShaderEmu_Enter_At[who][cell] = ShaderEmu_Enter_Now;
+        }
+    } else {
+        move = Can_Enter_Cell(cell, face);
+    }
+    ShaderEmu_Core[who].seen |= 1u << move;
+#else
     MoveType move = Can_Enter_Cell(cell, face);
+#endif
 
+#ifdef SHADEREMU
+    /* (a cell that is free passes any threshold: only a cloaked blocker's distance is asked) */
+    if (move == MOVE_CLOAK && Distance(cell) > 1)
+        threshhold = MOVE_MOVING_BLOCK;
+#else
     if (move < MOVE_MOVING_BLOCK && Distance(cell) > 1)
         threshhold = MOVE_MOVING_BLOCK;
+#endif
 
     if (move > threshhold)
         return (0);

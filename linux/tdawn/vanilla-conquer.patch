+            });
+        }
+    }
+    if (!ShaderEmu_Sorting && layer.Count() > 1 && layer.Count() <= 1024) {
+        ShaderEmu_Sorting = mcw_try_call(ShaderEmu_Sort_Job, (uint32_t)(uintptr_t)&layer, (uint32_t)layer.Count());
+        ShaderEmu_Sort_Of = &layer;
+    }
+}
+
+/* The pass as Sort() makes it, on a list of the layer's objects (for the check). */
+static void ShaderEmu_Sort_Here(ObjectClass** out, int count)
+{
+    ObjectClass* lower = out[0];
+    COORDINATE lower_y = ShaderEmu_Sort_Key(lower);
+    for (int index = 0; index < count - 1; index++) {
+        ObjectClass* next = out[index + 1];
+        COORDINATE next_y = ShaderEmu_Sort_Key(next);
+        if (next_y < lower_y) {
+            out[index + 1] = lower;
+            out[index] = next;
+        } else {
+            lower = next;
+            lower_y = next_y;
+        }
+    }
+}

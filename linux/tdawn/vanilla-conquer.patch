+}
+
+/*
+** TDAWN_CHECK_REDRAW=1: at the held frame, is the picture that was kept up (the page, the
+** scene's kept cells, objects and shroud) the one made from nothing? Counts the pixels that are not.
+*/
+static void ShaderEmu_Check_Redraw(void)
+{
+    void ShaderEmu_GL_Anew(void);
+    int width = SeenBuff.Get_Width(), height = SeenBuff.Get_Height(), size = width * height, differ = 0;
+
+    if (!getenv("TDAWN_CHECK_REDRAW") || !host_page(1)) {
+        return;
+    }
+    Map.Render();
+    unsigned char* index = new unsigned char[2 * size];
+    unsigned* dark = new unsigned[2 * size];
+    ShaderEmu_Shown(index, dark);
+    ShaderEmu_GL_Anew();
+    Map.Flag_To_Redraw(true);
+    Map.Render();
+    ShaderEmu_Shown(index + size, dark + size);
+    int x0 = width, y0 = size, x1 = -1, y1 = -1;
+    for (int i = 0; i < size; i++) {
+        if (index[i] != index[size + i] || dark[i] != dark[size + i]) {
+            differ++;
+            x0 = MIN(x0, i % width);
+            x1 = MAX(x1, i % width);
+            y0 = MIN(y0, i / width);
+            y1 = MAX(y1, i / width);
+        }
+    }
+    delete[] index;
+    delete[] dark;
+    fprintf(stderr, "tdawn: %d of %d pixels differ from a full redraw (x %d..%d, y %d..%d); the view is at %08x\n",
+            differ, size, x0, x1, differ ? y0 : height, y1, (unsigned)Map.TacticalCoord);
+}
+
+/*
+** TDAWN_PICTURE=1: at the held frame the picture as the program has it goes to the console, for
+** tools/tdawn_picture.py to hold against a capture of what the GPU drew: the palette, then
+** every row's indexes and which of its pixels something darkens.
+*/
+static void ShaderEmu_Picture(void)
+{
+    int width = SeenBuff.Get_Width(), height = SeenBuff.Get_Height();
+
+    if (!getenv("TDAWN_PICTURE") || !host_page(1)) {
+        return;
+    }
+    unsigned char* index = new unsigned char[width * height];
+    unsigned* dark = new unsigned[width * height];
+    char* line = new char[3 * width + 2];
+    ShaderEmu_Shown(index, dark);
+    fprintf(stderr, "tdpic: %d %d", width, height);
+    for (int i = 0; i < 256; i++) {
+        fprintf(stderr, " %06x", host_palette()[i] & 0xffffff);
+    }
+    for (int y = 0; y < height; y++) {
+        char* to = line;
+        for (int x = 0; x < width; x++) {
+            *to++ = "0123456789abcdef"[index[y * width + x] >> 4];
+            *to++ = "0123456789abcdef"[index[y * width + x] & 15];
+        }
+        *to++ = ' ';
+        for (int x = 0; x < width; x++) {
+            *to++ = dark[y * width + x] ? '1' : '0';
+        }
+        *to = 0;
+        fprintf(stderr, "\ntdpic: %d %s", y, line);
+    }
+    fputc(10, stderr);
+    delete[] index;
+    delete[] dark;
+    delete[] line;
+}
+
+/*
+** TDAWN_SUMS=1: after every frame's drawing, a sum of the map's part of the picture as the
+** program has it (and one of what the page has over it), with where the view is: two runs of
+** one game by different ways of drawing must say the same, frame for frame.
+*/
+static void ShaderEmu_Sums(void)
+{
+    static int on = -1;
+    static unsigned char* index;
+    static unsigned* dark;
+    int width = SeenBuff.Get_Width(), height = SeenBuff.Get_Height();
+
+    if (on < 0) {
+        on = getenv("TDAWN_SUMS") != NULL && host_page(1);
+        if (on) {
+            index = new unsigned char[width * height];
+            dark = new unsigned[width * height];
+        }
+    }
+    if (!on) {
+        return;
+    }
+    const unsigned char* page = host_page(1);
+    int x0 = Map.TacPixelX, y0 = Map.TacPixelY;
+    int x1 = x0 + Lepton_To_Pixel(Map.TacLeptonWidth), y1 = y0 + Lepton_To_Pixel(Map.TacLeptonHeight);
+    unsigned sum = 2166136261u, over = 2166136261u;
+    ShaderEmu_Shown(index, dark);
+    for (int y = y0; y < y1; y++) {
+        for (int x = x0; x < x1; x++) {
+            int i = y * width + x;
+            sum = (sum ^ index[i] ^ dark[i] * 257u) * 16777619u;
+            over = (over ^ page[i]) * 16777619u;
+        }
+    }
+    fprintf(stderr, "tdsum: frame %d view %08x sum %08x over %08x\n", (int)Frame, (unsigned)Map.TacticalCoord, sum, over);
+}
+
+/*
+** TDAWN_CHECK_GPU=1: after every frame's drawing the window's picture as the GPU left it is held
+** against the picture as the program has it, every pixel of the map's part that nothing darkens
+** and the pointer is not near: the frames that differ are said, and their count at the end.
+*/
+static unsigned ShaderEmu_GPU_Frames, ShaderEmu_GPU_Differ;
+static inline bool ShaderEmu_Colour_Near(unsigned a, unsigned b)
+{
+    return abs((int)(a >> 16 & 255) - (int)(b >> 16 & 255)) <= 8 && abs((int)(a >> 8 & 255) - (int)(b >> 8 & 255)) <= 8
+           && abs((int)(a & 255) - (int)(b & 255)) <= 8;
+}
+static void ShaderEmu_Check_GPU(void)
+{
+    static int on = -1;
+    static unsigned char* index;
+    static unsigned* dark;
+    static unsigned char* under; // (the scene alone: what shows where the page's own pixel is not taken)
+    static unsigned* under_dark;
+    int width = SeenBuff.Get_Width(), height = SeenBuff.Get_Height(), w, h, row, px, py;
+
+    if (on < 0) {
+        on = getenv("TDAWN_CHECK_GPU") != NULL && host_page(1);
+        if (on) {
+            index = new unsigned char[width * height];
+            dark = new unsigned[width * height];
+            under = new unsigned char[width * height];
+            under_dark = new unsigned[width * height];
+            atexit([]() {
+                fprintf(stderr, "tdawn: %u frames held against the GPU's picture, %u of them differ\n", ShaderEmu_GPU_Frames,
+                        ShaderEmu_GPU_Differ);
+            });
+        }
+    }
+    if (!on || !InMainLoop) {
+        return;
+    }
+    Video_Render_Frame();
+    const unsigned* shown = host_window_picture(&w, &h, &row);
+    for (int wait = 0; shown && wait < 8; wait++) {
+        host_wait(); // (the picture reaches the window's buffer a machine frame after it is drawn)
+    }
+    if (!shown) {
+        return;
+    }
+    ShaderEmu_Shown(index, dark);
+    host_scene_picture(under, under_dark);
+    host_pointer(&px, &py);
+    const unsigned* palette = host_palette();
+    int differ = 0, x0 = w, y0 = h, x1 = -1, y1 = -1;
+    // (the map's part: around it the credits count by the clock)
+    int mx0 = Map.TacPixelX, my0 = Map.TacPixelY;
+    int mx1 = mx0 + Lepton_To_Pixel(Map.TacLeptonWidth), my1 = my0 + Lepton_To_Pixel(Map.TacLeptonHeight);
+    // The game's pixel under each of the window's middles. Over a window that is not a whole
+    // multiple of the screen a rectangle's edges are on the window's pixels (host.c), and what it
+    // shows is up to a pixel of the game's away: any of the nine there is right.
+    static short* column;
+    static short* line;
+    static int made_w, made_h;
+    if (made_w != w || made_h != h) {
+        column = (short*)realloc(column, w * sizeof(short));
+        line = (short*)realloc(line, h * sizeof(short));
+        for (int x = 0; x < w; x++) {
+            column[x] = (short)((2 * x + 1) * width / (2 * w));
+        }
+        for (int y = 0; y < h; y++) {
+            line[y] = (short)((2 * y + 1) * height / (2 * h));
+        }
+        made_w = w, made_h = h;
+    }
+    bool stretched = w % width || h % height;
+    for (int y = 0; y < h; y++) {
+        int gy = line[y];
+        const unsigned char* from = index + gy * width;
+        const unsigned* shade = dark + gy * width;
+        for (int x = 0; x < w; x++) {
+            int gx = column[x];
+            unsigned want = palette[from[gx]] & 0xffffff, got = shown[y * row + x] & 0xffffff;
+            if (want == got || shade[gx] || gx <= mx0 || gx >= mx1 - 1 || gy <= my0 || gy >= my1 - 1 || (abs(gx - px) < 34 && abs(gy - py) < 34)) {
+                continue;
+            }
+            bool found = ShaderEmu_Colour_Near(want, got);
+            for (int k = 0; stretched && !found && k < 9; k++) {
+                int i = (gy + k / 3 - 1) * width + gx + k % 3 - 1;
+                found = dark[i] || under_dark[i] || ShaderEmu_Colour_Near(palette[index[i]], got)
+                        || ShaderEmu_Colour_Near(palette[under[i]], got);
+            }
+            if (found) {
+                continue;
+            }
+            differ++;
+            x0 = MIN(x0, x), x1 = MAX(x1, x), y0 = MIN(y0, y), y1 = MAX(y1, y);
+        }
+    }
+    ShaderEmu_GPU_Frames++;
+    if (differ) {
+        ShaderEmu_GPU_Differ++;
+        fprintf(stderr, "tdgpu: frame %d view %08x: %d of the window's %dx%d pixels are not the program's (x %d..%d, y %d..%d)\n",
+                (int)Frame, (unsigned)Map.TacticalCoord, differ, w, h, x0, x1, y0, y1);
+    }
+}
+
+static void ShaderEmu_Stats(void)
+{
+    static int every = -1, cap, stop, frame_then;
+    static unsigned ms_then, cycles_then;
+    unsigned ms = host_ms(), cycles = host_cycles();
+    int frames = Frame - frame_then;
+
+    ShaderEmu_Check_Occupy();
+    if (every < 0) {
+        const char* text = getenv("TDAWN_STATS_MS");
+        every = text ? atoi(text) : 5000;
+        text = getenv("TDAWN_FRAMES");
+        cap = text ? atoi(text) : 0;
+        text = getenv("TDAWN_STOP_FRAME");
+        stop = text ? atoi(text) : 0;
+        ms_then = ms;
+        cycles_then = cycles;
+        frame_then = Frame;
+        ShaderEmu_Logic_Cycles = ShaderEmu_Draw_Cycles = ShaderEmu_Show_Cycles = ShaderEmu_Shows = 0;
+        return;
+    }
+    {
+        /* TDAWN_SLOW=N (with TDAWN_STATS_MS=0): each frame of more than N thousand instructions, and where they went */
+        static int slow = -1;
+        static unsigned was[7];
+        unsigned now[7] = {cycles, ShaderEmu_Logic_Cycles, ShaderEmu_Draw_Cycles, ShaderEmu_GL_Cycles,
+                           ShaderEmu_GL_Put[0], ShaderEmu_GL_Put[1], ShaderEmu_GL_Objects[2]};
+        if (slow < 0) {
+            slow = getenv("TDAWN_SLOW") ? atoi(getenv("TDAWN_SLOW")) : 0;
+        } else if (slow && now[0] - was[0] > (unsigned)slow * 1000) {
+            fprintf(stderr,
+                    "tdslow: frame %d at %u ms: %uk = logic %uk + draw %uk (the map %uk: %u objects drawn, %u shapes put, %uk "
+                    "pixels) + rest %uk; logic: teams %uk, objects %uk (one of kind %u took %uk from instruction %u), the map %uk; now %u\n",
+                    (int)Frame, ms, (now[0] - was[0]) / 1000, (now[1] - was[1]) / 1000, (now[2] - was[2]) / 1000,
+                    (now[3] - was[3]) / 1000, now[6] - was[6], now[4] - was[4], (now[5] - was[5]) / 1000,
+                    (now[0] - was[0] - (now[1] - was[1]) - (now[2] - was[2])) / 1000, ShaderEmu_Logic_Parts[0] / 1000,
+                    ShaderEmu_Logic_Parts[1] / 1000, ShaderEmu_Logic_Worst[1], ShaderEmu_Logic_Worst[0] / 1000,
+                    ShaderEmu_Logic_Worst[2], ShaderEmu_Logic_Parts[2] / 1000, host_cycles());
+        }
+        memcpy(was, now, sizeof(was));
+    }
+    {
+        /* TDAWN_MARK=A,B: a line as frame A begins and as frame B does (rvc_cpu --pc-from, --until) */
+        static int mark_a = -1, mark_b;
+        if (mark_a < 0) {
+            mark_a = mark_b = 0;
+            if (getenv("TDAWN_MARK")) {
+                sscanf(getenv("TDAWN_MARK"), "%d,%d", &mark_a, &mark_b);
+            }
+        }
+        if (mark_b && ((int)Frame == mark_a || (int)Frame == mark_b)) {
+            host_workers_mark((int)Frame == mark_b, mark_b - mark_a);
+            fprintf(stderr, "tdawn: mark %s\n", (int)Frame == mark_a ? "begins" : "ends");
+        }
+        /* TDAWN_FRAME_LOG=1: every frame's instructions (all, logic, drawing, the map and its parts) and what
+        ** the scene drew anew and put into the atlas, said when the run ends */
+        static unsigned (*log)[10], logged, was[10];
+        static int on = -1;
+        unsigned now[10] = {cycles, ShaderEmu_Logic_Cycles, ShaderEmu_Draw_Cycles, ShaderEmu_GL_Cycles,
+                            ShaderEmu_GL_Parts[0], ShaderEmu_GL_Parts[1], ShaderEmu_GL_Parts[2],
+                            ShaderEmu_GL_Objects[2], ShaderEmu_GL_Put[0], ShaderEmu_GL_Put[1]};
+        if (on < 0) {
+            on = getenv("TDAWN_FRAME_LOG") != NULL;
+            log = on ? (unsigned (*)[10])calloc(8192, sizeof *log) : NULL;
+        } else if (log && logged < 8192) {
+            for (int i = 0; i < 10; i++) {
+                log[logged][i] = now[i] >= was[i] ? now[i] - was[i] : now[i];
+            }
+            logged++;
+        }
+        memcpy(was, now, sizeof(was));
+        if (log && cap && (int)Frame >= cap) {
+            for (unsigned i = 0; i < logged; i++) {
+                fprintf(stderr, "frame %u: %u %u %u map %u %u %u %u drawn %u put %u %u\n", (unsigned)Frame - logged + i,
+                        log[i][0], log[i][1], log[i][2], log[i][3], log[i][4], log[i][5], log[i][6], log[i][7], log[i][8],
+                        log[i][9]);
+            }
+        }
+    }
+    if (cap || (stop && getenv("TDAWN_NO_DELAY"))) {
+        FrameTimer.Set(0);
+    }
+    if (frames > 0 && ((every && ms - ms_then >= (unsigned)every) || (cap && Frame >= cap))) {
+        unsigned all = (cycles - cycles_then) / frames;
+        unsigned logic = ShaderEmu_Logic_Cycles / frames, draw = ShaderEmu_Draw_Cycles / frames;
+        unsigned show = ShaderEmu_Show_Cycles / frames;
+        unsigned span = ms - ms_then ? ms - ms_then : 1;
+
+        fprintf(stderr,
+                "tdstat: frame %d: %d.%d game frames/s of %d, %uk instructions/s; a frame %uk = logic %uk + draw %uk + "
+                "show %uk (%u.%u shows) + rest %uk; %d objects; %u page copies of %u; %u undrawn; the map %uk (cells %uk, objects %uk: %u kept, %u away, %u drawn; shroud %uk), %u quads (%u shroud, %u shadows)\n",
+                Frame,
+                frames * 1000 / span,
+                frames * 10000 / span % 10,
+                Options.GameSpeed ? 60 / Options.GameSpeed : 60,
+                (cycles - cycles_then) / span,
+                all / 1000,
+                logic / 1000,
+                draw / 1000,
+                show / 1000,
+                ShaderEmu_Shows / frames,
+                ShaderEmu_Shows * 10 / frames % 10,
+                (all - logic - draw - show) / 1000,
+                Units.Count() + Infantry.Count() + Buildings.Count() + Aircraft.Count() + Bullets.Count()
+                    + Anims.Count(),
+                ShaderEmu_Page_Copies,
+                ShaderEmu_Page_Flips,
+                ShaderEmu_Skipped,
+                ShaderEmu_GL_Cycles / frames / 1000,
+                ShaderEmu_GL_Parts[0] / frames / 1000,
+                ShaderEmu_GL_Parts[1] / frames / 1000,
+                ShaderEmu_GL_Objects[0] / frames,
+                ShaderEmu_GL_Objects[1] / frames,
+                ShaderEmu_GL_Objects[2] / frames,
+                ShaderEmu_GL_Parts[2] / frames / 1000,
+                ShaderEmu_GL_Quads / frames,
+                ShaderEmu_GL_Shroud / frames,
+                ShaderEmu_GL_Shadows / frames);
+        host_scene_settle(); /* (the objects' worker adds to these: not while it draws) */
+        ShaderEmu_Page_Copies = ShaderEmu_Page_Flips = ShaderEmu_Skipped = ShaderEmu_GL_Quads = 0;
+        ShaderEmu_GL_Shroud = ShaderEmu_GL_Shadows = ShaderEmu_GL_Cycles = 0;
+        ShaderEmu_GL_Parts[0] = ShaderEmu_GL_Parts[1] = ShaderEmu_GL_Parts[2] = 0;
+        ShaderEmu_GL_Objects[0] = ShaderEmu_GL_Objects[1] = ShaderEmu_GL_Objects[2] = 0;
+        ms_then = ms;
+        cycles_then = cycles;
+        frame_then = Frame;
+        ShaderEmu_Logic_Cycles = ShaderEmu_Draw_Cycles = ShaderEmu_Show_Cycles = ShaderEmu_Shows = 0;
+    }
+    if (cap && Frame >= cap) {
+        ShaderEmu_State("done");
+        exit(0);
+    }
+    ShaderEmu_Script();
+    if (stop && Frame >= stop) {
+        ShaderEmu_Check_Redraw();
+        /* the picture reaches the window a machine frame after it is shown */
+        Video_Render_Frame();
+        for (int wait = 0; wait < 8; wait++) {
+            host_wait();
+        }
+        ShaderEmu_Picture();
+        ShaderEmu_State("stopped");
+        for (;;) {
+            host_wait();
+        }
+    }
+}

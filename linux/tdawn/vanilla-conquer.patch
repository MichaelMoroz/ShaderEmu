+    if (ptr && !ptr->IsActive) {
+        return (Occupier_Lapsed(this, ptr));
+    }
+#else
     while (ptr && !ptr->IsActive) {
         ptr = ptr->Next;
         ((ObjectClass*&)OccupierPtr) = 0;
     }
+#endif
 
     return (ptr);
 }

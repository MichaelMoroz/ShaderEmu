+/* Rows of the map's cells asked about ahead: y0, y1, x0, x1 a byte each. */
+unsigned FootClass::ShaderEmu_Pre_Job(unsigned object, unsigned rows)
+{
+    const FootClass* unit = (const FootClass*)object;
+    unsigned short now = ShaderEmu_Enter_Now;
+
+    for (int y = rows & 255; y < (int)(rows >> 8 & 255) && !ShaderEmu_Pre_Stop; y++) {
+        for (int x = rows >> 16 & 255; x < (int)(rows >> 24); x++) {
+            CELL cell = XY_Cell(x, y);
+            ShaderEmu_Pre[cell] = (unsigned char)unit->Can_Enter_Cell(cell, FACING_NONE);
+            ShaderEmu_Pre_At[cell] = now; /* (last: the other cores look at this) */
+        }
+    }
+    return 1;
+}

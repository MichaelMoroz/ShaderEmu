+void ShaderEmu_Enter_Keep(bool keep)
+{
+    static unsigned short turn;
+    static int check = -1;
+
+    if (check < 0) {
+        check = getenv("TDAWN_CHECK_ENTER") != NULL;
+        ShaderEmu_Enter_Check = check && atoi(getenv("TDAWN_CHECK_ENTER"));
+        if (check) {
+            atexit(ShaderEmu_Enter_Report);
+        }
+    }
+    /* (the cores that ask about cells ahead read the map: they have ended before it changes) */
+    if (ShaderEmu_Pre_Out) {
+        ShaderEmu_Pre_Stop = 1;
+        for (int k = 0; k < ShaderEmu_Pre_Out; k++) {
+            host_pre_wait(k);
+        }
+        ShaderEmu_Pre_Stop = 0;
+        ShaderEmu_Pre_Out = 0;
+    }
+    if (keep && ++turn == 0) {
+        memset(ShaderEmu_Enter_At, 0, sizeof(ShaderEmu_Enter_At));
+        memset(ShaderEmu_Pre_At, 0, sizeof(ShaderEmu_Pre_At));
+        turn = 1;
+    }
+    ShaderEmu_Enter_Now = keep ? turn : 0;
+    ShaderEmu_Searches = 0;
+    /* searches nobody asked the result of are stopped, and waited for: the unit is put back next */
+    for (int k = 1; k < PATH_CORES; k++) {
+        if (ShaderEmu_Path_Out[k]) {
+            ShaderEmu_Path_Stop = ShaderEmu_Path_Turn;
+            host_path_wait(k);
+            ShaderEmu_Path_Out[k] = 0;

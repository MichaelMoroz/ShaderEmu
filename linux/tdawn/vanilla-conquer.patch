+/*
+** The machine's clock is a word in memory and its frame ends with one instruction: no system
+** calls, and no 64-bit arithmetic. A forced call shows the screen; others at most 60 times a second.
+*/
+void Frame_Limiter(FrameLimitFlags flags)
+{
+    static unsigned shown;
+    unsigned now = host_ms();

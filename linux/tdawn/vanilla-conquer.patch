+*/
+static void ShaderEmu_Shown(unsigned char* index, unsigned* dark)
+{
+    extern bool ShaderEmu_GL_Live;
+    const unsigned char* page = host_page(1);
+    int width = SeenBuff.Get_Width(), height = SeenBuff.Get_Height();
+    int x0 = Map.TacPixelX, y0 = Map.TacPixelY;
+    int x1 = x0 + Lepton_To_Pixel(Map.TacLeptonWidth), y1 = y0 + Lepton_To_Pixel(Map.TacLeptonHeight);
+
+    host_scene_picture(index, dark);
+    for (int y = 0, i = 0; y < height; y++) {
+        for (int x = 0; x < width; x++, i++) {
+            if (!ShaderEmu_GL_Live || page[i] || x < x0 || x >= x1 || y < y0 || y >= y1) {
+                index[i] = page[i];
+                dark[i] = 0;
+            }
+        }

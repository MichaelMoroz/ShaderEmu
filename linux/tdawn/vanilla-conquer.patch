+static inline COORDINATE ShaderEmu_Sort_Key(ObjectClass* object)
+{
+    if (object->ShaderEmu_SortState == 1 && object->ShaderEmu_SortFor == object->Coord) {
+        return object->ShaderEmu_SortKey;
+    }
+    COORDINATE key = object->Sort_Y();

+/*
+** The same walk for a search that draws nothing, which is every one in play: a cell's answer
+** is read where Passable_Cell keeps it, and a cell that is new to the path is put on it here.
+** Step for step the walk above (TDAWN_CHECK_PATHS compares; TDAWN_WALK=old is the one above).
+*/
+bool FootClass::ShaderEmu_Walk(CELL start,
+                               CELL target,
+                               PathType* path,
+                               FacingType search,
+                               FacingType olddir,
+                               int threat,
+                               int max_cells,
+                               MoveType threshhold)
+{
+    static const unsigned char value[MOVE_COUNT] = {1, 1, 3, 8, 10, 0}; /* (Passable_Cell's) */
+    const int who = threshhold >> 4, most = threshhold & 15;
+    unsigned char* const enter = ShaderEmu_Enter[who];
+    unsigned short* const enter_at = ShaderEmu_Enter_At[who];
+    const unsigned short now = ShaderEmu_Enter_Now;
+    const int startx = Cell_X(start), starty = Cell_Y(start), targetx = Cell_X(target), targety = Cell_Y(target);
+    struct Seen
+    {
+        unsigned bits, &to;
+        ~Seen()
+        {
+            to |= bits;
+        }
+    } seen = {0, ShaderEmu_Core[who].seen};
+    auto cost_of = [&](CELL cell, FacingType face) -> int {
+        if ((unsigned)cell >= MAP_CELL_TOTAL) {
+            return Passable_Cell(cell, face, threat, threshhold);
+        }
+        int move;
+        if (enter_at[cell] == now) {
+            move = enter[cell];
+        } else {
+            move = ShaderEmu_Pre_At[cell] == now ? ShaderEmu_Pre[cell] : (int)Can_Enter_Cell(cell, face);
+            enter[cell] = (unsigned char)move;
+            enter_at[cell] = now;
+        }
+        seen.bits |= 1u << move;
+        int limit = most;
+        if (move == MOVE_CLOAK && Distance(cell) > 1) {
+            limit = MOVE_MOVING_BLOCK;
+        }
+        if (move > limit) {
+            return 0;
+        }
+        if (threat != -1 && GameToPlay == GAME_NORMAL && Map.Cell_Distance(cell, DestLocation) > THREAT_THRESHOLD
+            && Map.Cell_Threat(cell, Owner()) > threat) {
+            return 0;
+        }
+        return value[move];
+    };
+    FacingType newdir, firstdir = (FacingType)-1;
+    CELL oldcell = start, newcell, firstcell = -1;
+    int cost = 0, online = true, oldval = 0, cellcount = 0;
+
+    path->LastOverlap = -1;
+    path->LastFixup = -1;
+    while (path->Length < max_cells) {
+        if (who) {
+            if (PATH_STOPPED(who)) {
+                return false;
+            }
+        } else if (++ShaderEmu_Core[0].steps == PATH_HELP_STEPS) {
+            ShaderEmu_Path_Help();
+        }
+        bool forceout = false;
+        newdir = olddir;
+        for (;;) {
+            bool forcefail = false;
+
+            newdir = Next_Direction(newdir, search);
+            if (newdir & FACING_NE) {
+                CELL checkcell = Adjacent_Cell(oldcell, Next_Direction(newdir, search));
+                if (checkcell == target) {
+                    cost = cost_of(checkcell, Next_Direction(newdir, search));
+                    if (cost) {
+                        newdir = Next_Direction(newdir, search);
+                        newcell = Adjacent_Cell(oldcell, newdir);
+                        break;
+                    }
+                }
+                checkcell = Adjacent_Cell(oldcell, newdir);
+                int checkval = Point_Relative_To_Line(Cell_X(checkcell), Cell_Y(checkcell), startx, starty, targetx, targety);
+                forcefail = checkval && !online && (checkval ^ oldval) < 0;
+                if (forcefail && path->Length > 0 && (FacingType)(newdir ^ 4) == path->Command[path->Length - 1]) {
+                    forcefail = false;
+                }
+            }
+            if (newdir == olddir) {
+                return false;
+            }
+            newcell = Adjacent_Cell(oldcell, newdir);
+            if (!forcefail && (cost = cost_of(newcell, newdir)) != 0) {
+                break;
+            }
+            if (newcell == target) {
+                forceout = true;
+                break;
+            }
+        }
+        if (!forceout) {
+            int pos = newcell >> 5, bit = (newcell & 31) - 1; /* (as Register_Cell has them) */
+            if (!(path->Overlap[pos] & (1 << bit))) {
+                path->Command[path->Length++] = newdir;
+                path->Cost += cost;
+                path->Overlap[pos] |= (1 << bit);
+            } else if (!Register_Cell(path, newcell, newdir, cost, threshhold)) {
+                if (!Unravel_Loop(path, newcell, newdir, startx, starty, targetx, targety, threshhold)) {
+                    return false;
+                }
+                newdir = Next_Direction(newdir, (FacingType)(search * 2));
+            }
+            int val = Point_Relative_To_Line(Cell_X(newcell), Cell_Y(newcell), startx, starty, targetx, targety);
+            if (val) {
+                oldval = val;
+                online = false;
+            } else {
+                online = true;
+            }
+            if (++cellcount == MAX_PATH_EDGE_FOLLOW) {
+                return false;
+            }
+        }
+        if (newcell == target) {
+            path->Command[path->Length] = END;
+            return true;
+        }
+        if (newcell == firstcell && newdir == firstdir) {
+            return false;
+        }
+        if (firstcell == -1) {
+            firstcell = newcell;
+            firstdir = newdir;
+        }
+        olddir = Next_Direction(newdir, (FacingType)(-(int)search * 3));
+        oldcell = newcell;
+    }
+    return false;
+}

diff --git a/tiberiandawn/conquer.cpp b/tiberiandawn/conquer.cpp
index a8aebd8..0add8ef 100644
--- a/tiberiandawn/conquer.cpp
+++ b/tiberiandawn/conquer.cpp
@@ -98,6 +98,264 @@ extern void Send_Statistics_Packet(void);
 extern char* __nheapbeg;
 bool InMainLoop = false;
 
+#ifdef SHADEREMU
+/*
+** What the game costs on the ShaderEmu machine, in instructions (docs/tdawn.md):
+**   TDAWN_STATS_MS=N   print the figures every N milliseconds (5000; 0 for never)
+**   TDAWN_FRAMES=N     run N game frames with no delay between them, print, and leave
+**   TDAWN_STOP_FRAME=N hold the picture of game frame N (for comparing pictures)
+*/
+void Video_Render_Frame();
+#include "common/host.h"
+extern unsigned ShaderEmu_Show_Cycles, ShaderEmu_Shows, ShaderEmu_Page_Flips, ShaderEmu_Page_Copies;
+static unsigned ShaderEmu_Logic_Cycles, ShaderEmu_Draw_Cycles;
+#define SHADEREMU_COUNT(counter, call)                                                                                 \
+    {                                                                                                                  \
+        unsigned began_ = host_cycles();                                                                               \
+        call;                                                                                                          \
+        counter += host_cycles() - began_;                                                                             \
+    }
+
+/* A sum of the game's state, to see two runs (or two builds) play the same. */
+static void ShaderEmu_State(const char* when)
+{
+    unsigned hash = 2166136261u, overlays = 0;
+    int i;
+#define SHADEREMU_MIX(value) hash = (hash ^ (unsigned)(value)) * 16777619u
+
+    for (i = 0; i < MAP_CELL_TOTAL; i++) {
+        if (Map[(CELL)i].Overlay != OVERLAY_NONE) {
+            overlays++;
+            SHADEREMU_MIX(i * 256 + Map[(CELL)i].Overlay);
+        }
+    }
+    for (i = 0; i < Units.Count(); i++) {
+        SHADEREMU_MIX(Units.Ptr(i)->Coord);
+        SHADEREMU_MIX(Units.Ptr(i)->Strength);
+    }
+    for (i = 0; i < Infantry.Count(); i++) {
+        SHADEREMU_MIX(Infantry.Ptr(i)->Coord);
+        SHADEREMU_MIX(Infantry.Ptr(i)->Strength);
+    }
+    for (i = 0; i < Buildings.Count(); i++) {
+        SHADEREMU_MIX(Buildings.Ptr(i)->Coord);
+        SHADEREMU_MIX(Buildings.Ptr(i)->Strength);
+    }
+    fprintf(stderr,
+            "tdawn: %s at frame %d: %s, %d units, %d infantry, %d buildings, %u overlays, state %08x\n",
+            when,
+            Frame,
+            Scen.ScenarioName,
+            Units.Count(),
+            Infantry.Count(),
+            Buildings.Count(),
+            overlays,
+            hash);
+}
+
+/*
+** A frame that took too long leaves a debt, which shortens the next frames' waits and, while
+** it is over half a frame, leaves their drawing out: the game keeps its speed and draws less
+** often. TDAWN_SKIP=N: how many frames in a row may go undrawn (2; 0 for none).
+*/
+bool ShaderEmu_Scrolled;
+static unsigned ShaderEmu_Skipped;
+
+static bool ShaderEmu_Skip_Draw(void)
+{
+    static int most = -1, row;
+    static unsigned then, debt;
+    unsigned now = host_ms(), period = Options.GameSpeed * 1000u / 60u;
+    bool scrolled = ShaderEmu_Scrolled;
+
+    if (most < 0) {
+        const char* text = getenv("TDAWN_SKIP");
+        most = text ? atoi(text) : 2;
+        if (getenv("TDAWN_FRAMES") || getenv("TDAWN_NO_DELAY")) {
+            most = 0;
+        }
+        then = now;
+    }
+    ShaderEmu_Scrolled = false;
+    debt += now - then;
+    then = now;
+    debt = debt > period ? debt - period : 0;
+    if (debt > 4 * period) {
+        debt = 4 * period;
+    }
+    if (!most || !period) {
+        return false;
+    }
+    int ticks = Options.GameSpeed - (int)(debt * 60u / 1000u);
+    FrameTimer.Set(ticks > 0 ? ticks : 0);
+    if (debt > period / 2 && row < most && !scrolled) {
+        row++;
+        ShaderEmu_Skipped++;
+        return true;
+    }
+    row = 0;
+    return false;
+}
+
+/*
+** A scroll step is sized for some twenty passes a second. With fewer the steps are longer, up
+** to 0x170: a shift of 37 pixels or more has the whole map drawn again.
+*/
+int ShaderEmu_Scroll_Distance(int distance)
+{
+    static unsigned then;
+    unsigned now = host_ms(), gap = now - then;
+
+    then = now;
+    if (gap > 50 && gap < 1000 && !getenv("TDAWN_NO_DELAY")) {
+        distance = distance * (int)gap / 50;
+    }
+    ShaderEmu_Scrolled = true;
+    return distance > 0x170 ? 0x170 : distance;
+}
+
+/*
+** Things a player would do, for runs nobody is at:
+**   TDAWN_SCROLL=N   from frame 20 the map is scrolled for N frames: east, south, west, north
+**   TDAWN_BUILD=N    at frame N a refinery is put in view, which plays its construction
+*/
+static void ShaderEmu_Script(void)
+{
+    static int scroll = -1, build;
+
+    if (scroll < 0) {
+        const char* text = getenv("TDAWN_SCROLL");
+        scroll = text ? atoi(text) : 0;
+        text = getenv("TDAWN_BUILD");
+        build = text ? atoi(text) : 0;
+    }
+    if (Frame >= 20 && Frame < 20 + scroll) {
+        static const DirType way[4] = {DIR_E, DIR_S, DIR_W, DIR_N};
+        int distance = ShaderEmu_Scroll_Distance(0x60);
+        Map.Scroll_Map(way[(Frame - 20) / 12 % 4], distance, true);
+    }
+    if (build && Frame == build) {
+        CELL corner = Coord_Cell(Map.TacticalCoord);
+        int before = Buildings.Count();
+        for (int y = 2; y < 6 && Buildings.Count() == before; y++) {
+            for (int x = 2; x < 8 && Buildings.Count() == before; x++) {
+                BuildingTypeClass::As_Reference(STRUCT_REFINERY)
+                    .Create_And_Place((CELL)(corner + x + y * MAP_CELL_W), PlayerPtr->Class->House);
+            }
+        }
+        fprintf(stderr, "tdawn: a refinery at frame %d: %s\n", Frame, Buildings.Count() > before ? "placed" : "no room in view");
+    }
+}
+
+/*
+** TDAWN_CHECK_REDRAW=1: at the held frame, is the picture the game kept up by scrolling and
+** redrawing parts the picture it draws from nothing? Counts the pixels that are not.
+*/
+static void ShaderEmu_Check_Redraw(void)
+{
+    const unsigned char* page = host_page(1);
+    int size = SeenBuff.Get_Width() * SeenBuff.Get_Height(), differ = 0;
+
+    if (!getenv("TDAWN_CHECK_REDRAW") || !page) {
+        return;
+    }
+    Map.Render();
+    unsigned char* kept = new unsigned char[size];
+    memcpy(kept, page, size);
+    Map.Flag_To_Redraw(true);
+    Map.Render();
+    int width = SeenBuff.Get_Width(), x0 = width, y0 = size, x1 = -1, y1 = -1;
+    for (int i = 0; i < size; i++) {
+        if (kept[i] != page[i]) {
+            differ++;
+            x0 = MIN(x0, i % width);
+            x1 = MAX(x1, i % width);
+            y0 = MIN(y0, i / width);
+            y1 = MAX(y1, i / width);
+        }
+    }
+    delete[] kept;
+    fprintf(stderr, "tdawn: %d of %d pixels differ from a full redraw (x %d..%d, y %d..%d); the view is at %08x\n",
+            differ, size, x0, x1, y0, y1, (unsigned)Map.TacticalCoord);
+}
+
+static void ShaderEmu_Stats(void)
+{
+    static int every = -1, cap, stop, frame_then;
+    static unsigned ms_then, cycles_then;
+    unsigned ms = host_ms(), cycles = host_cycles();
+    int frames = Frame - frame_then;
+
+    if (every < 0) {
+        const char* text = getenv("TDAWN_STATS_MS");
+        every = text ? atoi(text) : 5000;
+        text = getenv("TDAWN_FRAMES");
+        cap = text ? atoi(text) : 0;
+        text = getenv("TDAWN_STOP_FRAME");
+        stop = text ? atoi(text) : 0;
+        ms_then = ms;
+        cycles_then = cycles;
+        frame_then = Frame;
+        ShaderEmu_Logic_Cycles = ShaderEmu_Draw_Cycles = ShaderEmu_Show_Cycles = ShaderEmu_Shows = 0;
+        return;
+    }
+    if (cap || (stop && getenv("TDAWN_NO_DELAY"))) {
+        FrameTimer.Set(0);
+    }
+    if (frames > 0 && ((every && ms - ms_then >= (unsigned)every) || (cap && Frame >= cap))) {
+        unsigned all = (cycles - cycles_then) / frames;
+        unsigned logic = ShaderEmu_Logic_Cycles / frames, draw = ShaderEmu_Draw_Cycles / frames;
+        unsigned show = ShaderEmu_Show_Cycles / frames;
+        unsigned span = ms - ms_then ? ms - ms_then : 1;
+
+        fprintf(stderr,
+                "tdstat: frame %d: %d.%d game frames/s of %d, %uk instructions/s; a frame %uk = logic %uk + draw %uk + "
+                "show %uk (%u.%u shows) + rest %uk; %d objects; %u page copies of %u; %u undrawn\n",
+                Frame,
+                frames * 1000 / span,
+                frames * 10000 / span % 10,
+                Options.GameSpeed ? 60 / Options.GameSpeed : 60,
+                (cycles - cycles_then) / span,
+                all / 1000,
+                logic / 1000,
+                draw / 1000,
+                show / 1000,
+                ShaderEmu_Shows / frames,
+                ShaderEmu_Shows * 10 / frames % 10,
+                (all - logic - draw - show) / 1000,
+                Units.Count() + Infantry.Count() + Buildings.Count() + Aircraft.Count() + Bullets.Count()
+                    + Anims.Count(),
+                ShaderEmu_Page_Copies,
+                ShaderEmu_Page_Flips,
+                ShaderEmu_Skipped);
+        ShaderEmu_Page_Copies = ShaderEmu_Page_Flips = ShaderEmu_Skipped = 0;
+        ms_then = ms;
+        cycles_then = cycles;
+        frame_then = Frame;
+        ShaderEmu_Logic_Cycles = ShaderEmu_Draw_Cycles = ShaderEmu_Show_Cycles = ShaderEmu_Shows = 0;
+    }
+    if (cap && Frame >= cap) {
+        ShaderEmu_State("done");
+        exit(0);
+    }
+    ShaderEmu_Script();
+    if (stop && Frame >= stop) {
+        ShaderEmu_Check_Redraw();
+        /* the picture reaches the window a machine frame after it is shown */
+        Video_Render_Frame();
+        for (int wait = 0; wait < 8; wait++) {
+            host_wait();
+        }
+        ShaderEmu_State("stopped");
+        for (;;) {
+            host_wait();
+        }
+    }
+}
+#else
+#define SHADEREMU_COUNT(counter, call) call
+#endif
+

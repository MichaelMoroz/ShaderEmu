+// The port: both of a tile's edge numbers at once, the visible one in the low byte and the explored one above it, from one look at
+// its eight neighbours: get_tile_mask_num's two calls a tile in the walk, each the same eight words (docs/games/aoe.md, "Speed in play")
+static inline int aoe_tile_masks(const unsigned char* edge, int map_col, int map_row, int map_width, int map_height, unsigned long visible,
+                                 unsigned long explored, unsigned long* const* unified_map_offsets) {
+    unsigned v = 0, e = 0;
+    if (0 < map_col && 0 < map_row && map_col < map_width - 1 && map_row < map_height - 1) {
+        const unsigned long* up = unified_map_offsets[map_row - 1] + map_col;
+        const unsigned long* mid = unified_map_offsets[map_row] + map_col;
+        const unsigned long* down = unified_map_offsets[map_row + 1] + map_col;
+        unsigned long n = up[0], ne = up[1], nw = up[-1], ea = mid[1], we = mid[-1], s = down[0], se = down[1], sw = down[-1];
+#define AOE_EDGE(word, bit) do { if (!((word) & visible)) v |= (bit); if (!((word) & explored)) e |= (bit); } while (0)
+        AOE_EDGE(n, 0x80); AOE_EDGE(ea, 0x40); AOE_EDGE(s, 0x20); AOE_EDGE(we, 0x10);
+        AOE_EDGE(ne, 0x08); AOE_EDGE(se, 0x04); AOE_EDGE(sw, 0x02); AOE_EDGE(nw, 0x01);
+#undef AOE_EDGE
+        return edge[v] | edge[e] << 8;
+    }
+    int max_col = map_width - 1, max_row = map_height - 1;
+#define AOE_EDGE_AT(ok, r, c, bit) do { if (ok) { unsigned long w = unified_map_offsets[r][c]; if (!(w & visible)) v |= (bit); if (!(w & explored)) e |= (bit); } } while (0)
+    AOE_EDGE_AT(0 < map_col, map_row, map_col - 1, 0x10);
+    AOE_EDGE_AT(map_col < max_col, map_row, map_col + 1, 0x40);
+    AOE_EDGE_AT(0 < map_row, map_row - 1, map_col, 0x80);
+    AOE_EDGE_AT(map_row < max_row, map_row + 1, map_col, 0x20);
+    AOE_EDGE_AT(0 < map_col && 0 < map_row, map_row - 1, map_col - 1, 0x01);
+    AOE_EDGE_AT(0 < map_col && map_row < max_row, map_row + 1, map_col - 1, 0x02);
+    AOE_EDGE_AT(map_col < max_col && 0 < map_row, map_row - 1, map_col + 1, 0x08);
+    AOE_EDGE_AT(map_col < max_col && map_row < max_row, map_row + 1, map_col + 1, 0x04);
+#undef AOE_EDGE_AT
+    return edge[v] | edge[e] << 8;
+}

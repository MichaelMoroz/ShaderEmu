+// The port: a sum of the game's state every AOE_SUM_EVERY updates, and the end of a run at AOE_SUM_END.
+#include "../include/world.h"
+#include "../include/player.h"
+#include "../include/stat_obj.h"
+#include "../include/obj_list.h"
+extern unsigned aoe_rand_state(void);
+extern void aoe_window_close(void);
+extern "C" void _exit(int);
+unsigned long aoe_updates, aoe_world_ms;
+static inline unsigned sum_in(unsigned h, unsigned v) { return (h ^ v) * 16777619u; }
+static unsigned sum_bits(float f) { unsigned u; memcpy(&u, &f, 4); return u; }
+static void aoe_world_updated(RGE_Game_World* w) {
+    static int every = -1, end;
+    if (every < 0) {
+        const char* e = getenv("AOE_SUM_EVERY"); every = e ? atoi(e) : 0;
+        e = getenv("AOE_SUM_END"); end = e ? atoi(e) : 0;
+    }
+    aoe_updates++;
+    aoe_world_ms = w->world_time;
+    if (!every || aoe_updates % every) return;
+    unsigned h = 2166136261u, count = 0;
+    h = sum_in(h, w->world_time);
+    h = sum_in(h, aoe_rand_state());
+    for (int p = 0; p < w->player_num; p++) {
+        RGE_Player* pl = w->players[p];
+        for (int a = 0; a < pl->attribute_num; a++) h = sum_in(h, sum_bits(pl->attributes[a]));
+        RGE_Object_List* lists[2] = { pl->objects, pl->sleeping_objects };
+        for (int l = 0; l < 2; l++) {
+            if (!lists[l]) continue;
+            for (RGE_Object_Node* n = lists[l]->list; n; n = n->next) {
+                RGE_Static_Object* o = n->node;
+                h = sum_in(h, o->id);
+                h = sum_in(h, sum_bits(o->hp));
+                h = sum_in(h, sum_bits(o->world_x));
+                h = sum_in(h, sum_bits(o->world_y));
+                h = sum_in(h, o->object_state);
+                count++;
+            }
+        }
+    }
+    if (getenv("AOE_PLAYERS")) for (int p = 0; p < w->player_num; p++) {
+        RGE_Player* pl = w->players[p];
+        fprintf(stderr, "aoeplayer %d type %d objects %d asleep %d food %d wood %d stone %d gold %d pop %d\n", p, (int) pl->type, pl->objects ? pl->objects->number_of_objects : 0,
+            pl->sleeping_objects ? pl->sleeping_objects->number_of_objects : 0, (int) pl->attributes[0], (int) pl->attributes[1], (int) pl->attributes[2], (int) pl->attributes[3], pl->attribute_num > 11 ? (int) pl->attributes[11] : 0);
+    }
+    fprintf(stderr, "aoesum: update %lu time %lu objects %u sum %08x\n", aoe_updates, (unsigned long) w->world_time, count, h);
+    if (end && aoe_updates >= (unsigned long) end) { aoe_window_close(); _exit(0); }
+}

+void RGE_View::aoe_terrain_band(long line_lo, long line_hi, TSpan_List_Manager* tm, TSpan_List_Manager* fm) {
+    aoe_strip_clears_rows(this->save_area1, line_lo, line_hi);   // (the strips a scroll uncovered: kept by draw for the bands)
+    TSpan_List_Manager* real[2] = {this->Terrain_Clip_Mask, this->Terrain_Fog_Clip_Mask};
+    TSpan_List_Manager* mine[2] = {tm, fm};
+    for (int i = 0; i < 2; i++) {   // (each as it stood when the walk began, on the band's lines)
+        TSpan_List_Manager* x = mine[i];
+        if (x != real[i]) x->VSList.ReclaimAllNodes();
+        x->Min_Span_Px = aoe_tr.start[i][0]; x->Min_Line = aoe_tr.start[i][1];
+        x->Max_Span_Px = aoe_tr.start[i][2]; x->Max_Line = aoe_tr.start[i][3];
+        if (x->Min_Line < line_lo) x->Min_Line = line_lo;
+        if (x->Max_Line > line_hi) x->Max_Line = line_hi;
+    }
+    long first = line_lo < 0 ? 0 : line_lo;
+    static const unsigned plain[4] = {0x00ff00ff, 0, 0xff00ff00, 0};
+    int shapes = 0;

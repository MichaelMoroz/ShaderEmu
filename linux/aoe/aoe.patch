+int aoe_tiles_owed;   // (the walk's tiles still being made: aoe_raster_levels waits for them before the bands)
+void aoe_view_tiles_counted(void) { tiles_drawn += aoe_sp.tiles; aoe_sp.tiles = 0; }   // (the view's worker, the tiles made)
+void aoe_band_split(RGE_View* v, long lo, long hi, int parts, long* bound) {
+    // (by groups of 4 lines, as the bands begin on 4: a group's weight the pixels of the shapes over its lines, and a little for each)
+    static int diff[1100];
+    long g0 = lo >> 2, groups = (hi >> 2) - g0 + 1;
+    if (hi < lo || groups > 1024) { for (int b = 1; b < parts; b++) bound[b] = (lo + (hi - lo + 1) * b / parts) & ~3L; return; }
+    memset(diff, 0, (groups + 1) * sizeof(int));
+    #define AOE_SPLIT_ADD(y0, h, w) do { long a_ = ((y0) >> 2) - g0, b_ = (((y0) + (h) - 1) >> 2) - g0 + 1; if (a_ < 0) a_ = 0; if (b_ > groups) b_ = groups; \
+        if (a_ < b_) { diff[a_] += ((w) + 16) * 4; diff[b_] -= ((w) + 16) * 4; } } while (0)
+    for (int i = 0; !aoe_tiles_owed && i < aoe_tr.n; i++) {   // (not while the tiles' worker writes the record)
+        AoeTrCmd* c = &aoe_tr.cmd[i];
+        if (c->kind == AOE_TR_SHAPE) { Shape_Info* info = (Shape_Info*) c->q; AOE_SPLIT_ADD(c->b, info->Height, info->Width); }
+    }
+    for (int level = 0; level <= 0x28; level++)
+        for (DClipInfo_Node* node = v->futur_objs->Draw_Level_Head[level]; node; node = node->NextOnLevel)
+            if (node->Node_Type == 0 && node->Shape) AOE_SPLIT_ADD(node->Draw_Y, node->Shape->Height, node->Shape->Width * (level <= 5 ? 2 : 1));
+    for (int i = 0; i < aoe_bf.adds; i++) {
+        DClipInfo_Node* node = aoe_bf.add[i];
+        if (node->Node_Type == 0 && node->Shape) AOE_SPLIT_ADD(node->Draw_Y, node->Shape->Height, 8);
+    }
+    #undef AOE_SPLIT_ADD
+    long long total = 0;
+    for (long i = 0, w = 0; i < groups; i++) { w += diff[i]; diff[i] = w + 192; total += diff[i]; }
+    long long run = 0;
+    int b = 1;
+    for (long i = 0; i < groups && b < parts; i++) {
+        run += diff[i];
+        while (b < parts && run * parts >= total * b) { bound[b] = (g0 + i + 1) * 4; b++; }
+    }
+    for (; b < parts; b++) bound[b] = (hi + 1) & ~3L;
+    for (b = 1; b < parts; b++) {   // (in order, each band at least empty)
+        if (bound[b] < (lo & ~3L)) bound[b] = lo & ~3L;
+        if (b > 1 && bound[b] < bound[b - 1]) bound[b] = bound[b - 1];
+    }

+        switch (c->kind) {
+            case AOE_TR_REGION: {
+                TSpan_List_Manager* x = mine[c->mask];
+                x->SetSpanRegions(c->a, c->b, c->c, c->d);
+                if (x->Min_Line < line_lo) x->Min_Line = line_lo;
+                if (x->Max_Line > line_hi) x->Max_Line = line_hi;
+                break;
+            }
+            case AOE_TR_ADD: mine[c->mask]->AddMiniList((VSpanMiniList*) c->p, c->a, c->b); break;
+            case AOE_TR_SUB: mine[c->mask]->SubtractMiniList((VSpanMiniList*) c->p, c->a, c->b); break;

+void TSpan_List_Manager::AddRect(int LeftPx, int RightPx, int Top, int Bottom) {
+    for (int line = Top; line <= Bottom; line++) {
+        if (line < this->Min_Line || line > this->Max_Line) continue;
+        VSpan_Node* node = this->VSList.GetNode();
+        node->Prev = 0;
+        node->Next = 0;
+        node->StartPx = LeftPx;
+        node->EndPx = RightPx;
+        this->Line_Head_Ptrs[line] = node;
+        this->Line_Tail_Ptrs[line] = node;
+        this->LeftMostPx[line] = LeftPx;
+        this->RightMostPx[line] = RightPx;
+        this->Span_Count[line] = 1;
+    }
+}

+    TSpan_List_Manager* current = area->CurSpanList;
+    AoeTrCmd* c = aoe_tr_new(AOE_TR_SHAPE);
+    c->p = shape->FShape; c->q = info; c->area = area; c->cur = current;
+    c->a = x - info->Hotspot_X; c->b = y - info->Hotspot_Y;
+    c->c = (span_list->Num_Lines < current->Num_Lines ? span_list->Num_Lines : current->Num_Lines) - 1;

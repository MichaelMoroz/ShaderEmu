+// The port: a big picture of the older format (a status screen's background, drawn four times as two come) kept as its rows' pixels
+// and runs the first time it is drawn plainly, then copied run by run within the clip: the pixels shape_draw_unclipped writes, and what a
+// skip passes over untouched (docs/games/aoe.md, "The load"). The first core's, pictures 256 wide or more; AOE_PLAIN=0 the way before.
+#include "aoe_cores.h"
+struct AoeOldRun { short a, b; };
+struct AoeOldShape { const void* header; long width, height; unsigned used; unsigned char* pix; int* first; AoeOldRun* runs; };
+enum { AOE_OLD_SHAPES = 4 };
+static AoeOldShape aoe_old_shapes[AOE_OLD_SHAPES];
+static unsigned aoe_old_clock;
+static const AoeOldShape* aoe_old_shape(Shape_Header* sh) {
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("AOE_PLAIN"); on = !(e && !strcmp(e, "0")); }
+    long width = sh->xmax - sh->xmin + 1, height = sh->ymax - sh->ymin + 1;
+    if (!on || width < 256 || height <= 0 || width > 4096 || aoe_view_core()) return 0;
+    AoeOldShape* old = &aoe_old_shapes[0];
+    for (int i = 0; i < AOE_OLD_SHAPES; i++) {
+        AoeOldShape* k = &aoe_old_shapes[i];
+        if (k->header == sh && k->width == width && k->height == height) { k->used = ++aoe_old_clock; return k; }
+        if (k->used < old->used) old = k;
+    }
+    free(old->pix); free(old->first); free(old->runs);
+    memset(old, 0, sizeof *old);
+    long cap = height * 8 + 64, total = 0;
+    old->pix = (unsigned char*) malloc(width * height);
+    old->first = (int*) malloc((height + 1) * sizeof(int));
+    old->runs = (AoeOldRun*) malloc(cap * sizeof(AoeOldRun));
+    if (!old->pix || !old->first || !old->runs) { free(old->pix); free(old->first); free(old->runs); memset(old, 0, sizeof *old); return 0; }
+    const unsigned char* p = (const unsigned char*) (sh + 1);
+    for (long r = 0; r < height; r++) {
+        unsigned char* out = old->pix + r * width;
+        long at = 0;
+        old->first[r] = (int) total;
+        for (;;) {
+            unsigned char command = *p++, c = command >> 1;
+            long n = 0;
+            if (command & 1) {
+                if (c == 0) { at += *p++; continue; }
+                n = c;
+                if (at >= 0 && at + n <= width) memcpy(out + at, p, n);
+                p += c;
+            } else {
+                if (c == 0) break;
+                n = c;
+                if (at >= 0 && at + n <= width) memset(out + at, *p, n);
+                p++;
+            }
+            if (at < 0 || at + n > width) { free(old->pix); free(old->first); free(old->runs); memset(old, 0, sizeof *old); return 0; }
+            if (total > old->first[r] && old->runs[total - 1].b == at - 1) old->runs[total - 1].b = (short) (at + n - 1);
+            else {
+                if (total == cap) {
+                    cap *= 2;
+                    AoeOldRun* grown = (AoeOldRun*) realloc(old->runs, cap * sizeof(AoeOldRun));
+                    if (!grown) { free(old->pix); free(old->first); free(old->runs); memset(old, 0, sizeof *old); return 0; }
+                    old->runs = grown;
+                }
+                old->runs[total].a = (short) at; old->runs[total].b = (short) (at + n - 1); total++;
+            }
+            at += n;
+        }
+    }
+    old->first[height] = (int) total;
+    old->header = sh; old->width = width; old->height = height; old->used = ++aoe_old_clock;
+    return old;
+}
+// its rows clip_y0 to clip_y1 and columns clip_x0 to clip_x1 into the area, the picture's corner at shape_x0, shape_y0
+static void aoe_old_draw(const AoeOldShape* k, TDrawArea* drawarea, long shape_x0, long shape_y0, long clip_x0, long clip_y0, long clip_x1, long clip_y1) {
+    long pitch = drawarea->AlignedWidth() * drawarea->Orien;
+    for (long y = clip_y0; y <= clip_y1; y++) {
+        long r = y - shape_y0;
+        if (r < 0 || r >= k->height) continue;
+        unsigned char* row = drawarea->Orien < 1 ? drawarea->Bits + (y - drawarea->Height + 1) * pitch : drawarea->Bits + y * pitch;
+        const unsigned char* px = k->pix + r * k->width;
+        for (int i = k->first[r]; i < k->first[r + 1]; i++) {
+            long a = shape_x0 + k->runs[i].a, b = shape_x0 + k->runs[i].b;
+            if (a < clip_x0) a = clip_x0;
+            if (b > clip_x1) b = clip_x1;
+            if (a <= b) memcpy(row + a, px + (a - shape_x0), b - a + 1);
+        }
+    }
+}

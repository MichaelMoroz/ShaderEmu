+// The port: the trial's game screen is a picture for 800 x 600. At 640 x 480 the layout (handle_size) puts what is right of the buttons 160
+// pixels to the left and the bottom panel 120 up, so a piece of the middle of each band is left out: the top bar from 376 and the bottom panel from
+// 406, each 160 wide, where nothing of the 640 layout looks.
+static void aoe_picture_cut(TShape* pic, TDrawArea* area) {
+    tagRECT save, piece;
+    save = area->ClipRect;
+    static const struct { short left, right, top, bottom, x, y, frame; } pieces[4] = {
+        { 0, 375, 0, 19, 0, 0, 0 }, { 376, 639, 0, 19, -160, 0, 0 }, { 0, 405, 354, 479, 0, 354, 1 }, { 406, 639, 354, 479, -160, 354, 1 } };
+    for (int i = 0; i < 4; i++) {
+        piece.left = pieces[i].left > save.left ? pieces[i].left : save.left;
+        piece.right = pieces[i].right < save.right ? pieces[i].right : save.right;
+        piece.top = pieces[i].top > save.top ? pieces[i].top : save.top;
+        piece.bottom = pieces[i].bottom < save.bottom ? pieces[i].bottom : save.bottom;
+        if (piece.left > piece.right || piece.top > piece.bottom) continue;
+        area->SetClipRect(&piece);
+        pic->shape_draw(area, pieces[i].x, pieces[i].y, pieces[i].frame, 0, 0);
+    }
+    area->SetClipRect(&save);
+}

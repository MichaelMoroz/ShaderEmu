+static void aoe_clear_lines(void* lines, int lo, int count) {
+    char* at = (char*) lines + lo * 4;
+    for (int bytes = count * 4; bytes > 0; ) {
+        int piece = bytes < 2044 ? bytes : 2044;
+        memset(at, 0, piece);
+        at += piece;
+        bytes -= piece;
+    }

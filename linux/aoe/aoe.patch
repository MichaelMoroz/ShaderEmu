+static int aoe_gdi_rows(const DClipInfo_Node* n, long* lo, long* hi) {
+    long a, b;
+    if (n->Node_Type == 1) {
+        a = b = n->y1;
+        if (n->y2 < a) a = n->y2; if (n->y2 > b) b = n->y2;
+        if (n->y3 < a) a = n->y3; if (n->y3 > b) b = n->y3;
+        if (n->y4 < a) a = n->y4; if (n->y4 > b) b = n->y4;
+    } else if (n->Node_Type >= 2 && n->Node_Type <= 4) {
+        a = n->y1 < n->y2 ? n->y1 : n->y2;
+        b = n->y1 < n->y2 ? n->y2 : n->y1;
+    } else return 0;
+    *lo = a; *hi = b;
+    return 1;

# Microwindows build configuration for the ShaderEmu Linux image: the Nano-X server with its
# window manager built in, clients over a UNIX socket, compiled-in fonts only, no external
# libraries. ARCH is LINUX-NATIVE with the tools overridden by build.sh.
ARCH                     = LINUX-NATIVE
SHAREDLIBS               = N
SHAREDLINK               = N
DEBUG                    = N
OPTIMIZE                 = -O2
VERBOSE                  = N
THREADSAFE               = N
PARALLEL                 = N

SCREEN                   = SHADEREMU
MOUSE                    = SHADEREMUMOUSE
KEYBOARD                 = SHADEREMUKBD
SCREEN_WIDTH             = 800
SCREEN_HEIGHT            = 600
SCREEN_PIXTYPE           = MWPF_TRUECOLORARGB
SCREEN_DEPTH             = 8

MICROWIN                 = N
NANOX                    = Y
NUKLEARUI                = N
NX11                     = N
ENGINE                   = N
TINYWIDGETS              = N
FBEMULATOR               = N
MICROWINDEMO             = N
MICROWINMULTIAPP         = N
NANOXDEMO                = Y
HAVE_VNCSERVER_SUPPORT   = N
LINK_APP_INTO_SERVER     = N
NANOWM                   = Y
HAVE_SHAREDMEM_SUPPORT   = N

HAVE_FILEIO              = Y
HAVE_BMP_SUPPORT         = Y
HAVE_GIF_SUPPORT         = Y
HAVE_PNM_SUPPORT         = Y
HAVE_XPM_SUPPORT         = Y
HAVE_JPEG_SUPPORT        = N
HAVE_PNG_SUPPORT         = N
HAVE_TIFF_SUPPORT        = N
HAVE_PCF_SUPPORT         = N
HAVE_PCFGZ_SUPPORT       = N
HAVE_FREETYPE_2_SUPPORT  = N
HAVE_HARFBUZZ_SUPPORT    = N
HAVE_T1LIB_SUPPORT       = N
HAVE_FNT_SUPPORT         = N
HAVE_FNTGZ_SUPPORT       = N
HAVE_HZK_SUPPORT         = N
HAVE_HBF_SUPPORT         = N
HAVE_BIG5_SUPPORT        = N
HAVE_GB2312_SUPPORT      = N
HAVE_JISX0213_SUPPORT    = N
HAVE_EUCJP_SUPPORT       = N
HAVE_KSC5601_SUPPORT     = N
HAVE_FRIBIDI_SUPPORT     = N
HAVE_SHAPEJOINING_SUPPORT = N

ERASEMOVE                = Y
UPDATEREGIONS            = Y
NOFONTS                  = N
NOCLIPPING               = N
USE_EXPOSURE             = Y
VTSWITCH                 = N
FBREVERSE                = N
GRAYPALETTE              = N
HAVETEXTMODE             = N

+/*
+ * A screen driver that composes the screen from one surface per top-level window sets
+ * gd_compositor; the window system then draws each window on the surface it is given.
+ */
+struct gd_compositor {
+	/* the surface of window `owner`, which is at x, y on the screen and this big */
+	PSD	(*surface)(void *owner, MWCOORD x, MWCOORD y, MWCOORD width, MWCOORD height);
+	void	(*release)(void *owner);
+	void	(*touch)(PSD psd);		/* something else drew on it */
+	/* where the surface keeps the pixel for screen position x, y */
+	void	(*locate)(PSD psd, MWCOORD x, MWCOORD y, uint32_t *address, uint32_t *row);
+	/* the surface follows the pointer from here on, its corner dx, dy from it (owner NULL:
+	 * no longer); 0 if the driver cannot, and the window system moves the window itself */
+	int	(*drag)(void *owner, MWCOORD dx, MWCOORD dy);
+	/* 0: the driver drags no surface; 2: it does, and has it there; 1: it has moved it nowhere yet */
+	int	(*dragged)(MWCOORD *x, MWCOORD *y);
+};
+/* set by the window system: the rectangle round the pointer in which a move of it is nobody's
+ * news (0: there is none) */
+extern int (*gd_quiet_rect)(MWCOORD *x0, MWCOORD *y0, MWCOORD *x1, MWCOORD *y1);
+/* goes up when a window comes, goes, moves, changes size or place in the order, or who hears of
+ * the pointer changes: what gd_composite_walk shows and gd_quiet_rect answers is as it was till then */
+extern unsigned gd_scene_gen;
+/* the rows of the surface gd_composite_walk's show is called for that are shown, 0 for all (a
+ * window rolled up to its caption keeps its picture) */
+extern int gd_show_height;
+/* where in its image the cursor's hot spot is, for a driver that shows the cursor itself */
+extern MWCOORD gd_cursor_hotx, gd_cursor_hoty;
+extern struct gd_compositor *gd_compositor;

+				if (!more)
+					break;
+				x->at = more;
+			}
+			strcpy(x->at[x->count].name, known);
+			x->at[x->count++].cell = cell;
+			if (!strcmp(known, "default") && x->fallback < 0)
+				x->fallback = cell;
+		}
+		free(text);
+	}
+	for (n = 0; n < x->count; n++)
+		if (!strcmp(x->at[n].name, name))
+			return x->at[n].cell;

+/*
+ * Composed screen: gives a window the surface of its top-level window, which is as big as
+ * that window with its border. The surface follows the window when it moves or is resized.
+ */
+void
+GsWindowSurface(GR_WINDOW *wp)
+{
+	GR_WINDOW *top = wp;
+	int bs;
+
+	if (!gd_compositor || wp == rootwp)
+		return;
+	while (top->parent != rootwp)
+		top = top->parent;
+	bs = top->bordersize;
+	top->psd = gd_compositor->surface(top, top->x - bs, top->y - bs, top->width + bs * 2, top->height + bs * 2);
+	if (wp != top && wp->psd != top->psd) {
+		gd_compositor->release(wp);	/* it may have been a top-level window before */
+		wp->psd = top->psd;
+	}
+}
+
+/* Shows the screen driver every visible top-level window's surface, lowest window first. */
+static void
+show_windows(GR_WINDOW *wp, void (*show)(PSD psd))
+{
+	if (!wp)
+		return;
+	show_windows(wp->siblings, show);
+	if (wp->realized && wp->output) {
+		GsWindowSurface(wp);
+		show(wp->psd);
+	}
+}
+
+void
+GsCompositeWalk(void (*show)(PSD psd))
+{
+	show_windows(rootwp->children, show);
+}

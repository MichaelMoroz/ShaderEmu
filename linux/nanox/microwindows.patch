+/* The top-level window wp is in, or NULL for the root. */
+static GR_WINDOW *
+top_level(GR_WINDOW *wp)
+{
+	while (wp != rootwp && wp->parent != rootwp)
+		wp = wp->parent;
+	return wp == rootwp ? NULL : wp;
+}
+
+/* Brings a framed window to the front (shown again if minimised) and gives it the keyboard. */
+static void
+activate_frame(GR_WINDOW *top)
+{
+	GR_WINDOW *cp = GsFrameClient(top), *fp;
+
+	if (!cp)
+		return;
+	/* (a frame put away with its desktop, brought forward: its desktop is shown) */
+	if (top->props & GR_WM_PROPS_AWAY)
+		wm_goto_desktop((top->props & GR_WM_PROPS_DESK) >> GR_WM_PROPS_DESK_SHIFT);
+	GrMapWindow(top->id);
+	if (!(top->props & GR_WM_PROPS_NORAISE))
+		GrRaiseWindow(top->id);
+	/* a window inside the program's own may hold the keyboard: leave it there */
+	for (fp = focuswp; fp != rootwp && fp != cp; fp = fp->parent)
+		;
+	if (fp != cp)
+		GrSetFocus(cp->id);
+}
+
+/* A frame to the front with the keyboard, its desktop shown (a program's word, GR_WMC_ACTIVATE). */
+void
+wm_activate(GR_WINDOW_ID frame)
+{
+	activate_frame(GsFindWindow(frame));
+}
+
+/* A word to the bar: an event of the key it grabbed, which no key makes (GR_WM_TELL). False with no bar. */
+int
+wm_tell_bar(int what, GR_WINDOW_ID frame, int x, int y)
+{
+	GR_GRABBED_KEY *keygrab;
+	GR_EVENT_KEYSTROKE *ep;
+
+	for (keygrab = list_grabbed_keys; keygrab; keygrab = keygrab->next)
+		if (keygrab->key == MWKEY_LMETA && keygrab->type == GR_GRAB_HOTKEY) {
+			if ((ep = (GR_EVENT_KEYSTROKE *)GsAllocEvent(keygrab->owner)) == NULL)
+				return 0;
+			ep->type = GR_EVENT_TYPE_KEY_DOWN;
+			ep->wid = keygrab->wid;
+			ep->subwid = frame;
+			ep->rootx = x;
+			ep->rooty = y;
+			ep->x = ep->y = 0;
+			ep->buttons = ep->modifiers = 0;
+			ep->ch = GR_WM_TELL(what);
+			ep->scancode = 0;
+			ep->hotkey = GR_TRUE;
+			return 1;
+		}
+	return 0;
+}
+
+/* Desktop `desktop` is shown: the frames of the one shown go away with their pictures kept,
+ * those put away for it come back (a window its user minimised stays so), the keyboard goes
+ * to the front-most. */
+void
+wm_goto_desktop(int desktop)
+{
+	GR_WINDOW *wp;
+	int shown = desktop & (GR_WM_DESKTOPS - 1);
+
+	if (shown != wm_desktop) {
+		for (wp = rootwp->children; wp; wp = wp->siblings) {
+			win *frame = wm_find_window(wp->id);
+			int on = (wp->props & GR_WM_PROPS_DESK) >> GR_WM_PROPS_DESK_SHIFT;
+
+			if (!frame || frame->type != WINDOW_TYPE_CONTAINER)
+				continue;
+			if (on == wm_desktop && wp->mapped) {
+				wp->props |= GR_WM_PROPS_AWAY;
+				GrUnmapWindow(wp->id);
+			} else if (on == shown && (wp->props & GR_WM_PROPS_AWAY)) {
+				wp->props &= ~GR_WM_PROPS_AWAY;
+				GrMapWindow(wp->id);
+			}
+		}
+		wm_desktop = shown;
+		GsSetFocus(GsNextFocusWindow());
+	}
+	wm_tell_bar(GR_WM_TELL_DESKTOP, 0, wm_desktop, 0);
+}
+
+/* A framed window goes to desktop `desktop`, shown or not. */
+void
+wm_to_desktop(win *window, int desktop)
+{
+	GR_WINDOW *wp = GsFindWindow(window->wid);
+	int to = desktop & (GR_WM_DESKTOPS - 1);
+
+	if (!wp)
+		return;
+	wp->props = (wp->props & ~GR_WM_PROPS_DESK) | (GR_WM_PROPS)to << GR_WM_PROPS_DESK_SHIFT;
+	if (to != wm_desktop && wp->mapped) {
+		wp->props |= GR_WM_PROPS_AWAY;
+		GrUnmapWindow(wp->id);
+		GsSetFocus(GsNextFocusWindow());
+	} else if (to == wm_desktop && (wp->props & GR_WM_PROPS_AWAY)) {
+		wp->props &= ~GR_WM_PROPS_AWAY;
+		GrMapWindow(wp->id);
+	}
+	wm_tell_bar(GR_WM_TELL_STATE, wp->id, 0, 0);
+}
+
+/*
+ * The keys with both Ctrl and Alt held, which no program of the desktop uses: the arrows snap
+ * (Up maximises, Down puts back, or minimises what is not snapped), U I J K a quarter, with
+ * Shift the arrows move; S rolls up, T keeps on top, D shows the desktop, Space the window's
+ * menu; 1 to 4 show a desktop, with Shift send the window there; Page Up and Down the desktop
+ * before and after. By the key's code: Ctrl makes a letter a control character. True if it was one.
+ */
+static GR_BOOL
+tile_key(MWKEY key, MWKEYMOD modifiers, MWSCANCODE code, win *frame)
+{
+	int shift = (modifiers & MWKMOD_SHIFT) != 0;
+
+	switch (key) {
+	case MWKEY_LEFT: case MWKEY_RIGHT: case MWKEY_UP: case MWKEY_DOWN:
+		if (!frame)
+			return GR_TRUE;
+		if (shift)
+			wm_nudge(frame, key == MWKEY_LEFT ? -16 : key == MWKEY_RIGHT ? 16 : 0, key == MWKEY_UP ? -16 : key == MWKEY_DOWN ? 16 : 0);
+		else if (key == MWKEY_DOWN) {
+			if (frame->maximized || frame->tiled) {
+				wm_tile(frame, 0);
+				wm_place_save(frame);
+			} else
+				GrUnmapWindow(frame->wid);
+		} else {
+			wm_tile(frame, key == MWKEY_LEFT ? 1 : key == MWKEY_RIGHT ? 2 : WM_ZONE_MAX);
+			wm_place_save(frame);
+		}
+		return GR_TRUE;
+	case MWKEY_PAGEUP: case MWKEY_PAGEDOWN:
+		wm_goto_desktop(wm_desktop + (key == MWKEY_PAGEUP ? GR_WM_DESKTOPS - 1 : 1));
+		return GR_TRUE;
+	}
+	switch (code) {
+	case 22: case 23: case 36: case 37:	/* U I, J K: where they lie on the keyboard */
+		if (frame) {
+			wm_tile(frame, code == 22 ? 3 : code == 23 ? 4 : code == 36 ? 5 : 6);
+			wm_place_save(frame);
+		}
+		return GR_TRUE;
+	case 31:
+		if (frame)
+			wm_shade(frame);
+		return GR_TRUE;
+	case 20:
+		if (frame)
+			wm_ontop(frame);
+		return GR_TRUE;
+	case 32:
+		wm_tell_bar(GR_WM_TELL_SHOW_DESK, 0, 0, 0);
+		return GR_TRUE;
+	case 57:
+		if (frame) {
+			GR_WINDOW *wp = GsFindWindow(frame->wid);
+
+			wm_tell_bar(GR_WM_TELL_MENU, frame->wid, wp->x + 4, wp->y + CYCAPTION + 4);
+		}
+		return GR_TRUE;
+	case 2: case 3: case 4: case 5:
+		if (!shift)
+			wm_goto_desktop(code - 2);
+		else if (frame)
+			wm_to_desktop(frame, code - 2);
+		return GR_TRUE;
+	}
+	return GR_FALSE;
+}
+
+static int wm_switching;	/* the bar's switcher is up: told when the key held with Tab is let go */
+
+/*
+ * The window manager's keys, with Alt or Ctrl held: Tab the next window (Shift: the one
+ * before), F4 close, F9 minimise, F10 maximise and back; with both, tile_key's. True if the
+ * key was one of them.
+ */
+static GR_BOOL
+window_key(MWKEY key, MWKEYMOD modifiers, MWSCANCODE code)
+{
+	GR_WINDOW *top = top_level(focuswp), *wp, *next = NULL;
+	win *frame = top && GsFrameClient(top) ? wm_find_window(top->id) : NULL;
+
+	if ((modifiers & MWKMOD_ALT) && (modifiers & MWKMOD_CTRL) && tile_key(key, modifiers, code, frame))
+		return GR_TRUE;
+	switch (key) {
+	case MWKEY_TAB:
+		/* the bar shows the windows and goes by which had the keyboard last; with no bar, in turn */
+		if (wm_tell_bar(GR_WM_TELL_SWITCH, 0, (modifiers & MWKMOD_SHIFT) != 0, 0)) {
+			wm_switching = 1;
+			return GR_TRUE;
+		}
+		if (modifiers & MWKMOD_SHIFT) {
+			/* the window at the back comes forward */
+			for (wp = rootwp->children; wp; wp = wp->siblings)
+				if (GsFrameClient(wp))
+					next = wp;
+		} else {
+			/* the window in front goes to the back, and the one then in front is next */
+			if (frame)
+				GrLowerWindow(top->id);
+			for (wp = rootwp->children; wp && !next; wp = wp->siblings)
+				if (GsFrameClient(wp))
+					next = wp;
+		}
+		if (next)

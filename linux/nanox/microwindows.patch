+/* The cell of a name in an index, or -1; `fallback` is then its "default" cell. */
+static int
+index_cell(struct icon_index *x, const char *name)
+{
+	int cell, fd, n, at, k;
+
+	if (x->count < 0) {
+		/* a name and a number a line, read in one piece */
+		char *text = malloc(8192);
+
+		x->count = 0;
+		fd = text ? open(x->path, O_RDONLY) : -1;
+		n = fd < 0 ? 0 : (int)read(fd, text, 8191);
+		if (fd >= 0)
+			close(fd);
+		if (text)
+			text[n < 0 ? 0 : n] = 0;
+		for (at = 0; text && text[at]; ) {
+			char known[32];
+
+			while (text[at] == ' ' || text[at] == '\n' || text[at] == '\r' || text[at] == '\t')
+				at++;
+			for (k = 0; (unsigned char)text[at] > ' ' && k < 31; k++)
+				known[k] = text[at++];
+			known[k] = 0;
+			while (text[at] == ' ' || text[at] == '\t')
+				at++;
+			if (!k || text[at] < '0' || text[at] > '9') {
+				while (text[at] && text[at] != '\n')
+					at++;
+				continue;
+			}
+			for (cell = 0; text[at] >= '0' && text[at] <= '9'; at++)
+				cell = cell * 10 + text[at] - '0';
+			if (!(x->count & 63)) {
+				void *more = realloc(x->at, (x->count + 64) * sizeof *x->at);

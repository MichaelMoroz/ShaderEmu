+/* An index of icons (tools/make_icons.py), kept from its first reading: names, and the cell of each. */
+struct icon_index { const char *path; int count, fallback; struct { char name[32]; int cell; } *at; };
+struct icon_index nx_icons = { "/usr/share/icons.idx", -1, -1, NULL };
+struct icon_index nx_icons7 = { "/usr/share/icons7.idx", -1, -1, NULL };

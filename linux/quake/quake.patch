+		particle_t	*p = &particles[se_job.fresh[w][i]];
+		const se_effect_t	*e;
+
+		s->alive[n++] = se_job.fresh[w][i];
+		if (!made)
+			continue;
+		// R_ParticleExplosion's particle number made & 1023, with its seven random numbers
+		e = &se_job.effects[(made >> 10) - 1];
+		if (by != made >> 10 || 7 * (made & 1023) < at)
+			by = made >> 10, x = e->seed, at = 0;
+		made &= 1023;
+		x = se_leap (x, 7 * made - at);
+		at = 7 * made + 7;
+		p->die = e->die;
+		p->color = ramp1[0];
+		x = 6364136223846793005ULL * x + 1;
+		p->ramp = (int)(x >> 33) & 3;
+		p->type = made & 1 ? pt_explode : pt_explode2;
+		for (j=0 ; j<3 ; j++)
+		{
+			x = 6364136223846793005ULL * x + 1;
+			p->org[j] = e->org[j] + (((int)(x >> 33) % 32) - 16);
+			x = 6364136223846793005ULL * x + 1;
+			p->vel[j] = ((int)(x >> 33) % 512) - 256;
+		}
+	}
+	for (j=0 ; j<n ; j++)
+	{
+		int			slot = s->alive[j];
+		particle_t	*p = &particles[slot];
+
+		if (p->die < now)
+		{
+			s->dead[dead++] = slot;
+			continue;
+		}
+		if (kept != j)
+			s->alive[kept] = slot;
+		kept++;
+		to[0] = ((unsigned *)p->org)[0];
+		to[1] = ((unsigned *)p->org)[1];
+		to[2] = ((unsigned *)p->org)[2];
+		to[3] = qgl_particle_colour[(int)p->color & 255];
+		to += 4;
+
+		p->org[0] += p->vel[0]*frametime;
+		p->org[1] += p->vel[1]*frametime;
+		p->org[2] += p->vel[2]*frametime;

+// What a frame given to a worker draws of them (scene_shaderemu.c).
+void SE_ParticlesView (int *view)
+{
+	int	w;
+
+	view[0] = se_shown;
+	for (w=0 ; w<SE_SHARES ; w++)
+		view[1 + w] = se_drawn[w];
+}
+
+void SE_ParticlesClock (void)
+{
+	if (se_how > SE_FRAME)
+		se_pending += cl.time - cl.oldtime;
+}
+
+// The frame's jobs: what the workers are to do of the particles, as the shares of each call
+// (how many calls; 0: none). None is out when this is asked.
+int SE_ParticlesGive (unsigned *mask)
+{
+	int		w, calls = 0;
+
+	if (se_how <= SE_FRAME)
+		return 0;
+	{
+		se_job.time = cl.time;
+		se_job.frametime = se_pending;
+		se_job.grav = se_pending * sv_gravity.value * 0.05;
+		{	// (a buffer no frame given out or a list being drawn may read: SE_BUFFERS has one)
+			unsigned	busy = SE_SceneParticlesBusy ();
+			int			b;
+
+			if (se_shown >= 0)
+				busy |= 1u << se_shown;
+			if (se_last_drawn >= 0 && !SE_SceneParticlesBusy ())
+				busy |= 1u << se_last_drawn;	// (no frame out: the last one's list may be drawn still)
+			for (b=0 ; b<SE_BUFFERS-1 && (busy >> b & 1) ; b++)
+				;
+			se_job.buffer = b;
+		}
+		se_pending = 0;
+		for (w=0 ; w<SE_SHARES ; w++)
+		{
+			se_job.fresh[w] = se_fresh[se_fresh_now][w];
+			se_job.made[w] = se_made[se_fresh_now][w];
+			se_job.fresh_count[w] = se_fresh_count[w];
+			if (!se_live[w] && !se_fresh_count[w])
+			{
+				se_drawn[w] = 0;	// (a share with nothing in it is not woken)
+				continue;
+			}
+			se_out |= 1 << w;
+			se_fresh_count[w] = 0;
+		}
+		se_job.effects = se_effects[se_fresh_now];
+		se_fresh_now ^= 1;
+		se_effect_count = 0;
+		if (se_out)
+		{
+			int		work = 0, c = 0;
+
+			// (a call a share in a fight, one for a few particles: a call has its own cost)
+			for (w=0 ; w<SE_SHARES ; w++)
+				if (se_out & (1 << w))
+					work += se_live[w] + 2 * se_job.fresh_count[w];
+			calls = 1 + work / SE_CALL_WORK;
+			for (w=0 ; w<SE_SHARES ; w++)
+				if (se_out & (1 << w))
+					mask[c] |= 1 << w, c = c + 1 < calls ? c + 1 : 0;
+			for (calls=0 ; calls<SE_SHARES && mask[calls] ; calls++)
+				;
+		}
+		else
+			se_shown = se_job.buffer;
+	}
+	return calls;
+}
+
+// A frame: the workers' last vertices are drawn.
+static void se_draw_particles (void)
+{
+	unsigned	*to = NULL, *from;
+	int			w, n, room = 0, given, done = 0;
+
+	int			shown, drawn[SE_SHARES];
+
+	if (!se_particles_now)	// (a frame drawn on a worker: the first core took them)
+		SE_FramePoll ();	// (particles moved meanwhile are drawn now)
+	shown = se_particles_now ? se_particles_now[0] : se_shown;
+	for (w=0 ; w<SE_SHARES ; w++)
+		drawn[w] = se_particles_now ? se_particles_now[1 + w] : se_drawn[w];
+	if (shown < 0)
+		return;
+	se_last_drawn = shown;
+	if (se_sum_every)
+	{	// (QUAKE_PARTICLE_SUM: a check that two ways of making them draw the same)
+		for (w=0 ; w<SE_SHARES ; w++)
+			for (from = se_vertices + (shown * r_numparticles + w * se_share) * 4, n=0 ; n<drawn[w]*4 ; n++)
+				se_sum = (se_sum << 5 | se_sum >> 27) + from[n];
+		if (++se_sum_frames % se_sum_every == 0)
+		{
+			if (mcw_on_worker ())
+				mcw_print ("quake: particles at frame %u: %08x\n", se_sum_frames, se_sum);
+			else
+				Sys_Printf ("quake: particles at frame %u: %08x\n", se_sum_frames, se_sum);
+		}
+	}
+	// (drawn where they are first: a copy's room is trimmed at the end, after its own draw)
+	for (w=0 ; w<SE_SHARES ; w++)
+		if (se_vertices_drawn && drawn[w] >= 3
+			&& qglParticlesAt (se_vertices + (shown * r_numparticles + w * se_share) * 4, drawn[w]))
+			done |= 1 << w;
+	for (w=0 ; w<SE_SHARES ; w++)
+	{
+		from = se_vertices + (shown * r_numparticles + w * se_share) * 4;
+		for (n=done & (1 << w) ? 0 : drawn[w] ; n>0 ; )
+		{
+			int	some;
+
+			if (!room)
+			{
+				to = qglParticleRoom (&given);
+				if ((room = given) == 0)
+					break;
+			}
+			some = n < room ? n : room;
+			memcpy (to, from, some * 16);
+			to += some * 4, from += some * 4, room -= some, n -= some;
+		}
+	}
+	qglParticleRoomLeft (room);
+}

+	for (w=0 ; w<SE_SHARES ; w++)
+	{
+		if (!(se_out & (1 << w)))
+			continue;
+		for (k=0 ; k<se_shares[w].dead_count ; k++)
+			se_free[w][se_free_count[w]++] = se_shares[w].dead[k];
+		se_drawn[w] = se_live[w] = se_shares[w].drawn;
+	}
+	se_shown = se_job.buffer;
+	se_out = 0;
+}
+
+void SE_ParticlesTaken (void)
+{
+	if (se_out)
+		se_particles_take ();

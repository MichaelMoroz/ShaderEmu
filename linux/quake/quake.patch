+
+// A worker's job: its share's particles, as R_DrawParticles has each (the same sums).
+static uint32_t se_particle_share (uint32_t w, uint32_t unused)
+{
+	se_share_t	*s = &se_shares[w];
+	float		frametime = se_job.frametime, time3 = frametime * 15, time2 = frametime * 10, time1 = frametime * 5;
+	float		grav = se_job.grav, dvel = 4*frametime, now = se_job.time;
+	unsigned	*to = se_vertices + (se_job.buffer * r_numparticles + w * se_share) * 4;
+	int			i, j, n = s->alive_count, kept = 0, dead = 0;

+#ifdef SHADEREMU
+/*
+The particles on workers (docs/games/quake.md, "The other workers", "Calls of the second layer"): the
+array is four shares, each moved by a worker that writes a vertex each into a buffer of its own in
+GPU memory, which the frame draws from there, and lists those that died; this core gives a new one
+a free place, and an explosion's particles are made by their share's worker from its random
+numbers. The calls are the frame's jobs (world_shaderemu.c), given out when the entities are placed.
+QUAKE_PARTICLES=frame: moved and drawn by this core as before; =wait: the workers, waited for;
+=copy: their vertices copied into the frame. QUAKE_EXPLODE=frame: explosions made by this core.
+*/
+#include "mcwx.h"
+
+#define SE_SHARES		SE_PARTICLE_WORKERS
+#define SE_SHARE_MOST	1024	// particles of a share, at most
+enum { SE_FRAME, SE_WAIT, SE_APART };
+
+// a worker's own: the places it moves, those that died in its last job, and how many it drew
+typedef struct {
+	unsigned short	alive[SE_SHARE_MOST], dead[SE_SHARE_MOST];
+	int				alive_count, dead_count, drawn, unused;
+} se_share_t;
+static se_share_t	se_shares[SE_SHARES] __attribute__ ((aligned (16)));
+// this core's: a share's free places, and the new particles of each for its next job (two
+// lists in turn: a job reads the one it was given)
+static unsigned short	se_free[SE_SHARES][SE_SHARE_MOST], se_fresh[2][SE_SHARES][SE_SHARE_MOST];
+// beside each new one: 0, made here; else which explosion of the list's makes it, and its number
+// in it (SE_MADE_BY): its worker makes it from the explosion's random numbers (se_explode)
+static unsigned short	se_made[2][SE_SHARES][SE_SHARE_MOST];
+#define SE_EFFECTS		63	// (SE_MADE_BY of the last fits 16 bits)
+#define SE_CALL_WORK	512		// particles a call, about, before another is given out
+#define SE_MADE_BY(e, i)	((e + 1) << 10 | (i))
+typedef struct { vec3_t org; float die; unsigned long long seed; int unused[2]; } se_effect_t;
+static se_effect_t	se_effects[2][SE_EFFECTS] __attribute__ ((aligned (16)));
+static int		se_effect_count, se_explode_here, se_sum_every;
+static unsigned	se_sum, se_sum_frames;
+// rand()'s step taken 2^b times at once: x' = mul x + add
+static struct { unsigned long long mul, add; } se_leaps[14];
+static int		se_free_count[SE_SHARES], se_fresh_count[SE_SHARES], se_fresh_now, se_next;
+#define SE_BUFFERS	4	// the workers' vertices: one written, one shown, two frames' lists that may read theirs
+static int		se_last_drawn = -1;	// the buffer the last frame drew
+int			*se_particles_now;	// a frame drawn on a worker: its copy of se_shown and se_drawn (scene_shaderemu.c)
+unsigned SE_SceneParticlesBusy (void);
+static int		se_how = -1, se_share, se_out, se_shown = -1, se_drawn[SE_SHARES], se_live[SE_SHARES];

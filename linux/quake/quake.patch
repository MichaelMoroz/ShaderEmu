+} se_job __attribute__ ((aligned (16)));
+
+extern unsigned	qgl_particle_colour[256];
+extern cvar_t	sv_gravity;
+
+static uint32_t se_particle_share (uint32_t w, uint32_t unused);
+
+// The seed of rand() as it is `steps` numbers later.
+static unsigned long long se_leap (unsigned long long x, unsigned steps)
+{
+	int	b;
+
+	for (b=0 ; steps ; b++, steps >>= 1)
+		if (steps & 1)
+			x = se_leaps[b].mul * x + se_leaps[b].add;
+	return x;
+}
+
+static void se_particles_start (void)
+{
+	const char	*how = getenv ("QUAKE_PARTICLES");
+
+	se_how = SE_APART;
+	se_share = r_numparticles / SE_SHARES;
+	if ((how && !strcmp (how, "frame")) || SE_Workers () < SE_WORKER_PARTICLES + SE_SHARES - 1 || se_share > SE_SHARE_MOST
+		|| ((se_vertices = qglParticleMemory (SE_BUFFERS * r_numparticles * 16)) == NULL
+			&& (se_vertices = mcw_alloc (SE_BUFFERS * r_numparticles * 16)) == NULL))
+	{
+		se_how = SE_FRAME;

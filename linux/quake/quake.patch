+		unsigned long long	mul = 6364136223846793005ULL, add = 1;
+		int		b;
+
+		for (b=0 ; b<14 ; b++)
+		{
+			se_leaps[b].mul = mul, se_leaps[b].add = add;
+			add = mul * add + add, mul *= mul;
+		}
+	}
+	// (the job's code is read here first: a worker stops at a page of it no core has run)
+	mcw_touch_code ((const void *)((unsigned)SE_ParticlesJob & ~4095u), 2*4096);
+	mcw_touch (se_vertices, SE_BUFFERS * r_numparticles * 16);
+	mcw_touch (se_shares, sizeof se_shares);
+	mcw_touch (&se_job, sizeof se_job);
+}
+
+// A new particle's place: of the free list, or of the share whose turn it is that has one.
+static particle_t *se_new_particle (void)
+{
+	particle_t	*p;
+	int			tries, w, slot;
+
+	if (se_how == SE_FRAME)
+	{
+		if (!free_particles)
+			return NULL;
+		p = free_particles;
+		free_particles = p->next;
+		p->next = active_particles;
+		active_particles = p;
+		return p;
+	}
+	for (tries=0 ; tries<SE_SHARES ; tries++)
+	{
+		w = se_next;
+		se_next = (se_next + 1) % SE_SHARES;

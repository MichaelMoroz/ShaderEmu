diff --git a/WinQuake/common.h b/WinQuake/common.h
index 87d4a55..8f1f1db 100644
--- a/WinQuake/common.h
+++ b/WinQuake/common.h
@@ -93,6 +93,12 @@ extern	int	(*BigLong) (int l);
 extern	int	(*LittleLong) (int l);
 extern	float	(*BigFloat) (float l);
 extern	float	(*LittleFloat) (float l);
+#ifdef SHADEREMU
+// a little-endian machine: these were calls through pointers, for every number of a file
+#define LittleShort(x) ((short)(x))
+#define LittleLong(x) ((int)(x))
+#define LittleFloat(x) ((float)(x))
+#endif
 
 //============================================================================
 
@@ -119,6 +125,55 @@ char *MSG_ReadString (void);
 float MSG_ReadCoord (void);
 float MSG_ReadAngle (void);
 
+#if defined (SHADEREMU) && defined (SE_MSG_INLINE)
+// The readers as common.c has them, inline where a message is read byte by byte every frame
+// (the client's updates): a call each was much of what a byte cost.
+extern	sizebuf_t	net_message;
+
+static inline int se_msg_char (void)
+{
+	if (msg_readcount+1 > net_message.cursize)
+	{
+		msg_badread = true;
+		return -1;
+	}
+	return (signed char)net_message.data[msg_readcount++];
+}
+
+static inline int se_msg_byte (void)
+{
+	if (msg_readcount+1 > net_message.cursize)
+	{
+		msg_badread = true;
+		return -1;
+	}
+	return (unsigned char)net_message.data[msg_readcount++];
+}
+
+static inline int se_msg_short (void)
+{
+	int	c;
+
+	if (msg_readcount+2 > net_message.cursize)
+	{
+		msg_badread = true;
+		return -1;
+	}
+	c = (short)(net_message.data[msg_readcount] + (net_message.data[msg_readcount+1]<<8));
+	msg_readcount += 2;
+	return c;
+}
+
+static inline float se_msg_coord (void) { return se_msg_short() * (1.0/8); }
+static inline float se_msg_angle (void) { return se_msg_char() * (360.0/256); }
+
+#define MSG_ReadChar	se_msg_char
+#define MSG_ReadByte	se_msg_byte
+#define MSG_ReadShort	se_msg_short
+#define MSG_ReadCoord	se_msg_coord
+#define MSG_ReadAngle	se_msg_angle
+#endif
+
 //============================================================================
 
 void Q_memset (void *dest, int fill, int count);
